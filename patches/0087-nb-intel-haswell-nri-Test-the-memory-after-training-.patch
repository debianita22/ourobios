diff --git a/src/northbridge/intel/haswell/native_raminit/memory_test.c b/src/northbridge/intel/haswell/native_raminit/memory_test.c
new file mode 100644
index 0000000000..d815d931c8
--- /dev/null
+++ b/src/northbridge/intel/haswell/native_raminit/memory_test.c
@@ -0,0 +1,171 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <console/console.h>
+#include <lib.h>
+#include <northbridge/intel/haswell/haswell.h>
+#include <types.h>
+
+#include "raminit_native.h"
+
+/*
+ * A memory test after training, as the MRC's MEMTST: with the REUT, every
+ * bank of every rank is written with the victim/aggressor patterns of the
+ * WDB and read back, and the first miscompare stops the test. It is a task
+ * of the training schedule only: a fast boot or S3 resume restores the
+ * training values that it checked, and does not touch the memory contents.
+ */
+
+static enum raminit_status run_bank_test(struct sysinfo *ctrl, const uint8_t chanmask)
+{
+	mchbar_write32(REUT_GLOBAL_CTL, (union reut_seq_ctl_reg) {
+		.start_test    = 1,
+		.clear_errors  = 1,
+		.stop_on_error = 1,
+	}.raw);
+	const uint8_t ch_error = wait_for_reut(ctrl, chanmask) & chanmask;
+	if (!ch_error)
+		return RAMINIT_STATUS_SUCCESS;
+
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+		if (!(ch_error & BIT(channel)))
+			continue;
+
+		const union raw_bitlane_errors errors = get_bitlane_errors(channel);
+		printk(BIOS_ERR, "Memory test: channel %u miscompare, lanes 0x%02x%08x%08x\n",
+		       channel, errors.ecc, errors.upper, errors.lower);
+	}
+	return RAMINIT_STATUS_MEMTEST_FAILURE;
+}
+
+enum raminit_status memory_test(struct sysinfo *ctrl)
+{
+	if (!CONFIG(HASWELL_NRI_MEMORY_TEST))
+		return RAMINIT_STATUS_SUCCESS;
+
+	/* MRC skips the REUT-based checks for HSW A0, the subsequence bitfields differ */
+	if (ctrl->stepping == STEPPING_A0)
+		return RAMINIT_STATUS_SUCCESS;
+
+	printk(BIOS_INFO, "Testing the memory after training\n");
+
+	setup_wdb(ctrl);
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+		if (!does_ch_exist(ctrl, channel))
+			continue;
+
+		/* Write the bank, then read it back from its first address */
+		const union reut_seq_cfg_reg reut_seq_cfg = {
+			.global_control            = 1,
+			.initialization_mode       = REUT_MODE_TEST,
+			.subsequence_start_pointer = 0,
+			.subsequence_end_pointer   = 1,
+			.start_test_delay          = 2,
+		};
+		mchbar_write64(REUT_ch_SEQ_CFG(channel), reut_seq_cfg.raw);
+		program_loop_count(ctrl, channel, 0);	/* Loop once */
+
+		/*
+		 * The eight victim/aggressor patterns of the WDB, one per cacheline,
+		 * driven by the LFSRs as in the alias check: setup_wdb() seeds the
+		 * write and the read LFSRs alike, so the read back is compared with
+		 * the data that was written, pseudo-random across the bank.
+		 */
+		mchbar_write32(REUT_ch_WDB_CL_CTRL(channel), (union reut_pat_wdb_cl_ctrl_reg) {
+			.start_ptr = 0,
+			.end_ptr   = 7,
+			.inc_rate  = 1,
+			.inc_scale = SCALE_LINEAR,
+		}.raw);
+		const union reut_pat_wdb_cl_mux_cfg_reg pat_wdb_cl_mux_cfg = {
+			.mux_0_control = REUT_MUX_LFSR,
+			.mux_1_control = REUT_MUX_LFSR,
+			.mux_2_control = REUT_MUX_LFSR,
+			.ecc_data_source_sel = 1,
+		};
+		mchbar_write32(REUT_ch_PAT_WDB_CL_MUX_CFG(channel), pat_wdb_cl_mux_cfg.raw);
+		mchbar_write32(REUT_ch_PAT_WDB_INV(channel), 0);
+
+		/* Stop at the first miscompare, on any lane */
+		const union reut_err_ctl_reg reut_err_ctl = {
+			.selective_err_enable_cacheline = 0xff,
+			.selective_err_enable_chunk     = 0xff,
+			.stop_on_error_control          = NTHSOE,
+			.stop_on_nth_error              = 1,
+		};
+		mchbar_write32(REUT_ch_ERR_CONTROL(channel), reut_err_ctl.raw);
+		mchbar_write64(REUT_ch_ERR_DATA_MASK(channel), 0);
+		mchbar_write8(REUT_ch_ERR_ECC_MASK(channel), 0);
+	}
+
+	/* Every row and column of one bank, as the ECC scrub walks them */
+	struct reut_box reut_addr = {
+		.row = {
+			.inc_val = 1,
+		},
+		.col = {
+			.inc_val = 1,
+		},
+	};
+	enum raminit_status status = RAMINIT_STATUS_SUCCESS;
+	for (uint8_t rank = 0; rank < NUM_SLOTRANKS; rank++) {
+		uint8_t chanmask = 0;
+		for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++)
+			chanmask |= select_reut_ranks(ctrl, channel, BIT(rank));
+
+		if (!chanmask)
+			continue;
+
+		printk(BIOS_INFO, "Testing rank %u\n", rank);
+		const uint8_t slot = rank / 2;
+		for (uint8_t bank = 0; bank < 8; bank++) {
+			reut_addr.bank.start = bank;
+			reut_addr.bank.stop = bank;
+			for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+				if (!(BIT(channel) & chanmask))
+					continue;
+
+				struct raminit_dimm_info *dimm = &ctrl->dimms[channel][slot];
+				const uint32_t row_size = BIT(dimm->data.row_bits);
+				const uint32_t col_size = BIT(dimm->data.col_bits);
+				const uint32_t cl_per_row = col_size / WDB_CACHE_LINE_SIZE;
+				reut_addr.row.stop = row_size - 1;
+				reut_addr.col.stop = col_size - WDB_CACHE_LINE_SIZE;
+				reut_addr.row.inc_rate = cl_per_row;
+				program_seq_addr(channel, &reut_addr, false);
+
+				/* Cachelines in the bank: a power of two, as the row and column counts */
+				const uint8_t num_cl = log2_ceil(row_size) + log2_ceil(cl_per_row);
+				const union reut_subseq_ctl_reg subseq_a = {
+					.num_cachelines_with_scale     = num_cl,
+					.subseq_type                   = SUBSEQ_B_WR,
+					.reset_curr_base_addr_to_start = 0,
+				};
+				const union reut_subseq_ctl_reg subseq_b = {
+					.num_cachelines_with_scale     = num_cl,
+					.subseq_type                   = SUBSEQ_B_RD,
+					.reset_curr_base_addr_to_start = 1,
+				};
+				mchbar_write32(REUT_ch_SUBSEQ_x_CTL(channel, 0), subseq_a.raw);
+				mchbar_write32(REUT_ch_SUBSEQ_x_CTL(channel, 1), subseq_b.raw);
+			}
+			status = run_bank_test(ctrl, chanmask);
+			if (status) {
+				printk(BIOS_ERR, "Memory test failed on rank %u bank %u\n", rank, bank);
+				break;
+			}
+		}
+		if (status)
+			break;
+	}
+
+	/* Return to normal operation mode */
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++)
+		reut_set_normal_mode(channel);
+
+	if (status)
+		printk(BIOS_ERR, "*** Memory test failed, the training is not usable ***\n");
+	else
+		printk(BIOS_INFO, "Memory test passed\n");
+
+	return status;
+}
diff --git a/src/northbridge/intel/haswell/native_raminit/raminit_main.c b/src/northbridge/intel/haswell/native_raminit/raminit_main.c
index 8e29f4c4a9..c6305ba231 100644
--- a/src/northbridge/intel/haswell/native_raminit/raminit_main.c
+++ b/src/northbridge/intel/haswell/native_raminit/raminit_main.c
@@ -138,6 +138,7 @@ static const struct task_entry cold_boot[] = {
 	{ save_non_training,                                      true, "SAVE_NONT",  },
 	{ alias_check,                                            true, "ALIASCHK",   },
 	{ ecc_scrub,                                              true, "ECCSCRUB",   },
+	{ memory_test,                                            true, "MEMTEST",    },
 	{ raminit_done,                                           true, "RAMINITEND", },
 };
 
@@ -287,9 +288,16 @@ void raminit_main(const enum raminit_boot_mode bootmode)
 		}
 	}
 
-	/** TODO: Try more than once **/
-	status = try_raminit(&mighty_ctrl, cold_boot, ARRAY_SIZE(cold_boot));
+	/* Train again once if a training step or the memory test fails */
+	for (uint8_t attempt = 0; attempt < 2; attempt++) {
+		if (attempt) {
+			printk(BIOS_WARNING, "Memory training failed (%u), trying again\n", status);
+			initialize_ctrl(&mighty_ctrl);
+		}
+		status = try_raminit(&mighty_ctrl, cold_boot, ARRAY_SIZE(cold_boot));
+		if (status == RAMINIT_STATUS_SUCCESS)
+			return;
+	}
 
-	if (status != RAMINIT_STATUS_SUCCESS)
-		die("Memory initialization was met with utmost failure and misery\n");
+	die("Memory initialization was met with utmost failure and misery\n");
 }
