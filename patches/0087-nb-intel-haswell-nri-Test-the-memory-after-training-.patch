diff --git a/src/northbridge/intel/haswell/Kconfig b/src/northbridge/intel/haswell/Kconfig
index ff4531d40e..b426d2d35a 100644
--- a/src/northbridge/intel/haswell/Kconfig
+++ b/src/northbridge/intel/haswell/Kconfig
@@ -19,6 +19,15 @@ config USE_NATIVE_RAMINIT
 	  basic training steps implemented and supports S3 resume. LPDDR3, ECC RAM
 	  and Broadwell CPUs are NOT supported yet.
 
+config HASWELL_NRI_MEMORY_TEST
+	bool "Test the memory after training it"
+	depends on USE_NATIVE_RAMINIT
+	help
+	  After a cold boot training, write every bank of every rank with
+	  the REUT and read it back, as the MRC's memory test: a training
+	  that leaves a miscompare is redone once, then the boot stops. A
+	  few seconds per cold boot; fast boots and S3 resume skip it.
+
 config HASWELL_VBOOT_IN_BOOTBLOCK
 	depends on VBOOT
 	bool "Start verstage in bootblock"
