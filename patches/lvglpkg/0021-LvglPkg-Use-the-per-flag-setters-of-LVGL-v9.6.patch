   # -Wno-unused-but-set-variable: newer GCC (e.g. with -Werror) flags dead assigns in
   # upstream LVGL (e.g. txt_tot_i in lv_buttonmatrix.c) that we cannot bump yet.
-  # -Wno-deprecated-declarations: LVGL v9.6 deprecates the flag API
-  # (lv_obj_add_flag() and the others) that lv_port_indev.c uses; v10 removes it.
-  GCC:*_*_*_CC_FLAGS = -Wno-format -Wno-unused-but-set-variable -Wno-deprecated-declarations
\ No newline at end of file
