     //
     mCursorObj     = cursor_obj;
     mCursorVisible = FALSE;
-    lv_obj_add_flag (mCursorObj, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_set_hidden (mCursorObj, true);
 
     //
     // Centre the cursor and zero the wheel accumulator.
