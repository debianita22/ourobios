index 4c981b7ebce..3d2ab5b3cfc 100644
--- a/src/drivers/smmstore/store.c
+++ b/src/drivers/smmstore/store.c
@@ -104,9 +104,43 @@ static bool locks_protecting(void)
 	return false;
 }
 
+#if CONFIG(SMMSTORE_RECLAIM)
+/*
+ * The areas of SMMSTORE_CMD_RECLAIM: 1 for a write or an erase all inside the
+ * staging area, which only the check of a reclaim reads; -1 for one that
+ * touches the commit block, which only the handler writes while a lock is
+ * armed; 0 for the others, which the locks decide.
+ */
+static int reclaim_area(size_t store_offset, size_t size)
+{
+	struct region store, vars;
+	size_t start;
+
+	if (lookup_store_region(&store) != CB_SUCCESS ||
+	    fmap_locate_area(SMMSTORE_REGION, &vars))
+		return -1;
+	start = region_offset(&store) + store_offset;
+	if (start + size <= region_offset(&vars) ||
+	    start >= region_offset(&vars) + region_sz(&vars))
+		return 0;
+	if (start < region_offset(&vars) ||
+	    start + size > region_offset(&vars) + region_sz(&vars))
+		return -1;
+	return smmstore_reclaim_area(start - region_offset(&vars), size);
+}
+#endif
+
 /* A write (or, @data NULL, an erase) at @store_offset of the store, for every lock */
 static bool locks_allow(size_t store_offset, const void *data, size_t size)
 {
+#if CONFIG(SMMSTORE_RECLAIM)
+	if (locks_protecting()) {
+		const int area = reclaim_area(store_offset, size);
+
+		if (area)
+			return area > 0;
+	}
+#endif
 #if CONFIG(SMMSTORE_MOR_LOCK)
 	if (!mor_lock_allows(store_offset, data, size))
 		return false;
