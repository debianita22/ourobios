diff --git a/src/drivers/smmstore/Kconfig b/src/drivers/smmstore/Kconfig
index 93e0496c27c..c4d4356d8f1 100644
--- a/src/drivers/smmstore/Kconfig
+++ b/src/drivers/smmstore/Kconfig
@@ -94,9 +94,25 @@ config SMMSTORE_OPTION_LOCK_ALL
 	  kept as a SHA-256 (vboot's library in SMM). The setup still changes
 	  the options, before the lock is armed.
 
+config SMMSTORE_RECLAIM
+	bool "Reclaim the variable store in SMM while a lock is armed"
+	depends on (SMMSTORE_OPTION_LOCK || SMMSTORE_MOR_LOCK) && VBOOT_LIB
+	# vboot's SHA-256 in C: its SHA extension code would use XMM registers in SMM
+	depends on !VBOOT_X86_SHA256_ACCELERATION
+	help
+	  SMMSTORE_CMD_RECLAIM: with the option lock or the MOR lock armed the
+	  payload cannot reclaim the variable store through its fault tolerant
+	  write, so the store fills up until the next boot. With this, the
+	  payload writes the reclaimed store into a staging area at the end of
+	  the region and the handler checks it whole with the rules of the
+	  locks, then puts it in place of the store behind a commit record;
+	  ramstage finishes a swap that a power loss cut. Needs the payload's
+	  side (the variable driver of ouroBIOS's EDK II).
+
 endif
 
 # Outside "if SMMSTORE": a board selects it whatever its payload
+
 config SMMSTORE_VBOOT_SWITCH_KEEPS_MRC_CACHE
 	bool
 	help
