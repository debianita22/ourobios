diff --git a/tests/drivers/smmstore_reclaim.c b/tests/drivers/smmstore_reclaim.c
new file mode 100644
index 00000000000..7166175739d
--- /dev/null
+++ b/tests/drivers/smmstore_reclaim.c
@@ -0,0 +1,382 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * SMMSTORE_CMD_RECLAIM on a flash that the test builds: the limits, the check
+ * of the image, the swap, and what the next boot does after a power loss at
+ * each step (the flash stops taking writes and erases after a number of them).
+ * The rules of the locks themselves are tested in smmstore_options_lock.c:
+ * here their answer on the image is a switch.
+ */
+
+#include <tests/test.h>
+
+#include <commonlib/region.h>
+#include <drivers/efi/efivars.h>
+#include <smmstore.h>
+#include <string.h>
+#include <types.h>
+
+#include "../../src/drivers/smmstore/reclaim.c"
+
+#define BLOCK 0x1000
+#define BLOCKS 8
+
+static uint8_t flash[BLOCKS * BLOCK];
+static struct region_device build_rw;
+static struct smmstore_reclaim_layout layout;
+
+/* The flash of the handler: writes and erases fail once ops_left is spent */
+static int ops_left = -1;
+
+static bool op_allowed(void)
+{
+	if (ops_left == 0)
+		return false;
+	if (ops_left > 0)
+		ops_left--;
+	return true;
+}
+
+static ssize_t flash_readat(const struct region_device *rd, void *b, size_t offset, size_t size)
+{
+	memcpy(b, flash + offset, size);
+	return size;
+}
+
+static ssize_t flash_writeat(const struct region_device *rd, const void *b, size_t offset,
+			     size_t size)
+{
+	const uint8_t *src = b;
+
+	if (!op_allowed())
+		return -1;
+	/* Programming clears bits only */
+	for (size_t i = 0; i < size; i++)
+		flash[offset + i] &= src[i];
+	return size;
+}
+
+static ssize_t flash_eraseat(const struct region_device *rd, size_t offset, size_t size)
+{
+	if (!op_allowed())
+		return -1;
+	memset(flash + offset, 0xff, size);
+	return size;
+}
+
+static void *flash_mmap(const struct region_device *rd, size_t offset, size_t size)
+{
+	return NULL;
+}
+
+static int flash_munmap(const struct region_device *rd, void *mapping)
+{
+	return 0;
+}
+
+static const struct region_device_ops flash_ops = {
+	.mmap = flash_mmap,
+	.munmap = flash_munmap,
+	.readat = flash_readat,
+	.writeat = flash_writeat,
+	.eraseat = flash_eraseat,
+};
+
+static struct region_device flash_root;
+
+int fmap_locate_area(const char *name, struct region *ar)
+{
+	*ar = region_create(0, sizeof(flash));
+	return 0;
+}
+
+int boot_device_rw_subregion(const struct region *sub, struct region_device *subrd)
+{
+	return rdev_chain(subrd, &flash_root, region_offset(sub), region_sz(sub));
+}
+
+/* The locks, as switches */
+static bool armed, image_ok;
+static int replaced;
+
+bool smmstore_options_protecting(void)
+{
+	return armed;
+}
+
+bool smmstore_options_image_allowed(const struct region_device *image)
+{
+	return image_ok;
+}
+
+void smmstore_options_store_replaced(void)
+{
+	replaced++;
+}
+
+void smmstore_locked_write_reset(void)
+{
+}
+
+static const EFI_GUID test_guid = {
+	0x8be4df61, 0x93ca, 0x11d2, { 0xaa, 0x0d, 0x00, 0xe0, 0x98, 0x03, 0x2b, 0x8c } };
+
+/* The store of a new boot, with one option */
+static void new_store(void)
+{
+	uint32_t on = 1;
+
+	memset(flash, 0xff, sizeof(flash));
+	ops_left = -1;
+	armed = true;
+	image_ok = true;
+	replaced = 0;
+	reclaims = 0;
+	region_device_init(&flash_root, &flash_ops, 0, sizeof(flash));
+	rdev_chain_mem_rw(&build_rw, flash, sizeof(flash));
+	assert_int_equal(efi_fv_initialize(&build_rw, BLOCK), CB_SUCCESS);
+	assert_int_equal(efi_fv_set_option(&build_rw, &walk_guid, "bios_lock", &on, sizeof(on)),
+			 CB_SUCCESS);
+	assert_int_equal(efi_fv_store_end(&build_rw, &layout.store_end), CB_SUCCESS);
+	assert_true(smmstore_reclaim_layout(sizeof(flash), BLOCK, layout.store_end, &layout));
+}
+
+static size_t store_free(void)
+{
+	size_t tail;
+
+	assert_int_equal(efi_fv_walk_guid(&build_rw, &walk_guid, no_var, NULL, &tail),
+			 CB_SUCCESS);
+	return layout.store_end - tail;
+}
+
+/* Updates of a variable until less than a quarter of the store is free */
+static void fill_store(void)
+{
+	uint32_t value = 0;
+
+	while (store_free() > layout.store_end / 4) {
+		value++;
+		assert_int_equal(efi_fv_set_option(&build_rw, &test_guid, "Timeout", &value,
+						   sizeof(value)), CB_SUCCESS);
+	}
+}
+
+/*
+ * The reclaimed store, as the payload's variable driver writes it into the
+ * staging area: the live variables only, the same headers. Returns a copy.
+ */
+static uint8_t image[BLOCKS * BLOCK];
+
+static void stage_image(void)
+{
+	struct region_device rw;
+	uint32_t on = 1, last = 7;
+
+	memset(image, 0xff, sizeof(image));
+	rdev_chain_mem_rw(&rw, image, sizeof(image));
+	assert_int_equal(efi_fv_initialize(&rw, BLOCK), CB_SUCCESS);
+	assert_int_equal(efi_fv_set_option(&rw, &walk_guid, "bios_lock", &on, sizeof(on)),
+			 CB_SUCCESS);
+	assert_int_equal(efi_fv_set_option(&rw, &test_guid, "Timeout", &last, sizeof(last)),
+			 CB_SUCCESS);
+	memset(flash + layout.staging, 0xff, layout.store_end);
+	memcpy(flash + layout.staging, image, layout.store_end);
+}
+
+static bool store_is(const uint8_t *what)
+{
+	return !memcmp(flash, what, layout.store_end);
+}
+
+static bool commit_erased(void)
+{
+	for (size_t i = 0; i < BLOCK; i++)
+		if (flash[layout.commit + i] != 0xff)
+			return false;
+	return true;
+}
+
+static uint32_t reclaim(uint32_t op)
+{
+	const struct smmstore_params_reclaim params = { .op = op };
+
+	return smmstore_reclaim(&params);
+}
+
+static void test_areas(void **state)
+{
+	new_store();
+	assert_int_equal(layout.staging, 4 * BLOCK);
+	assert_int_equal(layout.commit, 7 * BLOCK);
+	assert_int_equal(smmstore_reclaim_area(layout.staging, BLOCK), 1);
+	assert_int_equal(smmstore_reclaim_area(layout.staging + layout.store_end - 16, 16), 1);
+	assert_int_equal(smmstore_reclaim_area(layout.commit, 16), -1);
+	assert_int_equal(smmstore_reclaim_area(layout.commit - 8, 16), -1);
+	assert_int_equal(smmstore_reclaim_area(0, BLOCK), 0);
+	/* The working block of the fault tolerant write: the locks decide */
+	assert_int_equal(smmstore_reclaim_area(layout.store_end, 16), 0);
+	assert_int_equal(smmstore_reclaim_area(layout.staging - 8, 16), 0);
+}
+
+static void test_limits(void **state)
+{
+	new_store();
+	armed = false;
+	assert_int_equal(reclaim(SMMSTORE_RECLAIM_STATUS), SMMSTORE_RET_UNSUPPORTED);
+	armed = true;
+	/* Nearly empty: nothing to gain */
+	assert_int_equal(reclaim(SMMSTORE_RECLAIM_STATUS), SMMSTORE_RET_FAILURE);
+	fill_store();
+	assert_int_equal(reclaim(SMMSTORE_RECLAIM_STATUS), SMMSTORE_RET_SUCCESS);
+	assert_int_equal(reclaim(7), SMMSTORE_RET_FAILURE);
+}
+
+static void test_commit(void **state)
+{
+	new_store();
+	fill_store();
+	stage_image();
+	assert_int_equal(reclaim(SMMSTORE_RECLAIM_COMMIT), SMMSTORE_RET_SUCCESS);
+	assert_true(store_is(image));
+	assert_true(commit_erased());
+	assert_int_equal(replaced, 1);
+	/* The store reclaimed has room again: no second reclaim now */
+	assert_int_equal(reclaim(SMMSTORE_RECLAIM_STATUS), SMMSTORE_RET_FAILURE);
+}
+
+static void test_refused(void **state)
+{
+	static uint8_t before[BLOCKS * BLOCK];
+
+	new_store();
+	fill_store();
+	stage_image();
+	memcpy(before, flash, sizeof(before));
+
+	/* The locks refuse the image */
+	image_ok = false;
+	assert_int_equal(reclaim(SMMSTORE_RECLAIM_COMMIT), SMMSTORE_RET_FAILURE);
+	assert_true(store_is(before));
+	assert_true(commit_erased());
+
+	/* Other headers */
+	image_ok = true;
+	flash[layout.staging + 0x10] ^= 0x01;
+	assert_int_equal(reclaim(SMMSTORE_RECLAIM_COMMIT), SMMSTORE_RET_FAILURE);
+	assert_true(store_is(before));
+
+	/* An image the reader cannot walk: the name of its first record past the store */
+	stage_image();
+	memset(flash + layout.staging + 0x48 + 28 + 36, 0xff, 4);
+	assert_int_equal(reclaim(SMMSTORE_RECLAIM_COMMIT), SMMSTORE_RET_FAILURE);
+	assert_true(store_is(before));
+	assert_true(commit_erased());
+	assert_int_equal(replaced, 0);
+}
+
+static void test_per_boot(void **state)
+{
+	new_store();
+	for (int i = 0; i < SMMSTORE_RECLAIM_PER_BOOT; i++) {
+		fill_store();
+		stage_image();
+		assert_int_equal(reclaim(SMMSTORE_RECLAIM_COMMIT), SMMSTORE_RET_SUCCESS);
+		/* The next fill starts from the reclaimed store */
+		rdev_chain_mem_rw(&build_rw, flash, sizeof(flash));
+	}
+	fill_store();
+	stage_image();
+	assert_int_equal(reclaim(SMMSTORE_RECLAIM_STATUS), SMMSTORE_RET_FAILURE);
+}
+
+/*
+ * A power loss after each flash operation of the commit, then the next boot:
+ * the store is either the old one (before the record) or the image, and the
+ * record is gone.
+ */
+static void test_power_loss(void **state)
+{
+	static uint8_t before[BLOCKS * BLOCK];
+	int ops;
+
+	for (ops = 0; ; ops++) {
+		uint32_t ret;
+
+		new_store();
+		fill_store();
+		stage_image();
+		memcpy(before, flash, sizeof(before));
+
+		ops_left = ops;
+		ret = reclaim(SMMSTORE_RECLAIM_COMMIT);
+		ops_left = -1;
+
+		/* The next boot */
+		smmstore_reclaim_recover();
+		assert_true(commit_erased());
+		if (ret == SMMSTORE_RET_SUCCESS) {
+			assert_true(store_is(image));
+			break;
+		}
+		assert_true(store_is(before) || store_is(image));
+		/* Past the record, the swap always completes */
+		if (ops >= 2)
+			assert_true(store_is(image));
+	}
+	/* Erase and record, three blocks erased and written, the record erased */
+	assert_true(ops > 3);
+}
+
+/* A record whose staging area is not its image: dropped, the store left as it is */
+static void test_bad_record(void **state)
+{
+	static uint8_t before[BLOCKS * BLOCK];
+
+	new_store();
+	fill_store();
+	stage_image();
+	ops_left = 2;
+	assert_int_equal(reclaim(SMMSTORE_RECLAIM_COMMIT), SMMSTORE_RET_FAILURE);
+	ops_left = -1;
+	memcpy(before, flash, sizeof(before));
+	flash[layout.staging + layout.store_end - 1] ^= 0x01;
+	smmstore_reclaim_recover();
+	assert_true(commit_erased());
+	assert_true(!memcmp(flash, before, layout.store_end));
+}
+
+/* A record with another layout: dropped too */
+static void test_record_layout(void **state)
+{
+	static uint8_t before[BLOCKS * BLOCK];
+	uint32_t store_end = 2 * BLOCK;
+
+	new_store();
+	fill_store();
+	stage_image();
+	ops_left = 2;
+	assert_int_equal(reclaim(SMMSTORE_RECLAIM_COMMIT), SMMSTORE_RET_FAILURE);
+	ops_left = -1;
+	memcpy(flash + layout.commit + 8, &store_end, sizeof(store_end));
+	memcpy(before, flash, sizeof(before));
+	smmstore_reclaim_recover();
+	assert_true(commit_erased());
+	assert_true(!memcmp(flash, before, layout.store_end));
+}
+
+int main(void)
+{
+	const struct CMUnitTest tests[] = {
+		cmocka_unit_test(test_areas),
+		cmocka_unit_test(test_limits),
+		cmocka_unit_test(test_commit),
+		cmocka_unit_test(test_refused),
+		cmocka_unit_test(test_per_boot),
+		cmocka_unit_test(test_power_loss),
+		cmocka_unit_test(test_bad_record),
+		cmocka_unit_test(test_record_layout),
+	};
+
+	return cb_run_group_tests(tests, NULL, NULL);
+}
