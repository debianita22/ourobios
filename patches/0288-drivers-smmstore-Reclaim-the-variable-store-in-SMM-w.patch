+/*
+ * SMMSTORE_RECLAIM: the reclaim of the variable store while a lock is armed,
+ * when the payload's fault tolerant write may not write past the store.
+ * The variable driver writes the reclaimed store, a byte image of the first
+ * store_end bytes of the region (the firmware volume header included), into
+ * the staging area with raw writes, then sends SMMSTORE_RECLAIM_COMMIT. The
+ * handler reads the image back from the flash, checks it whole with the rules
+ * of the locks, writes a commit record into the commit block, copies the image
+ * over the store and erases the record; ramstage finishes a copy cut by a
+ * power loss (smmstore_reclaim_recover()). The two areas are the last ones of
+ * the region (smmstore_reclaim_layout()), in the spare area of the payload's
+ * fault tolerant write; while a lock is armed, raw writes and erases inside
+ * the staging area are allowed and those of the commit block refused.
+ *
+ * STATUS: SMMSTORE_RET_SUCCESS when a commit would be considered now;
+ * SMMSTORE_RET_UNSUPPORTED with no lock armed (the payload uses its fault
+ * tolerant write) or no room for the areas; SMMSTORE_RET_FAILURE over the
+ * limits: four reclaims a boot, and none while the store is more than a
+ * quarter free. COMMIT: SMMSTORE_RET_SUCCESS when the store is the image;
+ * SMMSTORE_RET_FAILURE when refused, the store as it was.
+ */
+#define SMMSTORE_CMD_RECLAIM 13
+
+#define SMMSTORE_RECLAIM_STATUS		0
+#define SMMSTORE_RECLAIM_COMMIT		1
+#define SMMSTORE_RECLAIM_PER_BOOT	4
+
 /*
  * Used by capsule updates as a standalone command or modifier to v2 commands.
  *
@@ -205,6 +232,55 @@ bool smmstore_mor_protecting(void);
  */
 bool smmstore_mor_write_allowed(size_t offset, const void *data, size_t size);
 
+/*
+ * The areas of SMMSTORE_CMD_RECLAIM in a region of @region_size bytes whose
+ * variable store ends at @store_end: the commit block is the last block, the
+ * staging area the @store_end bytes before it. False when they do not fit
+ * above the store and the fault tolerant write's working block that follows
+ * it, or the sizes are not whole blocks.
+ */
+struct smmstore_reclaim_layout {
+	size_t store_end;
+	size_t staging;
+	size_t commit;
+};
+
+static inline bool smmstore_reclaim_layout(size_t region_size, size_t block_size,
+					   size_t store_end, struct smmstore_reclaim_layout *l)
+{
+	if (!block_size || !store_end || store_end % block_size ||
+	    region_size % block_size || region_size < 2 * store_end + 2 * block_size)
+		return false;
+	l->store_end = store_end;
+	l->commit = region_size - block_size;
+	l->staging = l->commit - store_end;
+	return true;
+}
+
+/* SMMSTORE_CMD_RECLAIM (reclaim.c) */
+struct smmstore_params_reclaim {
+	uint32_t op;
+} __packed;
+
+uint32_t smmstore_reclaim(const struct smmstore_params_reclaim *params);
+/*
+ * For the rules of the raw writes while a lock is armed: 1 when
+ * [@offset, @offset + @size) of the SMMSTORE region is inside the staging
+ * area, -1 when it touches the commit block, 0 otherwise.
+ */
+int smmstore_reclaim_area(size_t offset, size_t size);
+/* ramstage: finish a reclaim that a power loss cut, before the payload */
+void smmstore_reclaim_recover(void);
+
+/*
+ * Whether the image of a whole store, which SMMSTORE_CMD_RECLAIM would put in
+ * place of the store, keeps what each lock holds; then, once it is in place.
+ */
+struct region_device;
+bool smmstore_mor_image_allowed(const struct region_device *image);
+bool smmstore_options_image_allowed(const struct region_device *image);
+void smmstore_options_store_replaced(void);
+
 /* SMMSTORE_CMD_OPTION_LOCK (options_lock.c) */
 uint32_t smmstore_options_lock(void);
 /* Whether the option lock is armed: writes of the variable store are checked */
