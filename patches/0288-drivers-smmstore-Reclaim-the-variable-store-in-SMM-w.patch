diff --git a/src/drivers/smmstore/mor_lock.c b/src/drivers/smmstore/mor_lock.c
index e64e9808109..9a4465ad784 100644
--- a/src/drivers/smmstore/mor_lock.c
+++ b/src/drivers/smmstore/mor_lock.c
@@ -198,6 +198,18 @@ bool smmstore_mor_write_allowed(size_t offset, const void *data, size_t size)
 	return requested;
 }
 
+/* The image of a whole store that SMMSTORE_CMD_RECLAIM would put in place of the store */
+bool smmstore_mor_image_allowed(const struct region_device *image)
+{
+	if (!smmstore_mor_protecting())
+		return true;
+	if (!mor_requested(image)) {
+		printk(BIOS_WARNING, "MOR lock: refused a reclaim that clears the request of the OS\n");
+		return false;
+	}
+	return true;
+}
+
 uint32_t smmstore_mor_lock(const struct smmstore_params_mor_lock *params)
 {
 	struct mor_lock_state *state = mor_state();
diff --git a/src/drivers/smmstore/options_lock.c b/src/drivers/smmstore/options_lock.c
index e5693cee08d..59c119e0e93 100644
--- a/src/drivers/smmstore/options_lock.c
+++ b/src/drivers/smmstore/options_lock.c
@@ -409,6 +409,62 @@ bool smmstore_options_write_allowed(size_t offset, const void *data, size_t size
 	return true;
 }
 
+/*
+ * The image of a whole store that SMMSTORE_CMD_RECLAIM would put in place of
+ * the store: the same rule as a write, on the image instead of the store as a
+ * write would leave it. The caller has walked the image already.
+ */
+bool smmstore_options_image_allowed(const struct region_device *image)
+{
+	struct option_lock_state *state = option_state();
+	uint32_t after[ARRAY_SIZE(protected_options)];
+
+	if (!state || !state->armed)
+		return true;
+
+#if CONFIG(SMMSTORE_OPTION_LOCK_ALL)
+	if (state->all) {
+		struct region_device store;
+		uint8_t digest[OPTION_SET_DIGEST_SIZE];
+		uint32_t count;
+
+		if (!option_set.fresh &&
+		    (variable_store(&store) || !option_set_latch(&store))) {
+			printk(BIOS_ERR, "Option lock: the options cannot be read, reclaim refused\n");
+			return false;
+		}
+		if (!option_set_of(image, &count, digest, NULL)) {
+			printk(BIOS_WARNING, "Option lock: refused a reclaim to an unreadable store\n");
+			return false;
+		}
+		if (count != option_set.count ||
+		    memcmp(digest, option_set.digest, sizeof(digest))) {
+			printk(BIOS_WARNING, "Option lock: refused a reclaim that changes a setup option\n");
+			return false;
+		}
+		return true;
+	}
+#endif
+
+	option_values(image, after);
+	for (size_t i = 0; i < ARRAY_SIZE(protected_options); i++) {
+		if (state->on[i] && !after[i]) {
+			printk(BIOS_WARNING, "Option lock: refused a reclaim that turns '%s' off\n",
+			       protected_options[i].name);
+			return false;
+		}
+	}
+	return true;
+}
+
+/* The store was replaced whole: the set and its erased tail from the flash again */
+void smmstore_options_store_replaced(void)
+{
+#if CONFIG(SMMSTORE_OPTION_LOCK_ALL)
+	option_set.fresh = false;
+#endif
+}
+
 uint32_t smmstore_options_lock(void)
 {
 	struct option_lock_state *state = option_state();
diff --git a/src/drivers/smmstore/reclaim.c b/src/drivers/smmstore/reclaim.c
new file mode 100644
index 00000000000..a5eff69851e
--- /dev/null
+++ b/src/drivers/smmstore/reclaim.c
@@ -0,0 +1,369 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * SMMSTORE_RECLAIM (smmstore.h): the reclaim of the variable store while a
+ * lock is armed. The payload reclaims the store through its fault tolerant
+ * write, which erases the store and copies it back from the spare blocks; the
+ * locks refuse both while armed (an erase leaves a store without the options,
+ * and a write past the store is the bypass that patch 0281 closed), so until
+ * the next boot every write appends a record, and a full store fails the
+ * writes of the OS.
+ *
+ * Here the one step that the rules of the locks cannot allow piece by piece,
+ * putting a new store in place of the old one, is checked whole. The payload
+ * writes the reclaimed store into the staging area; the handler reads it back
+ * from the flash, never from memory the OS can change, and checks it with the
+ * rules of the locks as if it were the store. Then:
+ *
+ *   1. the commit record, with the SHA-256 of the image, into the commit block;
+ *   2. the store erased and the image copied over it, read back;
+ *   3. the commit block erased.
+ *
+ * A power loss after 1 leaves a record that ramstage finds at the next boot,
+ * before the payload and before any lock: it checks the staging area against
+ * the hash of the record and finishes the copy, then erases the record. Before
+ * 1 the old store is intact, and a staging area without a record is inert,
+ * for coreboot and for the payload's fault tolerant write, which acts only on
+ * a record of its working block. Only SMM writes the commit block while a lock
+ * is armed, so nothing the OS writes outside the store reaches the store
+ * without the check.
+ *
+ * The swap takes one SMI: about a second for 192 KiB, with the OS stopped, at
+ * most SMMSTORE_RECLAIM_PER_BOOT times a boot and only while the store is
+ * nearly full. A swap split over several SMIs would leave a half-written store
+ * between them that an S3 resume (the latch of the option lock is taken from
+ * the flash again) or another write would meet.
+ */
+
+#include <acpi/acpi.h>
+#include <boot_device.h>
+#include <bootstate.h>
+#include <commonlib/helpers.h>
+#include <commonlib/region.h>
+#include <console/console.h>
+#include <drivers/efi/efivars.h>
+#include <fmap.h>
+#include <smmstore.h>
+#include <string.h>
+#include <types.h>
+#include <vb2_sha.h>
+
+#define RECLAIM_MAGIC "OBRCLM01"
+
+struct reclaim_record {
+	char magic[8];
+	uint32_t store_end;
+	uint32_t staging;
+	uint8_t digest[VB2_SHA256_DIGEST_SIZE];
+} __packed;
+
+/* One SMI, or ramstage, at a time: static, not on the small stack of SMM */
+static uint8_t chunk[4 * KiB];
+static uint8_t chunk2[4 * KiB];
+
+/* The SMMSTORE region, writable */
+static bool region_rw(struct region_device *rdev)
+{
+	struct region region;
+
+	return !fmap_locate_area(SMMSTORE_REGION, &region) &&
+	       !boot_device_rw_subregion(&region, rdev);
+}
+
+static bool hash_area(const struct region_device *rdev, size_t offset, size_t size,
+		      uint8_t digest[VB2_SHA256_DIGEST_SIZE])
+{
+	struct vb2_sha256_context ctx;
+
+	vb2_sha256_init(&ctx, VB2_HASH_SHA256);
+	for (size_t done = 0; done < size; done += sizeof(chunk)) {
+		const size_t n = MIN(sizeof(chunk), size - done);
+
+		if (rdev_readat(rdev, chunk, offset + done, n) != n)
+			return false;
+		vb2_sha256_update(&ctx, chunk, n);
+	}
+	vb2_sha256_finalize(&ctx, digest, VB2_HASH_SHA256);
+	return true;
+}
+
+/* Whether the store holds the image of the staging area: -1 on a read error */
+static int store_is_image(const struct region_device *rdev, const struct smmstore_reclaim_layout *l)
+{
+	for (size_t done = 0; done < l->store_end; done += sizeof(chunk)) {
+		const size_t n = MIN(sizeof(chunk), l->store_end - done);
+
+		if (rdev_readat(rdev, chunk, done, n) != n ||
+		    rdev_readat(rdev, chunk2, l->staging + done, n) != n)
+			return -1;
+		if (memcmp(chunk, chunk2, n))
+			return 0;
+	}
+	return 1;
+}
+
+/* The image over the store, block by block, and read back */
+static bool copy_image(const struct region_device *rdev, const struct smmstore_reclaim_layout *l)
+{
+	for (size_t block = 0; block < l->store_end; block += SMM_BLOCK_SIZE) {
+		if (rdev_eraseat(rdev, block, SMM_BLOCK_SIZE) != SMM_BLOCK_SIZE)
+			return false;
+		for (size_t done = 0; done < SMM_BLOCK_SIZE; done += sizeof(chunk)) {
+			if (rdev_readat(rdev, chunk, l->staging + block + done, sizeof(chunk))
+			    != sizeof(chunk) ||
+			    rdev_writeat(rdev, chunk, block + done, sizeof(chunk)) != sizeof(chunk))
+				return false;
+		}
+	}
+	return store_is_image(rdev, l) == 1;
+}
+
+static bool erase_commit(const struct region_device *rdev, const struct smmstore_reclaim_layout *l)
+{
+	return rdev_eraseat(rdev, l->commit, SMM_BLOCK_SIZE) == SMM_BLOCK_SIZE;
+}
+
+#if ENV_SMM
+/* The coreboot options GUID: any GUID gives the walk of the whole store */
+static const EFI_GUID walk_guid = {
+	0xceae4c1d, 0x335b, 0x4685, { 0xa4, 0xa0, 0xfc, 0x4a, 0x94, 0xee, 0xa0, 0x85 } };
+
+static enum cb_err no_var(const struct efi_fv_var *var, void *arg)
+{
+	return CB_SUCCESS;
+}
+
+/* The region and its areas, from the store's own header */
+static bool reclaim_region(struct region_device *rdev, struct smmstore_reclaim_layout *l)
+{
+	size_t store_end;
+
+	if (!region_rw(rdev) || efi_fv_store_end(rdev, &store_end) != CB_SUCCESS)
+		return false;
+	return smmstore_reclaim_layout(region_device_sz(rdev), SMM_BLOCK_SIZE, store_end, l);
+}
+
+static unsigned int reclaims;
+
+static bool locks_armed(void)
+{
+#if CONFIG(SMMSTORE_MOR_LOCK)
+	if (smmstore_mor_protecting())
+		return true;
+#endif
+#if CONFIG(SMMSTORE_OPTION_LOCK)
+	if (smmstore_options_protecting())
+		return true;
+#endif
+	return false;
+}
+
+int smmstore_reclaim_area(size_t offset, size_t size)
+{
+	struct region_device rdev;
+	struct smmstore_reclaim_layout l;
+
+	if (!reclaim_region(&rdev, &l))
+		return 0;
+	if (offset + size > l.commit && offset < l.commit + SMM_BLOCK_SIZE)
+		return -1;
+	if (offset >= l.staging && offset + size <= l.staging + l.store_end)
+		return 1;
+	return 0;
+}
+
+/*
+ * The region as it would be with the image in place of the store: the reader
+ * checks the firmware volume against the length of the whole region, so the
+ * image is read through a device of that size, the store from the staging
+ * area and the rest from the region itself (past the store the reader reads
+ * nothing). A static context, as the overlays of the locks: one SMI at a time.
+ */
+static const struct region_device *image_parent;
+static size_t image_staging, image_store_end;
+
+static ssize_t image_readat(const struct region_device *rd, void *b, size_t offset, size_t size)
+{
+	uint8_t *buf = b;
+	size_t done = 0;
+
+	while (done < size) {
+		const size_t at = offset + done;
+		size_t n = size - done, from = at;
+
+		if (at < image_store_end) {
+			n = MIN(n, image_store_end - at);
+			from = image_staging + at;
+		}
+		if (rdev_readat(image_parent, buf + done, from, n) != n)
+			return -1;
+		done += n;
+	}
+	return size;
+}
+
+static void *image_mmap(const struct region_device *rd, size_t offset, size_t size)
+{
+	return NULL;
+}
+
+static int image_munmap(const struct region_device *rd, void *mapping)
+{
+	return 0;
+}
+
+static const struct region_device_ops image_ops = {
+	.mmap = image_mmap,
+	.munmap = image_munmap,
+	.readat = image_readat,
+};
+
+/* The image is a store the reader can walk, with the headers of the store, that the locks keep */
+static bool image_allowed(const struct region_device *rdev, const struct smmstore_reclaim_layout *l)
+{
+	struct region_device image_root, image;
+	size_t header;
+	uint16_t fv_header;
+
+	image_parent = rdev;
+	image_staging = l->staging;
+	image_store_end = l->store_end;
+	/* The reader gets a child, never the root: see the overlays of the locks */
+	region_device_init(&image_root, &image_ops, 0, region_device_sz(rdev));
+	if (rdev_chain(&image, &image_root, 0, region_device_sz(rdev)))
+		return false;
+
+	/* The firmware volume header (its length at 0x30) and the 28 bytes of the store header */
+	if (rdev_readat(rdev, &fv_header, 0x30, sizeof(fv_header)) != sizeof(fv_header))
+		return false;
+	header = fv_header + 28;
+	if (header > sizeof(chunk) ||
+	    rdev_readat(rdev, chunk, 0, header) != header ||
+	    rdev_readat(&image, chunk2, 0, header) != header ||
+	    memcmp(chunk, chunk2, header)) {
+		printk(BIOS_WARNING, "SMMSTORE: reclaim refused, the headers differ\n");
+		return false;
+	}
+
+	if (efi_fv_walk_guid(&image, &walk_guid, no_var, NULL, NULL) != CB_SUCCESS) {
+		printk(BIOS_WARNING, "SMMSTORE: reclaim refused, the image cannot be read\n");
+		return false;
+	}
+
+#if CONFIG(SMMSTORE_MOR_LOCK)
+	if (!smmstore_mor_image_allowed(&image))
+		return false;
+#endif
+#if CONFIG(SMMSTORE_OPTION_LOCK)
+	if (!smmstore_options_image_allowed(&image))
+		return false;
+#endif
+	return true;
+}
+
+static void store_replaced(void)
+{
+#if CONFIG(SMMSTORE_OPTION_LOCK)
+	smmstore_options_store_replaced();
+#endif
+}
+
+uint32_t smmstore_reclaim(const struct smmstore_params_reclaim *params)
+{
+	struct region_device rdev;
+	struct smmstore_reclaim_layout l;
+	struct reclaim_record record;
+	size_t tail;
+
+	if (!locks_armed() || !reclaim_region(&rdev, &l))
+		return SMMSTORE_RET_UNSUPPORTED;
+	if (reclaims >= SMMSTORE_RECLAIM_PER_BOOT)
+		return SMMSTORE_RET_FAILURE;
+	if (efi_fv_walk_guid(&rdev, &walk_guid, no_var, NULL, &tail) != CB_SUCCESS ||
+	    l.store_end - tail > l.store_end / 4)
+		return SMMSTORE_RET_FAILURE;
+	if (params->op == SMMSTORE_RECLAIM_STATUS)
+		return SMMSTORE_RET_SUCCESS;
+	if (params->op != SMMSTORE_RECLAIM_COMMIT)
+		return SMMSTORE_RET_FAILURE;
+
+	smmstore_locked_write_reset();
+	if (!image_allowed(&rdev, &l))
+		return SMMSTORE_RET_FAILURE;
+
+	memset(&record, 0, sizeof(record));
+	memcpy(record.magic, RECLAIM_MAGIC, sizeof(record.magic));
+	record.store_end = l.store_end;
+	record.staging = l.staging;
+	if (!hash_area(&rdev, l.staging, l.store_end, record.digest) ||
+	    !erase_commit(&rdev, &l) ||
+	    rdev_writeat(&rdev, &record, l.commit, sizeof(record)) != sizeof(record))
+		return SMMSTORE_RET_FAILURE;
+
+	reclaims++;
+	/* From here the swap completes: now, or at the next boot from the record */
+	if (!copy_image(&rdev, &l)) {
+		printk(BIOS_ERR, "SMMSTORE: reclaim copy failed, the next boot finishes it\n");
+		store_replaced();
+		return SMMSTORE_RET_FAILURE;
+	}
+	erase_commit(&rdev, &l);
+	store_replaced();
+	return SMMSTORE_RET_SUCCESS;
+}
+#endif
+
+#if ENV_RAMSTAGE || ENV_TEST
+void smmstore_reclaim_recover(void)
+{
+	struct region_device rdev;
+	struct smmstore_reclaim_layout l;
+	struct reclaim_record record;
+	uint8_t digest[VB2_SHA256_DIGEST_SIZE];
+	int same;
+
+	/*
+	 * Not from the store's header: a power loss in the copy can leave the
+	 * first block of the store erased. The commit block is the last block of
+	 * the region, and the record says where the store ends.
+	 */
+	if (!region_rw(&rdev) || region_device_sz(&rdev) < SMM_BLOCK_SIZE ||
+	    rdev_readat(&rdev, &record, region_device_sz(&rdev) - SMM_BLOCK_SIZE,
+			sizeof(record)) != sizeof(record) ||
+	    memcmp(record.magic, RECLAIM_MAGIC, sizeof(record.magic)))
+		return;
+
+	if (!smmstore_reclaim_layout(region_device_sz(&rdev), SMM_BLOCK_SIZE, record.store_end,
+				     &l) || record.staging != l.staging ||
+	    !hash_area(&rdev, l.staging, l.store_end, digest) ||
+	    memcmp(digest, record.digest, sizeof(digest))) {
+		printk(BIOS_ERR, "SMMSTORE: a reclaim record without its image, dropped\n");
+		rdev_eraseat(&rdev, region_device_sz(&rdev) - SMM_BLOCK_SIZE, SMM_BLOCK_SIZE);
+		return;
+	}
+
+	same = store_is_image(&rdev, &l);
+	if (same < 0)
+		return;
+	if (!same) {
+		printk(BIOS_WARNING, "SMMSTORE: finishing a reclaim cut by a power loss\n");
+		if (!copy_image(&rdev, &l)) {
+			printk(BIOS_ERR, "SMMSTORE: the reclaim could not be finished\n");
+			return;
+		}
+	}
+	erase_commit(&rdev, &l);
+	printk(BIOS_INFO, "SMMSTORE: reclaim record cleared\n");
+}
+
+#endif
+
+#if ENV_RAMSTAGE && !ENV_TEST
+static void reclaim_recover(void *unused)
+{
+	if (!acpi_is_wakeup_s3())
+		smmstore_reclaim_recover();
+}
+
+BOOT_STATE_INIT_ENTRY(BS_PRE_DEVICE, BS_ON_ENTRY, reclaim_recover, NULL);
+#endif
diff --git a/src/drivers/smmstore/smi.c b/src/drivers/smmstore/smi.c
index 17f0bd84f12..8cd6e89d954 100644
--- a/src/drivers/smmstore/smi.c
+++ b/src/drivers/smmstore/smi.c
@@ -395,6 +395,19 @@ uint32_t smmstore_exec(uint8_t command, void *param)
 		}
 		ret = smmstore_options_lock();
 		break;
+	case SMMSTORE_CMD_RECLAIM: {
+		struct smmstore_params_reclaim *params = param;
+
+		if (!CONFIG(SMMSTORE_RECLAIM)) {
+			ret = SMMSTORE_RET_UNSUPPORTED;
+			break;
+		}
+		if (range_check(params, sizeof(*params)) != 0)
+			break;
+
+		ret = smmstore_reclaim(params);
+		break;
+	}
 	default:
 		printk(BIOS_DEBUG, "Unknown SMM store command: 0x%02x\n", command);
