--- a/src/northbridge/intel/haswell/Kconfig
+++ b/src/northbridge/intel/haswell/Kconfig
@@ -51,6 +51,16 @@ config HASWELL_NRI_COMMAND_VREF
 	  values that pass. Best with HASWELL_NRI_MEMORY_TEST, which trains
 	  again without this when the memory test fails.
 
+config HASWELL_NRI_TURNAROUND
+	bool "Shorten the write to read turnaround between ranks"
+	depends on USE_NATIVE_RAMINIT
+	help
+	  After the training, try the write to read turnaround between
+	  ranks one clock at a time below the sum of the JEDEC times, with
+	  the turnaround test of the REUT, and leave it one clock above the
+	  shortest that passes, one clock shorter than it was at most. Best
+	  with HASWELL_NRI_MEMORY_TEST and HASWELL_NRI_MARGIN_CHECK.
+
 config HASWELL_NRI_MARGIN_CHECK
 	bool "Measure the read and write margins after training"
 	depends on USE_NATIVE_RAMINIT
