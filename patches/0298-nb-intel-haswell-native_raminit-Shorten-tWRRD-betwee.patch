diff --git a/src/northbridge/intel/haswell/native_raminit/train_turnaround.c b/src/northbridge/intel/haswell/native_raminit/train_turnaround.c
new file mode 100644
index 0000000000..6455d8f711
--- /dev/null
+++ b/src/northbridge/intel/haswell/native_raminit/train_turnaround.c
@@ -0,0 +1,197 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <console/console.h>
+#include <lib.h>
+#include <northbridge/intel/haswell/haswell.h>
+#include <types.h>
+
+#include "raminit_native.h"
+
+/*
+ * Write to read turnaround between ranks.
+ *
+ * After a write to one rank, the controller waits tWRRD_dr (the other rank of
+ * the DIMM) or tWRRD_dd (a rank of the other DIMM) clocks before a read from
+ * another rank: the write data and its ODT must be off the bus before the
+ * read preamble. refresh_timings() sets both to the sum of the JEDEC times,
+ * and nothing shortens them: on a ThinkPad W541 with four DIMMs, mrc.bin ends
+ * one clock below that, and it is the only turnaround of the two that differs.
+ *
+ * The test is the turnaround test of the REUT, which no step used: a write of
+ * every rank of the channel in turn, six rounds of a read and a write that
+ * move to the next rank after each pair, so that every read follows a write to
+ * another rank, and a read of everything. The data and memory tests of the
+ * other steps work on one rank at a time and would not see a turnaround that
+ * is too short.
+ *
+ * With the read latency final: try each value from the one set downwards,
+ * until one fails. The turnaround becomes the shortest value that passes plus
+ * one clock of guard, and at most one clock shorter than it was, which is as
+ * far as mrc.bin goes. It moves only if a value did fail: a test that passes
+ * down to one clock has not seen the turnaround, and tells nothing. Not run in
+ * the training that is done again after a failure.
+ */
+
+#define TAT_NUM_CL	128
+#define TAT_MIN_WRRD	1
+
+static void setup_io_test_wr_rd_ta(struct sysinfo *ctrl, const uint8_t chanmask)
+{
+	/* A rank and a column for each cacheline: run_io_test() sets the rates */
+	const struct reut_box reut_addr = {
+		.rank = {
+			.start    = 0,
+			.stop     = 0,
+			.inc_rate = 32,
+			.inc_val  = 1,
+		},
+		.col = {
+			.start    = 0,
+			.stop     = 1023,
+			.inc_rate = 0,
+			.inc_val  = 1,
+		},
+	};
+	/* One line of the WDB, so that a read and a write of a pair use the same */
+	const struct wdb_pat pattern = {
+		.start_ptr  = 0,
+		.stop_ptr   = 0,
+		.inc_rate   = 0,
+		.dq_pattern = TURN_AROUND_WR,
+	};
+	setup_io_test(
+		ctrl,
+		chanmask,
+		PAT_WR_RD_TA,
+		TAT_NUM_CL,
+		0,
+		&reut_addr,
+		NSOE,
+		&pattern,
+		0,
+		0);
+
+	ctrl->dq_pat_lc = 1;
+	ctrl->dq_pat = TURN_AROUND_WR;
+}
+
+static void program_wrrd(struct sysinfo *ctrl, const uint8_t channel, const uint8_t value)
+{
+	union tc_bank_rank_b_reg tc_bank_rank_b = ctrl->tc_bankrank_b[channel];
+	tc_bank_rank_b.tWRRD_dr = value;
+	tc_bank_rank_b.tWRRD_dd = value;
+	mchbar_write32(TC_BANK_RANK_B_ch(channel), tc_bank_rank_b.raw);
+}
+
+enum nri_status optimise_turnaround(struct sysinfo *ctrl)
+{
+	if (!CONFIG(HASWELL_NRI_TURNAROUND) || ctrl->lpddr)
+		return NRI_STATUS_SUCCESS;
+
+	if (ctrl->no_latency_optimisation) {
+		printk(BIOS_INFO, "Turnarounds left as set\n");
+		return NRI_STATUS_SUCCESS;
+	}
+
+	/* The channels with more than one rank, where the two times are equal */
+	uint8_t before[NUM_CHANNELS] = { 0 };
+	uint8_t all = 0;
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+		const union tc_bank_rank_b_reg tc_bank_rank_b = ctrl->tc_bankrank_b[channel];
+		if (!does_ch_exist(ctrl, channel) || popcnt(ctrl->rankmap[channel]) < 2)
+			continue;
+
+		if (tc_bank_rank_b.tWRRD_dr != tc_bank_rank_b.tWRRD_dd)
+			continue;
+
+		before[channel] = tc_bank_rank_b.tWRRD_dr;
+		all |= BIT(channel);
+	}
+	if (!all)
+		return NRI_STATUS_SUCCESS;
+
+	setup_wdb(ctrl);
+	setup_io_test_wr_rd_ta(ctrl, all);
+	uint8_t chanmask = 0;
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+		if (all & BIT(channel))
+			chanmask |= select_reut_ranks(ctrl, channel, 0xf);
+	}
+
+	/* The shortest value that passed, and whether one below it failed */
+	uint8_t shortest[NUM_CHANNELS] = { 0 };
+	uint8_t failed = 0;
+	uint8_t testing = chanmask;
+	for (uint8_t step = 0; testing; step++) {
+		uint8_t now = 0;
+		for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+			if (!(testing & BIT(channel)))
+				continue;
+
+			if (before[channel] < TAT_MIN_WRRD + step) {
+				testing &= ~BIT(channel);
+				continue;
+			}
+			program_wrrd(ctrl, channel, before[channel] - step);
+			now |= BIT(channel);
+		}
+		if (!now)
+			break;
+
+		const uint8_t errors = run_io_test(ctrl, now, ctrl->dq_pat, true) & now;
+		for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+			if (!(now & BIT(channel)))
+				continue;
+
+			const uint8_t value = before[channel] - step;
+			const bool pass = !(errors & BIT(channel));
+			printk(BIOS_DEBUG, "TAT: C%u write to read, other rank, %u: %s\n",
+			       channel, value, pass ? "pass" : "fail");
+			if (pass) {
+				shortest[channel] = value;
+			} else {
+				/* A shorter one need not be tried */
+				failed |= BIT(channel);
+				testing &= ~BIT(channel);
+				program_wrrd(ctrl, channel, before[channel]);
+			}
+		}
+	}
+
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+		if (!(chanmask & BIT(channel)))
+			continue;
+
+		uint8_t value = before[channel];
+		if (!shortest[channel]) {
+			printk(BIOS_WARNING, "TAT: C%u turnaround test fails as set, "
+			       "left at %u\n", channel, value);
+		} else if (!(failed & BIT(channel))) {
+			printk(BIOS_WARNING, "TAT: C%u no value fails, test not usable, "
+			       "left at %u\n", channel, value);
+		} else {
+			/* One clock of guard, and one clock shorter at most */
+			value = MAX(shortest[channel] + 1, before[channel] - 1);
+			value = MIN(value, before[channel]);
+		}
+		ctrl->tc_bankrank_b[channel].tWRRD_dr = value;
+		ctrl->tc_bankrank_b[channel].tWRRD_dd = value;
+		mchbar_write32(TC_BANK_RANK_B_ch(channel), ctrl->tc_bankrank_b[channel].raw);
+		printk(BIOS_INFO, "TAT: C%u write to read, other rank: %u (was %u)\n",
+		       channel, value, before[channel]);
+	}
+
+	/* The result has to pass, or it is not kept */
+	const uint8_t errors = run_io_test(ctrl, chanmask, ctrl->dq_pat, true) & chanmask;
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+		if (!(errors & BIT(channel)))
+			continue;
+
+		printk(BIOS_WARNING, "TAT: C%u fails with the result, back to %u\n",
+		       channel, before[channel]);
+		ctrl->tc_bankrank_b[channel].tWRRD_dr = before[channel];
+		ctrl->tc_bankrank_b[channel].tWRRD_dd = before[channel];
+		mchbar_write32(TC_BANK_RANK_B_ch(channel), ctrl->tc_bankrank_b[channel].raw);
+	}
+	return NRI_STATUS_SUCCESS;
+}
-- 
