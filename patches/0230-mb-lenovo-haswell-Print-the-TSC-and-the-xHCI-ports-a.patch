 	u8 enable_peg = get_uint_option("enable_dual_graphics", 0);
 
 	/*
diff --git a/src/southbridge/intel/lynxpoint/diag_usb.h b/src/southbridge/intel/lynxpoint/diag_usb.h
new file mode 100644
index 00000000..6430f921
--- /dev/null
+++ b/src/southbridge/intel/lynxpoint/diag_usb.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * DIAG: prints of the xHCI SuperSpeed ports and of the registers that route
+ * them, for one test build of the W541, never for a release. A USB 3.0
+ * drive in a SuperSpeed port stays in Polling or in Compliance mode after
+ * a warm reset on the W541 (nri); the prints follow the ports from the
+ * early USB init of romstage to the jump to the payload or to the OS.
+ */
+
+#ifndef SOUTHBRIDGE_INTEL_LYNXPOINT_DIAG_USB_H
+#define SOUTHBRIDGE_INTEL_LYNXPOINT_DIAG_USB_H
+
+#include <console/console.h>
+#include <device/mmio.h>
+#include <device/pci_def.h>
+#include <device/pci_ops.h>
+#include <southbridge/intel/common/pmbase.h>
+#include <southbridge/intel/lynxpoint/pch.h>
+#include <types.h>
+
+#define DIAG_XHCI_USB2PDO	0xe4
+
+/* The PCH registers that decide where the ports go and what boot this is */
+static inline void diag_print_usb_route(const char *tag)
+{
+	printk(BIOS_NOTICE,
+	       "DIAG usb %s: PM1_STS=%04x PM1_CNT=%08x GEN_PMCON_2=%04x GEN_PMCON_3=%04x PMIR=%08x\n",
+	       tag, read_pmbase16(PM1_STS), read_pmbase32(PM1_CNT),
+	       pci_s_read_config16(PCH_LPC_DEV, GEN_PMCON_2),
+	       pci_s_read_config16(PCH_LPC_DEV, GEN_PMCON_3),
+	       pci_s_read_config32(PCH_LPC_DEV, PMIR));
+	printk(BIOS_NOTICE,
+	       "DIAG usb %s: xHCI PWR_CTL_STS=%04x USB2PR=%08x USB2PRM=%08x USB3PR=%08x USB3PRM=%08x USB3FUS=%08x USB2PDO=%08x USB3PDO=%08x\n",
+	       tag, pci_s_read_config16(PCH_XHCI_DEV, XHCI_PWR_CTL_STS),
+	       pci_s_read_config32(PCH_XHCI_DEV, XHCI_USB2PR),
+	       pci_s_read_config32(PCH_XHCI_DEV, XHCI_USB2PRM),
+	       pci_s_read_config32(PCH_XHCI_DEV, XHCI_USB3PR),
+	       pci_s_read_config32(PCH_XHCI_DEV, XHCI_USB3PRM),
+	       pci_s_read_config32(PCH_XHCI_DEV, XHCI_USB3FUS),
+	       pci_s_read_config32(PCH_XHCI_DEV, DIAG_XHCI_USB2PDO),
+	       pci_s_read_config32(PCH_XHCI_DEV, XHCI_USB3PDO));
+}
+
+/* The SuperSpeed ports the PCH has, from the fuses (as early_usb_native.c reads them) */
+static inline unsigned int diag_ss_port_count(void)
+{
+	if (CONFIG(INTEL_LYNXPOINT_LP))
+		return 4;
+
+	switch ((pci_s_read_config32(PCH_XHCI_DEV, XHCI_USB3FUS) >> XHCI_USB3FUS_SS_SHIFT) &
+		XHCI_USB3FUS_SS_MASK) {
+	case 3:
+		return 0;
+	case 2:
+		return 2;
+	case 1:
+		return 4;
+	default:
+		return 6;
+	}
+}
+
+/* The BAR of the xHCI as ramstage assigned it, NULL if it is not decoding memory */
+static inline const u8 *diag_xhci_bar(void)
+{
+	const u32 bar = pci_s_read_config32(PCH_XHCI_DEV, PCI_BASE_ADDRESS_0);
+	const u16 cmd = pci_s_read_config16(PCH_XHCI_DEV, PCI_COMMAND);
+
+	if (bar == 0 || bar == 0xffffffff || !(cmd & PCI_COMMAND_MEMORY))
+		return NULL;
+
+	return (const u8 *)(uintptr_t)(bar & ~0xf);
+}
+
+/* PORTSC of the first `count` SuperSpeed ports, with the BAR of the xHCI open */
+static inline void diag_print_ss_ports(const char *tag, const u8 *bar, unsigned int count)
+{
+	if (!bar) {
+		printk(BIOS_NOTICE, "DIAG usb %s: no xHCI BAR\n", tag);
+		return;
+	}
+
+	printk(BIOS_NOTICE, "DIAG usb %s: USBCMD=%08x SS PORTSC", tag, read32(bar + XHCI_USBCMD));
+	for (unsigned int port = 0; port < count; port++)
+		printk(BIOS_NOTICE, " %u=%08x", port, read32(bar + XHCI_USB3_PORTSC(port)));
+	printk(BIOS_NOTICE, "\n");
+}
+
+#endif /* SOUTHBRIDGE_INTEL_LYNXPOINT_DIAG_USB_H */
diff --git a/src/southbridge/intel/lynxpoint/early_usb_native.c b/src/southbridge/intel/lynxpoint/early_usb_native.c
index ff167fa1..e5e8b18b 100644
--- a/src/southbridge/intel/lynxpoint/early_usb_native.c
+++ b/src/southbridge/intel/lynxpoint/early_usb_native.c
@@ -12,6 +12,8 @@
 #include <timer.h>
 #include <types.h>
 
+#include "diag_usb.h"
+
 static unsigned int is_usbr_enabled(void)
 {
 	return !!(pci_read_config32(PCH_XHCI_DEV, XHCI_USB3FUS) & BIT(5));
@@ -251,6 +253,9 @@ static bool reset_usb2_ports(const unsigned int ehci_ports)
 /* Returns whether warm reset was successful */
 static bool warm_reset_usb3_ports(const unsigned int xhci_ports)
 {
+	/* DIAG: the ports before the warm reset is asked, and right after */
+	diag_print_ss_ports("warm reset, before WPR", (const u8 *)xhci_bar, xhci_ports);
+
 	for (unsigned int port = 0; port < xhci_ports; port++) {
 		/* Initiate warm reset for all USB3 ports */
 		clrsetbits32(
@@ -258,6 +263,9 @@ static bool warm_reset_usb3_ports(const unsigned int xhci_ports)
 			XHCI_USB3_PORTSC_PED,
 			XHCI_USB3_PORTSC_WPR);
 	}
+
+	diag_print_ss_ports("warm reset, after WPR", (const u8 *)xhci_bar, xhci_ports);
+
 	/* Poll for port reset bit to be cleared or time out at 100ms */
 	struct stopwatch timer;
 	stopwatch_init_msecs_expire(&timer, 100);
@@ -271,12 +279,14 @@ static bool warm_reset_usb3_ports(const unsigned int xhci_ports)
 		if (!reg32) {
 			const long elapsed_time = stopwatch_duration_usecs(&timer);
 			printk(BIOS_DEBUG, "%s: took %lu usecs\n", __func__, elapsed_time);
+			diag_print_ss_ports("warm reset, done", (const u8 *)xhci_bar, xhci_ports);
 			return true;
 		}
 		/* Reference code has a 10 ms delay here, but a smaller delay works too */
 		udelay(100);
 	} while (!stopwatch_expired(&timer));
 	printk(BIOS_ERR, "%s: timed out\n", __func__);
+	diag_print_ss_ports("warm reset, timed out", (const u8 *)xhci_bar, xhci_ports);
 	return !reg32;
 }
 
@@ -290,6 +300,10 @@ static void perform_xhci_ehci_switching_flow(const enum usb_port_route usb_route
 	const uint32_t ehci_mask = BIT(ehci_ports) - 1;
 	const uint32_t xhci_mask = BIT(xhci_ports) - 1;
 
+	/* DIAG: what the ports look like as romstage finds them */
+	diag_print_usb_route("switching flow, entry");
+	diag_print_ss_ports("switching flow, entry", (const u8 *)xhci_bar, xhci_ports);
+
 	/** TODO: Handle USBr port? How, though? **/
 	pci_update_config32(dev, XHCI_USB2PRM, ~XHCI_USB2PR_HCSEL, ehci_mask);
 	pci_update_config32(dev, XHCI_USB3PRM, ~XHCI_USB3PR_SSEN,  xhci_mask);
@@ -345,6 +359,10 @@ static void perform_xhci_ehci_switching_flow(const enum usb_port_route usb_route
 
 	/* Route to xHCI if xHCI enabled */
 	if (usb_route == ROUTE_TO_XHCI) {
+		/* DIAG: MEM_SR is set on an S3 resume and after a warm reset alike */
+		printk(BIOS_NOTICE, "DIAG usb switching flow: MEM_SR=%d, warm reset %s\n",
+		       is_mem_sr(), is_mem_sr() ? "asked" : "skipped");
+
 		if (is_mem_sr()) {
 			if (!warm_reset_usb3_ports(xhci_ports))
 				printk(BIOS_ERR, "USB3 warm reset timed out\n");
@@ -355,6 +373,10 @@ static void perform_xhci_ehci_switching_flow(const enum usb_port_route usb_route
 
 		const uint32_t ehci_port_mask = pci_read_config32(dev, XHCI_USB2PRM) & 0x7fff;
 		pci_update_config32(dev, XHCI_USB2PR, ~XHCI_USB2PR_HCSEL, ehci_port_mask);
+
+		/* DIAG: the ports with the routing set */
+		diag_print_usb_route("switching flow, routed");
+		diag_print_ss_ports("switching flow, routed", (const u8 *)xhci_bar, xhci_ports);
 	}
 }
 
@@ -579,6 +601,12 @@ void early_usb_init(void)
 	usb_overcurrent_mapping();
 	program_ehci_port_length();
 	/** FIXME: USB per port control is missing, is it needed? **/
+
+	/* DIAG: the ports as romstage leaves them, 10 ms later too */
+	diag_print_ss_ports("early_usb_init exit", (const u8 *)xhci_bar, ss_port_count());
+	mdelay(10);
+	diag_print_ss_ports("early_usb_init exit +10 ms", (const u8 *)xhci_bar, ss_port_count());
+
 	xhci_close_memory_space();
 	/** TODO: Close EHCI memory space? **/
 }
diff --git a/src/southbridge/intel/lynxpoint/usb_xhci.c b/src/southbridge/intel/lynxpoint/usb_xhci.c
index 72b53a2d..021ce378 100644
--- a/src/southbridge/intel/lynxpoint/usb_xhci.c
+++ b/src/southbridge/intel/lynxpoint/usb_xhci.c
@@ -11,6 +11,10 @@
 #include "iobp.h"
 #include "pch.h"
 
+#ifndef __SIMPLE_DEVICE__
+#include "diag_usb.h"
+#endif
+
 #ifdef __SIMPLE_DEVICE__
 static u8 *usb_xhci_mem_base(pci_devfn_t dev)
 #else
@@ -95,6 +99,13 @@ static void usb_xhci_reset_usb3(struct device *dev, int all)
 	/* Get mask of disabled ports */
 	port_disabled = pci_read_config32(dev, XHCI_USB3PDO);
 
+	/* DIAG: the ports as found, and which of them this call resets */
+	printk(BIOS_NOTICE, "DIAG usb xhci reset (all=%d, USB3PDO=%08x) entry: SS PORTSC",
+	       all, port_disabled);
+	for (port = 0; port < port_count; port++)
+		printk(BIOS_NOTICE, " %d=%08x", port, read32(mem_base + XHCI_USB3_PORTSC(port)));
+	printk(BIOS_NOTICE, "\n");
+
 	/* Wait until all enabled ports are done polling */
 	for (timeout = XHCI_RESET_TIMEOUT; timeout; timeout--) {
 		int complete = 1;
@@ -114,6 +125,10 @@ static void usb_xhci_reset_usb3(struct device *dev, int all)
 		udelay(XHCI_RESET_DELAY_US);
 	}
 
+	/* DIAG: how long the polling took to end, if it did */
+	printk(BIOS_NOTICE, "DIAG usb xhci reset: polling %s after %d ms\n",
+	       timeout ? "over" : "still on", XHCI_RESET_TIMEOUT - timeout);
+
 	/* Reset all requested ports */
 	for (port = 0; port < port_count; port++) {
 		u8 *portsc = mem_base + XHCI_USB3_PORTSC(port);
@@ -123,10 +138,15 @@ static void usb_xhci_reset_usb3(struct device *dev, int all)
 		status = read32(portsc) & XHCI_USB3_PORTSC_PLS;
 		/* Reset all or only disconnected ports */
 		if (all || (status == XHCI_PLSR_RXDETECT ||
-			    status == XHCI_PLSR_POLLING))
+			    status == XHCI_PLSR_POLLING)) {
+			printk(BIOS_NOTICE, "DIAG usb xhci reset: WPR to port %d (PLS %u)\n",
+			       port, status >> 5);
 			usb_xhci_reset_port_usb3(mem_base, port);
-		else
