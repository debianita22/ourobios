diff --git a/src/include/cpu/x86/diag_tsc.h b/src/include/cpu/x86/diag_tsc.h
new file mode 100644
index 00000000..63d5d1d7
--- /dev/null
+++ b/src/include/cpu/x86/diag_tsc.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * DIAG: prints of the TSC and of IA32_TSC_ADJUST along the boot, for one
+ * test build of the W541, never for a release. Linux finds TSC_ADJUST of
+ * the boot processor at a value near the TSC of the suspend at every
+ * resume from S3; the prints bracket the stage that sets it.
+ */
+
+#ifndef CPU_X86_DIAG_TSC_H
+#define CPU_X86_DIAG_TSC_H
+
+#include <arch/cpuid.h>
+#include <console/console.h>
+#include <cpu/x86/lapic.h>
+#include <cpu/x86/msr.h>
+#include <cpu/x86/tsc.h>
+#include <types.h>
+
+#define DIAG_MSR_IA32_TSC_ADJUST	0x3b
+
+/* CPUID.(EAX=7,ECX=0):EBX[1] */
+static inline bool diag_has_tsc_adjust(void)
+{
+	return cpuid_ext(7, 0).ebx & BIT(1);
+}
+
+static inline void diag_print_tsc(const char *tag)
+{
+	const uint64_t tsc = rdtscll();
+
+	if (!diag_has_tsc_adjust()) {
+		printk(BIOS_NOTICE, "DIAG tsc %s: lapic %u TSC=%llu, no TSC_ADJUST\n",
+		       tag, initial_lapicid(), tsc);
+		return;
+	}
+
+	const msr_t adj = rdmsr(DIAG_MSR_IA32_TSC_ADJUST);
+	const int64_t adjust = (int64_t)(((uint64_t)adj.hi << 32) | adj.lo);
+
+	printk(BIOS_NOTICE, "DIAG tsc %s: lapic %u TSC=%llu TSC_ADJUST=%lld\n",
+	       tag, initial_lapicid(), tsc, adjust);
+}
+
+#endif /* CPU_X86_DIAG_TSC_H */
