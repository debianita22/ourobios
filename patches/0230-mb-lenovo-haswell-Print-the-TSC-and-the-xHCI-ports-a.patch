diff --git a/src/mainboard/lenovo/haswell/diag.c b/src/mainboard/lenovo/haswell/diag.c
new file mode 100644
index 00000000..e3a5ae8e
--- /dev/null
+++ b/src/mainboard/lenovo/haswell/diag.c
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * DIAG: the TSC, IA32_TSC_ADJUST and the xHCI SuperSpeed ports at the boot
+ * states of ramstage, for one test build of the W541, never for a release.
+ * Two open items of docs/roadmap.md: Linux finds TSC_ADJUST of the boot
+ * processor near the TSC of the suspend at every resume from S3, and a
+ * USB 3.0 drive stays in Polling or Compliance mode after a warm reset.
+ */
+
+#include <acpi/acpi.h>
+#include <bootstate.h>
+#include <console/console.h>
+#include <cpu/x86/diag_tsc.h>
+#include <southbridge/intel/lynxpoint/diag_usb.h>
+
+static void diag_state(const char *tag)
+{
+	printk(BIOS_NOTICE, "DIAG state %s: S3 resume %d\n", tag, acpi_is_wakeup_s3());
+	diag_print_tsc(tag);
+	diag_print_usb_route(tag);
+	diag_print_ss_ports(tag, diag_xhci_bar(), diag_ss_port_count());
+}
+
+#define DIAG_STATE(func_, state_, when_, tag_)				\
+	static void func_(void *unused)					\
+	{								\
+		diag_state(tag_);					\
+	}								\
+	BOOT_STATE_INIT_ENTRY(state_, when_, func_, NULL)
+
+/* The first state of ramstage, before any device and before the MP init */
+DIAG_STATE(diag_pre_device, BS_PRE_DEVICE, BS_ON_ENTRY, "BS_PRE_DEVICE entry");
+/* Around the device init, where the MP init and the SMM relocation run */
+DIAG_STATE(diag_dev_init_entry, BS_DEV_INIT, BS_ON_ENTRY, "BS_DEV_INIT entry");
+DIAG_STATE(diag_dev_init_exit, BS_DEV_INIT, BS_ON_EXIT, "BS_DEV_INIT exit");
+DIAG_STATE(diag_post_device, BS_POST_DEVICE, BS_ON_ENTRY, "BS_POST_DEVICE entry");
+/* The resume path: the finalize SMI runs at this state too */
+DIAG_STATE(diag_os_resume, BS_OS_RESUME, BS_ON_ENTRY, "BS_OS_RESUME entry");
+/* The boot path: the last state before the payload */
+DIAG_STATE(diag_payload_boot, BS_PAYLOAD_BOOT, BS_ON_ENTRY, "BS_PAYLOAD_BOOT entry");
+
+/* Called by acpi_resume() after the GNVS SMI, right before the jump to the wake vector */
+void mainboard_suspend_resume(void)
+{
+	diag_state("before the wake vector");
+}
