-uint32_t get_max_margin_for_param(const enum margin_parameter param)
+enum last_margin_param get_margin_result_type(const enum margin_param param)
 {
 	switch (param) {
 	case RdV:
+		return LastRxV;
+	case RdT:
+		return LastRxT;
 	case WrV:
+		return LastTxV;
+	case WrT:
+		return LastTxT;
+	case RcvEna:
+	case RcvEnaX:
+		return LastRcvEna;
+	case WrLevel:
+		return LastWrLevel;
+	case CmdT:
+		return LastCmdT;
+	case CmdV:
+		return LastCmdV;
+	default:
+		die("%s: Unknown margin parameter %u\n", __func__, param);
+	}
+}
+
+uint32_t get_max_margin_for_param(const enum margin_param param)
+{
+	switch (param) {
+	case RdV:
+	case WrV:
+	case CmdV:
 		return MAX_POSSIBLE_VREF;
 	default:
 		return MAX_POSSIBLE_TIME;
@@ -421,13 +494,14 @@ uint32_t get_max_margin_for_param(const enum margin_parameter param)
 
