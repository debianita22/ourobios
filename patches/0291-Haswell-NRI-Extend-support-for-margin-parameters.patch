+static void change_rcven_latency(
+	struct sysinfo *ctrl,
+	const uint8_t channel,
+	const uint8_t rank,
+	const uint8_t byte,
+	int32_t v0)
+{
+	/* Calculate new IO comp latency to include over/underflow */
+	union sc_io_latency_reg sc_io_latency = {
+		.raw = mchbar_read32(SC_IO_LATENCY_ch(channel)),
+	};
+	const uint32_t rt_io_comp = ctrl->rt_io_comp[channel];
+	if (v0 > 0) {
+		if (rt_io_comp == 0) {
+			printk(BIOS_ERR, "%s: rt_iocomp underflow for channel %u\n",
+				__func__, channel);
+		} else {
+			v0 = v0 * 2 - 16;
+			sc_io_latency.rt_iocomp = ctrl->rt_io_comp[channel] - 1;
+		}
+	} else if (v0 < 0) {
+		if (rt_io_comp >= 0x3f) {
+			printk(BIOS_ERR, "%s: rt_iocomp overflow for channel %u\n",
+				__func__, channel);
+		} else {
+			v0 = v0 * 2 + 16;
+			sc_io_latency.rt_iocomp = ctrl->rt_io_comp[channel] + 1;
+		}
+	} else {
+		sc_io_latency.rt_iocomp = ctrl->rt_io_comp[channel];
+	}
+
+	/* The assumption is that we are at 1 Qclk before an edge */
+	v0 += ctrl->rcven[channel][rank][byte];
+	if (v0 < 0) {
+		printk(BIOS_ERR, "WARNING: RcvEn PI wrapped below zero!\n");
+		v0 = 0;
+	} else if (v0 > 511) {
+		printk(BIOS_ERR, "WARNING: RcvEn PI wrapped above 9 bits!\n");
+		v0 = 511;
+	}
+	update_rxt(ctrl, channel, rank, byte, RXT_RCVEN, v0);
+	mchbar_write32(SC_IO_LATENCY_ch(channel), sc_io_latency.raw);
+}
+
 static void update_data_offset_train(
 	struct sysinfo *ctrl,
 	const uint8_t param,
