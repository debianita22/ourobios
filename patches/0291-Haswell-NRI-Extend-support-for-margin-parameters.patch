+		break;
+	case CmdV:
+		update_vref_and_wait(ctrl, VREF_CA, update_ctrl, v0, skip_wait);
+		break;
 	default:
 		die("%s: Invalid margin parameter %u\n", __func__, param);
 	}
@@ -514,13 +593,13 @@ void change_margin(
 
 void change_1d_margin_multicast(
 	struct sysinfo *ctrl,
-	const enum margin_parameter param,
+	const enum margin_param param,
 	const int32_t value0,
 	const uint8_t rank,
 	const bool update_ctrl,
 	const enum regfile_mode regfile)
 {
-	change_margin(ctrl, param, value0, true, 0, rank, 0, update_ctrl, regfile);
+	change_margin(ctrl, param, value0, true, 0, rank, 0, update_ctrl, false, regfile);
