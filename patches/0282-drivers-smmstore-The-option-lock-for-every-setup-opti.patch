+	uint32_t data_size[4];
+	uint8_t state[4];
+};
+
+static enum cb_err walk_guid_see(const struct efi_fv_var *var, void *arg)
+{
+	struct walk_guid_seen *seen = arg;
+	uint8_t data[16];
+
+	assert_true(seen->count < 4);
+	assert_true(var->data_size <= sizeof(data));
+	/* The data follows the name */
+	assert_int_equal(rdev_readat(var->rdev, data, var->name_offset + var->name_size,
+				     var->data_size), var->data_size);
+	seen->data_size[seen->count] = var->data_size;
+	seen->state[seen->count] = var->state;
+	seen->count++;
+	return seen->count == 3 ? CB_ERR : CB_SUCCESS;
+}
+
+/* efi_fv_walk_guid gives the live variables of a guid, in order, and the tail */
+static void efi_test_walk_guid(void **state)
+{
+	const size_t state_offset = offsetof(AUTHENTICATED_VARIABLE_HEADER, State);
+	struct walk_guid_seen seen = { 0 };
+	uint32_t number = 7;
+	size_t second, third, tail;
+
+	mock_rdev(true);
+	assert_int_equal(efi_fv_set_option(&flash_rdev_rw, &OtherGuid, "other", "kept",
+		sizeof("kept")), CB_SUCCESS);
+	assert_int_equal(efi_fv_set_option(&flash_rdev_rw, &EficorebootNvDataGuid, "second",
+		&number, sizeof(number)), CB_SUCCESS);
+	second = next_variable(VARIABLE_OFFSET);
+	third = next_variable(second);
+	tail = next_variable(third);
+
+	/* The variable of the test image and "second"; not the one of the other guid */
+	assert_int_equal(efi_fv_walk_guid(&flash_rdev_rw, &EficorebootNvDataGuid,
+		walk_guid_see, &seen, &tail), CB_SUCCESS);
+	assert_int_equal(seen.count, 2);
+	assert_int_equal(seen.data_size[1], sizeof(number));
+	assert_int_equal(tail, next_variable(third));
+
+	/* In deleted transition it is still one; deleted it is not */
+	flash_buffer[VARIABLE_OFFSET + state_offset] = VAR_IN_DELETED_TRANSITION & VAR_ADDED;
+	flash_buffer[third + state_offset] = VAR_DELETED & VAR_ADDED;
+	memset(&seen, 0, sizeof(seen));
+	assert_int_equal(efi_fv_walk_guid(&flash_rdev_rw, &EficorebootNvDataGuid,
+		walk_guid_see, &seen, NULL), CB_SUCCESS);
+	assert_int_equal(seen.count, 1);
+	assert_int_equal(seen.state[0], VAR_IN_DELETED_TRANSITION & VAR_ADDED);
+
+	/* The error of the callback ends the walk */
+	seen.count = 2;
+	assert_int_equal(efi_fv_walk_guid(&flash_rdev_rw, &EficorebootNvDataGuid,
+		walk_guid_see, &seen, NULL), CB_ERR);
+
+	/* A store that the reader refuses: no walk */
+	flash_buffer[second] = 0;
+	memset(&seen, 0, sizeof(seen));
+	assert_int_equal(efi_fv_walk_guid(&flash_rdev_rw, &EficorebootNvDataGuid,
+		walk_guid_see, &seen, &tail), CB_EFI_VS_CORRUPTED_INVALID);
+}
