diff --git a/tests/drivers/smmstore_options_lock.c b/tests/drivers/smmstore_options_lock.c
new file mode 100644
index 00000000000..b1e2417a052
--- /dev/null
+++ b/tests/drivers/smmstore_options_lock.c
@@ -0,0 +1,539 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * The decisions of the SMMSTORE option lock, on variable stores that the test
+ * builds: what a write or an erase of the store is answered once the payload
+ * has armed the lock. Built twice, with and without SMMSTORE_OPTION_LOCK_ALL.
+ */
+
+#include <tests/test.h>
+
+#include <types.h>
+
+/* cpu/x86/smm.h declares it only in a build with the SMRAM region */
+void smm_get_option_lock_state_buffer(uintptr_t *base, size_t *size);
+
+/* The lock itself, with its statics */
+#include "../../src/drivers/smmstore/options_lock.c"
+
+#include <vendorcode/intel/edk2/UDK2017/MdeModulePkg/Include/Guid/VariableFormat.h>
+
+#define BLOCK 0x1000
+#define BLOCKS 8
+
+static uint8_t flash[BLOCKS * BLOCK];
+static uint8_t smram[0x1000];
+static struct region_device flash_rw;
+
+/* The flash as the lock reads it: reads fail from fail_from on */
+static size_t fail_from = SIZE_MAX;
+
+static ssize_t flash_readat(const struct region_device *rd, void *b, size_t offset, size_t size)
+{
+	if (offset + size > fail_from)
+		return -1;
+	memcpy(b, flash + offset, size);
+	return size;
+}
+
+static void *flash_mmap(const struct region_device *rd, size_t offset, size_t size)
+{
+	return NULL;
+}
+
+static int flash_munmap(const struct region_device *rd, void *mapping)
+{
+	return 0;
+}
+
+static const struct region_device_ops flash_ops = {
+	.mmap = flash_mmap,
+	.munmap = flash_munmap,
+	.readat = flash_readat,
+};
+
+static struct region_device flash_root;
+
+int fmap_locate_area(const char *name, struct region *ar)
+{
+	*ar = region_create(0, sizeof(flash));
+	return 0;
+}
+
+int boot_device_ro_subregion(const struct region *sub, struct region_device *subrd)
+{
+	return rdev_chain(subrd, &flash_root, region_offset(sub), region_sz(sub));
+}
+
+void smm_get_option_lock_state_buffer(uintptr_t *base, size_t *size)
+{
+	*base = (uintptr_t)smram;
+	*size = sizeof(smram);
+}
+
+static const EFI_GUID other_guid = {
+	0x8be4df61, 0x93ca, 0x11d2, { 0xaa, 0x0d, 0x00, 0xe0, 0x98, 0x03, 0x2b, 0x8c } };
+
+static size_t store_end;
+
+/* A new boot: an empty store, SMM loaded, the lock not armed */
+static void new_store(void)
+{
+	memset(flash, 0xff, sizeof(flash));
+	memset(smram, 0, sizeof(smram));
+#if CONFIG(SMMSTORE_OPTION_LOCK_ALL)
+	memset(&option_set, 0, sizeof(option_set));
+#endif
+	fail_from = SIZE_MAX;
+	region_device_init(&flash_root, &flash_ops, 0, sizeof(flash));
+	rdev_chain_mem_rw(&flash_rw, flash, sizeof(flash));
+	assert_int_equal(efi_fv_initialize(&flash_rw, BLOCK), CB_SUCCESS);
+	assert_int_equal(efi_fv_store_end(&flash_rw, &store_end), CB_SUCCESS);
+	assert_true(store_end < sizeof(flash));
+}
+
+static void set_option(const char *name, uint32_t value)
+{
+	assert_int_equal(efi_fv_set_option(&flash_rw, &EficorebootNvDataGuid, name, &value,
+					   sizeof(value)), CB_SUCCESS);
+}
+
+static enum cb_err no_var(const struct efi_fv_var *var, void *arg)
+{
+	return CB_SUCCESS;
+}
+
+/* Where the next record goes */
+static size_t store_tail(void)
+{
+	size_t tail;
+
+	assert_int_equal(efi_fv_walk_guid(&flash_rw, &other_guid, no_var, NULL, &tail),
+			 CB_SUCCESS);
+	return ALIGN_UP(tail, HEADER_ALIGNMENT);
+}
+
+/* The handler: the decision, then the flash programmed (bits only cleared) */
+static bool raw_write(size_t offset, const void *data, size_t size)
+{
+	if (!smmstore_options_write_allowed(offset, data, size))
+		return false;
+	for (size_t i = 0; i < size; i++)
+		flash[offset + i] &= ((const uint8_t *)data)[i];
+	return true;
+}
+
+static bool raw_erase(size_t block)
+{
+	if (!smmstore_options_write_allowed(block * BLOCK, NULL, BLOCK))
+		return false;
+	memset(flash + block * BLOCK, 0xff, BLOCK);
+	return true;
+}
+
+static bool raw_state(size_t record, uint8_t state)
+{
+	return raw_write(record + offsetof(AUTHENTICATED_VARIABLE_HEADER, State), &state,
+			 sizeof(state));
+}
+
+struct record {
+	AUTHENTICATED_VARIABLE_HEADER hdr;
+	uint8_t body[128];
+	size_t body_size;
+};
+
+static void make_record(struct record *r, const EFI_GUID *guid, const char *name,
+			uint32_t attributes, const void *data, size_t size)
+{
+	const size_t name_size = (strlen(name) + 1) * sizeof(CHAR16);
+
+	assert_true(name_size + size <= sizeof(r->body));
+	memset(r, 0xff, sizeof(*r));
+	r->hdr.StartId = VARIABLE_DATA;
+	r->hdr.Attributes = attributes;
+	r->hdr.NameSize = name_size;
+	r->hdr.DataSize = size;
+	memcpy(&r->hdr.VendorGuid, guid, sizeof(*guid));
+	memset(r->body, 0, name_size);
+	for (size_t i = 0; name[i]; i++)
+		r->body[i * sizeof(CHAR16)] = name[i];
+	memcpy(r->body + name_size, data, size);
+	r->body_size = name_size + size;
+}
+
+/*
+ * A record as the payload's variable driver writes it: the header, the state
+ * "header valid", name and data, the state "added". Returns how many of the
+ * four writes the lock allowed.
+ */
+static int append_record(const struct record *r, size_t at)
+{
+	if (!raw_write(at, &r->hdr, sizeof(r->hdr)))
+		return 0;
+	if (!raw_state(at, VAR_HEADER_VALID_ONLY))
+		return 1;
+	if (!raw_write(at + sizeof(r->hdr), r->body, r->body_size))
+		return 2;
+	if (!raw_state(at, VAR_ADDED))
+		return 3;
+	return 4;
+}
+
+static void arm(uint32_t expected)
+{
+	assert_int_equal(smmstore_options_lock(), expected);
+	assert_true(smmstore_options_protecting());
+}
+
+static size_t option_record(const char *name)
+{
+	struct region_device rdev = flash_rw;
+	uint32_t value, size = sizeof(value);
+	const size_t name_size = (strlen(name) + 1) * sizeof(CHAR16);
+
+	/* efi_fv_get_option() does not say where: look for the name */
+	assert_int_equal(efi_fv_get_option(&rdev, &EficorebootNvDataGuid, name, &value, &size),
+			 CB_SUCCESS);
+	for (size_t at = 0; at + sizeof(AUTHENTICATED_VARIABLE_HEADER) < store_end;
+	     at += HEADER_ALIGNMENT) {
+		const AUTHENTICATED_VARIABLE_HEADER *h = (const void *)(flash + at);
+		const uint8_t *n = flash + at + sizeof(*h);
+		size_t i;
+
+		if (h->StartId != VARIABLE_DATA || h->State != VAR_ADDED ||
+		    h->NameSize != name_size ||
+		    memcmp(&h->VendorGuid, &EficorebootNvDataGuid, sizeof(EFI_GUID)))
+			continue;
+		for (i = 0; name[i] && n[i * 2] == name[i]; i++)
+			;
+		if (!name[i])
+			return at;
+	}
+	fail_msg("no record of %s", name);
+	return 0;
+}
+
+static void three_options(void)
+{
+	new_store();
+	set_option("bios_lock", 1);
+	set_option("bootmedia_lock", 1);
+	set_option("onboard_audio", 0);
+}
+
+/* Not armed: anything goes */
+static void test_not_armed(void **state)
+{
+	const uint8_t zero[8] = { 0 };
+
+	three_options();
+	assert_false(smmstore_options_protecting());
+	assert_true(smmstore_options_write_allowed(option_record("bios_lock"), zero,
+						   sizeof(zero)));
+	assert_true(smmstore_options_write_allowed(0, NULL, BLOCK));
+	assert_true(smmstore_options_write_allowed(store_end, zero, sizeof(zero)));
+}
+
+/* What must keep working: variables of other GUIDs written, updated, deleted */
+static void test_other_variables(void **state)
+{
+	const uint16_t timeout = 3;
+	struct record r;
+	size_t first, second;
+
+	three_options();
+	arm(SMMSTORE_RET_SUCCESS);
+
+	/* A new variable, step by step */
+	first = store_tail();
+	make_record(&r, &other_guid, "Timeout", 7, &timeout, sizeof(timeout));
+	assert_int_equal(append_record(&r, first), 4);
+
+	/* Updated: the new record, then the states of the old one */
+	second = store_tail();
+	assert_true(second > first);
+	assert_int_equal(append_record(&r, second), 4);
+	assert_true(raw_state(first, VAR_IN_DELETED_TRANSITION & VAR_ADDED));
+	assert_true(raw_state(first, VAR_DELETED & VAR_IN_DELETED_TRANSITION & VAR_ADDED));
+
+	/* Deleted */
+	assert_true(raw_state(second, VAR_IN_DELETED_TRANSITION & VAR_ADDED));
+	assert_true(raw_state(second, VAR_DELETED & VAR_IN_DELETED_TRANSITION & VAR_ADDED));
+
+	/* And once more after it, past what the lock knew as erased at the arm */
+	assert_int_equal(append_record(&r, store_tail()), 4);
+}
+
+/* The fault tolerant write blocks, past the store: read-only while armed */
+static void test_ftw_blocks(void **state)
+{
+	const uint8_t record[16] = { 0 };
+
+	three_options();
+	arm(SMMSTORE_RET_SUCCESS);
+	assert_false(raw_write(store_end, record, sizeof(record)));
+	assert_false(raw_write(store_end - 4, record, sizeof(record)));
+	assert_false(raw_write(sizeof(flash) - sizeof(record), record, sizeof(record)));
+	assert_false(raw_erase(store_end / BLOCK));
+	assert_false(raw_erase(BLOCKS - 1));
+}
+
+/* A read error during the check */
+static void test_read_error(void **state)
+{
+	const uint16_t timeout = 3;
+	struct record r;
+	size_t at;
+
+	three_options();
+	arm(SMMSTORE_RET_SUCCESS);
+	at = store_tail();
+	make_record(&r, &other_guid, "Timeout", 7, &timeout, sizeof(timeout));
+	fail_from = 0x100;
+	assert_false(raw_write(at, &r.hdr, sizeof(r.hdr)));
+	fail_from = SIZE_MAX;
+	assert_true(raw_write(at, &r.hdr, sizeof(r.hdr)));
+}
+
+#if CONFIG(SMMSTORE_OPTION_LOCK_ALL)
+
+/* The value of an option changed: a new record of its name, the old one deleted */
+static void test_option_changed(void **state)
+{
+	const uint32_t on = 1;
+	struct record r;
+	size_t old;
+
+	three_options();
+	arm(SMMSTORE_RET_SUCCESS);
+	old = option_record("onboard_audio");
+
+	/* The record can be prepared, not made a variable */
+	make_record(&r, &EficorebootNvDataGuid, "onboard_audio", 3, &on, sizeof(on));
+	assert_int_equal(append_record(&r, store_tail()), 3);
+	/* Nor can the old one go, in either step */
+	assert_false(raw_state(old, VAR_IN_DELETED_TRANSITION & VAR_ADDED));
+	assert_false(raw_state(old, VAR_DELETED & VAR_ADDED));
+
+	/* The option reads as before */
+	assert_int_equal(option_record("onboard_audio"), old);
+}
+
+/* An option deleted, a security one and another */
+static void test_option_deleted(void **state)
+{
+	three_options();
+	arm(SMMSTORE_RET_SUCCESS);
+	assert_false(raw_state(option_record("onboard_audio"), VAR_DELETED & VAR_ADDED));
+	assert_false(raw_state(option_record("bios_lock"), VAR_DELETED & VAR_ADDED));
+	assert_false(raw_state(option_record("bios_lock"),
+			       VAR_IN_DELETED_TRANSITION & VAR_ADDED));
+}
+
+/* A variable of the options GUID that was not there, or there with other attributes */
+static void test_option_added(void **state)
+{
+	const uint32_t value = 1;
+	struct record r;
+
+	three_options();
+	arm(SMMSTORE_RET_SUCCESS);
+	make_record(&r, &EficorebootNvDataGuid, "new_option", 3, &value, sizeof(value));
+	assert_int_equal(append_record(&r, store_tail()), 3);
+
+	three_options();
+	arm(SMMSTORE_RET_SUCCESS);
+	make_record(&r, &EficorebootNvDataGuid, "bios_lock", 7, &value, sizeof(value));
+	assert_int_equal(append_record(&r, store_tail()), 3);
+}
+
+/* The data, the name or the attributes of an option programmed over */
+static void test_option_bits(void **state)
+{
+	const uint8_t zero[4] = { 0 };
+	size_t at;
+
+	three_options();
+	arm(SMMSTORE_RET_SUCCESS);
+	at = option_record("bootmedia_lock");
+	/* The data: the last four bytes of the record */
+	assert_false(raw_write(at + sizeof(AUTHENTICATED_VARIABLE_HEADER) +
+			       sizeof("bootmedia_lock") * sizeof(CHAR16), zero, sizeof(zero)));
+	/* A letter of the name */
+	assert_false(raw_write(at + sizeof(AUTHENTICATED_VARIABLE_HEADER), zero, 1));
+	/* The attributes */
+	assert_false(raw_write(at + offsetof(AUTHENTICATED_VARIABLE_HEADER, Attributes), zero,
+			       sizeof(zero)));
+}
+
+/* The block of an option erased, with the store still readable */
+static void test_option_erased(void **state)
+{
+	uint8_t filler[100];
+	struct record r;
+
+	new_store();
+	set_option("bios_lock", 1);
+	/* Other variables up to the second block, then an option in it */
+	memset(filler, 0x5a, sizeof(filler));
+	make_record(&r, &other_guid, "Filler", 7, filler, sizeof(filler));
+	while (store_tail() < BLOCK) {
+		const size_t at = store_tail();
+
+		memcpy(flash + at, &r.hdr, sizeof(r.hdr));
+		memcpy(flash + at + sizeof(r.hdr), r.body, r.body_size);
+		flash[at + offsetof(AUTHENTICATED_VARIABLE_HEADER, State)] = VAR_ADDED;
+	}
+	set_option("onboard_audio", 0);
+	assert_true(option_record("onboard_audio") >= BLOCK);
+	arm(SMMSTORE_RET_SUCCESS);
+
+	assert_false(raw_erase(1));
+	/* The block of the headers: the store unreadable */
+	assert_false(raw_erase(0));
+	/* A block of the store with nothing in it */
+	assert_true(raw_erase(2));
+}
+
+/* The store made unreadable: every option would read as its default */
+static void test_store_damaged(void **state)
+{
+	const uint8_t zero[4] = { 0 };
+	const uint8_t byte = 0x7f;
+	const uint16_t timeout = 3;
+	struct record r;
+	size_t at, tail;
+
+	three_options();
+	at = store_tail();
+	make_record(&r, &other_guid, "Timeout", 7, &timeout, sizeof(timeout));
+	memcpy(flash + at, &r.hdr, sizeof(r.hdr));
+	memcpy(flash + at + sizeof(r.hdr), r.body, r.body_size);
+	flash[at + offsetof(AUTHENTICATED_VARIABLE_HEADER, State)] = VAR_ADDED;
+	set_option("vtd", 1);
+	arm(SMMSTORE_RET_SUCCESS);
+
+	/* The size of a record between two options */
+	assert_false(raw_write(at + offsetof(AUTHENTICATED_VARIABLE_HEADER, NameSize), zero,
+			       sizeof(zero)));
+	/* Its start mark */
+	assert_false(raw_write(at, zero, 1));
+	/* The headers of the store */
+	assert_false(raw_write(0x10, zero, sizeof(zero)));
+	/* Bytes after the last record, at once and further on */
+	tail = store_tail();
+	assert_false(raw_write(tail, &byte, sizeof(byte)));
+	assert_false(raw_write(tail + 0x200, &byte, sizeof(byte)));
+	assert_false(raw_write(store_end - 1, &byte, sizeof(byte)));
+}
+
+/*
+ * The first piece of a header that the payload's driver splits at the end of
+ * a flash block: the reader cannot read a store that ends in half a header,
+ * so the piece is refused, and the write of that variable fails.
+ */
+static void test_split_header(void **state)
+{
+	const uint16_t timeout = 3;
+	struct record r;
+	size_t at;
+
+	three_options();
+	arm(SMMSTORE_RET_SUCCESS);
+	at = store_tail();
+	make_record(&r, &other_guid, "Timeout", 7, &timeout, sizeof(timeout));
+	assert_false(raw_write(at, &r.hdr, 20));
+	assert_false(raw_write(at, &r.hdr, 1));
+	/* Whole, it goes */
+	assert_true(raw_write(at, &r.hdr, sizeof(r.hdr)));
+}
+
+/* SMM loaded again on a resume: the set is the one of the flash at that time */
+static void test_resume(void **state)
+{
+	const uint16_t timeout = 3;
+	struct record r;
+
+	three_options();
+	arm(SMMSTORE_RET_SUCCESS);
+	/* ramstage wrote an option on the resume; SMM lost its statics */
+	set_option("me_state_counter", 2);
+	memset(&option_set, 0, sizeof(option_set));
+
+	make_record(&r, &other_guid, "Timeout", 7, &timeout, sizeof(timeout));
+	assert_int_equal(append_record(&r, store_tail()), 4);
+	assert_false(raw_state(option_record("me_state_counter"), VAR_DELETED & VAR_ADDED));
+	assert_false(raw_state(option_record("onboard_audio"), VAR_DELETED & VAR_ADDED));
+}
+
+/* The set cannot be read at the arm: the lock of the two options, and a status */
+static void test_no_latch(void **state)
+{
+	const uint8_t zero[4] = { 0 };
+
+	three_options();
+	/* A record with a size that does not fit: the reader gives the store up */
+	flash[option_record("onboard_audio") +
+	      offsetof(AUTHENTICATED_VARIABLE_HEADER, DataSize) + 3] = 0x7f;
+	arm(SMMSTORE_RET_FAILURE);
+	assert_int_equal(smmstore_options_lock(), SMMSTORE_RET_FAILURE);
+	/* The blocks past the store all the same */
+	assert_false(raw_write(store_end, zero, sizeof(zero)));
+}
+
+#else /* !SMMSTORE_OPTION_LOCK_ALL */
+
+/* The decisions of the lock of the two security options, as before */
+static void test_two_options(void **state)
+{
+	const uint32_t off = 0, on = 1;
+	struct record r;
+	size_t old;
+
+	three_options();
+	arm(SMMSTORE_RET_SUCCESS);
+
+	/* Another option changes */
+	old = option_record("onboard_audio");
+	make_record(&r, &EficorebootNvDataGuid, "onboard_audio", 3, &on, sizeof(on));
+	assert_int_equal(append_record(&r, store_tail()), 4);
+	assert_true(raw_state(old, VAR_IN_DELETED_TRANSITION & VAR_ADDED));
+	assert_true(raw_state(old, VAR_DELETED & VAR_IN_DELETED_TRANSITION & VAR_ADDED));
+
+	/* A security option turned off: refused when the reader would return it */
+	old = option_record("bios_lock");
+	make_record(&r, &EficorebootNvDataGuid, "bios_lock", 3, &off, sizeof(off));
+	assert_int_equal(append_record(&r, store_tail()), 4);
+	assert_false(raw_state(old, VAR_DELETED & VAR_ADDED));
+
+	/* Deleted, it reads as its default, on */
+	assert_true(raw_state(option_record("bootmedia_lock"), VAR_DELETED & VAR_ADDED));
+}
+
+#endif
