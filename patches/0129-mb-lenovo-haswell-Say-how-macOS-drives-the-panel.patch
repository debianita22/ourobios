From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Domenico D'Arrigo <d.darrigo@outlook.it>
Date: Tue, 27 Oct 2026 13:54:09 +0100
Subject: [PATCH] mb/lenovo/haswell: Say how macOS drives the panel

macOS drives the panel of the W541, on DDI D, as a DisplayPort sink
with a desktop framebuffer: it has no backlight control for it, and
the backlight device of 0124 only moved the PWM to 380 Hz there. A
laptop framebuffer with its built-in connector moved to DDI D may
drive it as built-in display instead, with the backlight device.

Add the setup option macos_panel, Panel under macOS:
- External display (default on the W541): under macOS the brightness
  keys set the PWM themselves, as the _Q14/_Q15 renames of OpenCore
  configurations had them do, and closing the lid on AC presses the
  sleep button (0113); no PNLF;
- Built-in display (default on the T440p): PNLF as 0124 had it, an
  ambient light sensor (ALS0, as the SSDT-ALS0 sample of OpenCore),
  the keys as ACPI events (Notify of LCD0) for BrightnessKeys.kext,
  and no sleep button on lid close: macOS sleeps on that itself.

The SSDT names the option (\_SB.PCI0.GFX0.MPBI). Linux and Windows
see no change.

TEST=acpiexec on the DSDT, under macOS and not, with MPBI missing, 0
and 1: PNLF and ALS0 present only under macOS with 1; Fn+F6/F5 with
BRCT 1 step the PWM themselves under macOS with 0 or none, and notify
LCD0 otherwise; _WAK 3 and 4 move the PWM to 0xad9 only with 1, and
_WAK 3 puts the last level back in both; the lid on AC presses the
sleep button only under macOS with 0 or none. The other acpiexec
tests of rc12 give the same results, but PNLF and _WAK with 1 only.
cfr-dump: the option once, in Compatibility > macOS. Both variants
build.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018n3yuWwDLW63F4vdf7ZFTv
---
 src/ec/lenovo/h8/acpi/ec.asl                  |  3 +-
 .../lenovo/haswell/acpi/platform.asl          |  9 ++-
 src/mainboard/lenovo/haswell/acpi/pnlf.asl    | 79 +++++++++++++++++--
 src/mainboard/lenovo/haswell/cfr.c            | 25 ++++++
 src/mainboard/lenovo/haswell/dsdt.asl         |  9 ++-
 src/mainboard/lenovo/haswell/mainboard.c      | 12 ++-
 src/mainboard/lenovo/haswell/setup_options.h  | 10 +++
 7 files changed, 131 insertions(+), 16 deletions(-)

diff --git a/src/ec/lenovo/h8/acpi/ec.asl b/src/ec/lenovo/h8/acpi/ec.asl
index 03e1eaec49..99cbd07bb2 100644
--- a/src/ec/lenovo/h8/acpi/ec.asl
+++ b/src/ec/lenovo/h8/acpi/ec.asl
@@ -212,8 +212,9 @@ Device(EC)
 		 * AC, and it is in desktop mode whenever no built-in display is
 		 * online: on boards where it drives the panel as an external
 		 * display, press the sleep button for it on AC, as Fn+4 does.
+		 * EC_LENOVO_H8_LID_SLEEP_DARWIN is the condition for that.
 		 */
-		If (HPAC && \ISDW ()) {
+		If (HPAC && \ISDW () && EC_LENOVO_H8_LID_SLEEP_DARWIN) {
 			Notify(^SLPB, 0x80)
 		}
 #endif
diff --git a/src/mainboard/lenovo/haswell/acpi/platform.asl b/src/mainboard/lenovo/haswell/acpi/platform.asl
index 7e51a8dc61..69bd489cef 100644
--- a/src/mainboard/lenovo/haswell/acpi/platform.asl
+++ b/src/mainboard/lenovo/haswell/acpi/platform.asl
@@ -14,11 +14,14 @@ Method(_WAK,1)
 	 * The firmware sets the backlight PWM at the frequency of the panel and
 	 * at 50%, at boot and at every resume from S3 (gma_setup_panel()).
 	 * Linux and Windows set their own level again, macOS keeps that one:
-	 * there, the maximum of the PWM as macOS takes it (PNLF), after S4 as
-	 * well, and after S3 the last level that _BCM set or _BQC read (BRLV).
+	 * there, with PNLF (the panel as built-in display) the maximum of the
+	 * PWM as macOS takes it, after S4 as well, and after S3 the last level
+	 * that _BCM or the brightness keys set or _BQC read (BRLV).
 	 */
 	If (\ISDW ()) {
-		\_SB.PCI0.GFX0.PNLF.PWMX ()
+		If (\_SB.PCI0.GFX0.DWBI ()) {
+			\_SB.PCI0.GFX0.PNLF.PWMX ()
+		}
 		If (Arg0 == 3 && \_SB.PCI0.GFX0.BRVA) {
 			\_SB.PCI0.GFX0.XBCM (\_SB.PCI0.GFX0.BRLV)
 		}
diff --git a/src/mainboard/lenovo/haswell/acpi/pnlf.asl b/src/mainboard/lenovo/haswell/acpi/pnlf.asl
index da5d08edc7..eca95e051c 100644
--- a/src/mainboard/lenovo/haswell/acpi/pnlf.asl
+++ b/src/mainboard/lenovo/haswell/acpi/pnlf.asl
@@ -1,13 +1,58 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
 /*
- * The backlight device of macOS, as the SSDT-PNLF sample of OpenCore has it
- * for Haswell: AppleBacklight drives the panel backlight through PNLF and,
- * from its _UID 15, takes 0xad9 for the maximum of the PWM, as on the
- * Haswell Macs. Present under macOS only.
+ * The panel under macOS, as the setup option macos_panel says how the Intel
+ * framebuffer of macOS drives it (MPBI, from the SSDT; 0 without it):
+ * - External display (MPBI 0): as a DisplayPort sink, with no backlight
+ *   control (a desktop framebuffer; the W541's panel is on DDI D): the
+ *   brightness keys set the PWM themselves, and closing the lid on AC
+ *   presses the sleep button (EC_LENOVO_H8_LID_SLEEP_DARWIN);
+ * - Built-in display (MPBI 1): the backlight device of macOS (PNLF) and an
+ *   ambient light sensor (ALS0), the keys to macOS as ACPI events.
  */
+External (\_SB.PCI0.GFX0.MPBI, IntObj)
+
 Scope (\_SB.PCI0.GFX0)
 {
+	/* 1 under macOS with the panel as built-in display */
+	Method (DWBI)
+	{
+		If (\ISDW () && CondRefOf (\_SB.PCI0.GFX0.MPBI)) {
+			Return (\_SB.PCI0.GFX0.MPBI)
+		}
+		Return (0)
+	}
+
+	/*
+	 * The brightness keys, Fn+F6 and Fn+F5 (BRIGHTNESS_UP/DOWN of the EC).
+	 * INCB and DECB set the PWM themselves, or with BRCT 1 (_BCL called)
+	 * leave the step to the OS with a Notify of LCD0. Under macOS, the
+	 * firmware with the panel as external display, which macOS has no
+	 * backlight control for (as the _Q14/_Q15 renames in OpenCore did),
+	 * else macOS, through BrightnessKeys.kext, which takes the Notify.
+	 */
+	Method (BKUP)
+	{
+		If (\ISDW ()) {
+			BRCT = DWBI ()
+		}
+		INCB ()
+	}
+
+	Method (BKDN)
+	{
+		If (\ISDW ()) {
+			BRCT = DWBI ()
+		}
+		DECB ()
+	}
+
+	/*
+	 * The backlight device of macOS, as the SSDT-PNLF sample of OpenCore has
+	 * it for Haswell: AppleBacklight drives the backlight of the built-in
+	 * display through PNLF and, from its _UID 15, takes 0xad9 for the
+	 * maximum of the PWM, as on the Haswell Macs and their framebuffers.
+	 */
 	Device (PNLF)
 	{
 		Name (_HID, EisaId ("APP0002"))
@@ -16,7 +61,7 @@ Scope (\_SB.PCI0.GFX0)
 
 		Method (_STA)
 		{
-			If (\ISDW ()) {
+			If (^^DWBI ()) {
 				Return (0x0b)
 			}
 			Return (0)
@@ -58,3 +103,27 @@ Scope (\_SB.PCI0.GFX0)
 		}
 	}
 }
+
+/*
+ * The ambient light sensor that macOS wants from 10.15 for the backlight
+ * of a built-in display, as the SSDT-ALS0 sample of OpenCore: fixed values,
+ * which SMCLightSensor reports. With PNLF only.
+ */
+Scope (\_SB)
+{
+	Device (ALS0)
+	{
+		Name (_HID, "ACPI0008")
+		Name (_CID, "smc-als")
+		Name (_ALI, 300)
+		Name (_ALR, Package () { Package () { 100, 300 } })
+
+		Method (_STA)
+		{
+			If (\_SB.PCI0.GFX0.DWBI ()) {
+				Return (0x0f)
+			}
+			Return (0)
+		}
+	}
+}
diff --git a/src/mainboard/lenovo/haswell/cfr.c b/src/mainboard/lenovo/haswell/cfr.c
index 6651c5de8e..bb6b55b750 100644
--- a/src/mainboard/lenovo/haswell/cfr.c
+++ b/src/mainboard/lenovo/haswell/cfr.c
@@ -687,6 +687,30 @@ static const struct sm_object macos_device_properties = SM_DECLARE_BOOL({
 	.default_value	= false,
 });
 
+/* For acpi/pnlf.asl and the lid of the EC, through the SSDT (mainboard_fill_ssdt()) */
+static const struct sm_object macos_panel = SM_DECLARE_ENUM({
+	.opt_name	= "macos_panel",
+	.ui_name	= "Panel under macOS",
+	.ui_helptext	= "How the Intel framebuffer of the OpenCore configuration\n"
+			  "has macOS drive the panel.\n"
+			  "External display: as a DisplayPort sink (a desktop\n"
+			  "framebuffer), with no backlight control: the brightness\n"
+			  "keys set the PWM themselves and closing the lid on AC\n"
+			  "sleeps the laptop. Replaces the _Q14/_Q15 renames and\n"
+			  "their SSDT.\n"
+			  "Built-in display (a laptop framebuffer): the backlight\n"
+			  "device of macOS (PNLF) and an ambient light sensor (ALS0),\n"
+			  "the keys as ACPI events for BrightnessKeys.kext. Replaces\n"
+			  "SSDT-PNLF and SSDT-ALS0.\n"
+			  "Default: External display on the W541, whose panel is on\n"
+			  "DDI D; Built-in display on the T440p.",
+	.default_value	= MACOS_PANEL_DEFAULT,
+	.values		= (const struct sm_enum_value[]) {
+				{ "External display",	MACOS_PANEL_EXTERNAL	},
+				{ "Built-in display",	MACOS_PANEL_BUILTIN	},
+				SM_ENUM_VALUE_END				},
+});
+
 static const struct sm_object macos_ports_note = SM_DECLARE_COMMENT({
 	.flags		= CONFIG(BOARD_LENOVO_THINKPAD_W541) ? 0 : CFR_OPTFLAG_SUPPRESS,
 	.ui_name	= "Unused slots: Hardware > Storage and Expansion ports",
@@ -706,6 +730,7 @@ static const struct sm_object compatibility_macos = SM_DECLARE_FORM({
 		&cfg_lock,
 		&dgpu_macos_off,
 		&gfx_resume_init,
+		&macos_panel,
 		&minihd_audio,
 		&macos_device_properties,
 		&macos_ports_note,
diff --git a/src/mainboard/lenovo/haswell/dsdt.asl b/src/mainboard/lenovo/haswell/dsdt.asl
index 1a4a236e87..679499e1d3 100644
--- a/src/mainboard/lenovo/haswell/dsdt.asl
+++ b/src/mainboard/lenovo/haswell/dsdt.asl
@@ -1,14 +1,15 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 
-#define BRIGHTNESS_UP \_SB.PCI0.GFX0.INCB
-#define BRIGHTNESS_DOWN \_SB.PCI0.GFX0.DECB
+/* INCB and DECB, through the brightness keys of macOS (acpi/pnlf.asl) */
+#define BRIGHTNESS_UP \_SB.PCI0.GFX0.BKUP
+#define BRIGHTNESS_DOWN \_SB.PCI0.GFX0.BKDN
 #define THINKPAD_EC_GPE 17
 #define THINKPAD_EC_WAKE_GPE 0x1d /* GPIO13 */
 #define EC_LENOVO_H8_ALT_FN_F2F3_LAYOUT 1
 #define EC_LENOVO_H8_FN_F9_F12_LAYOUT 1
 #if CONFIG(BOARD_LENOVO_THINKPAD_W541)
-/* macOS drives the panel, on DDI D, as an external display */
-#define EC_LENOVO_H8_LID_SLEEP_DARWIN 1
+/* macOS drives the panel, on DDI D, as an external display, unless set up as built-in */
+#define EC_LENOVO_H8_LID_SLEEP_DARWIN (!\_SB.PCI0.GFX0.DWBI ())
 #endif
 
 #include <acpi/acpi.h>
diff --git a/src/mainboard/lenovo/haswell/mainboard.c b/src/mainboard/lenovo/haswell/mainboard.c
index 44ba99fec9..6751c9b161 100644
--- a/src/mainboard/lenovo/haswell/mainboard.c
+++ b/src/mainboard/lenovo/haswell/mainboard.c
@@ -64,9 +64,16 @@ static void disable_root_port(unsigned int func, const char *what)
 	rp->enabled = 0;
 }
 
-/* The setup options that the DSDT reads (acpi/dgpu.asl, acpi/devprops.asl) */
+/* The setup options that the DSDT reads: acpi/dgpu.asl, devprops.asl, pnlf.asl */
 static void mainboard_fill_ssdt(const struct device *dev)
 {
+	const unsigned int panel = get_uint_option("macos_panel", MACOS_PANEL_DEFAULT);
+
+	/* Whether macOS drives the panel as built-in display: PNLF, ALS0, keys */
+	acpigen_write_scope("\\_SB.PCI0.GFX0");
+	acpigen_write_name_integer("MPBI", panel == MACOS_PANEL_BUILTIN ? 1 : 0);
+	acpigen_pop_len();
+
 	if (CONFIG(LENOVO_HASWELL_DGPU_RUNTIME_PM)) {
 		acpigen_write_scope("\\_SB.PCI0.PEGP");
 		acpigen_write_name_integer("DGOM",
@@ -116,8 +123,7 @@ static void set_sata_ports(void)
 
 static void mainboard_enable(struct device *dev)
 {
-	if (CONFIG(LENOVO_HASWELL_DGPU_RUNTIME_PM) || CONFIG(BOARD_LENOVO_THINKPAD_W541))
-		dev->ops->acpi_fill_ssdt = mainboard_fill_ssdt;
+	dev->ops->acpi_fill_ssdt = mainboard_fill_ssdt;
 
 	if (CONFIG(BOARD_LENOVO_THINKPAD_W541))
 		set_sata_ports();
diff --git a/src/mainboard/lenovo/haswell/setup_options.h b/src/mainboard/lenovo/haswell/setup_options.h
index dad9173a00..c588dbea2b 100644
--- a/src/mainboard/lenovo/haswell/setup_options.h
+++ b/src/mainboard/lenovo/haswell/setup_options.h
@@ -17,4 +17,14 @@ enum battery_charge_limit {
 	BATTERY_CHARGE_LIMIT_60		= 3,	/* start below 50%, stop at 60% */
 };
 
+/* Values of the macos_panel option: how the framebuffer of macOS drives the panel */
+enum macos_panel {
+	MACOS_PANEL_EXTERNAL	= 0,	/* as a DisplayPort sink, no backlight */
+	MACOS_PANEL_BUILTIN	= 1,	/* as the built-in display: PNLF, ALS0 */
+};
+
+/* The panel of the W541 is on DDI D, where the laptop framebuffers have none */
+#define MACOS_PANEL_DEFAULT	(CONFIG(BOARD_LENOVO_THINKPAD_W541) ? \
+				 MACOS_PANEL_EXTERNAL : MACOS_PANEL_BUILTIN)
+
 #endif /* MAINBOARD_LENOVO_HASWELL_SETUP_OPTIONS_H */
-- 
