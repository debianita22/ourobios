From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Domenico D'Arrigo <d.darrigo@outlook.it>
Date: Thu, 5 Nov 2026 16:30:00 +0100
Subject: [PATCH] mb/lenovo/m720q_m920q: Offer the HAP bit as a third ME
 setting

The ME of the M920x is turned off from the setup with the soft temporary
disable of the CSE driver, through HECI. With it the ME still starts at
every boot and applies its disable at the DRAM Init Done message of
FSP-M, which it answers up to 5 s late on most boots. The HAP bit of the
flash descriptor (bit 16 of PCH strap 0 on descriptor version 2) stops
the ME after its bring-up instead: FSP-M sends it nothing and there is
no wait. The descriptor of these boards grants the host write access to
itself, so the firmware can set and clear the bit.

me_state gets a third value, "Disabled (HAP bit)" (2). hap.c, at the
entry of BS_PRE_DEVICE, reads the descriptor through the SI_DESC area of
the flash map, checks its signature and the place of the PCH straps, and
writes the 4 KiB block only when the bit differs from what me_state
asks: set for 2, clear otherwise. The write is read back and tried three
times; if it does not take, the block of before is written back. The
PCH reads its straps at power-on, so the ME takes the change at the next
start from power off.

The CSE driver sends no HECI message for me_state above 1, and none to
an ME that is neither working nor soft disabled (stopped by the HAP bit,
in recovery), which would not answer and would have it reset waiting.
romstage takes the FSP-M settings of a disabled ME for any value but 0.
The ME page of the setup and SMBIOS say "Disabled (HAP bit)" once the
ME stopped, and when the bit waits for a power cycle.

A power cut during the descriptor write leaves the board unable to
start until the descriptor is written with an external programmer: the
write happens once per change of the setting, about 50 ms.
---
 src/mainboard/lenovo/m720q_m920q/Makefile.mk  |   1 +
 src/mainboard/lenovo/m720q_m920q/cfr.c        |  14 ++-
 src/mainboard/lenovo/m720q_m920q/hap.c        | 102 ++++++++++++++++++
 .../lenovo/m720q_m920q/include/mainboard/me.h |   6 ++
 src/mainboard/lenovo/m720q_m920q/me_status.c  |  21 +++-
 src/mainboard/lenovo/m720q_m920q/romstage.c   |   2 +-
 src/soc/intel/common/block/cse/cse.c          |  20 ++++
 7 files changed, 161 insertions(+), 5 deletions(-)
 create mode 100644 src/mainboard/lenovo/m720q_m920q/hap.c

diff --git a/src/mainboard/lenovo/m720q_m920q/Makefile.mk b/src/mainboard/lenovo/m720q_m920q/Makefile.mk
index 6bfa97378d..a09bb7922d 100644
--- a/src/mainboard/lenovo/m720q_m920q/Makefile.mk
+++ b/src/mainboard/lenovo/m720q_m920q/Makefile.mk
@@ -14,6 +14,7 @@ ramstage-$(CONFIG_DRIVERS_OPTION_CFR) += cfr.c
 ramstage-y += cpu.c
 ramstage-y += ec.c
 ramstage-y += gpio.c
+ramstage-y += hap.c
 ramstage-y += hda_verb.c
 ramstage-y += me_status.c
 ramstage-y += ramstage.c
diff --git a/src/mainboard/lenovo/m720q_m920q/cfr.c b/src/mainboard/lenovo/m720q_m920q/cfr.c
index b2e2a48219..9f288af212 100644
--- a/src/mainboard/lenovo/m720q_m920q/cfr.c
+++ b/src/mainboard/lenovo/m720q_m920q/cfr.c
@@ -697,12 +697,20 @@ static const struct sm_object me_state = SM_DECLARE_ENUM({
 			  "to stay in its disabled state from the next boot: AMT and\n"
 			  "the HECI interface go away. The change takes a few resets,\n"
 			  "which the firmware does by itself.\n"
+			  "Disabled (HAP bit): the firmware sets the HAP bit in the\n"
+			  "flash descriptor at the next boot, and the ME stops after\n"
+			  "its bring-up from the next start from power off: shut\n"
+			  "down, unplug for ten seconds. No HECI, no 5 s wait at\n"
+			  "boot. Another choice clears the bit the same way. The\n"
+			  "firmware writes the descriptor only then: a power cut\n"
+			  "during that write needs an external programmer.\n"
 			  "Default: Enabled.",
 	.default_value	= 0,
 	.values		= (const struct sm_enum_value[]) {
-				{ "Enabled",	0	},
-				{ "Disabled",	1	},
-				SM_ENUM_VALUE_END	},
+				{ "Enabled",		0	},
+				{ "Disabled",		1	},
+				{ "Disabled (HAP bit)",	2	},
+				SM_ENUM_VALUE_END		},
 });
 
 /* The resets the CSE driver counts while the ME changes state */
diff --git a/src/mainboard/lenovo/m720q_m920q/hap.c b/src/mainboard/lenovo/m720q_m920q/hap.c
new file mode 100644
index 0000000000..3c7ed63c27
--- /dev/null
+++ b/src/mainboard/lenovo/m720q_m920q/hap.c
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <bootstate.h>
+#include <commonlib/region.h>
+#include <console/console.h>
+#include <fmap.h>
+#include <intelblocks/fast_spi.h>
+#include <mainboard/me.h>
+#include <option.h>
+#include <string.h>
+#include <types.h>
+
+#define IFD_SIZE		4096
+#define IFD_SIGNATURE		0x0ff0a55a
+#define IFD_FLVALSIG		0x10
+#define IFD_FLMAP1		0x18
+/* Flash descriptor version 2 (Skylake and later): HAP is bit 16 of PCH strap 0 */
+#define PCHSTRP0_HAP		(1u << 16)
+#define IFD_WRITE_TRIES		3
+
+static uint8_t ifd[IFD_SIZE], ifd_new[IFD_SIZE], ifd_check[IFD_SIZE];
+static int hap_state = -1;
+
+int mainboard_me_hap(void)
+{
+	return hap_state;
+}
+
+static bool ifd_write(const struct region_device *rdev, const uint8_t *data)
+{
+	for (int i = 0; i < IFD_WRITE_TRIES; i++) {
+		if (rdev_eraseat(rdev, 0, IFD_SIZE) == IFD_SIZE &&
+		    rdev_writeat(rdev, data, 0, IFD_SIZE) == IFD_SIZE &&
+		    rdev_readat(rdev, ifd_check, 0, IFD_SIZE) == IFD_SIZE &&
+		    !memcmp(ifd_check, data, IFD_SIZE))
+			return true;
+		printk(BIOS_ERR, "HAP: flash descriptor write %d failed\n", i + 1);
+	}
+	return false;
+}
+
+/*
+ * The HAP bit of the flash descriptor as the me_state option asks: set for
+ * "Disabled (HAP bit)" (2), clear otherwise. The descriptor is written only
+ * when the two differ, so only at the first boot after the option changed.
+ * The PCH reads its straps at power-on: the ME changes state at the next
+ * start from power off.
+ */
+static void sync_hap(void *unused)
+{
+	struct region_device rdev;
+	uint32_t sig, flmap1, strap0;
+	size_t fpsba;
+	const bool want = get_uint_option("me_state", 0) == 2;
+
+	if (fast_spi_flash_descriptor_override()) {
+		printk(BIOS_WARNING, "HAP: descriptor override strap set, not touched\n");
+		return;
+	}
+	if (fmap_locate_area_as_rdev_rw("SI_DESC", &rdev) ||
+	    region_device_sz(&rdev) != IFD_SIZE ||
+	    rdev_readat(&rdev, ifd, 0, IFD_SIZE) != IFD_SIZE) {
+		printk(BIOS_ERR, "HAP: flash descriptor not read\n");
+		return;
+	}
+	memcpy(&sig, ifd + IFD_FLVALSIG, sizeof(sig));
+	memcpy(&flmap1, ifd + IFD_FLMAP1, sizeof(flmap1));
+	fpsba = ((flmap1 >> 16) & 0xff) << 4;
+	if (sig != IFD_SIGNATURE || fpsba < IFD_FLMAP1 + 8 || fpsba + sizeof(strap0) > IFD_SIZE ||
+	    !(flmap1 >> 24)) {
+		printk(BIOS_ERR, "HAP: no valid flash descriptor (signature %08x, FLMAP1 %08x)\n",
+		       sig, flmap1);
+		return;
+	}
+	memcpy(&strap0, ifd + fpsba, sizeof(strap0));
+	hap_state = !!(strap0 & PCHSTRP0_HAP);
+	if (hap_state == want) {
+		printk(BIOS_DEBUG, "HAP: %s in the flash descriptor, as me_state asks\n",
+		       hap_state ? "set" : "clear");
+		return;
+	}
+
+	memcpy(ifd_new, ifd, IFD_SIZE);
+	strap0 ^= PCHSTRP0_HAP;
+	memcpy(ifd_new + fpsba, &strap0, sizeof(strap0));
+	printk(BIOS_NOTICE, "HAP: %s the bit in the flash descriptor (PCHSTRP0 %08x)\n",
+	       want ? "setting" : "clearing", strap0);
+	if (ifd_write(&rdev, ifd_new)) {
+		hap_state = want;
+		printk(BIOS_NOTICE, "HAP: written; the ME takes it at the next start from "
+		       "power off\n");
+		return;
+	}
+	/* Leave the descriptor as it was, whatever the failed writes left */
+	if (ifd_write(&rdev, ifd))
+		printk(BIOS_ERR, "HAP: not written, the flash descriptor is as before\n");
+	else
+		printk(BIOS_CRIT, "HAP: the flash descriptor could not be written back: "
+		       "keep the computer on and rewrite it from a backup\n");
+}
+
+BOOT_STATE_INIT_ENTRY(BS_PRE_DEVICE, BS_ON_ENTRY, sync_hap, NULL);
diff --git a/src/mainboard/lenovo/m720q_m920q/include/mainboard/me.h b/src/mainboard/lenovo/m720q_m920q/include/mainboard/me.h
index f3733d9f27..239125c3c1 100644
--- a/src/mainboard/lenovo/m720q_m920q/include/mainboard/me.h
+++ b/src/mainboard/lenovo/m720q_m920q/include/mainboard/me.h
@@ -29,4 +29,10 @@ const char *mainboard_me_summary(void);
 /* The help text of the setup: registers, numbers, requested state */
 const char *mainboard_me_details(void);
 
+/*
+ * The HAP bit of the flash descriptor at this boot, after hap.c made it
+ * follow me_state 2 ("Disabled (HAP bit)"): 1 set, 0 clear, -1 not read
+ */
+int mainboard_me_hap(void);
+
 #endif /* MAINBOARD_ME_H */
diff --git a/src/mainboard/lenovo/m720q_m920q/me_status.c b/src/mainboard/lenovo/m720q_m920q/me_status.c
index 34ca63c4c6..76baa85c36 100644
--- a/src/mainboard/lenovo/m720q_m920q/me_status.c
+++ b/src/mainboard/lenovo/m720q_m920q/me_status.c
@@ -60,6 +60,10 @@ const char *mainboard_me_summary(void)
 	const struct mb_me_status *me = mainboard_me_status();
 	const union me_hfsts1 hfsts1 = { .data = me->hfsts[0] };
 
+	/* Set and taken: the ME stopped after its bring-up */
+	if (mainboard_me_hap() == 1 &&
+	    (!me->valid || hfsts1.fields.working_state != ME_HFS1_CWS_NORMAL))
+		return "Disabled (HAP bit)";
 	if (!me->valid)
 		return "Not available";
 
@@ -111,6 +115,9 @@ const char *mainboard_me_details(void)
 		text_add(text, sizeof(text),
 			 "The firmware could not read the ME at this boot: its HECI\n"
 			 "interface (00:16.0) was off or hidden.\n");
+		if (mainboard_me_hap() == 1)
+			text_add(text, sizeof(text),
+				 "The HAP bit of the flash descriptor is set.\n");
 	} else {
 		text_add(text, sizeof(text),
 			 "The Intel ME at this boot, from its status registers\n"
@@ -128,7 +135,19 @@ const char *mainboard_me_details(void)
 				 "Disabled: HECI (00:16.0) is hidden from the OS, no AMT.\n");
 
 		/* What the CSE driver did not get, as it compares them */
-		if (me->me_state != UINT_MAX && !!me->me_state != disabled) {
+		if (me->me_state == 2) {
+			if (mainboard_me_hap() != 1)
+				text_add(text, sizeof(text),
+					 "Requested: Disabled (HAP bit), but the bit is not set\n"
+					 "in the flash descriptor (the boot log says why).\n");
+			else if (hfsts1.fields.working_state == ME_HFS1_CWS_NORMAL)
+				text_add(text, sizeof(text),
+					 "The HAP bit is set: the ME stops at the next start\n"
+					 "from power off (shut down, unplug for ten seconds).\n");
+			else
+				text_add(text, sizeof(text),
+					 "Stopped by the HAP bit of the flash descriptor.\n");
+		} else if (me->me_state != UINT_MAX && !!me->me_state != disabled) {
 			text_add(text, sizeof(text),
 				 "Requested in Security > Management Engine: %s.\n",
 				 me->me_state ? "Disabled" : "Enabled");
diff --git a/src/mainboard/lenovo/m720q_m920q/romstage.c b/src/mainboard/lenovo/m720q_m920q/romstage.c
index 75aab61e7d..b2ffa7193f 100644
--- a/src/mainboard/lenovo/m720q_m920q/romstage.c
+++ b/src/mainboard/lenovo/m720q_m920q/romstage.c
@@ -144,7 +144,7 @@ void mainboard_memory_init_params(FSPM_UPD *memupd)
 	const uint32_t hfsts1 = me_read_config32(PCI_ME_HFSTS1);
 	printk(BIOS_INFO, "ME: HFSTS1 before FSP-M: %08x\n", hfsts1);
 	/* cse_is_me_state_requested_enabled() is ramstage only (true elsewhere) */
-	if (get_uint_option("me_state", 0) == 1 || cse_is_hfs1_com_soft_temp_disable()) {
+	if (get_uint_option("me_state", 0) != 0 || cse_is_hfs1_com_soft_temp_disable()) {
 		memupd->FspmTestConfig.DisableHeciRetry = 1;
 		memupd->FspmTestConfig.SkipMbpHob = 1;
 		printk(BIOS_INFO, "ME disabled: no HECI retries or MBP read in FSP-M\n");
diff --git a/src/soc/intel/common/block/cse/cse.c b/src/soc/intel/common/block/cse/cse.c
index 324c44ff2b..b47b513fb9 100644
--- a/src/soc/intel/common/block/cse/cse.c
+++ b/src/soc/intel/common/block/cse/cse.c
@@ -1419,6 +1419,26 @@ static void cse_set_state(struct device *dev)
 
 	printk(BIOS_DEBUG, "CMOS: me_state = %u\n", cmos_me_state);
 
+	/*
+	 * Above 1 the board keeps the ME off another way, such as the HAP bit of
+	 * the flash descriptor: no message for it.
+	 */
+	if (cmos_me_state > 1) {
+		printk(BIOS_DEBUG, "ME: kept off by the board (me_state %u), nothing sent.\n",
+		       cmos_me_state);
+		return;
+	}
+
+	/*
+	 * An ME neither working nor soft disabled (stopped by the HAP bit, in
+	 * recovery) would not answer: no message, no resets waiting for it.
+	 */
+	if (!cse_is_hfs1_cws_normal() && !cse_is_hfs1_com_soft_temp_disable()) {
+		printk(BIOS_DEBUG, "ME: not running (HFSTS1 %08x), nothing sent.\n",
+		       me_read_config32(PCI_ME_HFSTS1));
+		return;
+	}
+
 	/*
 	 * We only take action if the me_state doesn't match the CS(ME) working state
 	 */
-- 
2.43.0

