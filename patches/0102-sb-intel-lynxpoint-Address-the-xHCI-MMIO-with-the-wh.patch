From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Domenico D'Arrigo <d.darrigo@outlook.it>
Date: Sun, 25 Oct 2026 19:51:00 +0100
Subject: [PATCH] sb/intel/lynxpoint: Address the xHCI MMIO with the whole
 64-bit BAR

_PS0, _PS3 and, on Lynx Point-LP, LPCL and LPS0 build the MMIO address
of the xHCI controller from XMEM, bits 31:16 of its BAR. The BAR is a
64-bit one: an OS that puts it above 4 GiB, as macOS can when it
reassigns PCI resources, gets an address in the low 4 GiB, or, with the
low dword zero, _PS0 and _PS3 that return without doing their work.

Read the BAR as the 64-bit field it is and use bits 63:4, in XMMB,
which returns 0 when there is no BAR (all ones, the controller gone, or
0), the case in which _PS0 and _PS3 returned early before.

TEST=Built lenovo/w541 with mrc.bin and with the native RAM init. In
acpiexec, with the BAR at 0x7FB0000000: _PS3 clears and _PS0 sets bit 31
of the dword at BAR + 0x8154 and leave the one at 0xB0008154 alone,
which _PS3 cleared before this change; with the BAR 0 or all ones they
return early. The DSDTs of lenovo/t440p, asrock/b85m_pro4 and
google/monroe (Lynx Point-LP: LPCL, LPS0) build too.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018n3yuWwDLW63F4vdf7ZFTv
---
 src/southbridge/intel/lynxpoint/acpi/xhci.asl | 30 ++++++++++++++-----
 1 file changed, 22 insertions(+), 8 deletions(-)

diff --git a/src/southbridge/intel/lynxpoint/acpi/xhci.asl b/src/southbridge/intel/lynxpoint/acpi/xhci.asl
index 5c5c6144d2..5a9fc3af62 100644
--- a/src/southbridge/intel/lynxpoint/acpi/xhci.asl
+++ b/src/southbridge/intel/lynxpoint/acpi/xhci.asl
@@ -11,8 +11,7 @@ Device (XHCI)
 	{
 		DVID, 16,
 		Offset (0x10),
-		, 16,
-		XMEM, 16, // MEM_BASE
+		XBAR, 64, // MEM_BASE, a 64-bit BAR
 		Offset (0x40),
 		, 11,
 		SWAI, 1,
@@ -38,11 +37,24 @@ Device (XHCI)
 		PR3M, 32,  // USB3PRM
 	}
 
+	/*
+	 * The MMIO base in the BAR as it is now, all 64 bits of it, 0 without
+	 * one: the OS may have put the BAR above 4 GiB.
+	 */
+	Method (XMMB, 0, NotSerialized)
+	{
+		Local0 = ^XBAR & 0xfffffffffffffff0
+		If (Local0 == 0xfffffffffffffff0) {
+			Local0 = 0
+		}
+		Return (Local0)
+	}
+
 #if CONFIG(INTEL_LYNXPOINT_LP)
 	// Clear status bits
 	Method (LPCL, 0, Serialized)
 	{
-		OperationRegion (XREG, SystemMemory, ^XMEM << 16, 0x600)
+		OperationRegion (XREG, SystemMemory, ^XMMB (), 0x600)
 		Field (XREG, DWordAcc, Lock, Preserve)
 		{
 			Offset (0x510), // PORTSCNUSB3[0]
@@ -77,7 +89,7 @@ Device (XHCI)
 
 	Method (LPS0, 0, Serialized)
 	{
-		OperationRegion (XREG, SystemMemory, ^XMEM << 16, 0x600)
+		OperationRegion (XREG, SystemMemory, ^XMMB (), 0x600)
 		Field (XREG, DWordAcc, Lock, Preserve)
 		{
 			Offset (0x510), // PORTSCNUSB3
@@ -194,11 +206,12 @@ Device (XHCI)
 		If (^DVID == 0xFFFF) {
 			Return ()
 		}
-		If (^XMEM == 0xFFFF || ^XMEM == 0) {
+		Local1 = ^XMMB ()
+		If (Local1 == 0) {
 			Return ()
 		}
 
-		OperationRegion (XREG, SystemMemory, (^XMEM << 16) + 0x8000, 0x200)
+		OperationRegion (XREG, SystemMemory, Local1 + 0x8000, 0x200)
 		Field (XREG, DWordAcc, Lock, Preserve)
 		{
 			Offset (0x0e0), // AUX Reset Control 1
@@ -264,11 +277,12 @@ Device (XHCI)
 		If (^DVID == 0xFFFF) {
 			Return ()
 		}
-		If (^XMEM == 0xFFFF || ^XMEM == 0) {
+		Local1 = ^XMMB ()
+		If (Local1 == 0) {
 			Return ()
 		}
 
-		OperationRegion (XREG, SystemMemory, (^XMEM << 16) + 0x8000, 0x200)
+		OperationRegion (XREG, SystemMemory, Local1 + 0x8000, 0x200)
 		Field (XREG, DWordAcc, Lock, Preserve)
 		{
 			Offset (0x0e0), // AUX Reset Control 1
-- 
