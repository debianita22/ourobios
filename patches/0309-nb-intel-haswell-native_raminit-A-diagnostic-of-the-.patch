From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Domenico D'Arrigo <d.darrigo@outlook.it>
Date: Fri, 13 Nov 2026 13:43:40 +0100
Subject: [PATCH] nb/intel/haswell/native_raminit: A diagnostic of the margins
 after power-up

Not for a release. On a ThinkPad W541 a training right after a power
cycle reset or a boot from S5 has the read margins of channel 1
narrower than one after a warm reset (7 of 7 against 12 of 12).

HASWELL_NRI_POWERUP_DIAG: in every boot that trains, measure the
margins again after 3 s and after a ZQ calibration of the DIMMs, then
train a second time with the optimisations, and log the four sets
together at the end.

Co-Authored-By: Claude <noreply@anthropic.com>
Change-Id: I2bda9178ea7cbd30faa5861701181fe7f14e9128
---
 src/northbridge/intel/haswell/Kconfig         |   9 ++
 .../intel/haswell/native_raminit/Makefile.mk  |   1 +
 .../intel/haswell/native_raminit/init_mpll.c  |   4 +-
 .../haswell/native_raminit/raminit_main.c     |   5 +-
 .../haswell/native_raminit/raminit_native.c   |   3 +
 .../haswell/native_raminit/raminit_native.h   |   3 +
 .../native_raminit/train_powerup_diag.c       | 153 ++++++++++++++++++
 7 files changed, 176 insertions(+), 2 deletions(-)
 create mode 100644 src/northbridge/intel/haswell/native_raminit/train_powerup_diag.c

diff --git a/src/northbridge/intel/haswell/Kconfig b/src/northbridge/intel/haswell/Kconfig
index a82f22f675..1b59edab4a 100644
--- a/src/northbridge/intel/haswell/Kconfig
+++ b/src/northbridge/intel/haswell/Kconfig
@@ -99,6 +99,15 @@ config HASWELL_NRI_READ_VREF
 	  read timings, all the ranks tested at once, as the MRC does. Not
 	  run in the training that is done again after a failure.
 
+config HASWELL_NRI_POWERUP_DIAG
+	bool "Diagnostic: margins again after a wait, a ZQ calibration, a second training"
+	depends on HASWELL_NRI_MARGIN_CHECK
+	help
+	  Not for a release. Every boot that trains measures the margins
+	  again after 3 s and after a ZQ calibration, then trains a second
+	  time and logs the four sets, to tell why a training right after
+	  power-up has narrower read margins.
+
 config HASWELL_NRI_TURNAROUND
 	bool "Shorten the write to read turnaround between ranks as the MRC does"
 	depends on USE_NATIVE_RAMINIT
diff --git a/src/northbridge/intel/haswell/native_raminit/Makefile.mk b/src/northbridge/intel/haswell/native_raminit/Makefile.mk
index 3a5f08221b..22230b2c7d 100644
--- a/src/northbridge/intel/haswell/native_raminit/Makefile.mk
+++ b/src/northbridge/intel/haswell/native_raminit/Makefile.mk
@@ -30,6 +30,7 @@ romstage-y += train_2d_margins.c
 romstage-y += train_jedec_write_leveling.c
 romstage-y += train_late_command.c
 romstage-y += train_opt_param.c
+romstage-y += train_powerup_diag.c
 romstage-y += train_read_mpr.c
 romstage-y += train_read_vref.c
 romstage-y += train_receive_enable.c
diff --git a/src/northbridge/intel/haswell/native_raminit/init_mpll.c b/src/northbridge/intel/haswell/native_raminit/init_mpll.c
index bfaf46a1c8..5bff124e6a 100644
--- a/src/northbridge/intel/haswell/native_raminit/init_mpll.c
+++ b/src/northbridge/intel/haswell/native_raminit/init_mpll.c
@@ -337,8 +337,10 @@ enum nri_status initialise_mpll(struct sysinfo *ctrl)
 		/* Verify locked frequency */
 		const uint32_t mc_bios_data = mchbar_read32(MC_BIOS_DATA);
 		printk(RAM_DEBUG, "MC_BIOS_DATA = 0x%08x\n", mc_bios_data);
-		if ((mc_bios_data & 0xf) >= ctrl->multiplier)
+		if ((mc_bios_data & 0xf) >= ctrl->multiplier) {
+			powerup_diag_knob(2);
 			break;
+		}
 
 		printk(BIOS_DEBUG, "Retrying at a lower frequency\n\n");
 		ctrl->tCK++;
diff --git a/src/northbridge/intel/haswell/native_raminit/raminit_main.c b/src/northbridge/intel/haswell/native_raminit/raminit_main.c
index abf696ee1a..8e9cf7a87c 100644
--- a/src/northbridge/intel/haswell/native_raminit/raminit_main.c
+++ b/src/northbridge/intel/haswell/native_raminit/raminit_main.c
@@ -143,6 +143,7 @@ static const struct task_entry cold_boot[] = {
 	{ optimise_round_trip,                                    true, "RTL",        },
 	{ optimise_turnaround,                                    true, "TAT",        },
 	{ retrain_margin_check,                                   true, "RMC",        },
+	{ powerup_diag,                                           true, "PWRDIAG",    },
 	{ print_nri_summary,                                      true, "SUMMARY",    },
 	{ activate_mc,                                            true, "ACTIVATE",   },
 	{ save_training_values,                                   true, "SAVE_TRAIN", },
@@ -333,9 +334,11 @@ void raminit_main(const enum raminit_boot_mode bootmode)
 		if (attempt) {
 			printk(BIOS_WARNING, "Memory training failed (%u), trying again\n",
 			       status);
+			const bool diag = CONFIG(HASWELL_NRI_POWERUP_DIAG) &&
+					  status == NRI_STATUS_RETRAIN_REQUIRED;
 			initialize_ctrl(&mighty_ctrl);
 			/* As trained: the optimisations are the first suspects */
-			mighty_ctrl.no_latency_optimisation = true;
+			mighty_ctrl.no_latency_optimisation = !diag;
 		}
 		mighty_ctrl.summary_len = 0;
 		mighty_ctrl.summary[0] = '\0';
diff --git a/src/northbridge/intel/haswell/native_raminit/raminit_native.c b/src/northbridge/intel/haswell/native_raminit/raminit_native.c
index 63f6e942dd..21697960c3 100644
--- a/src/northbridge/intel/haswell/native_raminit/raminit_native.c
+++ b/src/northbridge/intel/haswell/native_raminit/raminit_native.c
@@ -176,6 +176,8 @@ void perform_raminit(const bool s3resume)
 	 */
 	const enum raminit_boot_mode orig_bootmode = get_boot_mode();
 
+	powerup_diag_knob(1);
+
 	/* Before the saved training is looked up: its version has the profile */
 	nri_memory_profile_init(s3resume);
 
@@ -223,6 +225,7 @@ void perform_raminit(const bool s3resume)
 	}
 
 	report_ignored_dimms();
+	powerup_diag_save();
 	if (bootmode == BOOTMODE_COLD)
 		nri_memory_profile_report();
 
diff --git a/src/northbridge/intel/haswell/native_raminit/raminit_native.h b/src/northbridge/intel/haswell/native_raminit/raminit_native.h
index 8e5cde1f0e..348d1a5a50 100644
--- a/src/northbridge/intel/haswell/native_raminit/raminit_native.h
+++ b/src/northbridge/intel/haswell/native_raminit/raminit_native.h
@@ -755,6 +755,9 @@ enum nri_status train_read_vref(struct sysinfo *ctrl);
 enum nri_status train_read_opt_params(struct sysinfo *ctrl);
 enum nri_status train_write_opt_params(struct sysinfo *ctrl);
 enum nri_status print_nri_summary(struct sysinfo *ctrl);
+enum nri_status powerup_diag(struct sysinfo *ctrl);
+void powerup_diag_save(void);
+void powerup_diag_knob(uint8_t where);
 void nri_note(struct sysinfo *ctrl, const char *fmt, ...) __printf(2, 3);
 enum nri_status alias_check(struct sysinfo *ctrl);
 enum nri_status raminit_done(struct sysinfo *ctrl);
diff --git a/src/northbridge/intel/haswell/native_raminit/train_powerup_diag.c b/src/northbridge/intel/haswell/native_raminit/train_powerup_diag.c
new file mode 100644
index 0000000000..4e2cc10a30
--- /dev/null
+++ b/src/northbridge/intel/haswell/native_raminit/train_powerup_diag.c
@@ -0,0 +1,153 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <cbmem.h>
+#include <commonlib/bsd/helpers.h>
+#include <console/console.h>
+#include <arch/io.h>
+#include <cf9_reset.h>
+#include <delay.h>
+#include <northbridge/intel/haswell/haswell.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <types.h>
+
+#include "raminit_native.h"
+
+/*
+ * A diagnostic, not for a release: on a ThinkPad W541 a training right after
+ * the memory and the processor got their power (a power cycle reset, a boot
+ * from S5) has the read margins of channel 1 narrower than one after a warm
+ * reset, every time. To tell what is narrow, in one boot:
+ *   M1  the margins after the training (the margin check before this step);
+ *   M2  again after 3 s, nothing changed: does time alone widen them?
+ *   M3  again after a ZQ calibration of the DIMMs;
+ *   M4  after a second training in the same boot, with the optimisations:
+ *       this step fails the first pass, and raminit_main() trains again.
+ * The lines are kept here and logged at the end, where the console keeps them.
+
+ *   M5  after the periodic compensation is turned on, as activate_mc() does
+ *       (the register survives a warm reset).
+ * And a copy of MCHBAR 0 to 0x5fff as it is after the first training, kept
+ * for the OS in CBMEM (cbmem -r 4e524944), to compare a boot after power-up
+ * with one after a warm reset.
+ */
+#define DIAG_CBMEM_ID	0x4e524944	/* "NRID" */
+#define DIAG_MCHBAR_END	0x6000
+
+static uint32_t diag_mchbar[DIAG_MCHBAR_END / 4];
+static bool diag_have_mchbar;
+
+void powerup_diag_save(void)
+{
+	if (!CONFIG(HASWELL_NRI_POWERUP_DIAG) || !diag_have_mchbar)
+		return;
+
+	void *dst = cbmem_add(DIAG_CBMEM_ID, sizeof(diag_mchbar));
+	if (dst)
+		memcpy(dst, diag_mchbar, sizeof(diag_mchbar));
+}
+
+/*
+ * A knob for the OS, one shot: byte 0xf0 of the extended CMOS bank (ports
+ * 0x72/0x73), which nothing uses. 1: a warm reset before anything of the RAM
+ * init; 2: a warm reset right after the MPLL locked. Cleared before the
+ * reset, and no reset if it does not read back clear.
+ */
+#define DIAG_KNOB	0xf0
+
+static uint8_t knob_read(void)
+{
+	outb(DIAG_KNOB, 0x72);
+	return inb(0x73);
+}
+
+static uint8_t diag_mpll_at_entry = 0xff;
+static uint8_t diag_knob_seen;
+
+void powerup_diag_knob(const uint8_t where)
+{
+	if (!CONFIG(HASWELL_NRI_POWERUP_DIAG))
+		return;
+
+	if (where == 1 && diag_mpll_at_entry == 0xff)
+		diag_mpll_at_entry = mchbar_read32(MC_BIOS_DATA) & 0xf;
+
+	const uint8_t knob = knob_read();
+	if (where == 1)
+		diag_knob_seen = knob;
+
+	if (knob != where)
+		return;
+
+	outb(DIAG_KNOB, 0x72);
+	outb(0, 0x73);
+	if (knob_read() != 0)
+		return;
+
+	printk(BIOS_NOTICE, "NRI power-up diagnostic: warm reset at point %u\n", where);
+	system_reset();
+}
+
+static char diag_log[3072];
+static size_t diag_len;
+static uint8_t diag_pass;
+
+static void diag_note(const char *fmt, ...) __printf(1, 2);
+static void diag_note(const char *fmt, ...)
+{
+	const size_t room = sizeof(diag_log) - diag_len;
+	if (room < 2)
+		return;
+
+	va_list args;
+	va_start(args, fmt);
+	const int len = vsnprintf(diag_log + diag_len, room, fmt, args);
+	va_end(args);
+	if (len > 0)
+		diag_len += MIN((size_t)len, room - 1);
+}
+
+static void note_margins(struct sysinfo *ctrl, const char *tag)
+{
+	const uint8_t rdt = get_margin_result_type(RdT);
+	const uint8_t rdv = get_margin_result_type(RdV);
+	const uint8_t wrv = get_margin_result_type(WrV);
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+		diag_note("  %s C%u RdT/RdV/WrV:", tag, channel);
+		for (uint8_t rank = 0; rank < NUM_SLOTRANKS; rank++) {
+			if (!rank_in_ch(ctrl, rank, channel))
+				continue;
+
+			const union last_margin *t = &ctrl->results[rdt][rank][channel][0];
+			const union last_margin *v = &ctrl->results[rdv][rank][channel][0];
+			const union last_margin *w = &ctrl->results[wrv][rank][channel][0];
+			diag_note(" %u-%u,%u-%u,%u-%u", t->m[0] / 10, t->m[1] / 10,
+				  v->m[0] / 10, v->m[1] / 10, w->m[0] / 10, w->m[1] / 10);
+		}
+		diag_note("\n");
+	}
+}
+
+enum nri_status powerup_diag(struct sysinfo *ctrl)
+{
+	if (!CONFIG(HASWELL_NRI_POWERUP_DIAG) || !CONFIG(HASWELL_NRI_MARGIN_CHECK))
+		return NRI_STATUS_SUCCESS;
+
+	if (diag_pass++) {
+		note_margins(ctrl, "M4 second training");
+		printk(BIOS_INFO, "NRI power-up diagnostic:\n%s", diag_log);
+		return NRI_STATUS_SUCCESS;
+	}
+
+	diag_note("  MPLL multiplier locked at entry: %u (0: not locked), knob seen %u\n",
+		  diag_mpll_at_entry, diag_knob_seen);
+	note_margins(ctrl, "M1 first training");
+	for (size_t i = 0; i < ARRAY_SIZE(diag_mchbar); i++)
+		diag_mchbar[i] = mchbar_read32(i * 4);
+
+	diag_have_mchbar = true;
+
+	printk(BIOS_INFO, "NRI power-up diagnostic: training again in this boot\n");
+	return NRI_STATUS_RETRAIN_REQUIRED;
+}
