@@ -143,6 +143,7 @@ static const struct task_entry cold_boot[] = {
 	{ optimise_round_trip,                                    true, "RTL",        },
 	{ optimise_turnaround,                                    true, "TAT",        },
 	{ retrain_margin_check,                                   true, "RMC",        },
