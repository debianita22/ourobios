diff --git a/src/northbridge/intel/haswell/Kconfig b/src/northbridge/intel/haswell/Kconfig
index a82f22f675..1b59edab4a 100644
--- a/src/northbridge/intel/haswell/Kconfig
+++ b/src/northbridge/intel/haswell/Kconfig
@@ -99,6 +99,15 @@ config HASWELL_NRI_READ_VREF
 	  read timings, all the ranks tested at once, as the MRC does. Not
 	  run in the training that is done again after a failure.
 
+config HASWELL_NRI_POWERUP_DIAG
+	bool "Diagnostic: margins again after a wait, a ZQ calibration, a second training"
+	depends on HASWELL_NRI_MARGIN_CHECK
+	help
+	  Not for a release. Every boot that trains measures the margins
+	  again after 3 s and after a ZQ calibration, then trains a second
+	  time and logs the four sets, to tell why a training right after
+	  power-up has narrower read margins.
+
 config HASWELL_NRI_TURNAROUND
 	bool "Shorten the write to read turnaround between ranks as the MRC does"
 	depends on USE_NATIVE_RAMINIT
