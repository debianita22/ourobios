diff --git a/src/northbridge/intel/haswell/native_raminit/train_powerup_diag.c b/src/northbridge/intel/haswell/native_raminit/train_powerup_diag.c
new file mode 100644
index 0000000000..af5bb7278a
--- /dev/null
+++ b/src/northbridge/intel/haswell/native_raminit/train_powerup_diag.c
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <cbmem.h>
+#include <commonlib/bsd/helpers.h>
+#include <console/console.h>
+#include <delay.h>
+#include <northbridge/intel/haswell/haswell.h>
+#include <northbridge/intel/haswell/raminit.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <types.h>
+
+#include "raminit_native.h"
+
+/*
+ * A diagnostic, not for a release: on a ThinkPad W541 a training right after
+ * the memory and the processor got their power (a power cycle reset, a boot
+ * from S5) has the read margins of channel 1 narrower than one after a warm
+ * reset, every time. To tell what is narrow, in one boot:
+ *   M1  the margins after the training (the margin check before this step);
+ *   M2  again after 3 s, nothing changed: does time alone widen them?
+ *   M3  again after a ZQ calibration of the DIMMs;
+ *   M4  after a second training in the same boot, with the optimisations:
+ *       this step fails the first pass, and raminit_main() trains again.
+ * The lines are kept here and logged at the end, where the console keeps them.
+
+ *   M5  after the periodic compensation is turned on, as activate_mc() does
+ *       (the register survives a warm reset).
+ * And a copy of MCHBAR 0 to 0x5fff as it is after the first training, kept
+ * for the OS in CBMEM (cbmem -r 4e524944), to compare a boot after power-up
+ * with one after a warm reset.
+ */
+#define DIAG_CBMEM_ID	0x4e524944	/* "NRID" */
+#define DIAG_MCHBAR_END	0x6000
+
+static uint32_t diag_mchbar[DIAG_MCHBAR_END / 4];
+static bool diag_have_mchbar;
+
+void powerup_diag_save(void)
+{
+	if (!CONFIG(HASWELL_NRI_POWERUP_DIAG) || !diag_have_mchbar)
+		return;
+
+	void *dst = cbmem_add(DIAG_CBMEM_ID, sizeof(diag_mchbar));
+	if (dst)
+		memcpy(dst, diag_mchbar, sizeof(diag_mchbar));
+}
+
+static uint8_t diag_knob_seen;
+
+void powerup_diag_note_knob(void)
+{
+	diag_knob_seen = powerup_diag_knob_value();
+}
+
+static char diag_log[3072];
+static size_t diag_len;
+
+static void diag_note(const char *fmt, ...) __printf(1, 2);
+static void diag_note(const char *fmt, ...)
+{
+	const size_t room = sizeof(diag_log) - diag_len;
+	if (room < 2)
+		return;
+
+	va_list args;
+	va_start(args, fmt);
+	const int len = vsnprintf(diag_log + diag_len, room, fmt, args);
+	va_end(args);
+	if (len > 0)
+		diag_len += MIN((size_t)len, room - 1);
+}
+
+static void note_margins(struct sysinfo *ctrl, const char *tag)
+{
+	const uint8_t rdt = get_margin_result_type(RdT);
+	const uint8_t rdv = get_margin_result_type(RdV);
+	const uint8_t wrv = get_margin_result_type(WrV);
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+		diag_note("  %s C%u RdT/RdV/WrV:", tag, channel);
+		for (uint8_t rank = 0; rank < NUM_SLOTRANKS; rank++) {
+			if (!rank_in_ch(ctrl, rank, channel))
+				continue;
+
+			const union last_margin *t = &ctrl->results[rdt][rank][channel][0];
+			const union last_margin *v = &ctrl->results[rdv][rank][channel][0];
+			const union last_margin *w = &ctrl->results[wrv][rank][channel][0];
+			diag_note(" %u-%u,%u-%u,%u-%u", t->m[0] / 10, t->m[1] / 10,
+				  v->m[0] / 10, v->m[1] / 10, w->m[0] / 10, w->m[1] / 10);
+		}
+		diag_note("\n");
+	}
+}
+
+enum nri_status powerup_diag(struct sysinfo *ctrl)
+{
+	if (!CONFIG(HASWELL_NRI_POWERUP_DIAG) || !CONFIG(HASWELL_NRI_MARGIN_CHECK))
+		return NRI_STATUS_SUCCESS;
+
+	diag_len = 0;
+	diag_note("  knobs at entry (reset<<4 | train): 0x%02x\n", diag_knob_seen);
+	note_margins(ctrl, "M1");
+	printk(BIOS_INFO, "NRI power-up diagnostic:\n%s", diag_log);
+	for (size_t i = 0; i < ARRAY_SIZE(diag_mchbar); i++)
+		diag_mchbar[i] = mchbar_read32(i * 4);
+
+	diag_have_mchbar = true;
+	return NRI_STATUS_SUCCESS;
+}
diff --git a/src/northbridge/intel/haswell/powerup_diag.c b/src/northbridge/intel/haswell/powerup_diag.c
new file mode 100644
index 0000000000..037fa2cca9
--- /dev/null
+++ b/src/northbridge/intel/haswell/powerup_diag.c
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <arch/io.h>
+#include <bootstate.h>
+#include <cf9_reset.h>
+#include <console/console.h>
+#include <delay.h>
+#include <northbridge/intel/haswell/raminit.h>
+#include <pc80/mc146818rtc.h>
+#include <post.h>
+#include <types.h>
+
+/*
+ * A diagnostic, not for a release. Knobs for the OS in the extended CMOS
+ * bank (ports 0x72/0x73), which nothing uses:
+ *   0xf0  one shot: a warm reset at a point of the boot.
+ *         1 before the RAM init, 2 after the MPLL lock, 3 at the end of the
+ *         RAM init (romstage), 4 at the end of ramstage, before the payload.
+ *   0xf1  one shot, taken only once 0xf0 is clear: train in this boot, the
+ *         saved training left aside.
+ * So: after a power-up, the boot runs to the point and resets warm, and the
+ * boot after trains: which part of a boot makes the training after it wide?
+ */
+#define KNOB_RESET	0xf0
+#define KNOB_TRAIN	0xf1
+
+static uint8_t ext_read(const uint8_t index)
+{
+	outb(index, 0x72);
+	return inb(0x73);
+}
+
+static void ext_write(const uint8_t index, const uint8_t value)
+{
+	outb(index, 0x72);
+	outb(value, 0x73);
+}
+
+uint8_t powerup_diag_knob_value(void)
+{
+	return ext_read(KNOB_RESET) << 4 | (ext_read(KNOB_TRAIN) & 0xf);
+}
+
+void powerup_diag_knob(const uint8_t where)
+{
+	if (ext_read(KNOB_RESET) != where)
+		return;
+
+	ext_write(KNOB_RESET, 0);
+	if (ext_read(KNOB_RESET) != 0)
+		return;
+
+	printk(BIOS_NOTICE, "NRI power-up diagnostic: warm reset at point %u\n", where);
+	/* A reset the firmware asked for */
+	if (CONFIG(CMOS_POST)) {
+		cmos_post_extra(0x44494147);	/* "DIAG" */
+		cmos_post_code(POSTCODE_RESET_REQUESTED);
+	}
+	mdelay(30);
+	system_reset();
+}
+
+bool powerup_diag_force_training(void)
+{
+	if (ext_read(KNOB_RESET) != 0 || ext_read(KNOB_TRAIN) != 1)
+		return false;
+
+	ext_write(KNOB_TRAIN, 0);
+	printk(BIOS_NOTICE, "NRI power-up diagnostic: training asked for\n");
+	return true;
+}
+
+#if ENV_RAMSTAGE
+static void reset_before_payload(void *unused)
+{
+	powerup_diag_knob(4);
+}
+BOOT_STATE_INIT_ENTRY(BS_PAYLOAD_LOAD, BS_ON_ENTRY, reset_before_payload, NULL);
+#endif
diff --git a/src/northbridge/intel/haswell/raminit.h b/src/northbridge/intel/haswell/raminit.h
index b1f30909e3..a56a859ecf 100644
--- a/src/northbridge/intel/haswell/raminit.h
+++ b/src/northbridge/intel/haswell/raminit.h
@@ -25,4 +25,15 @@ void setup_sdram_meminfo(const uint8_t *spd_data[NUM_CHANNELS][NUM_SLOTS]);
 
 void perform_raminit(const bool s3resume);
 
+/* powerup_diag.c: a diagnostic, not for a release */
+#if CONFIG(HASWELL_NRI_POWERUP_DIAG)
+void powerup_diag_knob(uint8_t where);
+bool powerup_diag_force_training(void);
+uint8_t powerup_diag_knob_value(void);
+#else
+static inline void powerup_diag_knob(uint8_t where) {}
+static inline bool powerup_diag_force_training(void) { return false; }
+static inline uint8_t powerup_diag_knob_value(void) { return 0; }
+#endif
+
 #endif	/* NORTHBRIDGE_INTEL_HASWELL_RAMINIT_H */
