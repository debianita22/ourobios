 src/mainboard/lenovo/m720q_m920q/cfr.c        |  17 ++
 .../lenovo/m720q_m920q/include/mainboard/me.h |  32 ++++
 src/mainboard/lenovo/m720q_m920q/me_status.c  | 148 ++++++++++++++++++
 src/mainboard/lenovo/m720q_m920q/ramstage.c   |  25 +++
 5 files changed, 223 insertions(+)
 create mode 100644 src/mainboard/lenovo/m720q_m920q/include/mainboard/me.h
 create mode 100644 src/mainboard/lenovo/m720q_m920q/me_status.c

