+/*
+ * The termination of the DIMMs as this code always set it, until the DIMM ODT
+ * step trains it or a fast boot restores what a training chose.
+ */
+void ddr3_default_rtt(struct sysinfo *ctrl)
+{
+	if (ctrl->rtt_set)
+		return;
+
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+		ctrl->rtt_nom[channel] = ctrl->dpc[channel] == 2 ? 60 : 0;
+		ctrl->rtt_wr[channel] = is_hsw_ult() ? 120 : 60;
+	}
+	ctrl->rtt_set = true;
+}
+
 static void ddr3_program_mr1(struct sysinfo *ctrl)
 {
 	union ddr3_mr_1 mr1reg = {
@@ -96,7 +112,8 @@ static void ddr3_program_mr1(struct sysinfo *ctrl)
 		if (!does_ch_exist(ctrl, channel))
 			continue;
 
-		ddr3_update_rtt_nom(&mr1reg.raw, ctrl->dpc[channel] == 2 ? 60 : 0);
+		ddr3_default_rtt(ctrl);
+		ddr3_update_rtt_nom(&mr1reg.raw, ctrl->rtt_nom[channel]);
 		for (uint8_t rank = 0; rank < NUM_SLOTRANKS; rank++) {
 			if (!rank_in_ch(ctrl, rank, channel))
 				continue;
@@ -119,11 +136,13 @@ static void ddr3_program_mr2(struct sysinfo *ctrl)
 		.auto_self_refresh = ctrl->flags.asr,
 		.self_refresh_temp = dimm_srt,
 	};
-	ddr3_update_rtt_wr(&mr2reg.raw, is_hsw_ult() ? 120 : 60);
+	ddr3_default_rtt(ctrl);
 	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
 		if (!does_ch_exist(ctrl, channel))
 			continue;
 
+		ddr3_update_rtt_wr(&mr2reg.raw, ctrl->rtt_wr[channel]);
+
 		for (uint8_t rank = 0; rank < NUM_SLOTRANKS; rank++) {
 			if (!rank_in_ch(ctrl, rank, channel))
 				continue;
