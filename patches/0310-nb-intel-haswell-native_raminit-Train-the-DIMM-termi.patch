diff --git a/src/northbridge/intel/haswell/Kconfig b/src/northbridge/intel/haswell/Kconfig
index a82f22f675..42ddd6462a 100644
--- a/src/northbridge/intel/haswell/Kconfig
+++ b/src/northbridge/intel/haswell/Kconfig
@@ -81,13 +81,15 @@ config HASWELL_NRI_OPT_PARAMS
 	bool "Train the drive, equalisation, termination and bias per byte"
 	depends on USE_NATIVE_RAMINIT
 	help
-	  After the 1D centring, try for every byte several values of the
-	  write drive strength and equalisation and of the read termination
-	  and receiver bias, measure the write or the read margins at each
-	  with the margin library, and keep for each byte the one with the
-	  widest eye, as the MRC does (without weighing the power). It adds
-	  a few seconds to a boot that trains. Not run in the training that
-	  is done again after a failure.
+	  After the 1D centring, try the termination of the DIMMs (RTT_NOM,
+	  RTT_WR) for every channel and, for every byte, several values of
+	  the write drive strength and equalisation and of the read
+	  termination and receiver bias; after the round trip step, the
+	  read ODT window of every byte. Measure the margins at each with
+	  the margin library and keep the widest eye, as the MRC does (the
+	  ODT window: the least power within a step of it). It adds a few
+	  seconds to a boot that trains. Not run in the training that is
+	  done again after a failure.
 
 config HASWELL_NRI_READ_VREF
 	bool "Centre the read Vref per bit and per byte as the MRC does"
diff --git a/src/northbridge/intel/haswell/native_raminit/ddr3.c b/src/northbridge/intel/haswell/native_raminit/ddr3.c
index b8cc0e3a67..36e6e01d2c 100644
--- a/src/northbridge/intel/haswell/native_raminit/ddr3.c
