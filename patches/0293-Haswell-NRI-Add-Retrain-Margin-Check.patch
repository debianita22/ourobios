diff --git a/src/northbridge/intel/haswell/native_raminit/retrain_margin_check.c b/src/northbridge/intel/haswell/native_raminit/retrain_margin_check.c
new file mode 100644
index 0000000000..9eb22357a7
--- /dev/null
+++ b/src/northbridge/intel/haswell/native_raminit/retrain_margin_check.c
@@ -0,0 +1,202 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <commonlib/bsd/clamp.h>
+#include <console/console.h>
+#include <delay.h>
+#include <northbridge/intel/haswell/haswell.h>
+#include <northbridge/intel/haswell/raminit.h>
+#include <string.h>
+#include <types.h>
+
+#include "raminit_native.h"
+
+static bool have_cardf(struct sysinfo *ctrl)
+{
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+		if (!ctrl->dpc[channel])
+			continue;
+
+		for (uint8_t slot = 0; slot < NUM_SLOTS; slot++) {
+			const struct raminit_dimm_info *dimm = &ctrl->dimms[channel][slot];
+			if (dimm->valid && dimm->data.reference_card == 5)
+				return true;
+		}
+	}
+	return false;
+}
+
+static struct margin_limits *get_margin_limits(struct sysinfo *ctrl, enum margin_param param)
+{
+	for (uint32_t index = 0; index < NUM_UPM_PWR_RETRAIN_MARGINS; index++) {
+		if (param == ctrl->limits[index].param) {
+			return &ctrl->limits[index];
+		}
+	}
+	die("%s: Invalid margin param %u\n", __func__, param);
+}
+
+uint16_t upm_pwr_limit_value(
+	struct sysinfo *ctrl,
+	const enum margin_param param,
+	const enum margin_limit_type lim_type)
+{
+	uint16_t limit = get_margin_limits(ctrl, param)->l[lim_type];
+
+	/* Add 20 ticks for WrV on ULT with DDR3L and raw card F */
+	if (is_hsw_ult() && !ctrl->lpddr && param == WrV && lim_type != RETRAIN_LIMIT) {
+		if (have_cardf(ctrl))
+			limit += 20 * 10;
+	}
+	/* TODO: For Broadwell and DDR3, add 8 ticks to UPM and 12 to PWR limits for CmdT */
+	return limit;
+}
+
+static uint16_t raise_limits(
+	struct sysinfo *ctrl,
+	const enum margin_param param,
+	const enum margin_limit_type lim_type)
+{
+	/* Increase UPM/PWR limits by 4 ticks every time training fails */
+	const uint32_t upm_pwr_inc = 4 * 10;
+
+	struct margin_limits *limits = get_margin_limits(ctrl, param);
+	uint16_t new_value = clamp_u32(0, limits->l[lim_type] + upm_pwr_inc, UINT16_MAX);
+	limits->l[lim_type] = new_value;
+	return new_value;
+}
+
+struct test_schedule {
+	enum margin_param param;
+	uint8_t max_margin;
+	enum wdb_dq_pattern dq_pat;
+};
+
+#define RMC_DEBUG	BIOS_DEBUG//BIOS_INFO
+
+enum nri_status retrain_margin_check(struct sysinfo *ctrl)
+{
+	const struct test_schedule test_list[] = {
+		{
+			.param      = RdT,
+			.max_margin = MAX_POSSIBLE_TIME,
+			.dq_pat     = RD_RD_TA,
+		},
+		{
+			.param      = WrT,
+			.max_margin = MAX_POSSIBLE_TIME,
+			.dq_pat     = RD_RD_TA,
+		},
+		{
+			.param      = RdV,
+			.max_margin = MAX_POSSIBLE_VREF,
+			.dq_pat     = BASIC_VA,
+		},
+		{
+			.param      = WrV,
+			.max_margin = MAX_POSSIBLE_VREF,
+			.dq_pat     = BASIC_VA,
+		},
+	};
+	const uint8_t loopcount = 17;
+	const bool stop_on_first_error = false;
+	setup_io_test_basic_va(ctrl, ctrl->chanmap, loopcount, NSOE);
+	for (uint8_t rank = 0; rank < NUM_SLOTRANKS; rank++) {
+		uint8_t chanmask = 0;
+		for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++)
+			chanmask |= select_reut_ranks(ctrl, channel, BIT(rank));
+
+		if (!chanmask)
+			continue;
+
+		clear_data_offset_train_all(ctrl);
+		for (uint32_t test = 0; test < ARRAY_SIZE(test_list); test++) {
+			ctrl->dq_pat = test_list[test].dq_pat;
+			get_ber_margin_ch(
+				ctrl,
+				ctrl->results,
+				chanmask,
+				rank,
+				0xff,
+				test_list[test].param,
+				1,
+				test_list[test].max_margin);
+		}
+	}
+	printk(RMC_DEBUG,
+		"Results are always unsigned. A minus sign only denotes a failed margin.\n\n");
+
+	printk(RMC_DEBUG, "Margin: RdT     WrT     RdV     WrV\n");
+	printk(RMC_DEBUG, "        Lft Rgt Lft Rgt Low Hi  Low Hi");
+
+	bool need_retrain_rd = false;
+	bool need_retrain_wr = false;
+	for (uint8_t channel = 0; channel < NUM_CHANNELS; channel++) {
+		for (uint8_t rank = 0; rank < NUM_SLOTRANKS; rank++) {
+			printk(RMC_DEBUG, "\nC%uR%u:  ", channel, rank);
+			if (!rank_in_ch(ctrl, rank, channel))
+				continue;
+
+			bool need_retrain = false;
+			for (uint32_t test = 0; test < ARRAY_SIZE(test_list); test++) {
+				const enum margin_param param = test_list[test].param;
+				const uint8_t res = get_margin_result_type(param);
+				const uint16_t limit =
+					upm_pwr_limit_value(ctrl, param, RETRAIN_LIMIT) / 10;
+
+				need_retrain = false;
+				union last_margin *m = &ctrl->results[res][rank][channel][0];
+				for (uint8_t sign = 0; sign < NUM_SIGN; sign++) {
+					const uint16_t mgn = m->m[sign] / 10;
+					const bool fail = mgn <= limit;
+					if (fail)
+						need_retrain = true;
+
+					/*
+					 * Prefix subpar results with a minus sign for visual
+					 * emphasis. The displayed margin values are unsigned.
+					 */
+					printk(RMC_DEBUG, "%c%2u ", fail ? '-' : ' ', mgn);
+				}
+				if (need_retrain) {
+					if (param == RdT || param == RdV)
+						need_retrain_rd = true;
+					else if (param == WrT || param == WrV)
+						need_retrain_wr = true;
+
+					if (stop_on_first_error) {
+						rank = NUM_SLOTRANKS;
+						channel = NUM_CHANNELS;
+						break;
+					}
+				}
+			}
+			if (need_retrain)
+				printk(RMC_DEBUG, "*** FAILED ***");
+		}
+		printk(RMC_DEBUG, "\n");
+	}
+	printk(RMC_DEBUG, "\n");
+	if (!need_retrain_rd && !need_retrain_wr)
+		return NRI_STATUS_SUCCESS;
+
+	printk(BIOS_ERR, "***** Margin limit check failed! *****\n");
+	printk(RMC_DEBUG, "New limits:\nParam\tUPM\tPWR\n");
+	for (unsigned int test = 0; test < ARRAY_SIZE(test_list); test++) {
+		const enum margin_param param = test_list[test].param;
+
+		if ((param == RdT || param == RdV) && !need_retrain_rd)
+			continue;
+
+		if ((param == WrT || param == WrV) && !need_retrain_wr)
+			continue;
+
+		printk(RMC_DEBUG, "%s", get_margin_name(param));
+		for (uint8_t lim_type = UPM_LIMIT; lim_type <= POWER_LIMIT; lim_type++) {
+			const uint16_t new_lim = raise_limits(ctrl, param, lim_type);
+			printk(RMC_DEBUG, "\t%u", new_lim);
+		}
+		printk(RMC_DEBUG, "\n");
+	}
+	printk(RMC_DEBUG, "\n");
+	return NRI_STATUS_RETRAIN_REQUIRED;
+}
