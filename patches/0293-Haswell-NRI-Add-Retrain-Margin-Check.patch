 /** TODO: Adjust unit scale dynamically? **/
@@ -272,6 +278,20 @@ static enum nri_status try_raminit(
 	return status;
 }
 
+/* UPM, PWR, retrain limits (x10) */
+static const struct margin_limits initial_limits[NUM_UPM_PWR_RETRAIN_MARGINS] = {
+	{RdT, {{240, 320,  90}}},
+	{WrT, {{220, 280,  90}}},
+	{RdV, {{400, 520, 160}}},
+	/* For ULT DDR3L rcF the values are increased by 20 ticks, see upm_pwr_limit_value() */
+	{WrV, {{400, 520, 160}}},
+};
+
+static void program_initial_upm_pwr_limits(struct sysinfo *ctrl)
+{
+	memcpy(ctrl->limits, initial_limits, sizeof(initial_limits));
+}
