+const char *get_margin_name(const enum margin_param param)
+{
+	static const char *const margin_names[] = {
+		"RcvEna",
+		"RdT",
+		"WrT",
+		"WrDqsT",
+		"RdV",
+		"WrV",
+		"WrLevel",
+		"WrTBit",
+		"RdTBit",
+		"RdVBit",
+		"RcvEnaX",
+		"CmdT",
+		"CmdV",
+	};
+	_Static_assert(ARRAY_SIZE(margin_names) == INVALID_MARGIN, "Margin names need update");
+
+	if (param >= ARRAY_SIZE(margin_names))
+		die("%s: Margin parameter %u out of range\n", __func__, param);
+
+	return margin_names[param];
+}
