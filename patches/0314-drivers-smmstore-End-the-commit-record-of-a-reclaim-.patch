+	_Static_assert(sizeof(rec) <= NOTE_SLOT, "The note does not fit its slot");
+
+	/* The first erased slot: the notes fill them in order */
+	while (first < end) {
+		const size_t slot = first + (end - first) / 2;
+		const size_t at = l->commit + RECLAIM_NOTE_OFFSET + slot * NOTE_SLOT;
+
+		flush_mapping(ro, at, sizeof(old));
+		if (rdev_readat(ro, old, at, sizeof(old)) != sizeof(old))
 			return;
+		if (all_erased(old, sizeof(old)))
+			end = slot;
+		else
+			first = slot + 1;
+	}
+	if (first == NOTE_SLOTS)
+		return;
 	memcpy(rec.magic, RECLAIM_NOTE_MAGIC, sizeof(rec.magic));
 	rec.code = code;
 	rec.a = a;
 	rec.reclaims = reclaims;
-	rdev_writeat(rw, &rec, l->commit + RECLAIM_NOTE_OFFSET, sizeof(rec));
+	rdev_writeat(rw, &rec, l->commit + RECLAIM_NOTE_OFFSET + first * NOTE_SLOT, sizeof(rec));
 }
 
 static bool locks_armed(void)
@@ -410,6 +507,7 @@ uint32_t smmstore_reclaim(const struct smmstore_params_reclaim *params)
