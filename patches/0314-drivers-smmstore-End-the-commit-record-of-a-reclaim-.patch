+		return slot;
+	return erase_commit(rw, l) ? 0 : -1;
+}
+
+/*
+ * The record of a swap that is done ends: zeros over its magic, and the erase
+ * of the block only if that write fails. Until then the next boot takes the
+ * staging area for the store to finish, which it no longer is once the OS
+ * writes a variable.
+ */
+static void end_record(const struct region_device *rw, const struct smmstore_reclaim_layout *l,
+		       int slot)
+{
+	static const uint8_t ended[sizeof(((struct reclaim_record *)0)->magic)];
+
+	if (rdev_writeat(rw, ended, l->commit + slot * RECORD_SLOT, sizeof(ended)) !=
+	    sizeof(ended))
+		erase_commit(rw, l);
 }
 
