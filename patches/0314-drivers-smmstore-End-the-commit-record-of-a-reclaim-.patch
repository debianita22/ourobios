+/*
+ * The records take the slots of the commit block one after the other, over the
+ * boots, and the block is erased by the boot that finds fewer free slots than
+ * its reclaims can use: no reclaim waits for that erase.
+ */
+static void test_slots(void **state)
+{
+	size_t used = 0;
+
+	new_store();
+	for (int boot = 0; boot < 3 * RECORD_SLOTS; boot++) {
+		const int before = commit_erases;
+
+		reclaims = 0;
+		smmstore_reclaim_recover();
+		if (RECORD_SLOTS - used < SMMSTORE_RECLAIM_PER_BOOT) {
+			assert_int_equal(commit_erases, before + 1);
+			assert_true(commit_erased());
+			used = 0;
+		}
+		assert_int_equal(commit_erases, used ? before : commit_erases);
+		for (int i = 0; i < 1 + boot % SMMSTORE_RECLAIM_PER_BOOT; i++) {
+			const int erases = commit_erases;
+
+			one_reclaim();
+			used++;
+			assert_true(slots_used(used));
+			assert_int_equal(commit_erases, erases);
+		}
+	}
+}
+
+/* Without the boot in between, the reclaim that finds no slot erases the block itself */
+static void test_slots_full(void **state)
+{
+	new_store();
+	for (size_t used = 1; used <= RECORD_SLOTS; used++) {
+		reclaims = 0;
+		one_reclaim();
+		assert_true(slots_used(used));
+	}
+	assert_int_equal(commit_erases, 0);
+	reclaims = 0;
+	one_reclaim();
+	assert_int_equal(commit_erases, 1);
+	assert_true(slots_used(1));
+}
+
+/*
+ * The commit block is also the last block of the spare area of the payload's
+ * fault tolerant write, which leaves a copy of its working block there. A
+ * boot does not erase what is not a record that ended, which the payload may
+ * still need; a reclaim, with the payload long past that, erases it before
+ * its record goes in, and the reclaims after it need no erase.
+ */
+static void test_foreign_block(void **state)
+{
+	static const size_t sizes[] = { 100, RECLAIM_NOTE_OFFSET, BLOCK };
+
+	for (size_t i = 0; i < ARRAY_SIZE(sizes); i++) {
+		new_store();
+		memset(flash + layout.commit, 0xa5, sizes[i]);
+		smmstore_reclaim_recover();
+		assert_int_equal(commit_erases, 0);
+		assert_int_equal(flash[layout.commit + sizes[i] - 1], 0xa5);
+		one_reclaim();
+		assert_int_equal(commit_erases, 1);
+		assert_true(slots_used(1));
+		one_reclaim();
+		assert_int_equal(commit_erases, 1);
