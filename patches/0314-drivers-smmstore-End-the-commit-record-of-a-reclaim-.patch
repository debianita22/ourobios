 #include <acpi/acpi.h>
@@ -67,10 +69,81 @@ struct reclaim_record {
 	uint8_t digest[VB2_SHA256_DIGEST_SIZE];
 } __packed;
 
+/*
+ * The commit block: slots of RECORD_SLOT bytes for the record up to
+ * RECLAIM_NOTE_OFFSET, then slots of NOTE_SLOT bytes for the notes of the
+ * refusals. Both are used in order, and programming a flash only clears bits:
+ * a record is live from the write of its slot to the write of zeros over its
+ * magic, and a slot that is neither erased nor a record is a record that
+ * ended. So a reclaim does not wait for an erase of the block, the slowest
+ * operation of the flash (about a second for 64 KiB on a ThinkPad W541), but
+ * once in RECORD_SLOTS reclaims.
+ *
+ * A build before the slots reads a record at the start of the block only: one
+ * in a later slot is found by this code alone, and a copy that a power loss
+ * cut is finished when a slot with this code boots.
+ */
+#define RECLAIM_NOTE_OFFSET	0x800
+#define RECORD_SLOT		64
+#define RECORD_SLOTS		(RECLAIM_NOTE_OFFSET / RECORD_SLOT)
+#define NOTE_SLOT		32
+#define NOTE_SLOTS		((SMM_BLOCK_SIZE - RECLAIM_NOTE_OFFSET) / NOTE_SLOT)
+
+_Static_assert(sizeof(struct reclaim_record) <= RECORD_SLOT, "The record does not fit its slot");
+
 /* One SMI, or ramstage, at a time: static, not on the small stack of SMM */
 static uint8_t chunk[4 * KiB];
 static uint8_t chunk2[4 * KiB];
 
+_Static_assert(RECLAIM_NOTE_OFFSET <= sizeof(chunk), "The record slots do not fit the buffer");
+
+static bool all_erased(const uint8_t *buf, size_t size)
+{
+	for (size_t i = 0; i < size; i++)
+		if (buf[i] != 0xff)
+			return false;
+	return true;
+}
+
+/* The slots of the records into chunk */
+static bool read_record_slots(const struct region_device *rdev, size_t commit)
+{
+	return rdev_readat(rdev, chunk, commit, RECLAIM_NOTE_OFFSET) == RECLAIM_NOTE_OFFSET;
+}
+
+/* The slot in chunk of the record that is live, or -1 */
+static int live_record_slot(void)
+{
+	for (int slot = 0; slot < RECORD_SLOTS; slot++)
+		if (!memcmp(chunk + slot * RECORD_SLOT, RECLAIM_MAGIC, sizeof(RECLAIM_MAGIC) - 1))
+			return slot;
+	return -1;
+}
+
+/* The first slot in chunk with nothing but erased slots from it on, or -1 */
+static int free_record_slot(void)
+{
+	int slot = RECORD_SLOTS;
+
+	while (slot > 0 && all_erased(chunk + (slot - 1) * RECORD_SLOT, RECORD_SLOT))
+		slot--;
+	return slot < RECORD_SLOTS ? slot : -1;
+}
+
+/* Whether the slots in chunk hold nothing but records that ended */
+static bool only_ended_records(void)
+{
+	static const uint8_t ended[sizeof(((struct reclaim_record *)0)->magic)];
+
+	for (int slot = 0; slot < RECORD_SLOTS; slot++) {
+		const uint8_t *record = chunk + slot * RECORD_SLOT;
+
+		if (!all_erased(record, RECORD_SLOT) && memcmp(record, ended, sizeof(ended)))
+			return false;
+	}
+	return true;
+}
+
