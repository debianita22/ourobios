index 3cea56aa76..0f5615a7a7 100644
--- a/src/northbridge/intel/haswell/Kconfig
+++ b/src/northbridge/intel/haswell/Kconfig
@@ -77,6 +77,16 @@ config HASWELL_NRI_2D_TIMING
 	  training that is done again after a failure. Best with
 	  HASWELL_NRI_MEMORY_TEST and HASWELL_NRI_MARGIN_CHECK.
 
+config HASWELL_NRI_TURNAROUND
+	bool "Shorten the write to read turnaround between ranks as the MRC does"
+	depends on USE_NATIVE_RAMINIT
+	help
+	  After the round trip step, try the write to read turnaround
+	  between ranks one clock shorter than the JEDEC sum and keep it if
+	  the turnaround test of the REUT passes with the read and write
+	  timing and voltage moved by 7 steps to each side, as the MRC does.
+	  Not run in the training that is done again after a failure.
+
 config HASWELL_NRI_WRITE_VREF
 	bool "Centre the write Vref of the DIMMs after training"
 	depends on USE_NATIVE_RAMINIT
