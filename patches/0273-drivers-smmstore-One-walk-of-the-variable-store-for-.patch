index d88ef9f5e72..a4b21b735d0 100644
--- a/src/drivers/efi/efivars.c
+++ b/src/drivers/efi/efivars.c
@@ -2,6 +2,7 @@
 
 #include <stdint.h>
 #include <string.h>
+#include <commonlib/helpers.h>
 #include <console/console.h>
 
 #include <Uefi/UefiBaseType.h>
@@ -731,6 +732,91 @@ enum cb_err efi_fv_get_option(const struct region_device *rdev,
 	return walk_variables(&store_rdev, auth_format, find_and_copy, &args, NULL);
 }
 
+struct efi_find_many_args {
+	const EFI_GUID *guid;
+	struct efi_fv_query *queries;
+	uint32_t *capacity;
+	bool *done;
+	size_t count;
+};
+
+/*
+ * find_and_copy() for each query not done yet, without ever stopping the walk:
+ * as walk_variables() does for one walker, a match in transition is kept until
+ * a later one, and the first match that is VAR_ADDED ends the search of its
+ * query.
+ */
+static enum cb_err find_and_copy_many(struct region_device *rdev, VARIABLE_HEADER *hdr,
+				      size_t hdr_size, void *arg, bool *stop)
+{
+	struct efi_find_many_args *fa = arg;
+
+	for (size_t i = 0; i < fa->count; i++) {
+		struct efi_fv_query *q = &fa->queries[i];
+		bool matched;
+		enum cb_err ret;
+
+		if (fa->done[i])
+			continue;
+		ret = match(rdev, hdr, hdr_size, q->name, fa->guid, &matched);
+		if (ret != CB_SUCCESS)
+			return ret;
+		if (!matched)
+			continue;
+
+		fa->done[i] = hdr->State == VAR_ADDED;
+		if (fa->capacity[i] < hdr->DataSize) {
+			q->ret = CB_EFI_BUFFER_TOO_SMALL;
+			continue;
+		}
+		if (hdr->DataSize &&
+		    rdev_readat(rdev, q->dest, hdr_size + hdr->NameSize, hdr->DataSize) !=
+				hdr->DataSize)
+			return CB_EFI_ACCESS_ERROR;
+		*q->size = hdr->DataSize;
+		q->ret = CB_SUCCESS;
+	}
+
+	return CB_SUCCESS;
+}
+
+enum cb_err efi_fv_get_options(const struct region_device *rdev, const EFI_GUID *guid,
+			       struct efi_fv_query *queries, size_t count)
+{
+	struct efi_find_many_args args;
+	uint32_t capacity[8];
+	bool done[8] = { false };
+	bool auth_format;
+	enum cb_err ret;
+	struct region_device store_rdev = *rdev;
+
+	if (count > ARRAY_SIZE(capacity))
+		return CB_ERR_ARG;
+	for (size_t i = 0; i < count; i++) {
+		capacity[i] = *queries[i].size;
+		queries[i].ret = CB_EFI_OPTION_NOT_FOUND;
+	}
+
+	ret = efi_fv_init(&store_rdev, &auth_format);
+	if (ret == CB_SUCCESS) {
+		args = (struct efi_find_many_args){
+			.guid = guid,
+			.queries = queries,
+			.capacity = capacity,
+			.done = done,
+			.count = count,
+		};
+		/* The walker never stops: a walk to the end returns "not found" */
+		ret = walk_variables(&store_rdev, auth_format, find_and_copy_many, &args, NULL);
+		if (ret == CB_EFI_OPTION_NOT_FOUND)
+			return CB_SUCCESS;
+	}
+
+	for (size_t i = 0; i < count; i++)
+		queries[i].ret = ret;
+	return ret;
+}
