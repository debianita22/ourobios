@@ -33,6 +33,30 @@ enum cb_err efi_fv_get_option(const struct region_device *rdev,
 			      void *dest,
 			      uint32_t *size);
 
+/**
+ * efi_fv_get_options
+ * Several variables of one vendor guid with one walk of the store, each found
+ * as efi_fv_get_option() would find it alone: the walk of the store costs the
+ * same for one variable as for all of them.
+ * @rdev: the readable region to operate on
+ * @guid: the vendor guid to look for
+ * @queries: the variables; on input each name, dest and *size (the size of
+ *           dest), on output in each ret what efi_fv_get_option() would have
+ *           returned for it and, on CB_SUCCESS, in *size the bytes written
+ * @count: the number of queries
+ * Returns CB_SUCCESS when the store could be walked (then each query has its
+ * ret), or the error of the store, which is then also each query's ret.
+ */
+struct efi_fv_query {
+	const char *name;
+	void *dest;
+	uint32_t *size;
+	enum cb_err ret;
+};
+
+enum cb_err efi_fv_get_options(const struct region_device *rdev, const EFI_GUID *guid,
+			       struct efi_fv_query *queries, size_t count);
+
 /**
  * efi_fv_get_mor
  * The TCG MOR variable MemoryOverwriteRequestControl in the variable store,
diff --git a/src/drivers/smmstore/options_lock.c b/src/drivers/smmstore/options_lock.c
index 06c86429a28..08b09787a08 100644
--- a/src/drivers/smmstore/options_lock.c
+++ b/src/drivers/smmstore/options_lock.c
@@ -93,16 +93,32 @@ static int variable_store(struct region_device *rdev)
 	return boot_device_ro_subregion(&region, rdev);
 }
 
-/* The effective value of a protected option (its fallback when it is missing) */
-static uint32_t option_value(const struct region_device *store, size_t which)
+/*
+ * The effective values of the protected options (each its fallback when it is
+ * missing or cannot be read), with one walk of the store for all of them: the
+ * check of every write walks the whole store, and each walk costs the same for
+ * one option as for all.
+ */
+static void option_values(const struct region_device *store,
+			  uint32_t values[ARRAY_SIZE(protected_options)])
 {
-	uint32_t value;
-	uint32_t size = sizeof(value);
+	struct efi_fv_query queries[ARRAY_SIZE(protected_options)];
+	uint32_t sizes[ARRAY_SIZE(protected_options)];
 
-	if (efi_fv_get_option(store, &EficorebootNvDataGuid, protected_options[which].name,
-			      &value, &size) != CB_SUCCESS || size != sizeof(value))
-		return protected_options[which].fallback;
-	return value;
+	for (size_t i = 0; i < ARRAY_SIZE(protected_options); i++) {
+		sizes[i] = sizeof(values[i]);
+		queries[i] = (struct efi_fv_query){
+			.name = protected_options[i].name,
+			.dest = &values[i],
+			.size = &sizes[i],
+		};
+	}
+
+	efi_fv_get_options(store, &EficorebootNvDataGuid, queries, ARRAY_SIZE(queries));
+
+	for (size_t i = 0; i < ARRAY_SIZE(protected_options); i++)
+		if (queries[i].ret != CB_SUCCESS || sizes[i] != sizeof(values[i]))
+			values[i] = protected_options[i].fallback;
 }
 
 /*
@@ -111,7 +127,7 @@ static uint32_t option_value(const struct region_device *store, size_t which)
  * (@data NULL) of [@offset, @offset + @size).
  *
  * The context is a file-static pointer, not container_of() on the rdev:
- * efi_fv_get_option() copies the rdev by value, so the rdev the readat
+ * efi_fv_get_options() copies the rdev by value, so the rdev the readat
  * callback is given is not the one embedded here. An SMI is handled by one
  * CPU at a time with the others held, so one static context is enough.
  */
@@ -174,6 +190,7 @@ bool smmstore_options_protecting(void)
 bool smmstore_options_write_allowed(size_t offset, const void *data, size_t size)
 {
 	const struct option_lock_state *state = option_state();
+	uint32_t after[ARRAY_SIZE(protected_options)];
 	struct region_device store, overlay_root, overlay;
 	struct after_write aw;
 
@@ -193,7 +210,7 @@ bool smmstore_options_write_allowed(size_t offset, const void *data, size_t size
 	};
 	/*
 	 * The reader gets a child of the overlay, never the root itself:
-	 * efi_fv_get_option() copies the rdev it is given and chains that copy
+	 * efi_fv_get_options() copies the rdev it is given and chains that copy
 	 * to itself, and rdev_chain() on a root device makes the copy its own
 	 * root with no ops, so the next read calls through NULL. A child keeps
 	 * the real root. overlay_root outlives the call.
@@ -204,26 +221,26 @@ bool smmstore_options_write_allowed(size_t offset, const void *data, size_t size
 		return false;
 	}
 
-	for (size_t i = 0; i < ARRAY_SIZE(protected_options); i++) {
-		uint32_t after;
+	/* One walk of the store as it would be after the write, for every option */
+	after_write_ctx = &aw;
+	aw.read_error = false;
+	option_values(&overlay, after);
+	after_write_ctx = NULL;
 
-		/* Latched at arm; an option that was off is never refused, so the
-		 * store is not read for it. bios_lock is always on (the guard). */
+	if (aw.read_error) {
+		/* Not the content: the flash could not be read, the check failed */
+		printk(BIOS_ERR, "Option lock: variable store unreadable, write refused\n");
+		return false;
+	}
+
+	for (size_t i = 0; i < ARRAY_SIZE(protected_options); i++) {
+		/* Latched at arm; an option that was off is never refused.
+		 * bios_lock is always on (the guard). */
 		if (!state->on[i])
 			continue;
 
-		after_write_ctx = &aw;
-		aw.read_error = false;
-		after = option_value(&overlay, i);
-		after_write_ctx = NULL;
-
-		if (aw.read_error) {
-			/* Not the content: the flash could not be read, the check failed */
-			printk(BIOS_ERR, "Option lock: variable store unreadable, write refused\n");
-			return false;
-		}
 		/* The downgrade to guard: a latched-on option becoming off */
-		if (!after) {
+		if (!after[i]) {
 			printk(BIOS_WARNING, "Option lock: refused a %s that turns '%s' off\n",
 			       data ? "write" : "erase", protected_options[i].name);
 			return false;
@@ -236,6 +253,7 @@ bool smmstore_options_write_allowed(size_t offset, const void *data, size_t size
 uint32_t smmstore_options_lock(void)
 {
 	struct option_lock_state *state = option_state();
+	uint32_t values[ARRAY_SIZE(protected_options)];
 	struct region_device store;
 	bool have_store;
 
@@ -252,8 +270,10 @@ uint32_t smmstore_options_lock(void)
 		 * store that cannot be read latches the secure fallback.
 		 */
 		have_store = variable_store(&store) == 0;
+		if (have_store)
+			option_values(&store, values);
 		for (size_t i = 0; i < ARRAY_SIZE(protected_options); i++)
-			state->on[i] = (have_store ? option_value(&store, i)
+			state->on[i] = (have_store ? values[i]
 						   : protected_options[i].fallback) ? 1 : 0;
 		state->armed = 1;
 		printk(BIOS_INFO, "Option lock: armed, the security options are read-only to the OS\n");
diff --git a/tests/drivers/efivars.c b/tests/drivers/efivars.c
index 682055b641b..d77efc045df 100644
--- a/tests/drivers/efivars.c
