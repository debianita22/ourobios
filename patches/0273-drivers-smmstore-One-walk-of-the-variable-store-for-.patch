+/* One walk for several variables finds each as efi_fv_get_option() would alone */
+static void efi_test_get_options(void **state)
+{
+	AUTHENTICATED_VARIABLE_HEADER *old_header;
+	uint8_t value[16], again[16], small[2];
+	uint32_t number = 7, got = 0, size, value_size, small_size, got_size, missing_size;
+	struct efi_fv_query queries[4];
+
+	mock_rdev(true);
+	assert_int_equal(efi_fv_set_option(&flash_rdev_rw, &OtherGuid, "second", "other",
+		sizeof("other")), CB_SUCCESS);
+	assert_int_equal(efi_fv_set_option(&flash_rdev_rw, &EficorebootNvDataGuid, "second",
+		&number, sizeof(number)), CB_SUCCESS);
+	assert_int_equal(efi_fv_set_option(&flash_rdev_rw, &EficorebootNvDataGuid, name,
+		"is awesome", strlen("is awesome") + 1), CB_SUCCESS);
+	/* The first copy of name in transition: the later one, added, wins */
+	old_header = (AUTHENTICATED_VARIABLE_HEADER *)(flash_buffer + VARIABLE_OFFSET);
+	old_header->State = VAR_IN_DELETED_TRANSITION & VAR_ADDED;
+	mock_rdev(false);
+
+	value_size = sizeof(value);
+	got_size = sizeof(got);
+	missing_size = sizeof(again);
+	small_size = sizeof(small);
+	queries[0] = (struct efi_fv_query){ .name = name, .dest = value, .size = &value_size };
+	queries[1] = (struct efi_fv_query){ .name = "second", .dest = &got, .size = &got_size };
+	queries[2] = (struct efi_fv_query){ .name = "missing", .dest = again,
+		.size = &missing_size };
+	queries[3] = (struct efi_fv_query){ .name = name, .dest = small, .size = &small_size };
+	assert_int_equal(efi_fv_get_options(&flash_rdev_rw, &EficorebootNvDataGuid, queries,
+		ARRAY_SIZE(queries)), CB_SUCCESS);
+
+	size = sizeof(again);
+	assert_int_equal(efi_fv_get_option(&flash_rdev_rw, &EficorebootNvDataGuid, name,
+		again, &size), CB_SUCCESS);
+	assert_int_equal(queries[0].ret, CB_SUCCESS);
+	assert_int_equal(value_size, size);
+	assert_memory_equal(value, again, size);
+	assert_string_equal((const char *)value, "is awesome");
+
+	assert_int_equal(queries[1].ret, CB_SUCCESS);
+	assert_int_equal(got_size, sizeof(number));
+	assert_int_equal(got, number);
+
+	assert_int_equal(queries[2].ret, CB_EFI_OPTION_NOT_FOUND);
+	assert_int_equal(queries[3].ret, CB_EFI_BUFFER_TOO_SMALL);
+
+	/* A store that is not one: every query gets the error of the store */
+	memset(flash_buffer, 0xff, sizeof(flash_buffer));
+	value_size = sizeof(value);
+	queries[0] = (struct efi_fv_query){ .name = name, .dest = value, .size = &value_size };
+	assert_int_not_equal(efi_fv_get_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		queries, 1), CB_SUCCESS);
+	assert_int_not_equal(queries[0].ret, CB_SUCCESS);
+}
