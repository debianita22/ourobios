From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Il tuo nome <tu@esempio.com>
Date: Sun, 8 Nov 2026 16:30:15 +0100
Subject: [PATCH] sb/intel/lynxpoint: A firmware watchdog from the option
 firmware_watchdog

SOUTHBRIDGE_INTEL_LYNXPOINT_FIRMWARE_WATCHDOG, for a board to select,
as SOC_INTEL_CANNONLAKE_FIRMWARE_WATCHDOG on Cannon Lake: romstage arms
the overclocking watchdog of the PCH (PMBASE + 0x54) before the memory
init, after the resets of the options, with the timeout of the option
"firmware_watchdog" (seconds, 0 for off, 180 to 1024), ramstage reloads
it at the payload and logs OC_WDT_CTL, and the SMI handler stops it
when the payload confirms the RW slot (smmstore_firmware_confirmed()).
A boot that hangs in between is reset by the PCH, so that a new slot on
trial falls back after two hangs without anyone at the power button.
Off, and on S3 resume, romstage stops the watchdog whatever a previous
firmware left; it logs and clears the status bits of a reset that came
from it, and leaves a locked register as it is.

The register has the layout of soc/intel/common/block/oc_wdt, which is
not built for this southbridge: the few accesses are local, with the
write-1-to-clear status bits masked in every write but the clear. The
Lenovo firmware of the ThinkPad W541 drives the same register. Read on
a W541 under coreboot: 0x00002000, the watchdog there and off.

TEST=Build of the ThinkPad W541 with the native RAM init.

Change-Id: I8f3bf538d06b880fa3ee96fae30b0b23c01e8111
---
 src/northbridge/intel/haswell/romstage.c      |   3 +
 src/southbridge/intel/lynxpoint/Kconfig       |  12 ++
 src/southbridge/intel/lynxpoint/Makefile.mk   |   5 +
 .../intel/lynxpoint/firmware_watchdog.c       | 120 ++++++++++++++++++
 src/southbridge/intel/lynxpoint/pch.h         |   5 +
 5 files changed, 145 insertions(+)
 create mode 100644 src/southbridge/intel/lynxpoint/firmware_watchdog.c

diff --git a/src/northbridge/intel/haswell/romstage.c b/src/northbridge/intel/haswell/romstage.c
index fe8f727941..30e54bb985 100644
--- a/src/northbridge/intel/haswell/romstage.c
+++ b/src/northbridge/intel/haswell/romstage.c
@@ -131,6 +131,9 @@ void mainboard_romstage_entry(void)
 		haswell_check_ht_option();
 	}
 
+	/* After the resets of the options, before the memory init */
+	firmware_watchdog_romstage(s3resume);
+
 	elog_boot_notify(s3resume);
 
 	/* Prepare USB controller early in S3 resume */
diff --git a/src/southbridge/intel/lynxpoint/Kconfig b/src/southbridge/intel/lynxpoint/Kconfig
index c3a574ef07..9cd297f505 100644
--- a/src/southbridge/intel/lynxpoint/Kconfig
+++ b/src/southbridge/intel/lynxpoint/Kconfig
@@ -96,6 +96,18 @@ config DISABLE_ME_PCI
 	  This will prevent the OS (and userspace apps) from interacting with
 	  the ME via the PCI interface after boot.
 
+config SOUTHBRIDGE_INTEL_LYNXPOINT_FIRMWARE_WATCHDOG
+	bool
+	depends on SMMSTORE
+	help
+	  Arm the overclocking watchdog of the PCH in romstage, before the
+	  memory init, with the timeout the option "firmware_watchdog" gives
+	  (seconds, 0 for off, never below 180), and stop it in SMM when the
+	  payload confirms the RW slot (SMMSTORE_CMD_VBOOT_SLOT_GOOD). A boot
+	  that hangs in between is reset by the PCH, so that a new slot on
+	  trial falls back after two hangs. Off, and on S3 resume, romstage
+	  stops the watchdog, whatever a previous firmware left.
+
 config SOUTHBRIDGE_INTEL_LYNXPOINT_GBE_OPTION
 	bool
 	help
diff --git a/src/southbridge/intel/lynxpoint/Makefile.mk b/src/southbridge/intel/lynxpoint/Makefile.mk
index 5088d8bb2d..9194ab3ebd 100644
--- a/src/southbridge/intel/lynxpoint/Makefile.mk
+++ b/src/southbridge/intel/lynxpoint/Makefile.mk
@@ -5,6 +5,11 @@ ifeq ($(CONFIG_SOUTHBRIDGE_INTEL_LYNXPOINT),y)
