+	 */
+	const uint8_t *sha1 = CONFIG(TPM_MEASURED_BOOT_SHA1_BANK) ? buffer : NULL;
 
 	switch (which_digest) {
 	/* SHA1 of (devmode|recmode|keyblock) bits */
 	case BOOT_MODE_PCR:
