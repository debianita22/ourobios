-		return tpm_extend_pcr(pcr, algo, buffer, vb2_digest_size(algo),
-				      TPM_PCR_GBB_HWID_NAME);
+		return tpm_extend_pcr_banks(pcr, algo, buffer, vb2_digest_size(algo), sha1,
+					    TPM_PCR_GBB_HWID_NAME);
