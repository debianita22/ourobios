+enum nri_status train_read_timing_centering_2d(struct sysinfo *ctrl)
+{
+	const uint8_t loopcount = 15;
+
+	bool en_per_bit;
+	bool en_rx_duty_cycle;
+	bool reset_per_bit;
+	bool en_2d;
+
+	en_per_bit       = true;
+	en_rx_duty_cycle = false;
+	reset_per_bit    = true;
+	en_2d            = false;
+	printk(BIOS_DEBUG, "\n### Center read timing (1D) ###\n");
+	data_time_centering_2d(
+		ctrl,
+		ctrl->results,
+		ctrl->chanmap,
+		RdT,
+		en_per_bit,
+		en_rx_duty_cycle,
+		reset_per_bit,
+		loopcount,
+		en_2d);
+
+	en_per_bit       = false;
+	en_rx_duty_cycle = true;
+	reset_per_bit    = false;
+	en_2d            = true;
+	printk(BIOS_DEBUG, "\n### Center read timing (2D) ###\n");
+	data_time_centering_2d(
+		ctrl,
+		ctrl->results,
+		ctrl->chanmap,
+		RdT,
+		en_per_bit,
+		en_rx_duty_cycle,
+		reset_per_bit,
+		loopcount,
+		en_2d);
+
+	return NRI_STATUS_SUCCESS;
+}
