+/**
+  Whether a list of region names separated by spaces has a manifest region
+  name.
+
+  @param[in] List  The names, NUL-terminated.
+  @param[in] Name  A valid manifest region name, NUL-padded.
+
+  @retval TRUE   List has Name.
+  @retval FALSE  It does not.
+**/
+STATIC
+BOOLEAN
+RegionListHas (
+  IN CONST CHAR8  *List,
+  IN CONST CHAR8  Name[REGION_MANIFEST_NAME_LEN]
+  )
+{
+  UINTN  Length;
+
+  while (*List != '\0') {
+    if (*List == ' ') {
+      List++;
+      continue;
+    }
+
+    for (Length = 0; (List[Length] != '\0') && (List[Length] != ' '); Length++) {
+    }
+
+    if ((Length <= REGION_MANIFEST_NAME_LEN) &&
+        (CompareMem (List, Name, Length) == 0) &&
+        ((Length == REGION_MANIFEST_NAME_LEN) || (Name[Length] == '\0')))
+    {
+      return TRUE;
+    }
+
+    List += Length;
+  }
+
+  return FALSE;
+}
+
+/**
+  Check the regions of a manifest against those that an update may write.
+
+  @param[in]  Entries     Manifest entries, as FmpDeviceLocateRegionManifest()
+                          returns them.
+  @param[in]  EntryCount  Number of entries.
+  @param[in]  Allowed     The names of the regions that an update may write,
+                          separated by spaces (PcdFmpDeviceSmmAllowedRegions);
+                          a list without names allows every region.
+  @param[out] Refused     The first entry that Allowed does not have.
+
+  @retval EFI_SUCCESS            Allowed has every region of the manifest.
+  @retval EFI_ACCESS_DENIED      Allowed does not have entry *Refused.
+  @retval EFI_INVALID_PARAMETER  A parameter is NULL.
+**/
+EFI_STATUS
+FmpDeviceCheckManifestRegions (
+  IN  CONST REGION_MANIFEST_ENTRY  *Entries,
+  IN  UINTN                        EntryCount,
+  IN  CONST CHAR8                  *Allowed,
+  OUT UINTN                        *Refused
+  )
+{
+  UINTN  Index;
+
+  if ((Entries == NULL) || (Allowed == NULL) || (Refused == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  for (Index = 0; Allowed[Index] == ' '; Index++) {
+  }
+
+  if (Allowed[Index] == '\0') {
+    return EFI_SUCCESS;
+  }
+
+  for (Index = 0; Index < EntryCount; Index++) {
+    if (!RegionListHas (Allowed, Entries[Index].RegionName)) {
+      *Refused = Index;
+      return EFI_ACCESS_DENIED;
+    }
+  }
+
+  return EFI_SUCCESS;
+}
