+/**
+  Fill manifest entries with region names.
+
+  @param[out] Entries  Entries to fill.
+  @param[in]  Names    Region names, up to REGION_MANIFEST_NAME_LEN characters.
+  @param[in]  Count    Number of names.
+**/
+STATIC
+VOID
+SetManifestNames (
+  OUT REGION_MANIFEST_ENTRY  *Entries,
+  IN  CONST CHAR8            **Names,
+  IN  UINTN                  Count
+  )
+{
+  UINTN  Index;
+
+  ZeroMem (Entries, Count * sizeof (*Entries));
+  for (Index = 0; Index < Count; Index++) {
+    CopyMem (Entries[Index].RegionName, Names[Index], MIN (AsciiStrLen (Names[Index]), REGION_MANIFEST_NAME_LEN));
+  }
+}
+
+/**
+  Verify the regions of the platform are allowed, in any order.
+
+  @param[in] Context  Unit test context.
+
+  @retval UNIT_TEST_PASSED  The test passed.
+**/
+STATIC
+UNIT_TEST_STATUS
+EFIAPI
+AllowedRegionsAreAccepted (
+  IN UNIT_TEST_CONTEXT  Context
+  )
+{
+  REGION_MANIFEST_ENTRY  Entries[3];
+  CONST CHAR8            *Release[]   = { "RW_MRC_CACHE", "RW_SECTION_A", "RW_SECTION_B" };
+  CONST CHAR8            *SlotsOnly[] = { "RW_SECTION_B", "RW_SECTION_A" };
+  UINTN                  Refused;
+
+  Refused = MAX_UINTN;
+  SetManifestNames (Entries, Release, ARRAY_SIZE (Release));
+  UT_ASSERT_NOT_EFI_ERROR (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (Release), TEST_ALLOWED_REGIONS, &Refused));
+  UT_ASSERT_NOT_EFI_ERROR (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (Release), "  RW_SECTION_B  RW_MRC_CACHE RW_SECTION_A ", &Refused));
+
+  SetManifestNames (Entries, SlotsOnly, ARRAY_SIZE (SlotsOnly));
+  UT_ASSERT_NOT_EFI_ERROR (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (SlotsOnly), TEST_ALLOWED_REGIONS, &Refused));
+  UT_ASSERT_EQUAL (Refused, MAX_UINTN);
+  return UNIT_TEST_PASSED;
+}
+
+/**
+  Verify a region the platform does not name is refused, and which one.
+
+  @param[in] Context  Unit test context.
+
+  @retval UNIT_TEST_PASSED  The test passed.
+**/
+STATIC
+UNIT_TEST_STATUS
+EFIAPI
+OtherRegionsAreRefused (
+  IN UNIT_TEST_CONTEXT  Context
+  )
+{
+  REGION_MANIFEST_ENTRY  Entries[3];
+  CONST CHAR8            *Store[]  = { "RW_SECTION_A", "RW_SECTION_B", "SMMSTORE" };
+  CONST CHAR8            *Gbe[]    = { "SI_GBE" };
+  CONST CHAR8            *Prefix[] = { "RW_SECTION" };
+  CONST CHAR8            *Longer[] = { "RW_SECTION_A2" };
+  CONST CHAR8            *Full[]   = { "ABCDEFGHIJKLMNOP" };
+  UINTN                  Refused;
+
+  SetManifestNames (Entries, Store, ARRAY_SIZE (Store));
+  UT_ASSERT_EQUAL (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (Store), TEST_ALLOWED_REGIONS, &Refused), EFI_ACCESS_DENIED);
+  UT_ASSERT_EQUAL (Refused, 2);
+
+  SetManifestNames (Entries, Gbe, ARRAY_SIZE (Gbe));
+  UT_ASSERT_EQUAL (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (Gbe), TEST_ALLOWED_REGIONS, &Refused), EFI_ACCESS_DENIED);
+  UT_ASSERT_EQUAL (Refused, 0);
+
+  //
+  // A name is allowed whole, not as a prefix of another one or with one.
+  //
+  SetManifestNames (Entries, Prefix, ARRAY_SIZE (Prefix));
+  UT_ASSERT_EQUAL (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (Prefix), TEST_ALLOWED_REGIONS, &Refused), EFI_ACCESS_DENIED);
+  SetManifestNames (Entries, Longer, ARRAY_SIZE (Longer));
+  UT_ASSERT_EQUAL (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (Longer), TEST_ALLOWED_REGIONS, &Refused), EFI_ACCESS_DENIED);
+
+  //
+  // A name of REGION_MANIFEST_NAME_LEN characters has no NUL.
+  //
+  SetManifestNames (Entries, Full, ARRAY_SIZE (Full));
+  UT_ASSERT_NOT_EFI_ERROR (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (Full), "ABCDEFGHIJKLMNOP", &Refused));
+  UT_ASSERT_EQUAL (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (Full), "ABCDEFGHIJKLMNO", &Refused), EFI_ACCESS_DENIED);
+  UT_ASSERT_EQUAL (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (Full), "ABCDEFGHIJKLMNOPQ", &Refused), EFI_ACCESS_DENIED);
+
+  UT_ASSERT_EQUAL (FmpDeviceCheckManifestRegions (NULL, 1, TEST_ALLOWED_REGIONS, &Refused), EFI_INVALID_PARAMETER);
+  UT_ASSERT_EQUAL (FmpDeviceCheckManifestRegions (Entries, 1, NULL, &Refused), EFI_INVALID_PARAMETER);
+  UT_ASSERT_EQUAL (FmpDeviceCheckManifestRegions (Entries, 1, TEST_ALLOWED_REGIONS, NULL), EFI_INVALID_PARAMETER);
+  return UNIT_TEST_PASSED;
+}
+
+/**
+  Verify a list without names allows every region.
+
+  @param[in] Context  Unit test context.
+
+  @retval UNIT_TEST_PASSED  The test passed.
+**/
+STATIC
+UNIT_TEST_STATUS
+EFIAPI
+EmptyRegionListAllowsAll (
+  IN UNIT_TEST_CONTEXT  Context
+  )
+{
+  REGION_MANIFEST_ENTRY  Entries[1];
+  CONST CHAR8            *Store[] = { "SMMSTORE" };
+  UINTN                  Refused;
+
+  SetManifestNames (Entries, Store, ARRAY_SIZE (Store));
+  UT_ASSERT_NOT_EFI_ERROR (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (Store), "", &Refused));
+  UT_ASSERT_NOT_EFI_ERROR (FmpDeviceCheckManifestRegions (Entries, ARRAY_SIZE (Store), "   ", &Refused));
+  return UNIT_TEST_PASSED;
+}
+
+/**
+  Verify a flash with both vboot slots takes only manifests with both.
+
+  @param[in] Context  Unit test context.
+
+  @retval UNIT_TEST_PASSED  The test passed.
+**/
+STATIC
+UNIT_TEST_STATUS
+EFIAPI
+SlotFlashNeedsBothSlots (
+  IN UNIT_TEST_CONTEXT  Context
+  )
+{
+  REGION_MANIFEST_ENTRY  Entries[3];
+  CONST CHAR8            *Release[]   = { "RW_MRC_CACHE", "RW_SECTION_A", "RW_SECTION_B" };
+  CONST CHAR8            *SlotsOnly[] = { "RW_SECTION_A", "RW_SECTION_B" };
+  CONST CHAR8            *SlotA[]     = { "RW_SECTION_A" };
+  CONST CHAR8            *SlotB[]     = { "RW_MRC_CACHE", "RW_SECTION_B" };
+  CONST CHAR8            *NoSlot[]    = { "RW_MRC_CACHE" };
+
+  SetManifestNames (Entries, Release, ARRAY_SIZE (Release));
+  UT_ASSERT_TRUE (FmpVbootManifestFitsFlash (Entries, ARRAY_SIZE (Release), TRUE));
+  SetManifestNames (Entries, SlotsOnly, ARRAY_SIZE (SlotsOnly));
+  UT_ASSERT_TRUE (FmpVbootManifestFitsFlash (Entries, ARRAY_SIZE (SlotsOnly), TRUE));
+
+  SetManifestNames (Entries, SlotA, ARRAY_SIZE (SlotA));
+  UT_ASSERT_FALSE (FmpVbootManifestFitsFlash (Entries, ARRAY_SIZE (SlotA), TRUE));
+  UT_ASSERT_TRUE (FmpVbootManifestFitsFlash (Entries, ARRAY_SIZE (SlotA), FALSE));
+  SetManifestNames (Entries, SlotB, ARRAY_SIZE (SlotB));
+  UT_ASSERT_FALSE (FmpVbootManifestFitsFlash (Entries, ARRAY_SIZE (SlotB), TRUE));
+  SetManifestNames (Entries, NoSlot, ARRAY_SIZE (NoSlot));
+  UT_ASSERT_FALSE (FmpVbootManifestFitsFlash (Entries, ARRAY_SIZE (NoSlot), TRUE));
+  UT_ASSERT_TRUE (FmpVbootManifestFitsFlash (Entries, ARRAY_SIZE (NoSlot), FALSE));
+  return UNIT_TEST_PASSED;
+}
