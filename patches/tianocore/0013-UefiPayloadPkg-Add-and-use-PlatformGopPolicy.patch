index bba04554f801a7e87bbfc1b40abf2721e36552d6..ecf83eee5faf9c833c2fd7a1b2f725855089d1bd 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.dec
+++ b/UefiPayloadPkg/UefiPayloadPkg.dec
