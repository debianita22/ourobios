+  //
+  if ((SetupMode == NULL) || (*SetupMode == SETUP_MODE)) {
+    ConfigData->SecureBootMode = SECURE_BOOT_MODE_CUSTOM;
+  } else {
+    BOOLEAN  Determined;
+
+    if (SecureBootKeysAreCustom (&Determined) && Determined) {
+      ConfigData->SecureBootMode = SECURE_BOOT_MODE_CUSTOM;
