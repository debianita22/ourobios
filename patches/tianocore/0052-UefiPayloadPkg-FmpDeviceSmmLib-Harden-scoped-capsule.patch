+  IN  UINTN        FlashSize,
+  IN  CONST UINT8  *Image,
+  IN  UINTN        ImageSize,
+  OUT UINTN        *BiosOffset,
+  OUT UINTN        *BiosSize,
+  OUT CONST CHAR8  **Source
+  )
