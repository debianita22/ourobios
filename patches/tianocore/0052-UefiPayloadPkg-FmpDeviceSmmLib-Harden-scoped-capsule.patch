From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sean Rhodes <sean@starlabs.systems>
Date: Sat, 22 Aug 2026 12:24:45 -0500
Subject: [PATCH] UefiPayloadPkg/FmpDeviceSmmLib: Harden scoped capsule
 flashing

[ouroBIOS: commit 6e839afac65f of MrChromebox's edk2, without the files
that TianoCore's tree does not have (tools/edk2-import.py): 11 in
edk2/OuroBiosPkg (10 in a directory of TianoCore's that the package
carries whole)]

Consolidate StarLabs hardening on top of FMAP/RMAP scoped updates:

- Retry and verify SMMSTORE read/erase/write before advancing.
- Fall back to the Intel flash descriptor BIOS region (FLREG1) when
  SI_BIOS is absent (Apollo Lake / IFWI layouts).
- Prefer a valid RMAP when SI_BIOS is missing; match live vs capsule
  descriptors when both are present.
- Harden FMAP detection with flashrom-style sanity checks.
- Preserve runtime variables after a successful region update when
  SMMSTORE was not modified so FmpDxe can persist the final result.
- Reject invalid RMAP manifests instead of widening to BIOS/full-flash.
- Split retry/manifest/update-policy helpers and add host unit tests.
- Tighten AppendRmapManifest.py region name validation.

Signed-off-by: Sean Rhodes <sean@starlabs.systems>
---
 UefiPayloadPkg/Tools/AppendRmapManifest.py | 9 +++++++++
 UefiPayloadPkg/UefiPayloadPkg.ci.yaml      | 1 +
 2 files changed, 10 insertions(+)

diff --git a/UefiPayloadPkg/Tools/AppendRmapManifest.py b/UefiPayloadPkg/Tools/AppendRmapManifest.py
index baf1df14136ec737c470b8194097a275205dff20..a75fe9fa53f77caae95b821e348e6dc54ce9d7ba 100644
--- a/UefiPayloadPkg/Tools/AppendRmapManifest.py
+++ b/UefiPayloadPkg/Tools/AppendRmapManifest.py
@@ -31,13 +31,22 @@ ENTRY_SIZE     = 16
 def build_manifest(region_names):
     """Return the encoded manifest bytes for the given region names."""
     entries = []
+    encoded_names = set()
+    if not region_names or len(region_names) > 0xffff:
+        raise ValueError("Manifest must contain between 1 and 65535 regions")
+
     for name in region_names:
         try:
             encoded = name.encode('ascii')
         except UnicodeError:
             raise ValueError("Region name '{}' is not ASCII".format(name))
+        if not encoded or any(character <= 0x20 or character > 0x7e for character in encoded):
+            raise ValueError("Region name '{}' contains invalid characters".format(name))
         if len(encoded) > ENTRY_SIZE:
             raise ValueError("Region name '{}' longer than {} bytes".format(name, ENTRY_SIZE))
+        if encoded in encoded_names:
+            raise ValueError("Region name '{}' is duplicated".format(name))
+        encoded_names.add(encoded)
         entries.append(struct.pack('<{}s'.format(ENTRY_SIZE), encoded))
 
     trailer = struct.pack('<IHH', RMAP_SIGNATURE, RMAP_VERSION, len(entries))
diff --git a/UefiPayloadPkg/UefiPayloadPkg.ci.yaml b/UefiPayloadPkg/UefiPayloadPkg.ci.yaml
index dbdda74961442236bcdaeb2951a78ef2e69b6946..39b63a5a2a92a21a62a45adfc5d3b2fb67f81934 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.ci.yaml
+++ b/UefiPayloadPkg/UefiPayloadPkg.ci.yaml
@@ -18,6 +18,7 @@
         ##     "<ErrorID>", "<KeyWord>"
         ## ]
         "ExceptionList": [
+            "8001", "FmpDeviceSmmLibUnitTestMain"
         ],
         ## Both file path and directory path are accepted.
         "IgnoreFiles": [
