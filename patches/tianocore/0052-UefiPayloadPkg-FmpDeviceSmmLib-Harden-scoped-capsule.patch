+/**
+  Read a little-endian 32-bit value from an unaligned byte buffer.
+
+  @param[in] Data  Four-byte input buffer.
+
+  @return Decoded value.
+**/
+STATIC
+UINT32
+ReadLe32 (
+  IN CONST UINT8  *Data
+  )
+{
+  return (UINT32)Data[0] |
+         ((UINT32)Data[1] << 8) |
+         ((UINT32)Data[2] << 16) |
+         ((UINT32)Data[3] << 24);
+}
