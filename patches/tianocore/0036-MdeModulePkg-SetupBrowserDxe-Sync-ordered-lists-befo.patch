From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt DeVillier <matt.devillier@gmail.com>
Date: Tue, 10 Mar 2026 14:11:12 -0500
Subject: [PATCH] MdeModulePkg/SetupBrowserDxe: Sync ordered lists before
 action callback

[ouroBIOS: commit 9b3274a776fa of MrChromebox's edk2, as it is]

Ordered lists (e.g. boot order) keep data in Statement->BufferValue,
separate from Storage->EditBuffer. When selecting "Commit Changes and
Exit", only the action is processed, so the ordered list is never
synced and the callback persists stale data.

Sync ordered lists to Storage before invoking the CHANGED callback for
action opcodes only. Fixes an issue where the 'Commit changes and exit'
button failed to save changes to the bootorder list.

Signed-off-by: Matt DeVillier <matt.devillier@gmail.com>
---
 .../Universal/SetupBrowserDxe/Presentation.c  | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/MdeModulePkg/Universal/SetupBrowserDxe/Presentation.c b/MdeModulePkg/Universal/SetupBrowserDxe/Presentation.c
index 05163b2cf20cbfd92678fa56c11066ee32e3ea34..e310e09bb2095c65b52658b8d4878cfe48bd38fb 100644
--- a/MdeModulePkg/Universal/SetupBrowserDxe/Presentation.c
+++ b/MdeModulePkg/Universal/SetupBrowserDxe/Presentation.c
@@ -2063,6 +2063,31 @@ ProcessCallBackFunction (
     return EFI_SUCCESS;
   }
 
+  //
+  // When processing CHANGED for an action opcode (e.g., "Commit Changes and Exit"),
+  // sync ordered list values to Storage first. Action opcodes can trigger form submit;
+  // ordered lists use separate BufferValue that must be synced before the callback
+  // runs HiiGetBrowserData. Only run for action opcodes to avoid affecting menu
+  // navigation (GOTO/REF) which was causing crashes.
+  //
+  if ((Action == EFI_BROWSER_ACTION_CHANGED) &&
+      (Question != NULL) &&
+      (Question->Operand == EFI_IFR_ACTION_OP))
+  {
+    Link = GetFirstNode (&Form->StatementListHead);
+    while (!IsNull (&Form->StatementListHead, Link)) {
+      Statement = FORM_BROWSER_STATEMENT_FROM_LINK (Link);
+      Link      = GetNextNode (&Form->StatementListHead, Link);
+
+      if ((Statement->Operand == EFI_IFR_ORDERED_LIST_OP) &&
+          (Statement->Storage != NULL) &&
+          (Statement->BufferValue != NULL))
+      {
+        SetQuestionValue (FormSet, Form, Statement, GetSetValueWithEditBuffer);
+      }
+    }
+  }
+
   Link = GetFirstNode (&Form->StatementListHead);
   while (!IsNull (&Form->StatementListHead, Link)) {
     Statement = FORM_BROWSER_STATEMENT_FROM_LINK (Link);
@@ -2732,3 +2757,4 @@ Done:
                   );
   return Status;
 }
+
