+          Parser->HasReportId = TRUE;
+          Parser->ReportId    = (UINT8)Data;
+          Parser->BitCursor   = 0;
+          break;
+
+        default:
+          break;
       }
 
       return;
 
     case HID_ITEM_TYPE_LOCAL:
       if (HidItem->Size == 0) {
-        //
