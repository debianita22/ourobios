From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Domenico D'Arrigo <d.darrigo@outlook.it>
Date: Fri, 16 Oct 2026 17:45:00 +0200
Subject: [PATCH] UefiPayloadPkg: A firmware update screen: the ouroboros and a
 flash map

[ouroBIOS: patches/edk2/0026, without the files that TianoCore's tree
does not have (tools/edk2-import.py): 8 in edk2/OuroBiosPkg (2 in a
directory of TianoCore's that the package carries whole)]

A capsule update showed a white bar under the boot logo and one line of
text at the bottom of the screen.  UpdateScreenLib, now the
DisplayUpdateProgressLib of the payload, draws a screen of its own: the
ouroboros of the ouroBIOS logo lights up from its head around to its tail
as the update goes on, and the bar under it is a map of the flash region
being written, one column per block of the flash (4 KiB on the W541):
rewritten, already up to date, still to do, and the block being
written.  Around them the versions and the vboot slots, what is being
written, the percentage, how much was rewritten and how much was already
there, the time left, and what not to do while it runs.  At the end the
snake winks and the screen counts down to the reset.

FmpDeviceSmmLib publishes what it writes, for the screen to read from the
progress callbacks (Protocol/FirmwareUpdateStatus.h): the versions, the
slots, the region, the state of each of its blocks, and why an update
failed.  PlatformBootManagerLib puts its lines (looking for the update,
checking its signature, the battery, the result) on the same screen
instead of BootLogoUpdateProgress(), and the countdown before the reset.

The text is Montserrat Medium, with a few icons of Font Awesome 5 Free,
as LVGL converted them for LvglPkg: UpdateScreenFont.c is made from those
files by tools/ui-font.py of ouroBIOS when the tree is prepared, with the
glyphs each size draws (the titles at 32 px, the versions line at 20, the
rest at 16), checked against the strings of UpdateScreenLib.c.

TEST=QEMU q35 at 1920x1080, ROM D of the update test applying capsule C,
and tools/qemu-update.py of ouroBIOS at every build; the drawing on the
host at 1920x1080 and 1024x768; the W541 installs the releases through
it since v1.3.6.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018n3yuWwDLW63F4vdf7ZFTv

---
diff --git a/UefiPayloadPkg/Include/Library/UpdateScreenLib.h b/UefiPayloadPkg/Include/Library/UpdateScreenLib.h
new file mode 100644
index 000000000..ed0e5a4ff
--- /dev/null
+++ b/UefiPayloadPkg/Include/Library/UpdateScreenLib.h
@@ -0,0 +1,54 @@
+/** @file
+  The firmware update screen of ouroBIOS.  The library is also the
+  DisplayUpdateProgressLib of the payload: FmpDxe reports the progress of a
+  capsule through DisplayUpdateProgress(), FmpDeviceSmmLib publishes what it
+  writes (Protocol/FirmwareUpdateStatus.h), and the boot manager, before and
+  after the capsule, sets the status line and the countdown below.
+
+  Copyright (c) 2026, ouroBIOS contributors
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef UPDATE_SCREEN_LIB_H_
+#define UPDATE_SCREEN_LIB_H_
+
+typedef enum {
+  UpdateScreenToneNormal,
+  UpdateScreenToneSuccess,
+  UpdateScreenToneWarning,
+  UpdateScreenToneError
+} UPDATE_SCREEN_TONE;
+
+/**
+  Show what the update is doing in the status line, drawing the screen if it
+  is not there yet.  Without a graphics console the line goes to the text
+  console.  The line stays until the next one, or until the progress of a
+  capsule replaces it.
+
+  @param[in] Tone    Its color.
+  @param[in] Format  A format string, then its arguments.
+**/
+VOID
+EFIAPI
+UpdateScreenStatus (
+  IN UPDATE_SCREEN_TONE  Tone,
+  IN CONST CHAR16        *Format,
+  ...
+  );
+
+/**
+  Count down to the reset after the capsules, Seconds seconds, on the
+  screen if there is one; after an update that succeeded the snake winks
+  first.  Returns when the time is up.
+
+  @param[in] Tone     Success or error, for the countdown.
+  @param[in] Seconds  How long.
+**/
+VOID
+EFIAPI
+UpdateScreenRestart (
+  IN UPDATE_SCREEN_TONE  Tone,
+  IN UINTN               Seconds
+  );
+
+#endif
diff --git a/UefiPayloadPkg/Include/Protocol/FirmwareUpdateStatus.h b/UefiPayloadPkg/Include/Protocol/FirmwareUpdateStatus.h
new file mode 100644
index 000000000..bfde30352
--- /dev/null
+++ b/UefiPayloadPkg/Include/Protocol/FirmwareUpdateStatus.h
@@ -0,0 +1,77 @@
+/** @file
+  The state of the firmware update that FmpDeviceSmmLib writes, for the
+  update screen (UpdateScreenLib): phase, versions, vboot slots, the region
+  being written and what happened to each of its flash blocks.
+
+  FmpDxe, with FmpDeviceSmmLib, owns the structure and changes it between
+  its progress callbacks; the screen only reads it, from those callbacks
+  (DisplayUpdateProgress()), so nothing runs concurrently.
+
+  Copyright (c) 2026, ouroBIOS contributors
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef FIRMWARE_UPDATE_STATUS_H_
+#define FIRMWARE_UPDATE_STATUS_H_
+
+#define FIRMWARE_UPDATE_STATUS_PROTOCOL_GUID \
+  { 0xe769a170, 0xb26e, 0x4763, { 0x9b, 0xbd, 0x42, 0xb7, 0xf6, 0x68, 0xdd, 0xa5 } }
+
+#define FIRMWARE_UPDATE_STATUS_REVISION  1
+
+//
+// Phase
+//
+#define FIRMWARE_UPDATE_PHASE_IDLE       0
+#define FIRMWARE_UPDATE_PHASE_PREPARING  1    ///< reading the flash map and the vboot nvdata
+#define FIRMWARE_UPDATE_PHASE_WRITING    2    ///< the blocks of Region
+#define FIRMWARE_UPDATE_PHASE_FINISHING  3    ///< asking vboot to try TargetSlot
+#define FIRMWARE_UPDATE_PHASE_DONE       4
+#define FIRMWARE_UPDATE_PHASE_FAILED     5
+
+//
+// A flash block of the region being written
+//
+#define FIRMWARE_UPDATE_BLOCK_TO_DO    0
+#define FIRMWARE_UPDATE_BLOCK_CURRENT  1      ///< being erased, programmed and verified
+#define FIRMWARE_UPDATE_BLOCK_WRITTEN  2      ///< rewritten and verified
+#define FIRMWARE_UPDATE_BLOCK_SAME     3      ///< already as in the capsule: not written
+#define FIRMWARE_UPDATE_BLOCK_FAILED   4
+
+//
+// Why an update failed, in phase FAILED
+//
+#define FIRMWARE_UPDATE_REASON_NONE     0
+#define FIRMWARE_UPDATE_REASON_INVALID  1     ///< not an image for this flash
+#define FIRMWARE_UPDATE_REASON_LAYOUT   2     ///< another flash map: flashrom only
+#define FIRMWARE_UPDATE_REASON_FLASH    3     ///< reading, erasing or writing the flash failed
+#define FIRMWARE_UPDATE_REASON_OTHER    4
+
+//
+// Map entries: a region of more blocks shares them out
+//
+#define FIRMWARE_UPDATE_STATUS_MAP_SIZE  1024
+
+typedef struct {
+  UINT32    Revision;
+  UINT32    Phase;
+  UINT32    FromVersion;                        ///< ESRT version of the firmware running
+  UINT32    ToVersion;                          ///< version of the capsule
+  CHAR8     RunningSlot;                        ///< 'A' or 'B', 0 without vboot slots
+  CHAR8     TargetSlot;                         ///< the slot written, 0 without vboot slots
+  CHAR8     Region[34];                         ///< FMAP name of the region being written
+  UINT32    RegionIndex;                        ///< among the regions written, from 0
+  UINT32    RegionCount;
+  UINT32    BlockSize;
+  UINT32    RegionBlocks;                       ///< blocks of Region
+  UINT32    TotalBlocks;                        ///< blocks of all the regions written
+  UINT32    DoneBlocks;
+  UINT32    WrittenBlocks;
+  UINT32    SameBlocks;
+  UINT32    Reason;                             ///< FIRMWARE_UPDATE_REASON_*
+  UINT8     Map[FIRMWARE_UPDATE_STATUS_MAP_SIZE];  ///< FIRMWARE_UPDATE_BLOCK_*, per block of Region
+} FIRMWARE_UPDATE_STATUS;
+
+extern EFI_GUID  gFirmwareUpdateStatusProtocolGuid;
+
+#endif
