From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt DeVillier <matt.devillier@gmail.com>
Date: Tue, 8 Sep 2026 10:04:21 -0500
Subject: [PATCH] UefiPayloadPkg: Add NVRAM-controlled bootsplash with Setup UI

[ouroBIOS: commit dfb8d33d966a of MrChromebox's edk2, without the files
that TianoCore's tree does not have (tools/edk2-import.py): 11 in
edk2/OuroBiosPkg (4 in a directory of TianoCore's that the package
carries whole)]

Allow enabling/disabling the boot splash and selecting a custom BMP via
EFI variables and a Platform Setup formset. Draw the default splash
before ConnectAll; connect first only when a custom filesystem logo is
selected. Fall back to the embedded LogoDxe image when the custom path
is missing or invalid, and keep default splash behavior when variables
are unavailable.

Signed-off-by: Matt DeVillier <matt.devillier@gmail.com>
---
 .../Include/Guid/BootSplashConfig.h           | 49 +++++++++++++++++++
 UefiPayloadPkg/UefiPayloadPkg.dec             |  4 ++
 2 files changed, 53 insertions(+)
 create mode 100644 UefiPayloadPkg/Include/Guid/BootSplashConfig.h

diff --git a/UefiPayloadPkg/Include/Guid/BootSplashConfig.h b/UefiPayloadPkg/Include/Guid/BootSplashConfig.h
new file mode 100644
index 0000000000000000000000000000000000000000..c2521dbd97f0fb4ae2edd089ae1c18f053850116
--- /dev/null
+++ b/UefiPayloadPkg/Include/Guid/BootSplashConfig.h
@@ -0,0 +1,49 @@
+/** @file
+  Boot splash NVRAM configuration definitions.
+
+  Copyright (c) 2026
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef BOOT_SPLASH_CONFIG_H_
+#define BOOT_SPLASH_CONFIG_H_
+
+#define UEFI_PAYLOAD_BOOT_SPLASH_GUID \
+  { \
+    0x8a7c3e21, 0x4f5b, 0x4d91, { 0x9c, 0x2e, 0x1a, 0x3b, 0x5d, 0x7f, 0x8e, 0x90 } \
+  }
+
+#define BOOT_SPLASH_CONFIG_FORMSET_GUID \
+  { \
+    0xb2d4e6f8, 0x1a3c, 0x4e5f, { 0x8b, 0x9d, 0x0c, 0x2e, 0x4a, 0x6f, 0x8d, 0xb1 } \
+  }
+
+#define BOOT_SPLASH_ENABLE_VARIABLE_NAME  L"BootSplashEnable"
+#define BOOT_SPLASH_TYPE_VARIABLE_NAME    L"BootSplashType"
+#define BOOT_SPLASH_PATH_VARIABLE_NAME    L"BootSplashPath"
+
+#define BOOT_SPLASH_VARIABLE_ATTRIBUTES  \
+  (EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS)
+
+#define BOOT_SPLASH_TYPE_DEFAULT  0
+#define BOOT_SPLASH_TYPE_CUSTOM   1
+
+#define BOOT_SPLASH_ENABLE_DEFAULT      1
+#define BOOT_SPLASH_TYPE_DEFAULT_VALUE  BOOT_SPLASH_TYPE_DEFAULT
+
+#define BOOT_SPLASH_PATH_MAX_SIZE  512
+
+#pragma pack(1)
+
+typedef struct {
+  UINT8    Value;
+} BOOT_SPLASH_UINT8_VAR;
+
+#pragma pack()
+
+#ifndef VFRCOMPILE
+extern EFI_GUID  gUefiPayloadBootSplashGuid;
+extern EFI_GUID  gBootSplashConfigFormSetGuid;
+#endif
+
+#endif
diff --git a/UefiPayloadPkg/UefiPayloadPkg.dec b/UefiPayloadPkg/UefiPayloadPkg.dec
index 3e5bc43d99e5bca8c60b2bc0e2a4a727efed3d03..031aceb685e3cb191fb2369fde63828af6a6f128 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.dec
+++ b/UefiPayloadPkg/UefiPayloadPkg.dec
@@ -27,6 +27,10 @@
