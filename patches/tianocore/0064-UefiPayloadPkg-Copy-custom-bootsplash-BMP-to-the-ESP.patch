 .../Include/Library/BootSplashLib.h           | 100 ++++++++++++++++
 .../PlatformBootManagerLib/BootSplash.c       | 112 ++++--------------
 .../PlatformBootManagerLib.inf                |   3 +-
 UefiPayloadPkg/UefiPayloadPkg.dec             |   1 +
 5 files changed, 140 insertions(+), 89 deletions(-)
 create mode 100644 UefiPayloadPkg/Include/Library/BootSplashLib.h

