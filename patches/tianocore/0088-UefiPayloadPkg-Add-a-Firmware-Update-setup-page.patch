+#define FIRMWARE_UPDATE_CONFIG_H_
+
+#define FIRMWARE_UPDATE_FORMSET_GUID \
+  { \
+    0x04e8b12f, 0xc919, 0x4cd9, { 0x89, 0x3d, 0x64, 0x23, 0x40, 0x4d, 0xc0, 0x2d } \
+  }
+
+#define FIRMWARE_UPDATE_FORM_ID              0x1000
+#define FIRMWARE_UPDATE_INSTALL_QUESTION_ID  0x1001
+
+#endif
