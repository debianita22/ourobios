From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sean Rhodes <sean@starlabs.systems>
Date: Mon, 28 Oct 2024 09:45:41 +0000
Subject: [PATCH] UefiPayloadPkg: Enroll Keys for SecureBoot

[ouroBIOS: commit 268675814afd of MrChromebox's edk2, without the files
that TianoCore's tree does not have (tools/edk2-import.py): 14 in
edk2/OuroBiosPkg]

Signed-off-by: Sean Rhodes <sean@starlabs.systems>
---
 UefiPayloadPkg/SmmStoreFvb/SmmStoreFvbRuntimeDxe.c |  2 +-
 UefiPayloadPkg/UefiPayloadPkg.dec                  | 12 ++++++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/UefiPayloadPkg/SmmStoreFvb/SmmStoreFvbRuntimeDxe.c b/UefiPayloadPkg/SmmStoreFvb/SmmStoreFvbRuntimeDxe.c
index 63cb760d8c68436449989a02f1cb02ac1132a50e..e156a89051bca9ce310483687c30bdb55f7ea053 100644
--- a/UefiPayloadPkg/SmmStoreFvb/SmmStoreFvbRuntimeDxe.c
+++ b/UefiPayloadPkg/SmmStoreFvb/SmmStoreFvbRuntimeDxe.c
@@ -157,7 +157,7 @@ InitializeFvAndVariableStoreHeaders (
   // Should be gEfiVariableGuid as SMM doesn't authenticate, but userspace does
   // Caveat: SecureBoot requires gEfiAuthenticatedVariableGuid type of storage
   //
-  CopyGuid (&VariableStoreHeader->Signature, &gEfiVariableGuid);
+  CopyGuid (&VariableStoreHeader->Signature, &gEfiAuthenticatedVariableGuid);
   VariableStoreHeader->Size   = PcdGet32 (PcdFlashNvStorageVariableSize) - FirmwareVolumeHeader->HeaderLength;
   VariableStoreHeader->Format = VARIABLE_STORE_FORMATTED;
   VariableStoreHeader->State  = VARIABLE_STORE_HEALTHY;
diff --git a/UefiPayloadPkg/UefiPayloadPkg.dec b/UefiPayloadPkg/UefiPayloadPkg.dec
index ecf83eee5faf9c833c2fd7a1b2f725855089d1bd..7b7a7cd3773f73220d9da0fc9d18d518d4b924dd 100644
