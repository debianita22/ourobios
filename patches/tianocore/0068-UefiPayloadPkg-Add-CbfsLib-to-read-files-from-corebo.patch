From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt DeVillier <matt.devillier@gmail.com>
Date: Sat, 3 Oct 2026 18:34:01 -0500
Subject: [PATCH] UefiPayloadPkg: Add CbfsLib to read files from coreboot's
 CBFS

[ouroBIOS: commit 81c562f371d3 of MrChromebox's edk2, without the files
that TianoCore's tree does not have (tools/edk2-import.py): 3 in
edk2/OuroBiosPkg]

Add a read-only CBFS library for DXE. It locates the active CBFS from
the boot media HOB, reads it through the x86 memory-mapped flash
window below 4 GiB, and walks it the same way as coreboot's
cbfs_walk(). Files may be uncompressed or LZMA-compressed; coreboot's
LZMA format matches edk2's, so the data is decoded through
ExtractGuidedSectionLib. Consumers must link LzmaCustomDecompressLib.

CBFS that is not entirely within the top 16 MiB of flash is not
supported, matching libpayload.

Signed-off-by: Matt DeVillier <matt.devillier@gmail.com>
---
 UefiPayloadPkg/Include/Library/CbfsLib.h | 37 ++++++++++++++++++++++++
 UefiPayloadPkg/UefiPayloadPkg.dec        |  1 +
 2 files changed, 38 insertions(+)
 create mode 100644 UefiPayloadPkg/Include/Library/CbfsLib.h

diff --git a/UefiPayloadPkg/Include/Library/CbfsLib.h b/UefiPayloadPkg/Include/Library/CbfsLib.h
new file mode 100644
index 0000000000000000000000000000000000000000..93bce7b929c4f4eb19e76df1e451d15ca4e5ab7f
--- /dev/null
+++ b/UefiPayloadPkg/Include/Library/CbfsLib.h
@@ -0,0 +1,37 @@
+/** @file
+  Read-only access to files in coreboot's CBFS.
+
+  LZMA-compressed files are decoded through ExtractGuidedSectionLib, so modules
+  using this library must also link LzmaCustomDecompressLib as a NULL library.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#pragma once
+
+#include <Uefi/UefiBaseType.h>
+
+/**
+  Load a file from the active CBFS into a newly allocated buffer, decompressing
+  it if needed.
+
+  @param[in]  Name        NUL-terminated CBFS file name.
+  @param[out] Buffer      Receives the file contents. Free with FreePool().
+  @param[out] BufferSize  Receives the size of Buffer in bytes.
+
+  @retval EFI_SUCCESS            The file was loaded.
+  @retval EFI_INVALID_PARAMETER  A parameter is NULL.
+  @retval EFI_NOT_FOUND          CBFS or the file could not be found.
+  @retval EFI_UNSUPPORTED        CBFS is not memory-mapped, or the file uses an
+                                 unsupported compression algorithm.
+  @retval EFI_OUT_OF_RESOURCES   Memory allocation failed.
+  @retval EFI_VOLUME_CORRUPTED   The file could not be decompressed.
+**/
+EFI_STATUS
+EFIAPI
+CbfsLoadFile (
+  IN  CONST CHAR8  *Name,
+  OUT VOID         **Buffer,
+  OUT UINTN        *BufferSize
+  );
diff --git a/UefiPayloadPkg/UefiPayloadPkg.dec b/UefiPayloadPkg/UefiPayloadPkg.dec
index 3bc6814ed9b3e3cf6a5df17f68af858e4c5bd901..b44b33200042384a0d0d5b05ce691b525e9e9452 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.dec
+++ b/UefiPayloadPkg/UefiPayloadPkg.dec
@@ -20,6 +20,7 @@
 [LibraryClasses]
   PayloadEntryHelperLib|Include/Library/PayloadEntryHelperLib.h
   BootSplashLib|Include/Library/BootSplashLib.h
+  CbfsLib|Include/Library/CbfsLib.h
 
 [Guids]
   # SMMSTORE for coreboot and EDK-2
