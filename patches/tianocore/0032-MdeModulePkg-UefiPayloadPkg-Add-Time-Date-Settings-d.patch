+#string STR_TIME_DATE_FORMSET_HELP            #language en-US "Configure system time and date settings"
+
+#string STR_TIME_DATE_FORM_TITLE              #language en-US "System Time and Date"
+#string STR_TIME_DATE_FORM_SUBTITLE           #language en-US "Set the system date and time:"
