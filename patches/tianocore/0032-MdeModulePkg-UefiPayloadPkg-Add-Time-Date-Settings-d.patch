+## @file
+#  Time/Date Settings DXE Driver
+#
+#  This driver provides a platform setup formset for configuring system time and date.
+#  It appears in the dynamically generated Platform Settings menu.
+#
+#  Copyright (c) 2024
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+#
+##
+
+[Defines]
+  INF_VERSION                    = 0x00010019
+  BASE_NAME                      = TimeDateSettingsDxe
+  FILE_GUID                      = 7A8B9C0D-1E2F-3A4B-5C6D-7E8F9A0B1C2D
+  MODULE_TYPE                    = DXE_DRIVER
+  VERSION_STRING                 = 1.0
+  ENTRY_POINT                    = TimeDateSettingsDxeEntryPoint
+
+#
+# The following information is for reference only and not required by the build tools.
+#
+#  VALID_ARCHITECTURES           = IA32 X64 ARM AARCH64 RISCV64 LOONGARCH64
+#
+
+[Sources]
+  TimeDateSettings.c
+  TimeDateSettingsForm.vfr
+  TimeDateSettings.uni
+
+[Packages]
+  MdePkg/MdePkg.dec
+  MdeModulePkg/MdeModulePkg.dec
+
+[LibraryClasses]
+  BaseLib
+  DebugLib
+  DevicePathLib
+  HiiLib
+  MemoryAllocationLib
+  UefiBootServicesTableLib
+  UefiDriverEntryPoint
+  UefiRuntimeServicesTableLib
+
+[Guids]
+  gEfiHiiPlatformSetupFormsetGuid               ## CONSUMES ## GUID (Class GUID for Platform Settings menu)
+  gTimeDateSettingsFormSetGuid                  ## CONSUMES
+
+[Protocols]
+  gEfiDevicePathProtocolGuid                    ## TO_START
+  gEfiHiiConfigAccessProtocolGuid               ## PRODUCES
+
+[Depex]
+  gEfiHiiDatabaseProtocolGuid
+
diff --git a/MdeModulePkg/Universal/TimeDateSettingsDxe/TimeDateSettingsForm.vfr b/MdeModulePkg/Universal/TimeDateSettingsDxe/TimeDateSettingsForm.vfr
new file mode 100644
index 0000000000000000000000000000000000000000..5af41620924f827c17f84e56b1521445f0fb6fd7
--- /dev/null
+++ b/MdeModulePkg/Universal/TimeDateSettingsDxe/TimeDateSettingsForm.vfr
@@ -0,0 +1,57 @@
+/** @file
+  Time/Date Settings VFR file
+
+  This file defines the HII formset for configuring system time and date.
+
+  Copyright (c) 2024
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#include <Uefi/UefiMultiPhase.h>
+#include <Guid/HiiPlatformSetupFormset.h>
+#include <Guid/TimeDateSettingsHii.h>
+
+#define TIME_DATE_SETTINGS_FORM_ID  0x1000
+
+formset
+  guid      = TIME_DATE_SETTINGS_FORMSET_GUID,
+  title     = STRING_TOKEN(STR_TIME_DATE_FORMSET_TITLE),
+  help      = STRING_TOKEN(STR_TIME_DATE_FORMSET_HELP),
+  classguid = EFI_HII_PLATFORM_SETUP_FORMSET_GUID,
+
+  form formid = TIME_DATE_SETTINGS_FORM_ID,
+    title = STRING_TOKEN(STR_TIME_DATE_FORM_TITLE);
+
+    subtitle text = STRING_TOKEN(STR_TIME_DATE_FORM_SUBTITLE);
+
+    //
+    // Add a blank line for spacing
+    //
+    subtitle text = STRING_TOKEN(STR_NULL_STRING);
+
+    //
+    // Date setting - uses STORAGE_TIME flag which makes Setup Browser
+    // automatically call gRT->GetTime() and gRT->SetTime()
+    //
+    date
+      prompt  = STRING_TOKEN(STR_DATE_PROMPT),
+      help    = STRING_TOKEN(STR_DATE_HELP),
+      flags   = STORAGE_TIME,
+    enddate;
+
+    //
+    // Time setting - uses STORAGE_TIME flag which makes Setup Browser
+    // automatically call gRT->GetTime() and gRT->SetTime()
+    //
+    time
+      prompt  = STRING_TOKEN(STR_TIME_PROMPT),
+      help    = STRING_TOKEN(STR_TIME_HELP),
+      flags   = STORAGE_TIME,
+    endtime;
+
+    subtitle text = STRING_TOKEN(STR_NULL_STRING);
+
+  endform;
+endformset;
+
