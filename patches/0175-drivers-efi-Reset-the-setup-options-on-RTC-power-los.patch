 src/drivers/efi/Kconfig                      |  31 +++
 src/drivers/efi/efivars.c                    | 194 +++++++++++++++++
 src/drivers/efi/efivars.h                    |  15 ++
 src/drivers/efi/option.c                     |  35 +++
 src/drivers/efi/option.h                     |   7 +
 src/soc/intel/cannonlake/include/soc/pm.h    |   2 +
 src/soc/intel/cannonlake/pmc.c               |  27 +++
