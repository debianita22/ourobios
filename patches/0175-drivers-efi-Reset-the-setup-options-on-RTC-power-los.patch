+static const EFI_GUID OtherGuid = {
+	0x8be4df61, 0x93ca, 0x11d2, { 0xaa, 0x0d, 0x00, 0xe0, 0x98, 0x03, 0x2b, 0x8c } };
+
+#define VARIABLE_OFFSET (sizeof(EFI_FIRMWARE_VOLUME_HEADER) + \
+	sizeof(EFI_FV_BLOCK_MAP_ENTRY) + sizeof(VARIABLE_STORE_HEADER))
+
+/* The variable after the one at offset */
+static size_t next_variable(size_t offset)
+{
+	const AUTHENTICATED_VARIABLE_HEADER *header = (void *)(flash_buffer + offset);
+
+	return offset + ALIGN_UP(sizeof(*header) + header->NameSize + header->DataSize,
+				 HEADER_ALIGNMENT);
+}
+
+static uint8_t flash_before[sizeof(flash_buffer)];
+
+/* Only the bytes at the offsets given, up to 4, differ from flash_before */
+static void assert_flash_changed_at(const size_t *offsets, size_t count)
+{
+	for (size_t i = 0; i < sizeof(flash_buffer); i++) {
+		bool expected = false;
+
+		for (size_t j = 0; j < count; j++)
+			expected |= i == offsets[j];
+		if (!expected)
+			assert_int_equal(flash_buffer[i], flash_before[i]);
+		else
+			assert_int_not_equal(flash_buffer[i], flash_before[i]);
+	}
+}
+
+/* Only the variables of the guid go, one state byte each, live or in transition */
+static void efi_test_delete_options(void **state)
+{
+	const size_t state_offset = offsetof(AUTHENTICATED_VARIABLE_HEADER, State);
+	size_t first, other, second, offsets[2], deleted;
+	uint8_t value[16];
+	uint32_t size, number = 1;
+
+	mock_rdev(true);
+	assert_int_equal(efi_fv_set_option(&flash_rdev_rw, &OtherGuid, "other", "kept",
+		sizeof("kept")), CB_SUCCESS);
+	assert_int_equal(efi_fv_set_option(&flash_rdev_rw, &EficorebootNvDataGuid,
+		"second", &number, sizeof(number)), CB_SUCCESS);
+	first = VARIABLE_OFFSET;
+	other = next_variable(first);
+	second = next_variable(other);
+	flash_buffer[first + state_offset] = VAR_IN_DELETED_TRANSITION & VAR_ADDED;
+	memcpy(flash_before, flash_buffer, sizeof(flash_buffer));
+
+	assert_int_equal(efi_fv_delete_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		&deleted), CB_SUCCESS);
+	/* Fails if the deletion walks from where the check left the rdev */
+	assert_int_equal(deleted, 2);
+	assert_int_equal(flash_buffer[first + state_offset],
+		VAR_DELETED & VAR_IN_DELETED_TRANSITION & VAR_ADDED);
+	assert_int_equal(flash_buffer[second + state_offset], VAR_DELETED & VAR_ADDED);
+	offsets[0] = first + state_offset;
+	offsets[1] = second + state_offset;
+	assert_flash_changed_at(offsets, ARRAY_SIZE(offsets));
+
+	size = sizeof(value);
+	assert_int_equal(efi_fv_get_option(&flash_rdev_rw, &EficorebootNvDataGuid, name,
+		value, &size), CB_EFI_OPTION_NOT_FOUND);
+	size = sizeof(value);
+	assert_int_equal(efi_fv_get_option(&flash_rdev_rw, &EficorebootNvDataGuid, "second",
+		value, &size), CB_EFI_OPTION_NOT_FOUND);
+	size = sizeof(value);
+	assert_int_equal(efi_fv_get_option(&flash_rdev_rw, &OtherGuid, "other", value, &size),
+		CB_SUCCESS);
+	assert_string_equal((const char *)value, "kept");
+
+	/* Again: nothing left to delete */
+	memcpy(flash_before, flash_buffer, sizeof(flash_buffer));
+	assert_int_equal(efi_fv_delete_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		&deleted), CB_SUCCESS);
+	assert_int_equal(deleted, 0);
+	assert_flash_changed_at(NULL, 0);
+}
+
+/* A malformed store is left to the payload, without a write */
+static void efi_test_delete_options_refuse_malformed(void **state)
+{
+	size_t deleted = 1;
+
+	mock_rdev(true);
+	flash_buffer[next_variable(VARIABLE_OFFSET)] = 0;
+	memcpy(flash_before, flash_buffer, sizeof(flash_buffer));
+	assert_int_equal(efi_fv_delete_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		&deleted), CB_EFI_VS_CORRUPTED_INVALID);
+	assert_int_equal(deleted, 0);
+	assert_flash_changed_at(NULL, 0);
+
+	/* A broken header with data after it is not an erased store */
+	mock_rdev(true);
+	flash_buffer[0x10] ^= 0xff;
+	memcpy(flash_before, flash_buffer, sizeof(flash_buffer));
+	assert_int_not_equal(efi_fv_delete_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		&deleted), CB_SUCCESS);
+	assert_flash_changed_at(NULL, 0);
+}
+
+/* Erased (never formatted) or empty: nothing to delete, and that is a success */
+static void efi_test_delete_options_erased_or_empty(void **state)
+{
+	size_t deleted = 1;
+
+	memset(flash_buffer, 0xff, sizeof(flash_buffer));
+	mock_rdev(false);
+	memcpy(flash_before, flash_buffer, sizeof(flash_buffer));
+	assert_int_equal(efi_fv_delete_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		&deleted), CB_SUCCESS);
+	assert_int_equal(deleted, 0);
+	assert_flash_changed_at(NULL, 0);
+
+	assert_int_equal(efi_fv_initialize(&flash_rdev_rw, 0x10000), CB_SUCCESS);
+	deleted = 1;
+	memcpy(flash_before, flash_buffer, sizeof(flash_buffer));
+	assert_int_equal(efi_fv_delete_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		&deleted), CB_SUCCESS);
+	assert_int_equal(deleted, 0);
+	assert_flash_changed_at(NULL, 0);
+}
+
+/* EDK2's FTW working block, right after the variable store of FVH */
+#define FTW_OFFSET		0x10000
+#define FTW_WRITE_HEADER	(FTW_OFFSET + 32)
+#define FTW_WRITE_RECORD	(FTW_WRITE_HEADER + 40)
+
+static void mock_ftw_write(uint8_t header_state, uint8_t record_state)
+{
+	static const EFI_GUID signature = { 0x9e58292b, 0x7c68, 0x497d,
+		{ 0xa0, 0xce, 0x65, 0x00, 0xfd, 0x9f, 0x1b, 0x95 } };
+	const uint64_t queue_size = 0x10000 - 32, writes = 1, private_size = 0;
+
+	memcpy(flash_buffer + FTW_OFFSET, &signature, sizeof(signature));
+	memset(flash_buffer + FTW_OFFSET + 16, 0, 4);			/* Crc */
+	flash_buffer[FTW_OFFSET + 20] = 0xfe;				/* valid */
+	memcpy(flash_buffer + FTW_OFFSET + 24, &queue_size, sizeof(queue_size));
+	flash_buffer[FTW_WRITE_HEADER] = header_state;
+	memcpy(flash_buffer + FTW_WRITE_HEADER + 24, &writes, sizeof(writes));
+	memcpy(flash_buffer + FTW_WRITE_HEADER + 32, &private_size, sizeof(private_size));
+	flash_buffer[FTW_WRITE_RECORD] = record_state;
+}
+
+/* The payload will rewrite the store from its spare copy: no deletion before that */
+static void efi_test_delete_options_pending_ftw(void **state)
+{
+	const size_t state_offset = VARIABLE_OFFSET +
+		offsetof(AUTHENTICATED_VARIABLE_HEADER, State);
+	size_t deleted;
+
+	/* Allocated, not complete; spare written, destination not */
+	mock_rdev(true);
+	mock_ftw_write(0xfc, 0xfd);
+	memcpy(flash_before, flash_buffer, sizeof(flash_buffer));
+	assert_int_equal(efi_fv_delete_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		&deleted), CB_ERR);
+	assert_flash_changed_at(NULL, 0);
+
+	/* The working block taken back from the spare copy first */
+	mock_rdev(true);
+	mock_ftw_write(0xfc, 0xfd);
+	flash_buffer[FTW_OFFSET] ^= 0xff;
+	memcpy(flash_before, flash_buffer, sizeof(flash_buffer));
+	assert_int_equal(efi_fv_delete_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		&deleted), CB_EFI_VS_CORRUPTED_INVALID);
+	assert_flash_changed_at(NULL, 0);
+
+	/* Spare not complete: the payload drops that write */
+	mock_rdev(true);
+	mock_ftw_write(0xfc, 0xff);
+	memcpy(flash_before, flash_buffer, sizeof(flash_buffer));
+	assert_int_equal(efi_fv_delete_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		&deleted), CB_SUCCESS);
+	assert_int_equal(deleted, 1);
+	assert_flash_changed_at(&state_offset, 1);
+
+	/* Destination written, or the whole write complete */
+	mock_rdev(true);
+	mock_ftw_write(0xfc, 0xf9);
+	assert_int_equal(efi_fv_delete_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		&deleted), CB_SUCCESS);
+	assert_int_equal(deleted, 1);
+	mock_rdev(true);
+	mock_ftw_write(0xf8, 0xf9);
+	assert_int_equal(efi_fv_delete_options(&flash_rdev_rw, &EficorebootNvDataGuid,
+		&deleted), CB_SUCCESS);
+	assert_int_equal(deleted, 1);
+}
