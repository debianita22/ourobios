diff --git a/tests/drivers/smmstore_options_lock.c b/tests/drivers/smmstore_options_lock.c
index b1e2417a052..e45f82d77a6 100644
--- a/tests/drivers/smmstore_options_lock.c
+++ b/tests/drivers/smmstore_options_lock.c
@@ -15,6 +15,8 @@ void smm_get_option_lock_state_buffer(uintptr_t *base, size_t *size);
 
 /* The lock itself, with its statics */
 #include "../../src/drivers/smmstore/options_lock.c"
+/* And the writes while it is armed, as store.c does them */
+#include "../../src/drivers/smmstore/split.c"
 
 #include <vendorcode/intel/edk2/UDK2017/MdeModulePkg/Include/Guid/VariableFormat.h>
 
@@ -84,6 +86,7 @@ static void new_store(void)
 #if CONFIG(SMMSTORE_OPTION_LOCK_ALL)
 	memset(&option_set, 0, sizeof(option_set));
 #endif
+	smmstore_locked_write_reset();
 	fail_from = SIZE_MAX;
 	region_device_init(&flash_root, &flash_ops, 0, sizeof(flash));
 	rdev_chain_mem_rw(&flash_rw, flash, sizeof(flash));
@@ -113,18 +116,47 @@ static size_t store_tail(void)
 	return ALIGN_UP(tail, HEADER_ALIGNMENT);
 }
 
-/* The handler: the decision, then the flash programmed (bits only cleared) */
+/* What the handler answered to the last raw write */
+static enum smmstore_locked_write last_write;
+
+/*
+ * The handler, as smmstore_rawwrite_region() of store.c: the decision, then
+ * the flash programmed (bits only cleared). True when the write is on the
+ * flash; a piece that was kept is not, and last_write says so.
+ */
 static bool raw_write(size_t offset, const void *data, size_t size)
 {
-	if (!smmstore_options_write_allowed(offset, data, size))
+	const void *write_data;
+	size_t write_offset, write_size;
+
+	last_write = smmstore_locked_write(offset, data, size, BLOCK,
+					   smmstore_options_write_allowed, &write_offset,
+					   &write_data, &write_size);
+	if (last_write != SMMSTORE_WRITE_ALLOWED)
 		return false;
-	for (size_t i = 0; i < size; i++)
-		flash[offset + i] &= ((const uint8_t *)data)[i];
+	for (size_t i = 0; i < write_size; i++)
+		flash[write_offset + i] &= ((const uint8_t *)write_data)[i];
+	return true;
+}
+
+/* A write of the payload's flash driver: one raw write for each flash block */
+static bool fvb_write(size_t offset, const void *data, size_t size)
+{
+	while (size) {
+		const size_t piece = MIN(size, BLOCK - offset % BLOCK);
+
+		if (!raw_write(offset, data, piece) && last_write != SMMSTORE_WRITE_KEPT)
+			return false;
+		offset += piece;
+		data = (const uint8_t *)data + piece;
+		size -= piece;
+	}
 	return true;
 }
 
 static bool raw_erase(size_t block)
 {
+	smmstore_locked_write_reset();
 	if (!smmstore_options_write_allowed(block * BLOCK, NULL, BLOCK))
 		return false;
 	memset(flash + block * BLOCK, 0xff, BLOCK);
@@ -169,11 +201,11 @@ static void make_record(struct record *r, const EFI_GUID *guid, const char *name
  */
 static int append_record(const struct record *r, size_t at)
 {
-	if (!raw_write(at, &r->hdr, sizeof(r->hdr)))
+	if (!fvb_write(at, &r->hdr, sizeof(r->hdr)))
 		return 0;
 	if (!raw_state(at, VAR_HEADER_VALID_ONLY))
 		return 1;
-	if (!raw_write(at + sizeof(r->hdr), r->body, r->body_size))
+	if (!fvb_write(at + sizeof(r->hdr), r->body, r->body_size))
 		return 2;
 	if (!raw_state(at, VAR_ADDED))
 		return 3;
@@ -425,28 +457,99 @@ static void test_store_damaged(void **state)
 	tail = store_tail();
 	assert_false(raw_write(tail, &byte, sizeof(byte)));
 	assert_false(raw_write(tail + 0x200, &byte, sizeof(byte)));
+	/* The last byte of the store, the end of a block: kept, never written */
 	assert_false(raw_write(store_end - 1, &byte, sizeof(byte)));
+	assert_int_equal(last_write, SMMSTORE_WRITE_KEPT);
+	assert_int_equal(flash[store_end - 1], 0xff);
+}
+
+/* Other variables, written before the arm, up to @tail */
+static void fill_to(size_t tail)
+{
+	AUTHENTICATED_VARIABLE_HEADER hdr;
+	const size_t at = store_tail();
+	const size_t name_size = sizeof(CHAR16);
+
+	assert_true(tail % HEADER_ALIGNMENT == 0 && tail >= at + sizeof(hdr) + name_size);
+	memset(&hdr, 0xff, sizeof(hdr));
+	hdr.StartId = VARIABLE_DATA;
+	hdr.State = VAR_ADDED;
+	hdr.Attributes = 7;
+	hdr.NameSize = name_size;
+	hdr.DataSize = tail - at - sizeof(hdr) - name_size;
+	memcpy(&hdr.VendorGuid, &other_guid, sizeof(other_guid));
+	memcpy(flash + at, &hdr, sizeof(hdr));
+	memset(flash + at + sizeof(hdr), 0, name_size);
+	memset(flash + at + sizeof(hdr) + name_size, 0x5a, hdr.DataSize);
+	assert_int_equal(store_tail(), tail);
 }
 
 /*
- * The first piece of a header that the payload's driver splits at the end of
- * a flash block: the reader cannot read a store that ends in half a header,
- * so the piece is refused, and the write of that variable fails.
+ * A header that the payload's driver splits at the end of a flash block. Alone,
+ * the first piece leaves a store that the reader cannot read: the lock refuses
+ * it, and the handler keeps it and writes it with the second one.
  */
 static void test_split_header(void **state)
 {
 	const uint16_t timeout = 3;
+	const uint32_t on = 1;
+	const size_t at = BLOCK - 20;
+	uint8_t before[sizeof(flash)];
 	struct record r;
-	size_t at;
 
 	three_options();
+	fill_to(at);
 	arm(SMMSTORE_RET_SUCCESS);
-	at = store_tail();
 	make_record(&r, &other_guid, "Timeout", 7, &timeout, sizeof(timeout));
+	memcpy(before, flash, sizeof(flash));
+
+	/* The decision of the lock on the piece alone */
+	assert_false(smmstore_options_write_allowed(at, &r.hdr, 20));
+
+	/* The handler: kept, the flash as it was; then the whole header */
 	assert_false(raw_write(at, &r.hdr, 20));
-	assert_false(raw_write(at, &r.hdr, 1));
-	/* Whole, it goes */
-	assert_true(raw_write(at, &r.hdr, sizeof(r.hdr)));
+	assert_int_equal(last_write, SMMSTORE_WRITE_KEPT);
+	assert_memory_equal(flash, before, sizeof(flash));
+	assert_true(raw_write(BLOCK, (const uint8_t *)&r.hdr + 20, sizeof(r.hdr) - 20));
+	assert_memory_equal(flash + at, &r.hdr, sizeof(r.hdr));
+	/* And the rest of the variable, as the driver goes on */
+	assert_true(raw_state(at, VAR_HEADER_VALID_ONLY));
+	assert_true(fvb_write(at + sizeof(r.hdr), r.body, r.body_size));
+	assert_true(raw_state(at, VAR_ADDED));
+	assert_int_equal(store_tail(), ALIGN_UP(at + sizeof(r.hdr) + r.body_size,
+						HEADER_ALIGNMENT));
+
+	/* A kept piece that is not followed by its rest is dropped */
+	three_options();
+	fill_to(at);
+	arm(SMMSTORE_RET_SUCCESS);
+	memcpy(before, flash, sizeof(flash));
+	assert_false(raw_write(at, &r.hdr, 20));
+	assert_int_equal(last_write, SMMSTORE_WRITE_KEPT);
+	/* Something else, elsewhere: refused, and the piece is gone */
+	assert_false(raw_write(BLOCK + 4, &r.hdr, 8));
+	assert_int_equal(last_write, SMMSTORE_WRITE_REFUSED);
+	assert_false(raw_write(BLOCK, (const uint8_t *)&r.hdr + 20, sizeof(r.hdr) - 20));
+	assert_memory_equal(flash, before, sizeof(flash));
+
+	/* The two pieces of what the lock refuses whole: refused, nothing written */
+	smmstore_locked_write_reset();
+	assert_false(raw_write(at, before + 0x40, 20));
+	assert_int_equal(last_write, SMMSTORE_WRITE_KEPT);
+	assert_false(raw_write(BLOCK, before + 0x40, 40));
+	assert_int_equal(last_write, SMMSTORE_WRITE_REFUSED);
+	assert_memory_equal(flash, before, sizeof(flash));
+
+	/* The whole variable through the driver's writes, an option's too */
+	three_options();
+	fill_to(at);
+	arm(SMMSTORE_RET_SUCCESS);
+	assert_int_equal(append_record(&r, at), 4);
+	three_options();
+	fill_to(at);
+	arm(SMMSTORE_RET_SUCCESS);
+	make_record(&r, &EficorebootNvDataGuid, "onboard_audio", 3, &on, sizeof(on));
+	assert_int_equal(append_record(&r, at), 3);
 }
 
 /* SMM loaded again on a resume: the set is the one of the flash at that time */
