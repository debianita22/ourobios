diff --git a/src/drivers/smmstore/split.c b/src/drivers/smmstore/split.c
new file mode 100644
index 00000000000..63113a05beb
--- /dev/null
+++ b/src/drivers/smmstore/split.c
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * The writes of the variable store while the MOR lock or the option lock
+ * checks them (store.c), and one case that the checks alone get wrong.
+ *
+ * The payload's variable driver writes a variable header with one write to
+ * its flash driver for each flash block, so a header that crosses the end of
+ * a block arrives as two raw writes. After the first one the store ends in
+ * half a header, which coreboot's reader does not read: every option would
+ * then be read as its default at the next boot, and the request of the MOR
+ * lock as absent, so the locks refuse the piece, and the variable write of
+ * the OS fails, there and at every later try, since the driver starts again
+ * at the same place.
+ *
+ * A piece that the locks refuse and that ends where a flash block ends is
+ * therefore not written and not failed, but kept here, in SMRAM. When the
+ * next raw write begins where it ended, the two are checked and written as
+ * the one write they are; any other write, or an erase, drops the piece.
+ * Nothing reaches the flash that the locks have not allowed as a whole, and
+ * the flash never holds the half header, not even across a power loss.
+ */
+
+#include <commonlib/helpers.h>
+#include <smmstore.h>
+#include <string.h>
+#include <types.h>
+
+/* More than the larger header (the authenticated one, 60 bytes) */
+#define SPLIT_PIECE_MAX 64
+
+static struct {
+	size_t offset;
+	size_t size;
+	uint8_t data[SPLIT_PIECE_MAX];
+} kept;
+
+/* The write as it is checked and written: the OS cannot change it in between */
+static uint8_t write_copy[SMM_BLOCK_SIZE + SPLIT_PIECE_MAX];
+
+void smmstore_locked_write_reset(void)
+{
+	kept.size = 0;
+}
+
+enum smmstore_locked_write smmstore_locked_write(size_t offset, const void *data, size_t size,
+		size_t block_size, bool (*allowed)(size_t offset, const void *data, size_t size),
+		size_t *write_offset, const void **write_data, size_t *write_size)
+{
+	bool joined = false;
+
+	if (size > SMM_BLOCK_SIZE) {
+		kept.size = 0;
+		return SMMSTORE_WRITE_REFUSED;
+	}
+
+	if (kept.size && offset == kept.offset + kept.size) {
+		memcpy(write_copy, kept.data, kept.size);
+		memcpy(write_copy + kept.size, data, size);
+		offset = kept.offset;
+		size += kept.size;
+		joined = true;
+	} else {
+		memcpy(write_copy, data, size);
+	}
+	kept.size = 0;
+
+	if (allowed(offset, write_copy, size)) {
+		*write_offset = offset;
+		*write_data = write_copy;
+		*write_size = size;
+		return SMMSTORE_WRITE_ALLOWED;
+	}
+
+	if (!joined && size && size < SPLIT_PIECE_MAX && (offset + size) % block_size == 0) {
+		kept.offset = offset;
+		kept.size = size;
+		memcpy(kept.data, write_copy, size);
+		return SMMSTORE_WRITE_KEPT;
+	}
+
+	return SMMSTORE_WRITE_REFUSED;
+}
diff --git a/src/drivers/smmstore/store.c b/src/drivers/smmstore/store.c
index d70e0a6e5b0..4c981b7ebce 100644
--- a/src/drivers/smmstore/store.c
+++ b/src/drivers/smmstore/store.c
@@ -55,8 +55,6 @@ static bool mor_lock_allows(size_t store_offset, const void *data, size_t size)
 		end - start);
 }
 
-/* A write checked for the MOR lock is checked and written from here, in SMRAM */
-static uint8_t mor_lock_copy[SMM_BLOCK_SIZE];
 #endif
 
 #if ENV_SMM && CONFIG(SMMSTORE_OPTION_LOCK)
@@ -87,8 +85,40 @@ static bool options_lock_allows(size_t store_offset, const void *data, size_t si
 		end - start);
 }
 
-/* A write checked for the option lock is checked and written from here, in SMRAM */
-static uint8_t options_lock_copy[SMM_BLOCK_SIZE];
+#endif
+
+#if ENV_SMM && (CONFIG(SMMSTORE_MOR_LOCK) || CONFIG(SMMSTORE_OPTION_LOCK))
+#define SMMSTORE_LOCKS 1
+
+/* Whether a lock checks the writes and erases of the store */
+static bool locks_protecting(void)
+{
+#if CONFIG(SMMSTORE_MOR_LOCK)
+	if (smmstore_mor_protecting())
+		return true;
+#endif
+#if CONFIG(SMMSTORE_OPTION_LOCK)
+	if (smmstore_options_protecting())
+		return true;
+#endif
+	return false;
+}
+
+/* A write (or, @data NULL, an erase) at @store_offset of the store, for every lock */
+static bool locks_allow(size_t store_offset, const void *data, size_t size)
+{
+#if CONFIG(SMMSTORE_MOR_LOCK)
+	if (!mor_lock_allows(store_offset, data, size))
+		return false;
+#endif
+#if CONFIG(SMMSTORE_OPTION_LOCK)
+	if (!options_lock_allows(store_offset, data, size))
+		return false;
+#endif
+	return true;
+}
+#else
+#define SMMSTORE_LOCKS 0
 #endif
 static int has_capsules = -1;
 
@@ -391,28 +421,33 @@ int smmstore_rawwrite_region(uint32_t block_id, uint32_t offset, uint32_t bufsiz
 	       ptr, block_id, offset, bufsize);
 
 	const void *data = ptr;
-#if ENV_SMM && CONFIG(SMMSTORE_MOR_LOCK)
-	if (smmstore_mor_protecting()) {
-		/* The OS cannot change it between the check and the write */
-		memcpy(mor_lock_copy, ptr, bufsize);
-		data = mor_lock_copy;
-		if (!mor_lock_allows((size_t)block_id * SMM_BLOCK_SIZE + offset, data, bufsize)) {
+#if SMMSTORE_LOCKS
+	if (locks_protecting()) {
+		size_t write_offset, write_size;
+
+		/*
+		 * Checked and written from a copy in SMRAM: the OS cannot change
+		 * it in between. The write may be this one joined to a piece that
+		 * was kept before it, or be kept itself (split.c).
+		 */
+		switch (smmstore_locked_write((size_t)block_id * SMM_BLOCK_SIZE + offset, ptr,
+					      bufsize, SMM_BLOCK_SIZE, locks_allow,
+					      &write_offset, &data, &write_size)) {
+		case SMMSTORE_WRITE_ALLOWED:
+			break;
+		case SMMSTORE_WRITE_KEPT:
+			rdev_munmap(&com_buf, ptr);
+			return 0;
+		default:
 			rdev_munmap(&com_buf, ptr);
 			return -1;
 		}
-	}
-#endif
-#if ENV_SMM && CONFIG(SMMSTORE_OPTION_LOCK)
-	if (smmstore_options_protecting()) {
-		/* The OS cannot change it between the check and the write */
-		if (data == ptr) {
-			memcpy(options_lock_copy, ptr, bufsize);
-			data = options_lock_copy;
-		}
-		if (!options_lock_allows((size_t)block_id * SMM_BLOCK_SIZE + offset, data, bufsize)) {
+		if (lookup_store(&store) < 0 ||
+		    rdev_chain(&store, &store, write_offset, write_size)) {
 			rdev_munmap(&com_buf, ptr);
 			return -1;
 		}
+		bufsize = write_size;
 	}
 #endif
 
@@ -438,12 +473,9 @@ int smmstore_rawclear_region(uint32_t block_id)
 	if (lookup_block_in_store(&store, block_id) < 0)
 		return -1;
 
-#if ENV_SMM && CONFIG(SMMSTORE_MOR_LOCK)
-	if (!mor_lock_allows((size_t)block_id * SMM_BLOCK_SIZE, NULL, SMM_BLOCK_SIZE))
-		return -1;
-#endif
-#if ENV_SMM && CONFIG(SMMSTORE_OPTION_LOCK)
-	if (!options_lock_allows((size_t)block_id * SMM_BLOCK_SIZE, NULL, SMM_BLOCK_SIZE))
+#if SMMSTORE_LOCKS
+	smmstore_locked_write_reset();
+	if (!locks_allow((size_t)block_id * SMM_BLOCK_SIZE, NULL, SMM_BLOCK_SIZE))
 		return -1;
 #endif
 
diff --git a/src/include/smmstore.h b/src/include/smmstore.h
index 20391dfd09f..4a365c54206 100644
--- a/src/include/smmstore.h
+++ b/src/include/smmstore.h
@@ -215,6 +215,27 @@ bool smmstore_options_protecting(void);
  */
 bool smmstore_options_write_allowed(size_t offset, const void *data, size_t size);
 
+/*
+ * A raw write at @offset of the store while a lock checks the writes
+ * (split.c). @allowed is the check of the locks. SMMSTORE_WRITE_ALLOWED: write
+ * @write_size bytes of @write_data at @write_offset, which is the write itself
+ * or, joined to it, the piece kept before it. SMMSTORE_WRITE_KEPT: the write
+ * was refused but may be the first piece of a write that the payload splits
+ * at the end of a flash block (@block_size): nothing to write, and no error.
+ * SMMSTORE_WRITE_REFUSED: an error.
+ */
+enum smmstore_locked_write {
+	SMMSTORE_WRITE_ALLOWED,
+	SMMSTORE_WRITE_KEPT,
+	SMMSTORE_WRITE_REFUSED,
+};
+
+enum smmstore_locked_write smmstore_locked_write(size_t offset, const void *data, size_t size,
+		size_t block_size, bool (*allowed)(size_t offset, const void *data, size_t size),
+		size_t *write_offset, const void **write_data, size_t *write_size);
+/* Any other access of the store drops a kept piece */
+void smmstore_locked_write_reset(void);
+
 /* Advertise SMMSTORE support */
 struct lb_header;
 void lb_smmstorev2(struct lb_header *header);
