+EFI_STATUS
+EFIAPI
+BootManagerContinueNotifyCallback (
+  EFI_KEY_DATA *KeyData
+  )
+{
+  //
+  // The user chose to boot directly, so clear the boot prompt text just like
+  // when entering the Boot Manager Menu.
