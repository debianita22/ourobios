diff --git a/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c b/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c
index 1d010de619..7b2e817144 100644
--- a/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c
+++ b/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c
@@ -482,6 +482,46 @@ SmmStoreLibVbootLockSlots (
   return CallSmm (mSmmStoreInfo->ApmCmd, SMMSTORE_CMD_VBOOT_LOCK, mArgComBufPhys);
 }
 
+/**
+  The lock of TCG Secure MOR that coreboot keeps in SMM
+  (SMMSTORE_CMD_MOR_LOCK): while it holds, coreboot refuses the writes of the
+  variable store that would clear the request of the OS to clear the memory.
+
+  @param[in] Op   SMMSTORE_MOR_LOCK_STATUS, SMMSTORE_MOR_LOCK_WITHOUT_KEY,
+                  SMMSTORE_MOR_LOCK_WITH_KEY or SMMSTORE_MOR_UNLOCK_WITH_KEY.
+  @param[in] Key  The 8 bytes of the key for the last two, else NULL.
+
+  @retval EFI_SUCCESS       Done (STATUS: the lock is supported).
+  @retval EFI_NO_MEDIA      SmmStore is not initialized.
+  @retval EFI_UNSUPPORTED   No lock: a coreboot without it, or flash writes
+                            not limited to SMM (BIOS Lock off).
+  @retval EFI_DEVICE_ERROR  Refused: locked already, a lock without a key or
+                            a wrong key (then locked until the next boot).
+
+**/
+EFI_STATUS
+SmmStoreLibMorLock (
+  IN       UINT32  Op,
+  IN CONST UINT8   *Key OPTIONAL
+  )
+{
+  EFI_STATUS  Status;
+
+  if (mSmmStoreInfo == NULL) {
+    return EFI_NO_MEDIA;
+  }
+
+  ZeroMem (&mArgComBuf->MorLock, sizeof (mArgComBuf->MorLock));
+  mArgComBuf->MorLock.Op = Op;
+  if (Key != NULL) {
+    CopyMem (mArgComBuf->MorLock.Key, Key, sizeof (mArgComBuf->MorLock.Key));
+  }
+
+  Status = CallSmm (mSmmStoreInfo->ApmCmd, SMMSTORE_CMD_MOR_LOCK, mArgComBufPhys);
+  ZeroMem (&mArgComBuf->MorLock, sizeof (mArgComBuf->MorLock));
+  return Status;
+}
