 #include <Library/BaseMemoryLib.h>
 #include <Library/PcdLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiRuntimeLib.h>
 #include "Variable.h"
 
+#include <Protocol/PlatformMorLock.h>
 #include <Protocol/VariablePolicy.h>
 #include <Library/VariablePolicyHelperLib.h>
 
+#define MOR_LOCK_DATA_UNLOCKED            0x0
+#define MOR_LOCK_DATA_LOCKED_WITHOUT_KEY  0x1
+#define MOR_LOCK_DATA_LOCKED_WITH_KEY     0x2
+
+#define MOR_LOCK_V1_SIZE      1
+#define MOR_LOCK_V2_KEY_SIZE  8
+
+#define MOR_ATTRIBUTES  (EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS)
+
+//
+// The lock of the platform, when it offers one
+//
+EDKII_PLATFORM_MOR_LOCK_PROTOCOL  *mPlatformMorLock = NULL;
+EFI_EVENT                         mPlatformMorLockVirtualAddressChangeEvent = NULL;
+BOOLEAN                           mMorLockPassThru = FALSE;
+UINT8                             mMorLockData     = MOR_LOCK_DATA_UNLOCKED;
+
+/**
+  Set MOR lock variable, through the variable driver.
+
+  @param  Data  MOR Lock variable data.
+
+  @return The status of the variable driver.
+**/
+STATIC
+EFI_STATUS
+SetMorLockVariable (
+  IN UINT8  Data
+  )
+{
+  EFI_STATUS  Status;
+
+  mMorLockPassThru = TRUE;
+  Status           = VariableServiceSetVariable (
+                       MEMORY_OVERWRITE_REQUEST_CONTROL_LOCK_NAME,
+                       &gEfiMemoryOverwriteRequestControlLockGuid,
+                       MOR_ATTRIBUTES,
+                       sizeof (Data),
+                       &Data
+                       );
+  mMorLockPassThru = FALSE;
+  return Status;
+}
+
+/**
+  The writes of the OS to MemoryOverwriteRequestControlLock, with the lock of
+  the platform (as SetVariableCheckHandlerMorLock() of the SMM version).
+
+  @retval  EFI_INVALID_PARAMETER  The data, size or attributes are not those
+                                  of the lock.
+  @retval  EFI_ACCESS_DENIED      It is locked.
+  @retval  EFI_WRITE_PROTECTED    It cannot be deleted.
+  @retval  EFI_DEVICE_ERROR       The platform did not lock.
+  @retval  EFI_ALREADY_STARTED    Handled here: the variable driver returns
+                                  EFI_SUCCESS.
+**/
+STATIC
+EFI_STATUS
+SetVariableCheckHandlerPlatformMorLock (
+  IN UINT32  Attributes,
+  IN UINTN   DataSize,
+  IN VOID    *Data
+  )
+{
+  EFI_STATUS  Status;
+  UINT8       NewData;
+
+  if ((Attributes == 0) || (DataSize == 0) || (Data == NULL)) {
+    return mMorLockPassThru ? EFI_SUCCESS : EFI_WRITE_PROTECTED;
+  }
+
+  if ((Attributes != MOR_ATTRIBUTES) ||
+      ((DataSize != MOR_LOCK_V1_SIZE) && (DataSize != MOR_LOCK_V2_KEY_SIZE)))
+  {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if (mMorLockPassThru) {
+    return EFI_SUCCESS;
+  }
+
+  if (mMorLockData == MOR_LOCK_DATA_UNLOCKED) {
+    if (DataSize == MOR_LOCK_V1_SIZE) {
+      if (*(UINT8 *)Data == MOR_LOCK_DATA_UNLOCKED) {
+        Status = SetMorLockVariable (MOR_LOCK_DATA_UNLOCKED);
+        return EFI_ERROR (Status) ? Status : EFI_ALREADY_STARTED;
+      }
+
+      if (*(UINT8 *)Data != MOR_LOCK_DATA_LOCKED_WITHOUT_KEY) {
+        return EFI_INVALID_PARAMETER;
+      }
+
+      Status  = mPlatformMorLock->Lock (NULL);
+      NewData = MOR_LOCK_DATA_LOCKED_WITHOUT_KEY;
+    } else {
+      Status  = mPlatformMorLock->Lock (Data);
+      NewData = MOR_LOCK_DATA_LOCKED_WITH_KEY;
+    }
+
+    if (EFI_ERROR (Status)) {
+      return EFI_DEVICE_ERROR;
+    }
+
+    mMorLockData = NewData;
+    SetMorLockVariable (NewData);
+    return EFI_ALREADY_STARTED;
+  }
+
+  //
+  // Locked: only the key of a lock with a key opens it
+  //
+  if ((mMorLockData != MOR_LOCK_DATA_LOCKED_WITH_KEY) || (DataSize != MOR_LOCK_V2_KEY_SIZE)) {
+    return EFI_ACCESS_DENIED;
+  }
+
+  if (!EFI_ERROR (mPlatformMorLock->Unlock (Data))) {
+    mMorLockData = MOR_LOCK_DATA_UNLOCKED;
+    SetMorLockVariable (MOR_LOCK_DATA_UNLOCKED);
+    return EFI_ALREADY_STARTED;
+  }
+
+  //
+  // A wrong key: locked until the next boot, without a key
+  //
+  mMorLockData = MOR_LOCK_DATA_LOCKED_WITHOUT_KEY;
+  SetMorLockVariable (MOR_LOCK_DATA_LOCKED_WITHOUT_KEY);
+  return EFI_ACCESS_DENIED;
+}
+
