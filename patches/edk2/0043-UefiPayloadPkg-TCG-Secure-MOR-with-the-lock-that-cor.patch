+/**
+  The pointer to the lock of the platform, in virtual mode.
+
+  @param[in]  Event    Event whose notification function is being invoked
+  @param[in]  Context  Unused
+**/
+STATIC
+VOID
+EFIAPI
+PlatformMorLockVirtualAddressChange (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  EfiConvertPointer (0x0, (VOID **)&mPlatformMorLock);
+}
+
+/**
+  Whether to offer the lock of the platform: the protocol, which keeps it in
+  this boot, and a MOR variable, which the platform creates only when it
+  honors MOR (PcdTcgMorWithoutSmm).
+
+  @retval TRUE   Offer it: mPlatformMorLock is set.
+  @retval FALSE  The lock stays unsupported.
+**/
+STATIC
+BOOLEAN
+PlatformMorLockOffered (
+  VOID
+  )
+{
+  EDKII_PLATFORM_MOR_LOCK_PROTOCOL  *PlatformMorLock;
+  EFI_STATUS                        Status;
+  UINTN                             MorSize;
+
+  if (!FeaturePcdGet (PcdTcgMorWithoutSmm)) {
+    return FALSE;
+  }
+
+  Status = gBS->LocateProtocol (&gEdkiiPlatformMorLockProtocolGuid, NULL, (VOID **)&PlatformMorLock);
+  if (EFI_ERROR (Status) || EFI_ERROR (PlatformMorLock->Supported ())) {
+    return FALSE;
+  }
+
+  MorSize = 0;
+  Status  = VariableServiceGetVariable (
+              MEMORY_OVERWRITE_REQUEST_VARIABLE_NAME,
+              &gEfiMemoryOverwriteControlDataGuid,
+              NULL,
+              &MorSize,
+              NULL
+              );
+  if (Status != EFI_BUFFER_TOO_SMALL) {
+    return FALSE;
+  }
+
+  Status = gBS->CreateEventEx (
+                  EVT_NOTIFY_SIGNAL,
+                  TPL_NOTIFY,
+                  PlatformMorLockVirtualAddressChange,
+                  NULL,
+                  &gEfiEventVirtualAddressChangeGuid,
+                  &mPlatformMorLockVirtualAddressChangeEvent
+                  );
+  if (EFI_ERROR (Status)) {
+    return FALSE;
+  }
+
+  mPlatformMorLock = PlatformMorLock;
+  return TRUE;
+}
+
 /**
   Delayed initialization for MOR Control Lock at EndOfDxe.
 
@@ -117,6 +354,30 @@ MorLockInitAtEndOfDxe (
   EFI_STATUS                      Status;
   EDKII_VARIABLE_POLICY_PROTOCOL  *VariablePolicy;
 
