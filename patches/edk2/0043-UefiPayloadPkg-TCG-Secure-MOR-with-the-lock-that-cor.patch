--- /dev/null
+++ b/MdeModulePkg/Include/Protocol/PlatformMorLock.h
@@ -0,0 +1,79 @@
+/** @file
+  The lock of TCG Secure MOR (MemoryOverwriteRequestControlLock) kept by the
+  platform, for the variable driver that runs outside SMM.
+
+  The variable driver without SMM (VariableRuntimeDxe) cannot make the lock
+  secure itself: code in the OS can change its memory. A platform whose
+  firmware keeps the lock where the OS cannot reach it (on a coreboot
+  payload, coreboot's SMM, which then refuses the writes of the variable
+  store that would clear the request of the OS) installs this protocol, and
+  the variable driver offers MemoryOverwriteRequestControlLock through it
+  (PcdTcgMorWithoutSmm). Every function is callable at runtime.
+
+  Copyright (c) 2026, Domenico D'Arrigo. All rights reserved.<BR>
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef PLATFORM_MOR_LOCK_H_
+#define PLATFORM_MOR_LOCK_H_
+
+#define EDKII_PLATFORM_MOR_LOCK_PROTOCOL_GUID \
+  { 0xf1dba97f, 0xa870, 0x4608, { 0x9a, 0x90, 0x3d, 0x93, 0x51, 0xa7, 0x0d, 0x3b } }
+
+#define EDKII_PLATFORM_MOR_LOCK_KEY_SIZE  8
+
+typedef struct _EDKII_PLATFORM_MOR_LOCK_PROTOCOL EDKII_PLATFORM_MOR_LOCK_PROTOCOL;
+
+/**
+  Whether the platform keeps the lock in this boot.
+
+  @retval EFI_SUCCESS      The lock can be taken.
+  @retval EFI_UNSUPPORTED  Not in this boot (for example a flash that the OS
+                           can write directly).
+**/
+typedef
+EFI_STATUS
+(EFIAPI *EDKII_PLATFORM_MOR_LOCK_SUPPORTED)(
+  VOID
+  );
+
+/**
+  Lock until the next boot: the request of MemoryOverwriteRequestControl
+  cannot be cleared any more.
+
+  @param[in] Key  EDKII_PLATFORM_MOR_LOCK_KEY_SIZE bytes that unlock it, or
+                  NULL for a lock without a key.
+
+  @retval EFI_SUCCESS  Locked.
+  @retval Others       Not locked.
+**/
+typedef
+EFI_STATUS
+(EFIAPI *EDKII_PLATFORM_MOR_LOCK_LOCK)(
+  IN CONST UINT8  *Key OPTIONAL
+  );
+
+/**
+  Unlock with the key of the lock. A wrong key leaves it locked until the
+  next boot, and no key opens it any more.
+
+  @param[in] Key  EDKII_PLATFORM_MOR_LOCK_KEY_SIZE bytes.
+
+  @retval EFI_SUCCESS  Unlocked.
+  @retval Others       Still locked.
+**/
+typedef
+EFI_STATUS
+(EFIAPI *EDKII_PLATFORM_MOR_LOCK_UNLOCK)(
+  IN CONST UINT8  *Key
+  );
+
+struct _EDKII_PLATFORM_MOR_LOCK_PROTOCOL {
+  EDKII_PLATFORM_MOR_LOCK_SUPPORTED    Supported;
+  EDKII_PLATFORM_MOR_LOCK_LOCK         Lock;
+  EDKII_PLATFORM_MOR_LOCK_UNLOCK       Unlock;
+};
+
+extern EFI_GUID  gEdkiiPlatformMorLockProtocolGuid;
+
+#endif
