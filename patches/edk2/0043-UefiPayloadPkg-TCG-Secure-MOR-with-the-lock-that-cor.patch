+++ b/UefiPayloadPkg/Include/Library/SmmStoreLib.h
@@ -218,6 +218,34 @@ SmmStoreLibVbootLockSlots (
   and operation of EfiConvertPointer.
 
 **/
+//
+// SmmStoreLibMorLock(): the operations of SMMSTORE_CMD_MOR_LOCK
+//
+#define SMMSTORE_MOR_LOCK_STATUS        0
+#define SMMSTORE_MOR_LOCK_WITHOUT_KEY   1
+#define SMMSTORE_MOR_LOCK_WITH_KEY      2
+#define SMMSTORE_MOR_UNLOCK_WITH_KEY    3
+#define SMMSTORE_MOR_LOCK_KEY_SIZE      8
+
+/**
+  The lock of TCG Secure MOR that coreboot keeps in SMM.
+
+  @param[in] Op   One of SMMSTORE_MOR_*.
+  @param[in] Key  SMMSTORE_MOR_LOCK_KEY_SIZE bytes for the operations with a
+                  key, else NULL.
+
+  @retval EFI_SUCCESS       Done (STATUS: the lock is supported).
+  @retval EFI_NO_MEDIA      SmmStore is not initialized.
+  @retval EFI_UNSUPPORTED   No lock in this coreboot, or BIOS Lock off.
+  @retval EFI_DEVICE_ERROR  Refused (locked already, no key, wrong key).
+
+**/
+EFI_STATUS
+SmmStoreLibMorLock (
+  IN       UINT32  Op,
+  IN CONST UINT8   *Key OPTIONAL
+  );
+
 typedef EFI_STATUS EFIAPI (*CONVERT_POINTER_CALLBACK) (
   IN UINTN     DebugDisposition,
