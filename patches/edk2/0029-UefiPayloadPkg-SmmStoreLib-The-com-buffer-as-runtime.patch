From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Domenico D'Arrigo <DCHEM88@hotmail.it>
Date: Tue, 27 Oct 2026 20:19:06 +0100
Subject: [PATCH] UefiPayloadPkg/SmmStoreLib: The com buffer as runtime MMIO

SMM reads and writes the com buffer of SMMSTORE, which coreboot places
in CBMEM, at its physical address, and so do the runtime variable
services, through the virtual address an OS gives it. SmmStoreLib gave
the range EFI_MEMORY_RUNTIME, and the memory map showed it as
EfiReservedMemoryType with the runtime attribute (the memmap of the
W541: Reserved 0x7F635000-0x7F644FFF, attributes 0x800000000000000F).
Linux maps such a range for the runtime services. XNU maps the runtime
services code and data and runtime MMIO only: macOS restarted right
after boot.efi handed over to the kernel, unless OpenCore's
ProtectMemoryRegions retyped the range as MMIO. boot.efi also moves the
runtime services code and data after ExitBootServices(), and leaves
MMIO in place: SMM read the arguments of a command, which the library
keeps in runtime services data, where they no longer were, unless
OpenCore's AvoidRuntimeDefrag hid the runtime services from boot.efi.

The range now becomes MMIO with EFI_MEMORY_RUNTIME in the GCD, as
ProtectMemoryRegions made it: every OS maps it for the runtime services
and keeps it out of its own memory, and boot.efi leaves it in place. The
modules that link the library call it in turn: the first one converts
the range, the next ones find it converted. When the com buffer has
room after the block, a page that coreboot gives it (patch 0134), the
runtime driver passes the arguments there once the OS has called
SetVirtualAddressMap(): SMM then reads and writes nothing that boot.efi
moves. When the range cannot be converted, the old marking stays.

TEST=The W541 payload (nri) in a q35 ROM with patch 0134, QEMU with
2 GiB: the memmap of OpenShell shows the com buffer, 0x7FD7F000-
0x7FD8FFFF (68 KiB), as MMIO with 0x800000000000000F (Reserved with the
payload of rc14), as does Linux 6.8 with efi=debug; no reserved range
with EFI_MEMORY_RUNTIME is left, also in the memory map of
ExitBootServices() (tools/efi/slot-lock-test.c). setvar in the shell
writes a variable that the next boot reads. Linux writes a variable
through efivarfs at runtime without a fault: with DEBUG_SMI, the raw
writes before SetVirtualAddressMap() pass their arguments in runtime
services data, those after it at the com buffer plus 0x10000, and the
next boot reads the variable. A DEBUG build with the modules that link
the library (SmmStoreFvbRuntimeDxe, FmpDxe, FirmwareUpdateDxe, BdsDxe)
logs no error and no assert. The smoke test of the payload
(tools/qemu-smoke.py) passes.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018n3yuWwDLW63F4vdf7ZFTv
---
 UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c | 153 +++++++++++++++---
 1 file changed, 133 insertions(+), 20 deletions(-)

diff --git a/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c b/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c
index 98f282b..808eb19 100644
--- a/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c
+++ b/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c
@@ -495,6 +495,19 @@ SmmStoreLibVirtualAddressChange (
   IN CONVERT_POINTER_CALLBACK  ConvertPointer
   )
 {
+  //
+  // At runtime the arguments go after the data, where the com buffer has
+  // room for them (coreboot gives a page more than a block): macOS's boot
+  // loader moves the runtime services data, where they were, and SMM reads
+  // them at their physical address
+  //
+  if ((mSmmStoreInfo != NULL) &&
+      (mSmmStoreInfo->ComBufferSize >= mSmmStoreInfo->BlockSize + sizeof (SMM_STORE_COM_BUF)))
+  {
+    mArgComBufPhys = mSmmStoreInfo->ComBuffer + mSmmStoreInfo->BlockSize;
+    mArgComBuf     = (SMM_STORE_COM_BUF *)(UINTN)mArgComBufPhys;
+  }
+
   ConvertPointer (0x0, (VOID **)&mArgComBuf);
   if (mSmmStoreInfo != NULL) {
     ConvertPointer (0x0, (VOID **)&mSmmStoreInfo->ComBuffer);
@@ -504,6 +517,91 @@ SmmStoreLibVirtualAddressChange (
   return;
 }
 
+/**
+  Makes the com buffer runtime MMIO of the memory map.
+
+  SMM reads and writes the com buffer at its physical address, and so do the
+  runtime services, through the virtual address an OS gives it.  An OS maps
+  the runtime services code and data and the MMIO ranges with
+  EFI_MEMORY_RUNTIME, not reserved memory with it: XNU leaves that unmapped
+  and faults at the first variable write.  The boot loader of macOS also moves
+  the runtime services code and data after ExitBootServices(), where SMM
+  would no longer find the buffer, and leaves MMIO where it is.  coreboot puts
+  the buffer in CBMEM, DRAM that the GCD holds as reserved memory: the range
+  becomes MMIO with EFI_MEMORY_RUNTIME, which an OS maps for the runtime
+  services and keeps out of its own memory.  The modules that link this
+  library call this in turn: the first one converts the range, the next ones
+  find it converted.
+
+  @retval EFI_SUCCESS  The com buffer is runtime MMIO.
+  @retval others       It is not, and the GCD is as it was.
+
+**/
+STATIC
+EFI_STATUS
+SmmStoreLibComBufferAsRuntimeMmio (
+  VOID
+  )
+{
+  EFI_STATUS                       Status;
+  EFI_GCD_MEMORY_SPACE_DESCRIPTOR  Descriptor;
+  EFI_PHYSICAL_ADDRESS             Base;
+  UINT64                           Length;
+  UINT64                           Capabilities;
+
+  Base   = mSmmStoreInfo->ComBuffer;
+  Length = mSmmStoreInfo->ComBufferSize;
+  if ((Length == 0) || (((Base | Length) & EFI_PAGE_MASK) != 0)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  Status = gDS->GetMemorySpaceDescriptor (Base, &Descriptor);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  //
+  // All of it in one range of the GCD
+  //
+  if (Base + Length > Descriptor.BaseAddress + Descriptor.Length) {
+    return EFI_UNSUPPORTED;
+  }
+
+  if ((Descriptor.GcdMemoryType == EfiGcdMemoryTypeReserved) ||
+      (Descriptor.GcdMemoryType == EfiGcdMemoryTypeNonExistent))
+  {
+    Capabilities = Descriptor.Capabilities &
+                   (EFI_MEMORY_UC | EFI_MEMORY_WC | EFI_MEMORY_WT | EFI_MEMORY_WB);
+    if (Capabilities == 0) {
+      Capabilities = EFI_MEMORY_WB;
+    }
+
+    if (Descriptor.GcdMemoryType == EfiGcdMemoryTypeReserved) {
+      Status = gDS->RemoveMemorySpace (Base, Length);
+      if (EFI_ERROR (Status)) {
+        return Status;
+      }
+    }
+
+    Status = gDS->AddMemorySpace (EfiGcdMemoryTypeMemoryMappedIo, Base, Length, Capabilities);
+    if (EFI_ERROR (Status)) {
+      if (Descriptor.GcdMemoryType == EfiGcdMemoryTypeReserved) {
+        gDS->AddMemorySpace (EfiGcdMemoryTypeReserved, Base, Length, Descriptor.Capabilities);
+      }
+
+      return Status;
+    }
+  } else if (Descriptor.GcdMemoryType != EfiGcdMemoryTypeMemoryMappedIo) {
+    return EFI_UNSUPPORTED;
+  }
+
+  //
+  // EFI_MEMORY_RUNTIME, without cache attributes, reaches the memory map,
+  // not the CPU
+  //
+  return gDS->SetMemorySpaceAttributes (Base, Length, EFI_MEMORY_RUNTIME);
+}
+
 /**
   Initializes SmmStore support
 
@@ -586,38 +684,53 @@ SmmStoreLibInitialize (
   mArgComBuf = (VOID *)mArgComBufPhys;
 
   //
-  // Finally mark the SMM communication buffer provided by CB or SBL as runtime memory
+  // Finally mark the SMM communication buffer provided by CB or SBL as runtime memory:
+  // runtime MMIO if it can be, else EFI_MEMORY_RUNTIME on what it is
   //
-  Status = gDS->GetMemorySpaceDescriptor (mSmmStoreInfo->ComBuffer, &GcdDescriptor);
-  if (EFI_ERROR (Status) || (GcdDescriptor.GcdMemoryType != EfiGcdMemoryTypeReserved)) {
+  Status = SmmStoreLibComBufferAsRuntimeMmio ();
+  if (EFI_ERROR (Status)) {
     DEBUG ((
-      DEBUG_INFO,
-      "%a: No memory space descriptor for com buffer found\n",
-      __func__
+      DEBUG_WARN,
+      "%a: com buffer at 0x%lx not runtime MMIO: %r\n",
+      __func__,
+      mSmmStoreInfo->ComBuffer,
+      Status
       ));
 
+    Status = gDS->GetMemorySpaceDescriptor (mSmmStoreInfo->ComBuffer, &GcdDescriptor);
+    if (EFI_ERROR (Status) ||
+        ((GcdDescriptor.GcdMemoryType != EfiGcdMemoryTypeReserved) &&
+         (GcdDescriptor.GcdMemoryType != EfiGcdMemoryTypeMemoryMappedIo)))
+    {
+      DEBUG ((
+        DEBUG_INFO,
+        "%a: No memory space descriptor for com buffer found\n",
+        __func__
+        ));
+
+      //
+      // Add a new entry if not covered by existing mapping
+      //
+      Status = gDS->AddMemorySpace (
+                      EfiGcdMemoryTypeReserved,
+                      mSmmStoreInfo->ComBuffer,
+                      mSmmStoreInfo->ComBufferSize,
+                      EFI_MEMORY_WB | EFI_MEMORY_RUNTIME
+                      );
+      ASSERT_EFI_ERROR (Status);
+    }
+
     //
-    // Add a new entry if not covered by existing mapping
+    // Mark as runtime service
     //
-    Status = gDS->AddMemorySpace (
-                    EfiGcdMemoryTypeReserved,
+    Status = gDS->SetMemorySpaceAttributes (
                     mSmmStoreInfo->ComBuffer,
                     mSmmStoreInfo->ComBufferSize,
-                    EFI_MEMORY_WB | EFI_MEMORY_RUNTIME
+                    EFI_MEMORY_RUNTIME
                     );
     ASSERT_EFI_ERROR (Status);
   }
 
-  //
-  // Mark as runtime service
-  //
-  Status = gDS->SetMemorySpaceAttributes (
-                  mSmmStoreInfo->ComBuffer,
-                  mSmmStoreInfo->ComBufferSize,
-                  EFI_MEMORY_RUNTIME
-                  );
-  ASSERT_EFI_ERROR (Status);
-
   //
   // Mark the memory mapped store as MMIO memory
   //
