+    Status = gBS->InstallMultipleProtocolInterfaces (
+                    &ImageHandle,
+                    &gEdkiiPlatformVariableReclaimProtocolGuid,
+                    &mPlatformVariableReclaim,
+                    NULL
+                    );
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_WARN, "%a: no reclaim by the platform: %r\n", __func__, Status));
+    }
+  }
+
   mSmmStoreInstance = AllocateRuntimeCopyPool (sizeof (SMMSTORE_INSTANCE), &mSmmStoreInstanceTemplate);
   if (mSmmStoreInstance == NULL) {
     SmmStoreLibDeinitialize ();
