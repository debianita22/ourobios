diff --git a/UefiPayloadPkg/SmmStoreFvb/SmmStoreFvbRuntime.c b/UefiPayloadPkg/SmmStoreFvb/SmmStoreFvbRuntime.c
index 53d2557b5..dc61e81ed 100644
--- a/UefiPayloadPkg/SmmStoreFvb/SmmStoreFvbRuntime.c
+++ b/UefiPayloadPkg/SmmStoreFvb/SmmStoreFvbRuntime.c
@@ -14,11 +14,17 @@
 #include <Library/UefiBootServicesTableLib.h>
 #include <Library/PcdLib.h>
 #include <Library/SmmStoreLib.h>
+#include <Protocol/PlatformVariableReclaim.h>
 
 #include "SmmStoreFvbRuntime.h"
 
 STATIC EFI_EVENT  mSmmStoreVirtualAddrChangeEvent;
 
+//
+// One block, to build each block of the staging area of a reclaim
+//
+STATIC UINT8  *mReclaimBlock;
+
 //
 // Global variable declarations
 //
@@ -121,6 +127,104 @@ SmmStoreInitInstance (
   return Status;
 }
 
+/**
+  The reclaim of the variable store while coreboot keeps a lock armed
+  (SMMSTORE_CMD_RECLAIM): the reclaimed store, with the firmware volume header
+  before it, written into the staging area, the store_end bytes before the
+  last block of the region, then put in place of the store by coreboot once
+  it has checked it whole. The fault tolerant write cannot do it then: the
+  locks refuse its writes past the store.
+
+  Each step that fails gives its own status, which the OS sees as the error of
+  the write that needed the reclaim (efivarfs: EIO, EINTR, EROFS, EACCES).
+
+  @retval EFI_UNSUPPORTED        No lock armed, or no such reclaim in coreboot,
+                                 or no room for the staging area: the fault
+                                 tolerant write reclaims, when it is available.
+  @retval EFI_DEVICE_ERROR       coreboot refused the reclaim now (its limits).
+  @retval EFI_ABORTED            The header of the firmware volume not read.
+  @retval EFI_WRITE_PROTECTED    The staging area could not be written.
+  @retval EFI_SECURITY_VIOLATION coreboot refused the image, or failed the swap.
+**/
+STATIC
+EFI_STATUS
+EFIAPI
+SmmStoreFvbReclaim (
+  IN EFI_LBA     Lba,
+  IN UINTN       Offset,
+  IN UINTN       NumBytes,
+  IN CONST VOID  *Buffer
+  )
+{
+  UINTN       BlockSize;
+  UINTN       RegionSize;
+  UINTN       Start;
+  UINTN       StoreEnd;
+  UINTN       Staging;
+  UINTN       Block;
+  UINTN       Header;
+  UINTN       Size;
+  EFI_STATUS  Status;
+
+  if ((mSmmStoreInstance == NULL) || (mReclaimBlock == NULL)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  BlockSize  = mSmmStoreInstance->BlockSize;
+  RegionSize = (mSmmStoreInstance->LastBlock + 1) * BlockSize;
+  Start      = (UINTN)Lba * BlockSize + Offset;
+  StoreEnd   = Start + NumBytes;
+  if ((StoreEnd % BlockSize != 0) || (RegionSize < 2 * StoreEnd + 2 * BlockSize)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  Staging = RegionSize - BlockSize - StoreEnd;
+
+  Status = SmmStoreLibReclaim (SMMSTORE_RECLAIM_STATUS);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  for (Block = 0; Block < StoreEnd / BlockSize; Block++) {
+    //
+    // Below the store, the firmware volume header as the flash has it
+    //
+    Header = 0;
+    if (Block * BlockSize < Start) {
+      Header = MIN (Start - Block * BlockSize, BlockSize);
+      Size   = Header;
+      Status = SmmStoreLibRead (Block, 0, &Size, mReclaimBlock);
+      if (EFI_ERROR (Status) || (Size != Header)) {
+        return EFI_ABORTED;
+      }
+    }
+
+    CopyMem (
+      mReclaimBlock + Header,
+      (CONST UINT8 *)Buffer + Block * BlockSize + Header - Start,
+      BlockSize - Header
+      );
+
+    Status = SmmStoreLibEraseBlock ((Staging / BlockSize) + Block);
+    if (EFI_ERROR (Status)) {
+      return EFI_WRITE_PROTECTED;
+    }
+
+    Size   = BlockSize;
+    Status = SmmStoreLibWrite ((Staging / BlockSize) + Block, 0, &Size, mReclaimBlock);
+    if (EFI_ERROR (Status)) {
+      return EFI_WRITE_PROTECTED;
+    }
+  }
+
+  Status = SmmStoreLibReclaim (SMMSTORE_RECLAIM_COMMIT);
+  return EFI_ERROR (Status) ? EFI_SECURITY_VIOLATION : EFI_SUCCESS;
+}
+
+STATIC EDKII_PLATFORM_VARIABLE_RECLAIM_PROTOCOL  mPlatformVariableReclaim = {
+  SmmStoreFvbReclaim
+};
+
