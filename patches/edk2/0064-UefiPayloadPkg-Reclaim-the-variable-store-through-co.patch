diff --git a/MdeModulePkg/Include/Protocol/PlatformVariableReclaim.h b/MdeModulePkg/Include/Protocol/PlatformVariableReclaim.h
new file mode 100644
index 000000000..dfa8e9c08
--- /dev/null
+++ b/MdeModulePkg/Include/Protocol/PlatformVariableReclaim.h
@@ -0,0 +1,53 @@
+/** @file
+  The reclaim of the variable store by the platform, for the variable driver
+  that runs outside SMM.
+
+  A platform whose firmware locks the variable store against writes that
+  would change what it protects (on a coreboot payload, the option lock and
+  the MOR lock kept in coreboot's SMM) can refuse the fault tolerant write of
+  a reclaim, which erases the store and copies it back from its spare blocks.
+  Such a platform installs this protocol: the variable driver hands it the
+  reclaimed store, and the platform puts it in place of the store once it has
+  checked it whole, also at runtime, where the fault tolerant write is not
+  available. Every function is callable at runtime.
+
+  Copyright (c) 2026, Domenico D'Arrigo. All rights reserved.<BR>
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef PLATFORM_VARIABLE_RECLAIM_H_
+#define PLATFORM_VARIABLE_RECLAIM_H_
+
+#define EDKII_PLATFORM_VARIABLE_RECLAIM_PROTOCOL_GUID \
+  { 0xe71102e1, 0xf37e, 0x4c09, { 0xa9, 0x39, 0x5e, 0xff, 0x3e, 0x95, 0xc1, 0xb9 } }
+
+/**
+  Put the reclaimed store in place of the store: NumBytes of Buffer at Offset
+  of block Lba of the firmware volume of the variables, where the store is.
+
+  @param[in] Lba       The block of the firmware volume where the store begins.
+  @param[in] Offset    The offset of the store in that block.
+  @param[in] NumBytes  The size of the store.
+  @param[in] Buffer    The reclaimed store.
+
+  @retval EFI_SUCCESS       The store is the reclaimed one.
+  @retval EFI_UNSUPPORTED   Not by the platform now: the fault tolerant write
+                            reclaims, when it is available.
+  @retval Others            Refused or failed: the store is as it was.
+**/
+typedef
+EFI_STATUS
+(EFIAPI *EDKII_PLATFORM_VARIABLE_RECLAIM_RECLAIM)(
+  IN EFI_LBA     Lba,
+  IN UINTN       Offset,
+  IN UINTN       NumBytes,
+  IN CONST VOID  *Buffer
+  );
+
+typedef struct {
+  EDKII_PLATFORM_VARIABLE_RECLAIM_RECLAIM    Reclaim;
+} EDKII_PLATFORM_VARIABLE_RECLAIM_PROTOCOL;
+
+extern EFI_GUID  gEdkiiPlatformVariableReclaimProtocolGuid;
+
+#endif
