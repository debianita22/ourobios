diff --git a/UefiPayloadPkg/Include/Library/SmmStoreLib.h b/UefiPayloadPkg/Include/Library/SmmStoreLib.h
index 021444a38..6a5178822 100644
--- a/UefiPayloadPkg/Include/Library/SmmStoreLib.h
+++ b/UefiPayloadPkg/Include/Library/SmmStoreLib.h
@@ -265,6 +265,33 @@ SmmStoreLibMorLock (
   IN CONST UINT8   *Key OPTIONAL
   );
 
+//
+// SmmStoreLibReclaim(): the operations of SMMSTORE_CMD_RECLAIM
+//
+#define SMMSTORE_RECLAIM_STATUS  0
+#define SMMSTORE_RECLAIM_COMMIT  1
+
+/**
+  The reclaim of the variable store that coreboot does in SMM while a lock is
+  armed: STATUS asks whether one would be considered now, COMMIT puts the image
+  written into the staging area (the bytes of the store, the firmware volume
+  header included, just before the last block of the region) in place of the
+  store, once coreboot has checked it whole.
+
+  @param[in] Op   SMMSTORE_RECLAIM_STATUS or SMMSTORE_RECLAIM_COMMIT.
+
+  @retval EFI_SUCCESS       Would be considered (STATUS); done (COMMIT).
+  @retval EFI_NO_MEDIA      SmmStore is not initialized.
+  @retval EFI_UNSUPPORTED   No lock armed, or no such reclaim in coreboot.
+  @retval EFI_DEVICE_ERROR  Refused: four a boot, the store more than a quarter
+                            free, or the image.
+
+**/
+EFI_STATUS
+SmmStoreLibReclaim (
+  IN UINT32  Op
+  );
+
 typedef EFI_STATUS EFIAPI (*CONVERT_POINTER_CALLBACK) (
   IN UINTN     DebugDisposition,
   IN OUT VOID  **Address
diff --git a/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c b/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c
index 5b502e77f..f80a21b0b 100644
--- a/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c
+++ b/UefiPayloadPkg/Library/SmmStoreLib/SmmStore.c
@@ -549,6 +549,38 @@ SmmStoreLibMorLock (
   return Status;
 }
 
+/**
+  The reclaim of the variable store that coreboot does in SMM while a lock is
+  armed (SMMSTORE_CMD_RECLAIM): STATUS asks whether one would be considered
+  now, COMMIT puts the image that the caller wrote into the staging area in
+  place of the store, once coreboot has checked it whole. Allocates nothing.
+
+  @param[in] Op   SMMSTORE_RECLAIM_STATUS or SMMSTORE_RECLAIM_COMMIT.
+
+  @retval EFI_SUCCESS       Would be considered (STATUS); done (COMMIT).
+  @retval EFI_NO_MEDIA      SmmStore is not initialized.
+  @retval EFI_UNSUPPORTED   No lock armed, or no reclaim in this coreboot: the
+                            fault tolerant write reclaims.
+  @retval EFI_DEVICE_ERROR  Refused (the limits, or the image).
+
+**/
+EFI_STATUS
+SmmStoreLibReclaim (
+  IN UINT32  Op
+  )
+{
+  EFI_STATUS  Status;
+
+  if (mSmmStoreInfo == NULL) {
+    return EFI_NO_MEDIA;
+  }
+
+  mArgComBuf->Reclaim.Op = Op;
+  Status                 = CallSmm (mSmmStoreInfo->ApmCmd, SMMSTORE_CMD_RECLAIM, mArgComBufPhys);
+  ZeroMem (&mArgComBuf->Reclaim, sizeof (mArgComBuf->Reclaim));
+  return Status;
+}
+
