   ## Whether capsules are allowed to persist across reset.
   gEfiMdeModulePkgTokenSpaceGuid.PcdSupportUpdateCapsuleReset|$(CAPSULE_SUPPORT)
+!if $(VARIABLE_SUPPORT) == "SMMSTORE"
+  ## coreboot honors TCG MOR itself (clear_dram_on_boot "When the OS asks"):
+  ## MorControlDxe, not the variable driver, decides whether the variable exists
+  gEfiMdeModulePkgTokenSpaceGuid.PcdTcgMorWithoutSmm|TRUE
+!endif
 
 
   #
@@ -1513,6 +1518,7 @@
       NULL|MdeModulePkg/Library/VarCheckUefiLib/VarCheckUefiLib.inf
       NULL|EmbeddedPkg/Library/NvVarStoreFormattedLib/NvVarStoreFormattedLib.inf
   }
+  UefiPayloadPkg/MorControlDxe/MorControlDxe.inf
 !elseif $(VARIABLE_SUPPORT) == "SPI"
   MdeModulePkg/Universal/Variable/RuntimeDxe/VariableSmm.inf {
     <LibraryClasses>
