 .../UefiPayloadEntry/Tcg2EventLog.c           | 214 ++++++++++++++++++
 .../UefiPayloadEntry/UefiPayloadEntry.c       |   5 +
 .../UefiPayloadEntry/UefiPayloadEntry.h       |  11 +
 .../UefiPayloadEntry/UefiPayloadEntry.inf     |   3 +
