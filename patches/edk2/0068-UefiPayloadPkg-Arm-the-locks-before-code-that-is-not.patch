+
+[Defines]
+  INF_VERSION                    = 0x00010005
+  BASE_NAME                      = ThirdPartyImageLockLib
+  FILE_GUID                      = 5E59667E-08B9-4EA5-A1E8-DF4D15AF85EB
+  MODULE_TYPE                    = DXE_DRIVER
+  VERSION_STRING                 = 1.0
+  LIBRARY_CLASS                  = NULL|DXE_DRIVER
+  CONSTRUCTOR                    = ThirdPartyImageLockLibConstructor
+
+[Sources]
+  ThirdPartyImageLockLib.c
+
+[Packages]
+  MdePkg/MdePkg.dec
+  MdeModulePkg/MdeModulePkg.dec
+  UefiPayloadPkg/UefiPayloadPkg.dec
+
+[LibraryClasses]
