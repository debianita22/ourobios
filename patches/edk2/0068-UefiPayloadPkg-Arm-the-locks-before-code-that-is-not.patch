diff --git a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenu.h b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenu.h
index 87c8ad6f9..9a0816ac7 100644
--- a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenu.h
+++ b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenu.h
@@ -77,6 +77,20 @@ CfrCleanupLockAtBoot (
   VOID
   );
 
+/**
+  Whether an image that is not part of the firmware was loaded before a boot
+  was started (gUefiPayloadThirdPartyImageEventGroupGuid): the platform armed
+  its locks then, before the setup could be opened.
+
+  @retval TRUE   One was loaded: the options are locked for this boot.
+  @retval FALSE  None.
+**/
+BOOLEAN
+EFIAPI
+CfrThirdPartyImageLoaded (
+  VOID
+  );
+
 /**
   Register the EndOfDxe callback that links the pages of other drivers from
   the categories, once their formsets are installed.
diff --git a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c
index 5df4ceae2..586bbcff2 100644
--- a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c
+++ b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c
@@ -22,6 +22,7 @@
 #include <Library/UefiRuntimeServicesTableLib.h>
 #include <Guid/CfrSetupMenuGuid.h>
 #include <Guid/VariableFormat.h>
+#include <Guid/ThirdPartyImage.h>
 
 //
 // CFR_OPTFLAG_LOCK_AT_BOOT: the setup may still write the option in this
@@ -39,6 +40,8 @@
 STATIC EFI_EVENT  mLockAtBootEvent      = NULL;
 STATIC BOOLEAN    mLockAtBootRegistered = FALSE;
 STATIC BOOLEAN    mLockAtBootApplied    = FALSE;
+STATIC EFI_EVENT  mThirdPartyImageEvent = NULL;
+STATIC BOOLEAN    mThirdPartyImage      = FALSE;
 
 /**
   Register, before EndOfDxe, the rule that write-locks a CFR option variable
@@ -132,9 +135,45 @@ CfrApplyLockAtBoot (
   }
 }
 
+/**
+  An image that is not part of the firmware is about to be loaded before a
+  boot was started (an option ROM, a Driver#### or a SysPrep#### option): the
+  platform armed its locks, and the options with CFR_OPTFLAG_LOCK_AT_BOOT
+  lock now as at ReadyToBoot, for the same reason.
+
+**/
+STATIC
+VOID
+EFIAPI
+CfrThirdPartyImageNotify (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  mThirdPartyImage = TRUE;
+  if (mLockAtBootRegistered) {
+    CfrApplyLockAtBoot (Event, Context);
+  }
+}
+
+/**
+  Whether an image that is not part of the firmware was loaded before a boot
+  was started.
+
+**/
+BOOLEAN
+EFIAPI
+CfrThirdPartyImageLoaded (
+  VOID
+  )
+{
+  return mThirdPartyImage;
+}
+
 /**
   Register a ReadyToBoot callback that write-locks CFR variables marked
-  CFR_OPTFLAG_LOCK_AT_BOOT.
+  CFR_OPTFLAG_LOCK_AT_BOOT, and the same for an image that is not part of the
+  firmware loaded before that.
 
 **/
 EFI_STATUS
@@ -145,6 +184,21 @@ CfrRegisterLockAtBootEvent (
 {
   EFI_STATUS  Status;
 
+  if (mThirdPartyImageEvent == NULL) {
+    Status = gBS->CreateEventEx (
+                    EVT_NOTIFY_SIGNAL,
+                    TPL_CALLBACK,
+                    CfrThirdPartyImageNotify,
+                    NULL,
+                    &gUefiPayloadThirdPartyImageEventGroupGuid,
+                    &mThirdPartyImageEvent
+                    );
+    if (EFI_ERROR (Status)) {
+      mThirdPartyImageEvent = NULL;
+      DEBUG ((DEBUG_WARN, "CFR: No event for the images loaded before a boot: %r\n", Status));
+    }
+  }
+
   if (!mLockAtBootRegistered || (mLockAtBootEvent != NULL)) {
     return EFI_SUCCESS;
   }
@@ -181,6 +235,11 @@ CfrCleanupLockAtBoot (
     mLockAtBootEvent = NULL;
   }
 
+  if (mThirdPartyImageEvent != NULL) {
+    gBS->CloseEvent (mThirdPartyImageEvent);
+    mThirdPartyImageEvent = NULL;
+  }
+
   mLockAtBootApplied = FALSE;
 }
 
diff --git a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuHii.c b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuHii.c
index e5b6d0e6d..6123ccb04 100644
--- a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuHii.c
+++ b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuHii.c
@@ -17,6 +17,7 @@
 #include <Library/UefiLib.h>
 #include <Library/UefiBootServicesTableLib.h>
 #include <Library/UefiRuntimeServicesTableLib.h>
+#include <Guid/GlobalVariable.h>
 #include <Guid/VariableFormat.h>
 #include <Protocol/HiiPopup.h>
 
@@ -230,6 +231,130 @@ OptionLockArmed (
   return ((EFI_STATUS)LockStatus != EFI_UNSUPPORTED) && ((EFI_STATUS)LockStatus != EFI_NO_MEDIA);
 }
 
+/**
+  Restart into the setup: the request that an OS makes of the firmware
+  (EFI_OS_INDICATIONS_BOOT_TO_FW_UI), which the next boot answers by opening
+  the setup before any image that is not part of the firmware is loaded
+  (ThirdPartyImageLockLib), with the locks open. Returns only if the request
+  could not be written.
+**/
+STATIC
+VOID
+RestartIntoSetup (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  UINT64      OsIndications;
+  UINTN       Size;
+
+  OsIndications = 0;
+  Size          = sizeof (OsIndications);
+  Status        = gRT->GetVariable (
+                         EFI_OS_INDICATIONS_VARIABLE_NAME,
+                         &gEfiGlobalVariableGuid,
+                         NULL,
+                         &Size,
+                         &OsIndications
+                         );
+  if (EFI_ERROR (Status) || (Size != sizeof (OsIndications))) {
+    OsIndications = 0;
+  }
+
+  OsIndications |= EFI_OS_INDICATIONS_BOOT_TO_FW_UI;
+  Status         = gRT->SetVariable (
+                          EFI_OS_INDICATIONS_VARIABLE_NAME,
+                          &gEfiGlobalVariableGuid,
+                          EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS,
+                          sizeof (OsIndications),
+                          &OsIndications
+                          );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_WARN, "CFR: the restart into the setup could not be asked for: %r\n", Status));
+    return;
+  }
+
+  gRT->ResetSystem (EfiResetCold, EFI_SUCCESS, 0, NULL);
+}
+
+/**
+  The settings are locked because an image that is not part of the firmware
+  was loaded before the setup: a restart does not change that, the image
+  runs again. Offer the restart into the setup, which loads none.
+
+  The browser routes each option of a form on its own, and each one fails:
+  the question is asked once for the options of a form, and again when the
+  user tries to save later.
+**/
+STATIC
+VOID
+ShowThirdPartyLocked (
+  VOID
+  )
+{
+  STATIC BOOLEAN           Asked = FALSE;
+  STATIC UINT32            AskedAt;
+  EFI_HII_POPUP_PROTOCOL   *HiiPopup;
+  EFI_HII_POPUP_SELECTION  Selection;
+  EFI_INPUT_KEY            Key;
+  EFI_TIME                 Time;
+  UINT32                   Now;
+
+  //
+  // Seconds of the day: without a clock, once in a boot
+  //
+  Now = MAX_UINT32;
+  if (!EFI_ERROR (gRT->GetTime (&Time, NULL))) {
+    Now = (UINT32)Time.Hour * 3600 + (UINT32)Time.Minute * 60 + Time.Second;
+  }
+
+  if (Asked && ((Now == MAX_UINT32) || ((Now >= AskedAt) && (Now - AskedAt < 3)))) {
+    AskedAt = Now;
+    return;
+  }
+
+  Asked     = TRUE;
+  Selection = EfiHiiPopupSelectionNo;
+  if (EFI_ERROR (gBS->LocateProtocol (&gEfiHiiPopupProtocolGuid, NULL, (VOID **)&HiiPopup)) ||
+      EFI_ERROR (
+        HiiPopup->CreatePopup (
+                    HiiPopup,
+                    EfiHiiPopupStyleError,
+                    EfiHiiPopupTypeYesNo,
+                    mSetupMenuPrivate.HiiHandle,
+                    STRING_TOKEN (STR_OPTIONS_LOCKED_THIRD_PARTY),
+                    &Selection
+                    )
+        ))
+  {
+    CreatePopUp (
+      EFI_LIGHTGRAY | EFI_BACKGROUND_BLUE,
+      &Key,
+      L"The settings are locked in this boot: a driver that is not part of the",
+      L"firmware (an option ROM, a Driver or SysPrep option) started before the setup.",
+      L"",
+      L"Press Y to restart into the setup without it, any other key to go on.",
+      L"What was changed here is not saved.",
+      NULL
+      );
+    if ((Key.UnicodeChar == L'Y') || (Key.UnicodeChar == L'y')) {
+      Selection = EfiHiiPopupSelectionYes;
+    }
+  }
+
+  if (Selection == EfiHiiPopupSelectionYes) {
+    RestartIntoSetup ();
+  }
+
+  //
+  // After the answer: the time the user took is not time between two options
+  //
+  AskedAt = Now;
+  if (!EFI_ERROR (gRT->GetTime (&Time, NULL))) {
+    AskedAt = (UINT32)Time.Hour * 3600 + (UINT32)Time.Minute * 60 + Time.Second;
+  }
+}
+
 /**
   Say, once, why the settings are not saved: the browser only reports that
   the form could not be submitted.
@@ -245,6 +370,11 @@ ShowOptionsLocked (
   EFI_HII_POPUP_SELECTION  Selection;
   EFI_INPUT_KEY            Key;
 
+  if (CfrThirdPartyImageLoaded ()) {
+    ShowThirdPartyLocked ();
+    return;
+  }
+
   if (Shown) {
     return;
   }
