                             #language fr-FR  "The settings are locked until the next restart: a boot was started. Restart and open the setup again to change them."
+#string STR_OPTIONS_LOCKED_THIRD_PARTY  #language en-US  "The settings are locked in this boot: a driver that is not part of the firmware (an option ROM, a Driver or SysPrep option) started before the setup. Restart into the setup without it now? What was changed here is not saved."
diff --git a/UefiPayloadPkg/Include/Guid/ThirdPartyImage.h b/UefiPayloadPkg/Include/Guid/ThirdPartyImage.h
new file mode 100644
index 000000000..63c7c0036
--- /dev/null
+++ b/UefiPayloadPkg/Include/Guid/ThirdPartyImage.h
@@ -0,0 +1,26 @@
+/** @file
+  The event group that says that an image that is not part of the firmware is
+  about to be loaded before a boot was started.
+
+  Until a boot option is started (ReadyToBoot) the setup may change the
+  settings of the firmware, and the locks that keep an OS from changing them
+  are not armed yet. An option ROM, a Driver#### option and a SysPrep####
+  option run in that window. ThirdPartyImageLockLib arms the locks before the
+  first such image is loaded and then signals this group once, for the
+  modules that keep their own state of the locks.
+
+  Copyright (c) 2026, ouroBIOS contributors
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef THIRD_PARTY_IMAGE_H_
+#define THIRD_PARTY_IMAGE_H_
+
+#define THIRD_PARTY_IMAGE_EVENT_GROUP_GUID \
+  { \
+    0xa44c4d4f, 0x13c8, 0x4857, { 0xbf, 0x6d, 0xb0, 0x0d, 0x51, 0xbc, 0x12, 0x36 } \
+  }
+
+extern EFI_GUID  gUefiPayloadThirdPartyImageEventGroupGuid;
+
+#endif
diff --git a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c
index 13a43b586..e2462dbad 100644
--- a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c
+++ b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c
@@ -705,6 +705,13 @@ PlatformBootManagerBeforeConsole (
   //
   PlatformRegisterOptionLockPolicy ();
 
+  //
+  // The locks of the firmware slots and of the setup options, before the
+  // boot manager loads anything that is not part of the firmware: the
+  // deferred images just below, then the Driver#### options.
+  //
+  PlatformRegisterFirmwareLocks ();
+
   //
   // Install ready to lock.
   // This needs to be done before option rom dispatched.
diff --git a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.h b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.h
index d91e98478..a027c33bc 100644
--- a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.h
+++ b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.h
@@ -166,11 +166,6 @@ PlatformProcessCapsules (
   VOID
   );
 
-/**
-  Tell coreboot that the firmware booted, so that vboot keeps a new RW slot
-  that it is trying; lock the switch to the other slot before a boot option
-  starts and at ExitBootServices().
-**/
 /**
   Make OptionLockStatus read-only once it exists; before EndOfDxe.
 **/
@@ -179,6 +174,21 @@ PlatformRegisterOptionLockPolicy (
   VOID
   );
 
+/**
+  Register the locks of the firmware slots and of the setup options: armed
+  before a boot option starts, at ExitBootServices() and before an image that
+  is not part of the firmware is loaded ahead of those. After the capsules,
+  before EndOfDxe.
+**/
+VOID
+PlatformRegisterFirmwareLocks (
+  VOID
+  );
+
+/**
+  Tell coreboot that the firmware booted, so that vboot keeps a new RW slot
+  that it is trying.
+**/
 VOID
 PlatformMarkFirmwareGood (
   VOID
diff --git a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManagerLib.inf b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManagerLib.inf
index b4cd16166..4434dde40 100644
--- a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManagerLib.inf
+++ b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManagerLib.inf
@@ -63,12 +63,13 @@
   gEfiEndOfDxeEventGroupGuid
   gEfiEventExitBootServicesGuid   ## CONSUMES ## Event
   gEfiEventReadyToBootGuid        ## CONSUMES ## Event
+  gUefiPayloadThirdPartyImageEventGroupGuid ## CONSUMES ## Event
   gUefiShellFileGuid
   gUefiPayloadBootSplashGuid
   gEfiCapsuleReportGuid           ## CONSUMES ## Variable:L"CapsuleLast"
   gEfiFileInfoGuid                ## CONSUMES
   gEfiPartTypeSystemPartGuid      ## CONSUMES
-  gEficorebootNvDataGuid          ## CONSUMES ## Variable:L"ipxe_boot" L"csmwrap_boot" L"usb_boot" L"boot_menu_prompt"; PRODUCES ## Variable:L"OptionLockStatus"
+  gEficorebootNvDataGuid          ## CONSUMES ## Variable:L"ipxe_boot" L"csmwrap_boot" L"usb_boot" L"boot_menu_prompt"; PRODUCES ## Variable:L"OptionLockStatus" L"OptionLockEarly"
   gEfiGlobalVariableGuid          ## CONSUMES ## Variable:L"SecureBoot"
 
 [Protocols]
diff --git a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformCapsule.c b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformCapsule.c
index 2afe01069..4bff23671 100644
--- a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformCapsule.c
+++ b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformCapsule.c
@@ -26,6 +26,7 @@
 #include <Guid/CapsuleReport.h>
 #include <Guid/FileInfo.h>
 #include <Guid/Gpt.h>
+#include <Guid/ThirdPartyImage.h>
 #include <Library/SmmStoreLib.h>
 #include <Library/VariablePolicyHelperLib.h>
 #include <Protocol/VariablePolicy.h>
@@ -487,6 +488,10 @@ CapsuleApply (
 
 STATIC BOOLEAN  mFirmwareSlotsLocked;
 STATIC BOOLEAN  mOptionLockReported;
+//
+// SmmStoreLib is initialized, and stays so, for the locks
+//
+STATIC BOOLEAN  mLocksRegistered;
 
 /**
   Before EndOfDxe, which closes Variable Policy to new rules: OptionLockStatus
@@ -517,6 +522,24 @@ PlatformRegisterOptionLockPolicy (
 
   if (EFI_ERROR (Status)) {
     DEBUG ((DEBUG_WARN, "Capsules: no Variable Policy for OptionLockStatus: %r\n", Status));
+    return;
+  }
+
+  //
+  // The same for OptionLockEarly (PlatformReportEarlyLock())
+  //
+  Status = RegisterBasicVariablePolicy (
+             VariablePolicy,
+             &gEficorebootNvDataGuid,
+             L"OptionLockEarly",
+             VARIABLE_POLICY_NO_MIN_SIZE,
+             VARIABLE_POLICY_NO_MAX_SIZE,
+             VARIABLE_POLICY_NO_MUST_ATTR,
+             EFI_VARIABLE_NON_VOLATILE,
+             VARIABLE_POLICY_TYPE_LOCK_ON_CREATE
+             );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_WARN, "Capsules: no Variable Policy for OptionLockEarly: %r\n", Status));
   }
 }
 
@@ -560,9 +583,44 @@ PlatformReportOptionLock (
 }
 
 /**
-  A boot option or an OS is about to start: from now on, only an update
-  capsule, with its checks, may change the RW slot that vboot boots.
-  Allocates nothing.
+  Tell the OS that the locks were armed before the setup could be opened,
+  for an image that is not part of the firmware loaded before any boot
+  option: the volatile variable OptionLockEarly of the coreboot options
+  GUID, one byte, 1. In such a boot the setup cannot save, and where it
+  happens at every boot, for the option ROM of a device, the settings change
+  only after a restart into the setup: tools/hw-report.py says so (FLASH-01).
+  Lock on create, as OptionLockStatus.
+**/
+STATIC
+VOID
+PlatformReportEarlyLock (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  UINT8       Early;
+
+  Early  = 1;
+  Status = gRT->SetVariable (
+                  L"OptionLockEarly",
+                  &gEficorebootNvDataGuid,
+                  EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS,
+                  sizeof (Early),
+                  &Early
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_WARN, "Capsules: OptionLockEarly not written: %r\n", Status));
+  }
+}
+
+/**
+  A boot option, an OS or an image that is not part of the firmware is about
+  to start: from now on, only an update capsule, with its checks, may change
+  the RW slot that vboot boots. Allocates nothing.
+
+  @param[in] Event    The event.
+  @param[in] Context  Not NULL for the event of an image that is not part of
+                      the firmware (PlatformRegisterFirmwareLocks()).
 **/
 STATIC
 VOID
@@ -578,14 +636,18 @@ PlatformLockFirmwareSlots (
     return;
   }
 
+  if (Context != NULL) {
+    PlatformReportEarlyLock ();
+  }
+
   Status               = SmmStoreLibVbootLockSlots ();
   mFirmwareSlotsLocked = !EFI_ERROR (Status);
   DEBUG ((DEBUG_INFO, "Capsules: switch to the other firmware slot locked: %r\n", Status));
 
   //
-  // The setup could have changed the security options (bios_lock,
-  // bootmedia_lock) in this boot; from here, before a boot option or an OS
-  // runs, coreboot keeps the OS from turning them off.
+  // The setup could have changed its options in this boot; from here, before
+  // a boot option, an OS or an image that is not part of the firmware runs,
+  // coreboot keeps them as they are.
   //
   Status = SmmStoreLibOptionLock ();
   DEBUG ((DEBUG_INFO, "Capsules: security options write-locked: %r\n", Status));
@@ -593,42 +655,36 @@ PlatformLockFirmwareSlots (
 }
 
 /**
-  Tell coreboot that the firmware booted: with vboot, a new RW slot that it is
-  trying (after an update) is then kept, instead of being given up for the
-  other one when its tries run out.  Called once the console is up.
-
-  With two RW slots, the setup can also switch to the other slot (the
-  Firmware Update page); coreboot refuses that once a boot option starts
-  (ReadyToBoot, which booting the setup does not signal) or anything calls
-  ExitBootServices().
+  Register the locks of the firmware slots and of the setup options. They are
+  armed when a boot option is started (ReadyToBoot, which booting the setup
+  does not signal), when anything calls ExitBootServices(), and when an image
+  that is not part of the firmware is loaded before either: an option ROM, a
+  Driver#### or a SysPrep#### option. ThirdPartyImageLockLib arms them in
+  SMM itself before such an image and signals the event; what is left to do
+  here is the report of the lock, for the setup and for the OS.
+
+  To be called after the capsules of the boot and before EndOfDxe, after
+  which the boot manager loads such images. The events were registered once
+  the console was up, after the option ROMs and the Driver#### options: an
+  image started from one of those ran with the locks open, even when it
+  called ExitBootServices().
+
+  The library stays initialized for the events: at ExitBootServices() it
+  cannot allocate.  Without every event, lock now: the setup then cannot
+  switch slots or save in this boot.
 **/
 VOID
-PlatformMarkFirmwareGood (
+PlatformRegisterFirmwareLocks (
   VOID
   )
 {
-  EFI_STATUS  Status;
-  EFI_EVENT   Event;
+  EFI_EVENT  Event;
 
   if (EFI_ERROR (SmmStoreLibInitialize ())) {
     return;
   }
 
-  Status = SmmStoreLibVbootSlotGood ();
-  if (Status != EFI_UNSUPPORTED) {
-    DEBUG ((DEBUG_INFO, "Capsules: firmware slot marked good: %r\n", Status));
-  }
-
-  if (Status == EFI_UNSUPPORTED) {
-    SmmStoreLibDeinitialize ();
-    return;
-  }
-
-  //
-  // The library stays initialized for the lock: at ExitBootServices() it
-  // cannot allocate.  Without both events, lock now: the setup then cannot
-  // switch slots in this boot.
-  //
+  mLocksRegistered = TRUE;
   if (EFI_ERROR (EfiCreateEventReadyToBootEx (TPL_CALLBACK, PlatformLockFirmwareSlots, NULL, &Event)) ||
       EFI_ERROR (
         gBS->CreateEventEx (
@@ -639,13 +695,49 @@ PlatformMarkFirmwareGood (
                &gEfiEventExitBootServicesGuid,
                &Event
                )
+        ) ||
+      EFI_ERROR (
+        gBS->CreateEventEx (
+               EVT_NOTIFY_SIGNAL,
+               TPL_CALLBACK,
+               PlatformLockFirmwareSlots,
+               &mLocksRegistered,
+               &gUefiPayloadThirdPartyImageEventGroupGuid,
+               &Event
+               )
         ))
   {
-    DEBUG ((DEBUG_ERROR, "Capsules: no event for the lock of the firmware slots\n"));
+    DEBUG ((DEBUG_ERROR, "Capsules: no event for the locks of the firmware\n"));
     PlatformLockFirmwareSlots (NULL, NULL);
   }
 }
 
+/**
+  Tell coreboot that the firmware booted: with vboot, a new RW slot that it is
+  trying (after an update) is then kept, instead of being given up for the
+  other one when its tries run out.  Called once the console is up.
+
+  With two RW slots, the setup can also switch to the other slot (the
+  Firmware Update page); coreboot refuses that once the locks are armed
+  (PlatformRegisterFirmwareLocks()).
+**/
+VOID
+PlatformMarkFirmwareGood (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+
+  if (!mLocksRegistered) {
+    return;
+  }
+
+  Status = SmmStoreLibVbootSlotGood ();
+  if (Status != EFI_UNSUPPORTED) {
+    DEBUG ((DEBUG_INFO, "Capsules: firmware slot marked good: %r\n", Status));
+  }
+}
+
 /**
   Apply the update capsules of this boot, if it has any, and reset after
   applying one.  Otherwise make sure that the whole flash is no longer
diff --git a/UefiPayloadPkg/Library/ThirdPartyImageLockLib/ThirdPartyImageLockLib.c b/UefiPayloadPkg/Library/ThirdPartyImageLockLib/ThirdPartyImageLockLib.c
new file mode 100644
index 000000000..3feb63e39
--- /dev/null
+++ b/UefiPayloadPkg/Library/ThirdPartyImageLockLib/ThirdPartyImageLockLib.c
@@ -0,0 +1,303 @@
+/** @file
+  Arm the locks of the platform before an image that is not part of the
+  firmware runs ahead of a boot.
+
+  The payload arms coreboot's locks (the setup options, the switch to the
+  other firmware slot) when a boot option is started, at ReadyToBoot, so that
+  the setup, which runs before, can change what they protect. The boot
+  manager also runs other code before that: the option ROMs of the devices,
+  and the Driver#### and SysPrep#### load options, which an OS can create.
+  Such an image ran with the locks open and could write the settings as the
+  setup does, for the next boot.
+
+  This Security2 handler sees every image before it is loaded. For the first
+  one that does not come from a firmware volume, before ReadyToBoot, it arms
+  the locks and signals gUefiPayloadThirdPartyImageEventGroupGuid. The setup
+  then cannot save in that boot, and says so. So that it can save at all on
+  a machine where such an image runs at every boot, a boot that the OS or the
+  setup asked to end in the firmware setup (EFI_OS_INDICATIONS_BOOT_TO_FW_UI)
+  refuses those images until a boot option is started: the locks stay open
+  for the setup, and nothing but the firmware ran before it. But for one
+  kind: the option ROM of a display controller is loaded in such a boot too,
+  without arming anything, since on a machine without integrated graphics
+  its driver is the screen of the setup. It comes from the flash of a card
+  in the machine, not from a variable that an OS writes, and Secure Boot
+  checks it when it is on.
+
+  It is linked after DxeImageVerificationLib: an image that Secure Boot
+  refuses does not get here, as the handlers run in the order in which they
+  are registered and stop at the first that fails.
+
+  Copyright (c) 2026, ouroBIOS contributors
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <PiDxe.h>
+#include <Guid/EventGroup.h>
+#include <Guid/GlobalVariable.h>
+#include <Guid/ThirdPartyImage.h>
+#include <IndustryStandard/Pci22.h>
+#include <Library/DebugLib.h>
+#include <Library/DevicePathLib.h>
+#include <Library/SecurityManagementLib.h>
+#include <Library/SmmStoreLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+#include <Protocol/FirmwareVolume2.h>
+#include <Protocol/PciIo.h>
+
+//
+// A boot option was started: the platform armed the locks itself.
+//
+STATIC BOOLEAN  mReadyToBoot;
+//
+// This boot was asked to end in the firmware setup.
+//
+STATIC BOOLEAN  mFirmwareUi;
+//
+// The locks were armed here.
+//
+STATIC BOOLEAN  mArmed;
+
+/**
+  Does the image come from a firmware volume? As DxeImageVerificationLib
+  decides it (IMAGE_FROM_FV).
+
+  @param[in] File  The device path of the image, or NULL.
+
+  @retval TRUE   The device path leads to a firmware volume.
+  @retval FALSE  It does not, or there is none.
+**/
+STATIC
+BOOLEAN
+ImageFromFirmwareVolume (
+  IN CONST EFI_DEVICE_PATH_PROTOCOL  *File
+  )
+{
+  EFI_STATUS                Status;
+  EFI_HANDLE                DeviceHandle;
+  EFI_DEVICE_PATH_PROTOCOL  *TempDevicePath;
+
+  if (File == NULL) {
+    return FALSE;
+  }
+
+  DeviceHandle   = NULL;
+  TempDevicePath = (EFI_DEVICE_PATH_PROTOCOL *)File;
+  Status         = gBS->LocateDevicePath (
+                          &gEfiFirmwareVolume2ProtocolGuid,
+                          &TempDevicePath,
+                          &DeviceHandle
+                          );
+  if (EFI_ERROR (Status)) {
+    return FALSE;
+  }
+
+  Status = gBS->OpenProtocol (
+                  DeviceHandle,
+                  &gEfiFirmwareVolume2ProtocolGuid,
+                  NULL,
+                  NULL,
+                  NULL,
+                  EFI_OPEN_PROTOCOL_TEST_PROTOCOL
+                  );
+  return (BOOLEAN)!EFI_ERROR (Status);
+}
+
+/**
+  Is the image the driver in the option ROM of a display controller? PciBusDxe
+  loads the images of an option ROM with the device path of the PCI device
+  and one node after it, the range of the image in the ROM.
+
+  @param[in] File  The device path of the image, or NULL.
+
+  @retval TRUE   The device path is that of a PCI device of the display
+                 class, then a relative offset range node.
+  @retval FALSE  It is not.
+**/
+STATIC
+BOOLEAN
+ImageFromDisplayOptionRom (
+  IN CONST EFI_DEVICE_PATH_PROTOCOL  *File
+  )
+{
+  EFI_STATUS                Status;
+  EFI_HANDLE                DeviceHandle;
+  EFI_DEVICE_PATH_PROTOCOL  *Node;
+  EFI_PCI_IO_PROTOCOL       *PciIo;
+  UINT8                     BaseClass;
+
+  if (File == NULL) {
+    return FALSE;
+  }
+
+  DeviceHandle = NULL;
+  Node         = (EFI_DEVICE_PATH_PROTOCOL *)File;
+  Status       = gBS->LocateDevicePath (&gEfiPciIoProtocolGuid, &Node, &DeviceHandle);
+  if (EFI_ERROR (Status) ||
+      (DevicePathType (Node) != MEDIA_DEVICE_PATH) ||
+      (DevicePathSubType (Node) != MEDIA_RELATIVE_OFFSET_RANGE_DP) ||
+      !IsDevicePathEnd (NextDevicePathNode (Node)))
+  {
+    return FALSE;
+  }
+
+  Status = gBS->HandleProtocol (DeviceHandle, &gEfiPciIoProtocolGuid, (VOID **)&PciIo);
+  if (EFI_ERROR (Status)) {
+    return FALSE;
+  }
+
+  Status = PciIo->Pci.Read (PciIo, EfiPciIoWidthUint8, PCI_CLASSCODE_OFFSET + 2, 1, &BaseClass);
+  return (BOOLEAN)(!EFI_ERROR (Status) && (BaseClass == PCI_CLASS_DISPLAY));
+}
+
+/**
+  The Security2 handler: before a boot option is started, the first image
+  that is not part of the firmware arms the locks, or is refused in a boot
+  that goes to the firmware setup.
+
+  The locks are armed here, with the SMIs of SmmStoreLib, and not by the
+  modules that take the event: their notifications wait for the TPL to drop,
+  and nothing says that it does before the image is started.
+
+  @retval EFI_SUCCESS        The image may be loaded.
+  @retval EFI_ACCESS_DENIED  Not part of the firmware, nor the option ROM of
+                             a display controller, in a boot that goes to the
+                             firmware setup: not loaded.
+**/
+STATIC
+EFI_STATUS
+EFIAPI
+ThirdPartyImageLockHandler (
+  IN  UINT32                          AuthenticationStatus,
+  IN  CONST EFI_DEVICE_PATH_PROTOCOL  *File,
+  IN  VOID                            *FileBuffer,
+  IN  UINTN                           FileSize,
+  IN  BOOLEAN                         BootPolicy
+  )
+{
+  EFI_STATUS  Status;
+
+  if (mReadyToBoot || ImageFromFirmwareVolume (File)) {
+    return EFI_SUCCESS;
+  }
+
+  if (mFirmwareUi) {
+    if (ImageFromDisplayOptionRom (File)) {
+      DEBUG ((DEBUG_INFO, "ThirdPartyImageLockLib: the option ROM of a display controller, for the setup\n"));
+      return EFI_SUCCESS;
+    }
+
+    DEBUG ((DEBUG_WARN, "ThirdPartyImageLockLib: image refused: this boot goes to the setup\n"));
+    return EFI_ACCESS_DENIED;
+  }
+
+  if (mArmed) {
+    return EFI_SUCCESS;
+  }
+
+  mArmed = TRUE;
+  Status = SmmStoreLibInitialize ();
+  if (!EFI_ERROR (Status)) {
+    Status = SmmStoreLibVbootLockSlots ();
+    DEBUG ((DEBUG_INFO, "ThirdPartyImageLockLib: switch to the other firmware slot locked: %r\n", Status));
+    Status = SmmStoreLibOptionLock ();
+    DEBUG ((DEBUG_INFO, "ThirdPartyImageLockLib: setup options write-locked: %r\n", Status));
+  }
+
+  EfiEventGroupSignal (&gUefiPayloadThirdPartyImageEventGroupGuid);
+  return EFI_SUCCESS;
+}
+
+/**
+  At EndOfDxe, before the boot manager loads anything that is not part of the
+  firmware and before it clears the request: was this boot asked to end in
+  the firmware setup?
+
+  @param[in] Event    The event.
+  @param[in] Context  Not used.
+**/
+STATIC
+VOID
+EFIAPI
+ThirdPartyImageLockEndOfDxe (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  EFI_STATUS  Status;
+  UINT64      OsIndications;
+  UINTN       Size;
+
+  OsIndications = 0;
+  Size          = sizeof (OsIndications);
+  Status        = gRT->GetVariable (
+                         EFI_OS_INDICATIONS_VARIABLE_NAME,
+                         &gEfiGlobalVariableGuid,
+                         NULL,
+                         &Size,
+                         &OsIndications
+                         );
+  mFirmwareUi = (BOOLEAN)(!EFI_ERROR (Status) && (Size == sizeof (OsIndications)) &&
+                          ((OsIndications & EFI_OS_INDICATIONS_BOOT_TO_FW_UI) != 0));
+  gBS->CloseEvent (Event);
+}
+
+/**
+  A boot option is started: from here the platform keeps the locks.
+
+  @param[in] Event    The event.
+  @param[in] Context  Not used.
+**/
+STATIC
+VOID
+EFIAPI
+ThirdPartyImageLockReadyToBoot (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  mReadyToBoot = TRUE;
+  gBS->CloseEvent (Event);
+}
+
+/**
+  Register the handler for the images that are loaded, and the two events.
+  Without the events no image is refused and the first one that is not part
+  of the firmware arms the locks, which is the safe side of both.
+
+  @param[in] ImageHandle  The image handle of the driver.
+  @param[in] SystemTable  The EFI system table.
+
+  @return The status of RegisterSecurity2Handler.
+**/
+EFI_STATUS
+EFIAPI
+ThirdPartyImageLockLibConstructor (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS  Status;
+  EFI_EVENT   Event;
+
+  Status = gBS->CreateEventEx (
+                  EVT_NOTIFY_SIGNAL,
+                  TPL_CALLBACK,
+                  ThirdPartyImageLockEndOfDxe,
+                  NULL,
+                  &gEfiEndOfDxeEventGroupGuid,
+                  &Event
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_WARN, "ThirdPartyImageLockLib: no EndOfDxe event: %r\n", Status));
+  }
+
+  Status = EfiCreateEventReadyToBootEx (TPL_CALLBACK, ThirdPartyImageLockReadyToBoot, NULL, &Event);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_WARN, "ThirdPartyImageLockLib: no ReadyToBoot event: %r\n", Status));
+  }
+
+  return RegisterSecurity2Handler (ThirdPartyImageLockHandler, EFI_AUTH_OPERATION_VERIFY_IMAGE);
+}
