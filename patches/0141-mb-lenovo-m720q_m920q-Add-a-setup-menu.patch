diff --git a/src/mainboard/lenovo/m720q_m920q/cfr.c b/src/mainboard/lenovo/m720q_m920q/cfr.c
new file mode 100644
index 0000000000..0daea7fdf0
--- /dev/null
+++ b/src/mainboard/lenovo/m720q_m920q/cfr.c
@@ -0,0 +1,594 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <boot/coreboot_tables.h>
+#include <build.h>
+#include <cbmem.h>
+#include <commonlib/helpers.h>
+#include <cpu/x86/name.h>
+#include <drivers/option/cfr_frontend.h>
+#include <drivers/vpd/vpd.h>
+#include <intelblocks/pmclib.h>
+#include <memory_info.h>
+#include <soc/soc_chip.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <types.h>
+
+/*
+ * The setup menu, one form per category, each split into cards (nested
+ * forms): General, Energy Saver, Hardware, Security and Compatibility.
+ * Each option is in one card only, and its help says what it does, its
+ * default and when to change it. The option names are those that the SoC,
+ * Super I/O and common code read (get_uint_option()).
+ */
+
+/* General: what this machine is */
+
+static const struct sm_object info_model = SM_DECLARE_VARCHAR({
+	.flags		= CFR_OPTFLAG_READONLY | CFR_OPTFLAG_VOLATILE,
+	.opt_name	= "info_model",
+	.ui_name	= "Model",
+	.default_value	= CONFIG_MAINBOARD_PART_NUMBER,
+});
+
+/* This machine's data from the VPD, as the OEM setup shows it, if there */
+static void show_vpd_string(struct sm_object *new, const char *key)
+{
+	char *value = CONFIG(VPD) ? malloc(64) : NULL;
+
+	if (value && vpd_gets(key, value, 64, VPD_RO) && value[0]) {
+		new->sm_varchar.default_value = value;
+		return;
+	}
+	free(value);
+	new->sm_varchar.flags |= CFR_OPTFLAG_SUPPRESS;
+}
+
+static void update_mtm(struct sm_object *new)
+{
+	show_vpd_string(new, "system_product_name");
+}
+
+static void update_serial(struct sm_object *new)
+{
+	show_vpd_string(new, "serial_number");
+}
+
+static void update_board_serial(struct sm_object *new)
+{
+	show_vpd_string(new, "mlb_serial_number");
+}
+
+static void update_uuid(struct sm_object *new)
+{
+	const uint8_t *u = NULL;
+	int size = 0;
+	char *text;
+
+	if (CONFIG(VPD))
+		u = vpd_find("system_uuid", &size, VPD_RO);
+	if (!u || size != 16 || !(text = malloc(37))) {
+		new->sm_varchar.flags |= CFR_OPTFLAG_SUPPRESS;
+		return;
+	}
+	/* The first three fields are little-endian, as in SMBIOS */
+	snprintf(text, 37, "%02X%02X%02X%02X-%02X%02X-%02X%02X-"
+		 "%02X%02X-%02X%02X%02X%02X%02X%02X",
+		 u[3], u[2], u[1], u[0], u[5], u[4], u[7], u[6],
+		 u[8], u[9], u[10], u[11], u[12], u[13], u[14], u[15]);
+	new->sm_varchar.default_value = text;
+}
+
+static const struct sm_object info_mtm = SM_DECLARE_VARCHAR({
+	.flags		= CFR_OPTFLAG_READONLY | CFR_OPTFLAG_VOLATILE,
+	.opt_name	= "info_mtm",
+	.ui_name	= "Machine type",
+	.default_value	= "",
+}, WITH_CALLBACK(update_mtm));
+
+static const struct sm_object info_serial = SM_DECLARE_VARCHAR({
+	.flags		= CFR_OPTFLAG_READONLY | CFR_OPTFLAG_VOLATILE,
+	.opt_name	= "info_serial",
+	.ui_name	= "Serial number",
+	.default_value	= "",
+}, WITH_CALLBACK(update_serial));
+
+static const struct sm_object info_board_serial = SM_DECLARE_VARCHAR({
+	.flags		= CFR_OPTFLAG_READONLY | CFR_OPTFLAG_VOLATILE,
+	.opt_name	= "info_board_serial",
+	.ui_name	= "System board serial number",
+	.default_value	= "",
+}, WITH_CALLBACK(update_board_serial));
+
+static const struct sm_object info_uuid = SM_DECLARE_VARCHAR({
+	.flags		= CFR_OPTFLAG_READONLY | CFR_OPTFLAG_VOLATILE,
+	.opt_name	= "info_uuid",
+	.ui_name	= "UUID",
+	.default_value	= "",
+}, WITH_CALLBACK(update_uuid));
+
+static void update_processor(struct sm_object *new)
+{
+	char *name = malloc(49);
+
+	if (!name)
+		return;
+	fill_processor_name(name);
+	new->sm_varchar.default_value = name;
+}
+
+static const struct sm_object info_processor = SM_DECLARE_VARCHAR({
+	.flags		= CFR_OPTFLAG_READONLY | CFR_OPTFLAG_VOLATILE,
+	.opt_name	= "info_processor",
+	.ui_name	= "Processor",
+	.default_value	= "Unknown",
+}, WITH_CALLBACK(update_processor));
+
+static void update_memory(struct sm_object *new)
+{
+	const struct memory_info *info = cbmem_find(CBMEM_ID_MEMINFO);
+	unsigned int total_mib = 0, mts = 0;
+	char *text;
+
+	if (!info || !info->dimm_cnt)
+		return;
+
+	const size_t count = MIN(info->dimm_cnt, DIMM_INFO_TOTAL);
+	for (size_t i = 0; i < count; i++) {
+		total_mib += info->dimm[i].dimm_size;
+		mts = MAX(mts, (unsigned int)info->dimm[i].ddr_frequency);
+	}
+
+	text = malloc(48);
+	if (!text)
+		return;
+	snprintf(text, 48, "%u GiB DDR4-%u, %zu module%s", total_mib / 1024, mts,
+		 count, count == 1 ? "" : "s");
+	new->sm_varchar.default_value = text;
+}
+
+static const struct sm_object info_memory = SM_DECLARE_VARCHAR({
+	.flags		= CFR_OPTFLAG_READONLY | CFR_OPTFLAG_VOLATILE,
+	.opt_name	= "info_memory",
+	.ui_name	= "Memory",
+	.default_value	= "Unknown",
+}, WITH_CALLBACK(update_memory));
+
+static const struct sm_object info_memory_profile = SM_DECLARE_COMMENT({
+	.ui_name	= "Memory profile: JEDEC (XMP is not supported)",
+	.ui_helptext	= "The memory runs at the JEDEC timings from its SPD, up to\n"
+			  "the speed the processor supports. FSP-M does not use XMP\n"
+			  "profiles here.",
+});
+
+static const struct sm_object info_firmware = SM_DECLARE_VARCHAR({
+	.flags		= CFR_OPTFLAG_READONLY | CFR_OPTFLAG_VOLATILE,
+	.opt_name	= "info_firmware",
+	.ui_name	= "Firmware",
+	.default_value	= CONFIG_LOCALVERSION " (coreboot " COREBOOT_VERSION ")",
+});
+
+static const struct sm_object general_about = SM_DECLARE_FORM({
+	.ui_name	= "About this ThinkCentre",
+	.obj_list	= (const struct sm_object *[]) {
+		&info_model,
+		&info_mtm,
+		&info_serial,
+		&info_board_serial,
+		&info_uuid,
+		&info_processor,
+		&info_memory,
+		&info_memory_profile,
+		&info_firmware,
+		NULL
+	},
+});
+
+/*
+ * The boot options of the payload: its boot manager reads them (EDK2,
+ * PlatformBootManagerLib), coreboot does not.
+ */
+static const struct sm_object ipxe_boot = SM_DECLARE_BOOL({
+	.flags		= CONFIG(EDK2_ENABLE_IPXE) ? 0 : CFR_OPTFLAG_SUPPRESS,
+	.opt_name	= "ipxe_boot",
+	.ui_name	= "Network boot (iPXE)",
+	.ui_helptext	= "The iPXE entry of the boot menu: PXE, HTTP and iPXE\n"
+			  "scripts over the Ethernet port.\n"
+			  "Default: on. Off: the entry is not listed.",
+	.default_value	= true,
+});
+
+static const struct sm_object csmwrap_boot = SM_DECLARE_BOOL({
+	.flags		= CONFIG(EDK2_ENABLE_CSMWRAP) ? 0 : CFR_OPTFLAG_SUPPRESS,
+	.opt_name	= "csmwrap_boot",
+	.ui_name	= "Legacy boot (CSMWrap)",
+	.ui_helptext	= "The CSMWrap entry of the boot menu: a legacy BIOS (the\n"
+			  "CSM of SeaBIOS) for the systems and tools that do not boot\n"
+			  "from UEFI, from the disks and USB drives. Needs Secure Boot\n"
+			  "off: while it is on, the entry is not listed. Some legacy\n"
+			  "systems also need Compatibility > Legacy 8254 timer.\n"
+			  "Default: on. Off: the entry is not listed.",
+	.default_value	= true,
+});
+
+static const struct sm_object general_boot = SM_DECLARE_FORM({
+	.flags		= (CONFIG(EDK2_ENABLE_IPXE) || CONFIG(EDK2_ENABLE_CSMWRAP))
+			  ? 0 : CFR_OPTFLAG_SUPPRESS,
+	.ui_name	= "Boot",
+	.obj_list	= (const struct sm_object *[]) {
+		&ipxe_boot,
+		&csmwrap_boot,
+		NULL
+	},
+});
+
+/* Energy Saver */
+
+/* Read by FSP-M parameters (soc/intel/cannonlake/romstage/fsp_params.c) */
+static const struct sm_object hyper_threading = SM_DECLARE_BOOL({
+	.opt_name	= "hyper_threading",
+	.ui_name	= "Hyper-Threading",
+	.ui_helptext	= "Two logical processors per core, on the processors that\n"
+			  "have them (Core i7).\n"
+			  "Default: on.",
+	.default_value	= CONFIG(FSP_HYPERTHREADING),
+});
+
+/* Read by soc/intel/cannonlake/cpu.c and acpi.c */
+static const struct sm_object eist = SM_DECLARE_BOOL({
+	.opt_name	= "eist",
+	.ui_name	= "Intel SpeedStep",
+	.ui_helptext	= "Lets the OS change the frequency and voltage of the\n"
+			  "processor with the load (P-states, and Speed Shift).\n"
+			  "Default: on. Off: the processor runs at its base\n"
+			  "frequency, and draws more power at idle.",
+	.default_value	= true,
+});
+
+static const struct sm_object turbo_mode = SM_DECLARE_BOOL({
+	.opt_name	= "turbo_mode",
+	.ui_name	= "Intel Turbo Boost",
+	.ui_helptext	= "Frequencies above the base one while the power limits and\n"
+			  "the temperature allow it.\n"
+			  "Default: on. Off: quieter and cooler, slower under load.",
+	.default_value	= true,
+}, WITH_DEP_VALUES(&eist, true));
+
+/* Read by soc/intel/common/block/power_limit (set_power_limits()) */
+static const struct sm_object tdp_pl1_override = SM_DECLARE_NUMBER({
+	.opt_name	= "tdp_pl1_override",
+	.ui_name	= "CPU PL1 power limit (W)",
+	.ui_helptext	= "Long-duration power limit of the CPU package, 0-65 W,\n"
+			  "within what the processor allows.\n"
+			  "Default: 0, the TDP of the processor (35 W for the T\n"
+			  "models of this Tiny).",
+	.default_value	= 0,
+	.min		= 0,
+	.max		= 65,
+	.step		= 1,
+	.display_flags	= 0,
+});
+
+static const struct sm_object tdp_pl2_override = SM_DECLARE_NUMBER({
+	.opt_name	= "tdp_pl2_override",
+	.ui_name	= "CPU PL2 power limit (W)",
+	.ui_helptext	= "Short-duration power limit of the CPU package, 0-90 W, at\n"
+			  "least PL1 (the firmware raises it to PL1 if lower).\n"
+			  "Default: 65 W, as for this Tiny. 0: 1.25 times the TDP.",
+	.default_value	= 65,
+	.min		= 0,
+	.max		= 90,
+	.step		= 1,
+	.display_flags	= 0,
+});
+
+static const struct sm_object pkg_power_limit_lock = SM_DECLARE_BOOL({
+	.opt_name	= "pkg_power_limit_lock",
+	.ui_name	= "CPU power limit lock",
+	.ui_helptext	= "Lock the power limits after the firmware sets them, so\n"
+			  "that the OS and its tools cannot change them until the\n"
+			  "next reset.\n"
+			  "Default: off.",
+	.default_value	= false,
+});
+
+/* Read by the PMC (soc/intel/common/block/pmc) and the NCT6687D */
+static const struct sm_object power_on_after_fail = SM_DECLARE_ENUM({
+	.opt_name	= "power_on_after_fail",
+	.ui_name	= "After a power loss",
+	.ui_helptext	= "What the computer does when the power comes back after\n"
+			  "a power loss.\n"
+			  "Default: as set at build time (Power on for this board).",
+	.default_value	= CONFIG_MAINBOARD_POWER_FAILURE_STATE,
+	.values		= (const struct sm_enum_value[]) {
+				{ "Stay off",		MAINBOARD_POWER_STATE_OFF	},
+				{ "Power on",		MAINBOARD_POWER_STATE_ON	},
+				{ "Previous state",	MAINBOARD_POWER_STATE_PREVIOUS	},
+				SM_ENUM_VALUE_END					},
+});
+
+static const struct sm_object energy_processor = SM_DECLARE_FORM({
+	.ui_name	= "Processor",
+	.obj_list	= (const struct sm_object *[]) {
+		&eist,
+		&turbo_mode,
+		&hyper_threading,
+		&tdp_pl1_override,
+		&tdp_pl2_override,
+		&pkg_power_limit_lock,
+		NULL
+	},
+});
+
+static const struct sm_object energy_power = SM_DECLARE_FORM({
+	.ui_name	= "Power",
+	.obj_list	= (const struct sm_object *[]) {
+		&power_on_after_fail,
+		NULL
+	},
+});
+
+/* Hardware */
+
+/* Read by FSP-M parameters (soc/intel/cannonlake/romstage/fsp_params.c) */
+static const struct sm_object igd_enabled = SM_DECLARE_BOOL({
+	.opt_name	= "igd_enabled",
+	.ui_name	= "Intel graphics",
+	.ui_helptext	= "The graphics of the processor, behind the DisplayPort and\n"
+			  "HDMI ports of the rear panel.\n"
+			  "Default: on. Turn it off only with a graphics card on the\n"
+			  "PCIe riser, connected to the screen: off, the rear ports\n"
+			  "stay dark, the firmware screen included.",
+	.default_value	= true,
+});
+
+static const struct sm_object igd_dvmt = SM_DECLARE_ENUM({
+	.opt_name	= "igd_dvmt_prealloc",
+	.ui_name	= "Graphics stolen memory",
+	.ui_helptext	= "Memory reserved for the Intel graphics at boot (DVMT\n"
+			  "pre-allocated); the drivers allocate the rest as needed.\n"
+			  "Default: 64 MB. More for macOS (OpenCore configurations\n"
+			  "of this Tiny patch the framebuffer for 32 or 64 MB).",
+	.default_value	= IGD_SM_64MB,
+	.values		= (const struct sm_enum_value[]) {
+				{ "32 MB",	IGD_SM_32MB	},
+				{ "64 MB",	IGD_SM_64MB	},
+				{ "96 MB",	IGD_SM_96MB	},
+				{ "128 MB",	IGD_SM_128MB	},
+				SM_ENUM_VALUE_END		},
+}, WITH_DEP_VALUES(&igd_enabled, true));
+
+static const struct sm_object igd_aperture = SM_DECLARE_ENUM({
+	.opt_name	= "igd_aperture_size",
+	.ui_name	= "Graphics aperture",
+	.ui_helptext	= "The window of the Intel graphics memory that the CPU sees\n"
+			  "through the PCI BAR.\n"
+			  "Default: 256 MB.",
+	.default_value	= IGD_AP_SZ_256MB,
+	.values		= (const struct sm_enum_value[]) {
+				{ "128 MB",	IGD_AP_SZ_128MB	},
+				{ "256 MB",	IGD_AP_SZ_256MB	},
+				{ "512 MB",	IGD_AP_SZ_512MB	},
+				SM_ENUM_VALUE_END		},
+}, WITH_DEP_VALUES(&igd_enabled, true));
+
+static const struct sm_object hardware_intel_graphics = SM_DECLARE_FORM({
+	.ui_name	= "Intel graphics",
+	.obj_list	= (const struct sm_object *[]) {
+		&igd_enabled,
+		&igd_dvmt,
+		&igd_aperture,
+		NULL
+	},
+});
+
+/* Security */
+
+static void update_bios_lock(struct sm_object *new)
+{
+	if (!CONFIG(BOOTMEDIA_SMM_BWP_RUNTIME_OPTION))
+		new->sm_bool.flags |= CFR_OPTFLAG_SUPPRESS;
+}
+
+/* Read by enable_smm_bios_protection() (security/lockdown/lockdown.h) */
+static const struct sm_object bios_lock = SM_DECLARE_BOOL({
+	.opt_name	= "bios_lock",
+	.ui_name	= "BIOS Lock",
+	.ui_helptext	= "Only the firmware, in System Management Mode, can write\n"
+			  "the flash: flashrom and the other tools of the OS can only\n"
+			  "read it. Settings are still saved and update capsules\n"
+			  "still install.\n"
+			  "Default: off. Turn it off before writing the flash with\n"
+			  "flashrom.",
+	.default_value	= CONFIG(BOOTMEDIA_SMM_BWP),
+}, WITH_CALLBACK(update_bios_lock));
+
+static void update_bootmedia_lock(struct sm_object *new)
+{
+	if (!CONFIG(BOOTMEDIA_LOCK_RUNTIME_OPTION))
+		new->sm_bool.flags |= CFR_OPTFLAG_SUPPRESS;
+}
+
+/* Read by enable_bootmedia_lock() (security/lockdown/lockdown.h) */
+static const struct sm_object bootmedia_lock = SM_DECLARE_BOOL({
+	.opt_name	= "bootmedia_lock",
+	.ui_name	= "Firmware protection",
+	.ui_helptext	= "Write-protect the read-only part of the firmware (the\n"
+			  "bootblock and the keys of verified boot) from power-on, so\n"
+			  "that no program can change it. Updates with a capsule still\n"
+			  "install.\n"
+			  "Default: on. Turn it off only to write the whole flash with\n"
+			  "flashrom, then on again.",
+	.default_value	= true,
+}, WITH_CALLBACK(update_bootmedia_lock));
+
+/* Read by security_clear_dram_request() (security/memory/memory.c) */
+static const struct sm_object clear_dram_on_boot = SM_DECLARE_BOOL({
+	.opt_name	= "clear_dram_on_boot",
+	.ui_name	= "Clear memory at power-on",
+	.ui_helptext	= "Clear all the memory at every boot (not when resuming\n"
+			  "from sleep), so that what the previous OS left in it\n"
+			  "cannot be read. About 1 s more per boot with 32 GB.\n"
+			  "Default: on.",
+	.default_value	= true,
+});
+
+/* Read by FSP-M parameters (soc/intel/cannonlake/romstage/fsp_params.c) */
+static const struct sm_object vtd = SM_DECLARE_BOOL({
+	.opt_name	= "vtd",
+	.ui_name	= "Intel VT-d",
+	.ui_helptext	= "The IOMMU, for device passthrough to virtual machines and\n"
+			  "DMA protection (intel_iommu, Kernel DMA Protection).\n"
+			  "Default: on.",
+	.default_value	= true,
+});
+
+/* Read by the CSE driver (soc/intel/common/block/cse), through HECI */
+static const struct sm_object me_state = SM_DECLARE_ENUM({
+	.opt_name	= "me_state",
+	.ui_name	= "Intel Management Engine",
+	.ui_helptext	= "Enabled: the ME runs its full firmware (AMT on the vPro\n"
+			  "models). Disabled: the firmware asks the ME, through HECI,\n"
+			  "to stay in its disabled state from the next boot: AMT and\n"
+			  "the HECI interface go away. The change takes a few resets,\n"
+			  "which the firmware does by itself.\n"
+			  "Default: Enabled.",
+	.default_value	= 0,
+	.values		= (const struct sm_enum_value[]) {
+				{ "Enabled",	0	},
+				{ "Disabled",	1	},
+				SM_ENUM_VALUE_END	},
+});
+
+/* The resets the CSE driver counts while the ME changes state */
+static const struct sm_object me_state_counter = SM_DECLARE_NUMBER({
+	.flags		= CFR_OPTFLAG_SUPPRESS,
+	.opt_name	= "me_state_counter",
+	.ui_name	= "ME state counter",
+	.default_value	= 0,
+	.min		= 0,
+	.max		= 3,
+	.step		= 1,
+	.display_flags	= 0,
