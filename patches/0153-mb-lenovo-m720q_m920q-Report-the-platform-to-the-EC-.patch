 src/mainboard/lenovo/m720q_m920q/cfr.c        |  29 +++++
 src/mainboard/lenovo/m720q_m920q/ec.c         | 120 ++++++++++++++++++
 .../lenovo/m720q_m920q/include/mainboard/ec.h |  13 ++
 4 files changed, 163 insertions(+)
 create mode 100644 src/mainboard/lenovo/m720q_m920q/ec.c
 create mode 100644 src/mainboard/lenovo/m720q_m920q/include/mainboard/ec.h

