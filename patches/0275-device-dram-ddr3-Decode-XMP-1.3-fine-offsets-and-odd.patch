From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Domenico D'Arrigo <d.darrigo@outlook.it>
Date: Tue, 10 Nov 2026 19:06:37 +0100
Subject: [PATCH] device/dram/ddr3: Decode XMP 1.3 fine offsets and odd
 timebases exactly

A profile for DDR3-1866 or faster cannot tell its cycle time in the
usual medium timebase of 1/8 ns: tCKmin reads 1.125 ns for DDR3-1866
(1.071 ns) and 0.875 ns for DDR3-2400 (0.833 ns). XMP 1.3 adds fine
offsets for tCKmin, tAAmin, tRPmin, tRCDmin and tRCmin, in units of the
fine timebase of the SPD, as the SPD has them for the same timings.
They were not decoded, so the memory controller code, which takes the
standard speed that the cycle time allows, chose one speed lower than
the profile's.

Apply them when the profile says revision 1.3 and the SPD has a fine
timebase. The XMP specification is not public; the bytes and their
meaning are from profiles of modules on sale: with a cycle time of 7
units of 1/8 ns and an offset of -42, and offsets of -39, -79, -79 and
-28 for the others, a DDR3-2400 kit decodes to the 11-13-13-31 it is
sold as. The offsets of tRPmin and tRCDmin were the same in every
profile seen, so their order could not be told apart: both timings get
the larger of the two, so that neither is shortened by more than its
own offset.

Other profiles use a medium timebase of 1/14 or 1/12 ns, which is not
a whole number of the units of 1/256 ns that the decoded times use.
The timebase was rounded down once and then multiplied: times up to
1.6% too short. Multiply first and round up; the cycle time to the
nearest unit, as the cycle times of the standard speeds are rounded
(15/14 ns must stay the TCK_933MHZ it is). A profile with no cycle
time or no timebase is invalid.

Add a unit test for the decoder, with the SPD of a DDR3L SO-DIMM and
profiles as described above.

TEST=make run-tests/device/ddr3-test

Change-Id: I56342dcf711b87f4644d49a3d5099dd70475f3f3
---
 src/device/dram/ddr3.c   |  92 ++++++++++----
 tests/device/Makefile.mk |   7 ++
 tests/device/ddr3-test.c | 258 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 334 insertions(+), 23 deletions(-)
 create mode 100644 tests/device/ddr3-test.c

diff --git a/src/device/dram/ddr3.c b/src/device/dram/ddr3.c
index eb872894..bab9cbef 100644
--- a/src/device/dram/ddr3.c
+++ b/src/device/dram/ddr3.c
@@ -403,7 +403,7 @@ int spd_xmp_decode_ddr3(struct dimm_attr_ddr3_st *dimm, spd_ddr3_raw_data spd,
 			enum ddr3_xmp_profile profile)
 {
 	int ret;
-	u32 mtb; /* medium time base */
+	u32 mtb_dividend, mtb_divisor; /* medium time base of the profile, in ns */
 	u8 *xmp; /* pointer to XMP profile data */
 
 	/* need a valid SPD */
@@ -431,9 +431,8 @@ int spd_xmp_decode_ddr3(struct dimm_attr_ddr3_st *dimm, spd_ddr3_raw_data spd,
 		/* Medium Timebase =
 		 *   Medium Timebase (MTB) Dividend /
 		 *   Medium Timebase (MTB) Divisor */
-		if (spd[181] == 0) // Avoid dividing by zero.
-			return SPD_STATUS_INVALID;
-		mtb = (((u32)spd[180]) << 8) / spd[181];
+		mtb_dividend = spd[180];
+		mtb_divisor = spd[181];
 
 		dimm->dimms_per_channel = ((spd[178] >> 2) & 0x3) + 1;
 	} else {
@@ -448,13 +447,25 @@ int spd_xmp_decode_ddr3(struct dimm_attr_ddr3_st *dimm, spd_ddr3_raw_data spd,
 		/* Medium Timebase =
 		 *   Medium Timebase (MTB) Dividend /
 		 *   Medium Timebase (MTB) Divisor */
-		if (spd[183] == 0) // Avoid dividing by zero.
-			return SPD_STATUS_INVALID;
-		mtb = (((u32)spd[182]) << 8) / spd[183];
+		mtb_dividend = spd[182];
+		mtb_divisor = spd[183];
 
 		dimm->dimms_per_channel = ((spd[178] >> 4) & 0x3) + 1;
 	}
 
+	/* Avoid dividing by zero, and a profile without a cycle time */
+	if (mtb_dividend == 0 || mtb_divisor == 0 || xmp[1] == 0)
+		return SPD_STATUS_INVALID;
+
+	/*
+	 * A time of the profile in units of 1/256 ns, rounded up. With a
+	 * timebase that is not a multiple of 1/256 ns (1/14 ns and 1/12 ns
+	 * are in use), a timebase rounded once and then multiplied gave
+	 * times up to 1.6% too short, and a timing one clock too tight when
+	 * the time was a whole number of clocks.
+	 */
+#define XMP_TIME(v)	DIV_ROUND_UP((u32)(v) * mtb_dividend * 256, mtb_divisor)
+
 	printram("  Max DIMMs/channel  : %u\n", dimm->dimms_per_channel);
 
 	printram("  XMP Revision       : %u.%u\n", spd[179] >> 4, spd[179] & 0xf);
@@ -468,36 +479,71 @@ int spd_xmp_decode_ddr3(struct dimm_attr_ddr3_st *dimm, spd_ddr3_raw_data spd,
 
 	printram("  Requested voltage  : %u mV\n", dimm->voltage);
 
-	/* SDRAM Minimum Cycle Time (tCKmin) */
-	dimm->tCK = xmp[1] * mtb;
+	/*
+	 * SDRAM Minimum Cycle Time (tCKmin), to the nearest unit: the cycle
+	 * times of the standard speeds are rounded down (TCK_933MHZ is 274
+	 * for 274.3), so 15/14 ns rounded up would not be DDR3-1866 any more.
+	 */
+	dimm->tCK = DIV_ROUND_CLOSEST((u32)xmp[1] * mtb_dividend * 256, mtb_divisor);
 	/* CAS Latencies Supported */
 	dimm->cas_supported = ((xmp[4] << 8) + xmp[3]) & 0x7fff;
 	/* Minimum CAS Latency Time (tAAmin) */
-	dimm->tAA = xmp[2] * mtb;
+	dimm->tAA = XMP_TIME(xmp[2]);
 	/* Minimum Write Recovery Time (tWRmin) */
-	dimm->tWR = xmp[8] * mtb;
+	dimm->tWR = XMP_TIME(xmp[8]);
 	/* Minimum RAS# to CAS# Delay Time (tRCDmin) */
-	dimm->tRCD = xmp[7] * mtb;
+	dimm->tRCD = XMP_TIME(xmp[7]);
 	/* Minimum Row Active to Row Active Delay Time (tRRDmin) */
-	dimm->tRRD = xmp[17] * mtb;
+	dimm->tRRD = XMP_TIME(xmp[17]);
 	/* Minimum Row Precharge Delay Time (tRPmin) */
-	dimm->tRP = xmp[6] * mtb;
+	dimm->tRP = XMP_TIME(xmp[6]);
 	/* Minimum Active to Precharge Delay Time (tRASmin) */
-	dimm->tRAS = (((xmp[9] & 0x0f) << 8) + xmp[10]) * mtb;
+	dimm->tRAS = XMP_TIME(((xmp[9] & 0x0f) << 8) + xmp[10]);
 	/* Minimum Active to Active/Refresh Delay Time (tRCmin) */
-	dimm->tRC = (((xmp[9] & 0xf0) << 4) + xmp[11]) * mtb;
+	dimm->tRC = XMP_TIME(((xmp[9] & 0xf0) << 4) + xmp[11]);
 	/* Minimum Refresh Recovery Delay Time (tRFCmin) */
-	dimm->tRFC = ((xmp[15] << 8) + xmp[14]) * mtb;
+	dimm->tRFC = XMP_TIME((xmp[15] << 8) + xmp[14]);
 	/* Minimum Internal Write to Read Command Delay Time (tWTRmin) */
-	dimm->tWTR = xmp[20] * mtb;
+	dimm->tWTR = XMP_TIME(xmp[20]);
 	/* Minimum Internal Read to Precharge Command Delay Time (tRTPmin) */
-	dimm->tRTP = xmp[16] * mtb;
+	dimm->tRTP = XMP_TIME(xmp[16]);
 	/* Minimum Four Activate Window Delay Time (tFAWmin) */
-	dimm->tFAW = (((xmp[18] & 0x0f) << 8) + xmp[19]) * mtb;
+	dimm->tFAW = XMP_TIME(((xmp[18] & 0x0f) << 8) + xmp[19]);
 	/* Minimum CAS Write Latency Time (tCWLmin) */
-	dimm->tCWL = xmp[5] * mtb;
-	/* System CMD Rate Mode */
-	dimm->tCMD = xmp[23] * mtb;
+	dimm->tCWL = XMP_TIME(xmp[5]);
+	/* System CMD Rate Mode: in clocks, with the timebase taken as a number */
+	dimm->tCMD = XMP_TIME(xmp[23]);
+
+#undef XMP_TIME
+
+	/*
+	 * XMP 1.3 adds fine offsets, in units of the fine timebase of the SPD,
+	 * to the five timings that the SPD itself corrects this way. A profile
+	 * for DDR3-1866 or faster cannot tell its cycle time in medium timebase
+	 * units of 1/8 ns: without the offset, tCKmin reads 1.125 ns for
+	 * DDR3-1866 (1.071 ns) and 0.875 ns for DDR3-2400 (0.833 ns), and the
+	 * memory would run one frequency lower than the profile says.
+	 *
+	 * The offsets of tRPmin and tRCDmin follow one another, as the two
+	 * timings do in the profile, and are the same in the profiles seen so
+	 * far. Use the larger for both, so that neither is shortened by more
+	 * than its own offset whichever of the two comes first.
+	 */
+	if (spd[179] >= 0x13 && spd[1] >= 0x11 && (spd[9] & 0x0f)) {
+		/* Fine timebase (1/256 ps), as spd_decode_ddr3() */
+		const u32 ftb = (((u16)spd[9] & 0xf0) << 4) / (spd[9] & 0x0f);
+		const s8 rp_rcd = MAX((s8)xmp[28], (s8)xmp[29]);
+
+		printram("  XMP fine offsets   : tCK %d tAA %d tRP/tRCD %d tRC %d\n",
+			 (s8)xmp[26], (s8)xmp[27], rp_rcd, (s8)xmp[30]);
+
+		/* As for the SPD: the MTB part is rounded up, the offset negative */
+		dimm->tCK += (s32)((s8)xmp[26] * ftb - 500) / 1000;
+		dimm->tAA += (s32)((s8)xmp[27] * ftb - 500) / 1000;
+		dimm->tRP += (s32)(rp_rcd * ftb - 500) / 1000;
+		dimm->tRCD += (s32)(rp_rcd * ftb - 500) / 1000;
+		dimm->tRC += (s32)((s8)xmp[30] * ftb - 500) / 1000;
+	}
 
 	return ret;
 }
diff --git a/tests/device/Makefile.mk b/tests/device/Makefile.mk
index 22036cc9..142a693e 100644
--- a/tests/device/Makefile.mk
+++ b/tests/device/Makefile.mk
@@ -2,6 +2,7 @@
 
 tests-y += i2c-test
 tests-y += ddr4-test
