From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Domenico D'Arrigo <d.darrigo@outlook.it>
Date: Sun, 25 Oct 2026 15:11:40 +0100
Subject: [PATCH] cpu/intel/haswell: Add an option to declare the CPUs as
 Processor

The SSDT declares each CPU thread as a Device with _HID ACPI0007
(acpigen_write_processor_device()), the form the ACPI specification asks
for since version 6.3, which deprecated the Processor operator. macOS
only looks for Processor objects: with none it finds no CPU and stops
early in the boot, unless an SSDT loaded by OpenCore wraps the devices
in Processor objects of its own.

Add an acpi_cpu_objects option, with a CFR object for the setup menu,
that writes Processor(\_SB.CPxx, xx, 0, 0) instead, with the same names,
processor IDs (the UIDs of the MADT) and contents. No processor block:
_CST, _PTC and _PSS already go through MWAIT and the MSRs. It defaults
to Device objects, which is what the code does today; Linux and Windows
work with both.

TEST=Built lenovo/w541 with mrc.bin and with the native RAM init.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018n3yuWwDLW63F4vdf7ZFTv
---
 src/cpu/intel/haswell/acpi.c    | 33 ++++++++++++++++++++++++++-------
 src/cpu/intel/haswell/cfr.h     | 16 ++++++++++++++++
 src/cpu/intel/haswell/haswell.h |  4 ++++
 3 files changed, 46 insertions(+), 7 deletions(-)

diff --git a/src/cpu/intel/haswell/acpi.c b/src/cpu/intel/haswell/acpi.c
index e946c9e478..58441ed506 100644
--- a/src/cpu/intel/haswell/acpi.c
+++ b/src/cpu/intel/haswell/acpi.c
@@ -8,6 +8,7 @@
 #include <cpu/intel/turbo.h>
 #include <cpu/x86/msr.h>
 #include <device/device.h>
+#include <option.h>
 #include <types.h>
 
 #include "haswell.h"
@@ -333,10 +334,20 @@ static void generate_P_state_entries(int core, int cores_per_package)
 	acpigen_pop_len();
 }
 
-static void generate_cpu_entry(const struct device *device, int cpu, int core, int cores_per_package)
+static void generate_cpu_entry(const struct device *device, int cpu, int core,
+			       int cores_per_package, bool processor_op)
 {
-	/* Generate Scope(\_SB) { Device(CPUx */
-	acpigen_write_processor_device(cpu * cores_per_package + core);
+	const unsigned int index = cpu * cores_per_package + core;
+
+	/*
+	 * Generate Scope(\_SB) { Device(CPUx, or Processor(\_SB.CPUx), deprecated
+	 * since ACPI 6.3, without a processor block: the _CST, _PTC and _PSS below
+	 * go through MWAIT and the MSRs.
+	 */
+	if (processor_op)
+		acpigen_write_processor(index, 0, 0);
+	else
+		acpigen_write_processor_device(index);
 
 	/* Generate P-state tables, unless SpeedStep is disabled */
 	if (haswell_eist_enabled())
@@ -348,7 +359,10 @@ static void generate_cpu_entry(const struct device *device, int cpu, int core, i
 	/* Generate T-state tables */
 	generate_T_state_entries(cpu, cores_per_package);
 
-	acpigen_write_processor_device_end();
+	if (processor_op)
+		acpigen_write_processor_end();
+	else
+		acpigen_write_processor_device_end();
 }
 
 void generate_cpu_entries(const struct device *device)
@@ -357,12 +371,17 @@ void generate_cpu_entries(const struct device *device)
 	int cores_per_package = get_logical_cores_per_package();
 	int numcpus = totalcores / cores_per_package;
 
-	printk(BIOS_DEBUG, "Found %d CPU(s) with %d core(s) each.\n",
-	       numcpus, cores_per_package);
+	/* macOS only finds CPUs declared with Processor */
+	const bool processor_op = get_uint_option("acpi_cpu_objects", ACPI_CPU_OBJECTS_DEVICE)
+				  == ACPI_CPU_OBJECTS_PROCESSOR;
+
+	printk(BIOS_DEBUG, "Found %d CPU(s) with %d core(s) each, as %s objects.\n",
+	       numcpus, cores_per_package, processor_op ? "Processor" : "Device");
 
 	for (int cpu_id = 0; cpu_id < numcpus; cpu_id++)
 		for (int core_id = 0; core_id < cores_per_package; core_id++)
-			generate_cpu_entry(device, cpu_id, core_id, cores_per_package);
+			generate_cpu_entry(device, cpu_id, core_id, cores_per_package,
+					   processor_op);
 
 	/* PPKG is usually used for thermal management
 	   of the first and only package. */
diff --git a/src/cpu/intel/haswell/cfr.h b/src/cpu/intel/haswell/cfr.h
index f53afee49b..a64a76621e 100644
--- a/src/cpu/intel/haswell/cfr.h
+++ b/src/cpu/intel/haswell/cfr.h
@@ -3,6 +3,7 @@
 #ifndef _CPU_INTEL_HASWELL_CFR_H_
 #define _CPU_INTEL_HASWELL_CFR_H_
 
+#include <cpu/intel/haswell/haswell.h>
 #include <drivers/option/cfr_frontend.h>
 
 static const struct sm_object cpu_power_limit_lock = SM_DECLARE_BOOL({
@@ -51,6 +52,21 @@ static const struct sm_object cfg_lock = SM_DECLARE_BOOL({
 	.default_value	= true,
 });
 
+static const struct sm_object acpi_cpu_objects = SM_DECLARE_ENUM({
+	.opt_name	= "acpi_cpu_objects",
+	.ui_name	= "ACPI processor objects",
+	.ui_helptext	= "How the ACPI tables declare the CPU threads: as Device\n"
+			  "objects with _HID ACPI0007, the form ACPI asks for since\n"
+			  "version 6.3, or as Processor objects, the older form and\n"
+			  "the only one macOS looks for. Linux and Windows work with\n"
+			  "both.",
+	.default_value	= ACPI_CPU_OBJECTS_DEVICE,
+	.values		= (const struct sm_enum_value[]) {
+				{ "Device (ACPI0007)",	ACPI_CPU_OBJECTS_DEVICE		},
+				{ "Processor",		ACPI_CPU_OBJECTS_PROCESSOR	},
+				SM_ENUM_VALUE_END					},
+});
+
 static const struct sm_object vmx = SM_DECLARE_BOOL({
 	.opt_name	= "vmx",
 	.ui_name	= "Intel VT-x",
diff --git a/src/cpu/intel/haswell/haswell.h b/src/cpu/intel/haswell/haswell.h
index 0cca857dc2..c2d3aac066 100644
--- a/src/cpu/intel/haswell/haswell.h
+++ b/src/cpu/intel/haswell/haswell.h
@@ -172,6 +172,10 @@ int cpu_config_tdp_levels(void);
 bool haswell_eist_enabled(void);
 bool haswell_c_states_enabled(void);
 
+/* The acpi_cpu_objects option: how the ACPI tables declare the CPU threads */
+#define ACPI_CPU_OBJECTS_DEVICE		0	/* Device, with _HID ACPI0007 */
+#define ACPI_CPU_OBJECTS_PROCESSOR	1	/* Processor, deprecated since ACPI 6.3 */
+
 void set_max_freq(void);
 
 /* romstage.c: full reset if the vmx option differs from the locked state */
-- 
2.43.0

