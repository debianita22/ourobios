index 0f5615a7a7..5beef2afa9 100644
--- a/src/northbridge/intel/haswell/Kconfig
+++ b/src/northbridge/intel/haswell/Kconfig
@@ -77,6 +77,16 @@ config HASWELL_NRI_2D_TIMING
 	  training that is done again after a failure. Best with
 	  HASWELL_NRI_MEMORY_TEST and HASWELL_NRI_MARGIN_CHECK.
 
+config HASWELL_NRI_READ_VREF
+	bool "Centre the read Vref per bit and per byte as the MRC does"
+	depends on USE_NATIVE_RAMINIT
+	help
+	  After the write Vref, centre the offset of each data receiver on
+	  the read data (the sense amplifier training sets it from the
+	  receivers alone), then the read reference of each byte at three
+	  read timings, all the ranks tested at once, as the MRC does. Not
+	  run in the training that is done again after a failure.
+
 config HASWELL_NRI_TURNAROUND
 	bool "Shorten the write to read turnaround between ranks as the MRC does"
 	depends on USE_NATIVE_RAMINIT
