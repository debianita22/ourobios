diff --git a/src/cpu/x86/Kconfig b/src/cpu/x86/Kconfig
index 10764aee58..9c7dbe3bd9 100644
--- a/src/cpu/x86/Kconfig
+++ b/src/cpu/x86/Kconfig
@@ -211,6 +211,19 @@ config SMM_OPAL_S3_STATE_SMRAM_SIZE
 	  secret/state. Must be large enough to store the OPAL S3 state
 	  structure and should be kept minimal to reduce SMRAM pressure.
 
+config SMM_MOR_LOCK_STATE_SMRAM
+	bool
+	help
+	  Reserve a small persistent region in SMRAM for the state of the TCG
+	  MOR lock (SMMSTORE_MOR_LOCK), so that a lock the OS took survives the
+	  reload of the SMM handler on S3 resume. It is cleared on every other
+	  boot, where the lock starts over.
+
+config SMM_MOR_LOCK_STATE_SMRAM_SIZE
+	hex
+	default 0x1000 if SMM_MOR_LOCK_STATE_SMRAM
+	default 0x0
+
 config SMM_OPAL_S3_SCRATCH_CBMEM
 	bool
 	depends on HAVE_ACPI_RESUME
diff --git a/src/cpu/x86/smm/smm_module_handler.c b/src/cpu/x86/smm/smm_module_handler.c
index 1833c0e70c..abec3c97ca 100644
--- a/src/cpu/x86/smm/smm_module_handler.c
+++ b/src/cpu/x86/smm/smm_module_handler.c
@@ -91,6 +91,14 @@ void smm_get_opal_s3_state_buffer(uintptr_t *base, size_t *size)
 }
 #endif
 
+#if CONFIG(SMM_MOR_LOCK_STATE_SMRAM)
+void smm_get_mor_lock_state_buffer(uintptr_t *base, size_t *size)
+{
+	*base = smm_runtime.mor_lock_state_base;
+	*size = smm_runtime.mor_lock_state_size;
+}
+#endif
+
 void smm_get_cbmemc_buffer(void **buffer_out, size_t *size_out)
 {
 	*buffer_out = smm_runtime.cbmemc;
diff --git a/src/cpu/x86/smm/smm_module_loader.c b/src/cpu/x86/smm/smm_module_loader.c
index 665b251cd0..f0fd2246a6 100644
--- a/src/cpu/x86/smm/smm_module_loader.c
+++ b/src/cpu/x86/smm/smm_module_loader.c
@@ -416,6 +416,23 @@ static void setup_smihandler_params(struct smm_runtime *mod_params,
 			memset((void *)state_base, 0, state_size);
 	}
 #endif
+
+#if CONFIG(SMM_MOR_LOCK_STATE_SMRAM)
+	uintptr_t mor_base = 0;
+	size_t mor_size = 0;
+	if (smm_subregion(SMM_SUBREGION_MOR_LOCK_STATE, &mor_base, &mor_size)) {
+		printk(BIOS_ERR, "SMM: Failed to locate MOR lock state SMRAM region\n");
+		mod_params->mor_lock_state_base = 0;
+		mod_params->mor_lock_state_size = 0;
+	} else {
+		mod_params->mor_lock_state_base = mor_base;
+		mod_params->mor_lock_state_size = mor_size;
+
+		/* A lock lasts until the next boot: kept across S3 only. */
+		if (!acpi_is_wakeup_s3())
+			memset((void *)mor_base, 0, mor_size);
+	}
+#endif
 }
 
 static void print_region(const char *name, const struct region region)
diff --git a/src/cpu/x86/smm/tseg_region.c b/src/cpu/x86/smm/tseg_region.c
index d02f9d8e08..eadc7b2b4e 100644
--- a/src/cpu/x86/smm/tseg_region.c
+++ b/src/cpu/x86/smm/tseg_region.c
@@ -17,6 +17,8 @@
  *     +-------------------------+
  *     |   OPAL S3 State (opt)   | SMM_OPAL_S3_STATE_SMRAM_SIZE
  *     +-------------------------+
+ *     |  MOR lock state (opt)   | SMM_MOR_LOCK_STATE_SMRAM_SIZE
+ *     +-------------------------+
  *     |      code and data      |
  *     |         (TSEG)          |
  *     +-------------------------+ TSEG
@@ -28,6 +30,7 @@ int smm_subregion(int sub, uintptr_t *start, size_t *size)
 	const size_t ied_size = CONFIG_IED_REGION_SIZE;
 	const size_t cache_size = CONFIG_SMM_RESERVED_SIZE;
 	const size_t opal_state_size = CONFIG_SMM_OPAL_S3_STATE_SMRAM_SIZE;
+	const size_t mor_state_size = CONFIG_SMM_MOR_LOCK_STATE_SMRAM_SIZE;
 
 	if (CONFIG(SMM_TSEG))
 		smm_region(&sub_base, &sub_size);
@@ -37,7 +40,7 @@ int smm_subregion(int sub, uintptr_t *start, size_t *size)
 		return -1;
 
 	ASSERT(IS_ALIGNED(sub_base, sub_size));
-	ASSERT(sub_size > (cache_size + ied_size + opal_state_size));
+	ASSERT(sub_size > (cache_size + ied_size + opal_state_size + mor_state_size));
 
 	switch (sub) {
 	case SMM_SUBREGION_HANDLER:
@@ -45,6 +48,14 @@ int smm_subregion(int sub, uintptr_t *start, size_t *size)
 		sub_size -= ied_size;
 		sub_size -= cache_size;
 		sub_size -= opal_state_size;
+		sub_size -= mor_state_size;
+		break;
+	case SMM_SUBREGION_MOR_LOCK_STATE:
+		if (!mor_state_size)
+			return -1;
+		/* Persistent MOR lock state lives below the OPAL S3 state. */
+		sub_base += sub_size - (ied_size + cache_size + opal_state_size + mor_state_size);
+		sub_size = mor_state_size;
 		break;
 	case SMM_SUBREGION_OPAL_S3_STATE:
 		if (!opal_state_size)
diff --git a/src/drivers/efi/efivars.c b/src/drivers/efi/efivars.c
index e72ba8c2f4..d88ef9f5e7 100644
--- a/src/drivers/efi/efivars.c
+++ b/src/drivers/efi/efivars.c
@@ -731,6 +731,19 @@ enum cb_err efi_fv_get_option(const struct region_device *rdev,
 	return walk_variables(&store_rdev, auth_format, find_and_copy, &args, NULL);
 }
 
+enum cb_err efi_fv_get_mor(const struct region_device *rdev, uint8_t *mor)
+{
+	static const EFI_GUID mor_guid = {
+		0xe20939be, 0x32d4, 0x41be, { 0xa1, 0x50, 0x89, 0x7f, 0x85, 0xd4, 0x98, 0x29 } };
+	uint32_t size = sizeof(*mor);
+	enum cb_err ret;
+
+	ret = efi_fv_get_option(rdev, &mor_guid, "MemoryOverwriteRequestControl", mor, &size);
+	if (ret == CB_SUCCESS && size != sizeof(*mor))
+		return CB_EFI_VS_CORRUPTED_INVALID;
+	return ret;
+}
+
 static enum cb_err variable_write_sizes(const struct region_device *rdev, const char *name,
 					size_t header_size, size_t data_size,
 					size_t *name_size)
diff --git a/src/drivers/efi/efivars.h b/src/drivers/efi/efivars.h
index f9c2b1babe..f3383fc3ff 100644
--- a/src/drivers/efi/efivars.h
+++ b/src/drivers/efi/efivars.h
@@ -33,6 +33,19 @@ enum cb_err efi_fv_get_option(const struct region_device *rdev,
 			      void *dest,
 			      uint32_t *size);
 
+/**
+ * efi_fv_get_mor
+ * The TCG MOR variable MemoryOverwriteRequestControl in the variable store,
+ * as the decision to clear the memory at boot reads it (security/memory) and
+ * as SMMSTORE_MOR_LOCK protects it: one function, so that both agree.
+ * @rdev: the readable region of the variable store
+ * @mor: the variable, on CB_SUCCESS
+ * Returns CB_SUCCESS with a variable of one byte, CB_EFI_OPTION_NOT_FOUND
+ * without one, another error when the store or the variable cannot be read
+ * (a variable of another size included).
+ */
+enum cb_err efi_fv_get_mor(const struct region_device *rdev, uint8_t *mor);
+
 /**
  * efi_fv_set_option
  * Use the provided EFI variable store inside the region device as variable store.
diff --git a/src/drivers/smmstore/Kconfig b/src/drivers/smmstore/Kconfig
index d47493b3ea..65666fffd0 100644
--- a/src/drivers/smmstore/Kconfig
+++ b/src/drivers/smmstore/Kconfig
@@ -29,6 +29,25 @@ config SMMSTORE_BLOCK_SIZE
 	  Sets the logical block size used by the SMMSTORE protocol. This is
 	  an internal SoC or board policy value, not a user-visible option.
 
+config SMMSTORE_MOR_LOCK
+	bool "TCG Secure MOR lock (MemoryOverwriteRequestControlLock)"
+	depends on DRIVERS_EFI_VARIABLE_STORE && SECURITY_CLEAR_DRAM_ON_REGULAR_BOOT
+	select SMM_MOR_LOCK_STATE_SMRAM
+	help
+	  SMMSTORE_CMD_MOR_LOCK: the lock of revision 2 of TCG MOR, which a UEFI
+	  payload offers the OS. While the OS holds it, the handler refuses the
+	  writes of the variable store that would clear the request to clear
+	  the memory at the next boot. Only with the flash written by SMM alone
+	  (BIOS Lock); the OS sees the lock as unsupported otherwise.
+
+config SMMSTORE_MOR_LOCK_ANY_BIOS_LOCK
+	bool
+	depends on SMMSTORE_MOR_LOCK
+	help
+	  Offer the MOR lock without SMM-only flash writes too. For tests in
+	  QEMU, where the flash has no such protection: the lock can be
+	  bypassed there, by writing the flash directly.
+
 endif
 
 # Outside "if SMMSTORE": a board selects it whatever its payload
