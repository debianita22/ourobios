 smm-$(CONFIG_SMMSTORE) += store.c smi.c
+smm-$(CONFIG_SMMSTORE_MOR_LOCK) += mor_lock.c
diff --git a/src/drivers/smmstore/mor_lock.c b/src/drivers/smmstore/mor_lock.c
new file mode 100644
index 0000000000..2236aea401
--- /dev/null
+++ b/src/drivers/smmstore/mor_lock.c
@@ -0,0 +1,224 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * The lock of TCG Secure MOR (SMMSTORE_CMD_MOR_LOCK, smmstore.h): its state
+ * in SMRAM, and the check of the writes of the variable store while it holds.
+ */
+
+#include <boot_device.h>
+#include <commonlib/helpers.h>
+#include <commonlib/region.h>
+#include <console/console.h>
+#include <cpu/x86/smm.h>
+#include <drivers/efi/efivars.h>
+#include <fmap.h>
+#include <security/lockdown/lockdown.h>
+#include <smmstore.h>
+#include <string.h>
+#include <types.h>
+
+#define MOR_LOCK_SIGNATURE 0x4b4c524d /* "MRLK" */
+
+struct mor_lock_state {
+	uint32_t signature;
+	uint8_t locked;
+	uint8_t has_key;
+	/* The OS asked for the clearing when it locked: keep that request */
+	uint8_t protect;
+	uint8_t reserved;
+	uint8_t key[SMMSTORE_MOR_LOCK_KEY_SIZE];
+} __packed;
+
+/* In the SMRAM region kept across S3, zeroed on every other boot */
+static struct mor_lock_state *mor_state(void)
+{
+	struct mor_lock_state *state;
+	uintptr_t base;
+	size_t size;
+
+	smm_get_mor_lock_state_buffer(&base, &size);
+	if (!base || size < sizeof(*state))
+		return NULL;
+
+	state = (struct mor_lock_state *)base;
+	if (state->signature != MOR_LOCK_SIGNATURE) {
+		memset(state, 0, sizeof(*state));
+		state->signature = MOR_LOCK_SIGNATURE;
+	}
+	return state;
+}
+
+/*
+ * The variable store itself, not smmstore_lookup_region(): that one keeps the
+ * region of its first call, the whole flash when capsules came first.
+ */
+static int variable_store(struct region_device *rdev)
+{
+	struct region region;
+
+	if (fmap_locate_area(SMMSTORE_REGION, &region))
+		return -1;
+	return boot_device_ro_subregion(&region, rdev);
+}
+
+/*
+ * The request as the next boot reads it (security/memory): a variable that is
+ * missing or unreadable counts as one.
+ */
+static bool mor_requested(const struct region_device *store)
+{
+	uint8_t mor;
+
+	if (efi_fv_get_mor(store, &mor) != CB_SUCCESS)
+		return true;
+	return mor & 1;
+}
+
+/*
+ * The variable store as the flash would be after a write (@data, programmed
+ * over what is there: only bits that are set can be cleared) or an erase
+ * (@data NULL) of [@offset, @offset + @size).
+ */
+struct after_write {
+	struct region_device rdev;
+	const struct region_device *store;
+	size_t offset;
+	size_t size;
+	const uint8_t *data;
+	bool read_error;
+};
+
+static ssize_t after_write_readat(const struct region_device *rd, void *b, size_t offset,
+				  size_t size)
+{
+	struct after_write *aw = container_of((struct region_device *)rd, struct after_write,
+					      rdev);
+	const size_t start = MAX(offset, aw->offset);
+	const size_t end = MIN(offset + size, aw->offset + aw->size);
+	uint8_t *buf = b;
+
+	if (rdev_readat(aw->store, b, offset, size) != size) {
+		aw->read_error = true;
+		return -1;
+	}
+
+	for (size_t i = start; i < end; i++)
+		buf[i - offset] = aw->data ? buf[i - offset] & aw->data[i - aw->offset] : 0xff;
+
+	return size;
+}
+
+static void *after_write_mmap(const struct region_device *rd, size_t offset, size_t size)
+{
+	return NULL;
+}
+
+static int after_write_munmap(const struct region_device *rd, void *mapping)
+{
+	return 0;
+}
+
+static const struct region_device_ops after_write_ops = {
+	.mmap = after_write_mmap,
+	.munmap = after_write_munmap,
+	.readat = after_write_readat,
+};
+
+bool smmstore_mor_protecting(void)
+{
+	const struct mor_lock_state *state = mor_state();
+
+	return state && state->locked && state->protect;
+}
+
+bool smmstore_mor_write_allowed(size_t offset, const void *data, size_t size)
+{
+	struct region_device store;
+	struct after_write aw;
+	bool requested;
+
+	if (!smmstore_mor_protecting())
+		return true;
+
+	if (variable_store(&store)) {
+		printk(BIOS_ERR, "MOR lock: no variable store, write refused\n");
+		return false;
+	}
+
+	aw = (struct after_write){
+		.store = &store,
+		.offset = offset,
+		.size = size,
+		.data = data,
+	};
+	region_device_init(&aw.rdev, &after_write_ops, 0, region_device_sz(&store));
+
+	requested = mor_requested(&aw.rdev);
+	if (aw.read_error) {
+		/* Not the content: the flash could not be read, the check failed */
+		printk(BIOS_ERR, "MOR lock: variable store unreadable, write refused\n");
+		return false;
+	}
+	if (!requested)
+		printk(BIOS_WARNING, "MOR lock: refused a %s of the variable store that clears "
+		       "the request of the OS\n", data ? "write" : "erase");
+	return requested;
+}
+
+uint32_t smmstore_mor_lock(const struct smmstore_params_mor_lock *params)
+{
+	struct mor_lock_state *state = mor_state();
+	struct smmstore_params_mor_lock p;
+	struct region_device store;
+	uint8_t diff = 0;
+
+	if (!state)
+		return SMMSTORE_RET_UNSUPPORTED;
+	/* Without SMM-only flash writes the OS gets around any lock */
+	if (!enable_smm_bios_protection() && !CONFIG(SMMSTORE_MOR_LOCK_ANY_BIOS_LOCK))
+		return SMMSTORE_RET_UNSUPPORTED;
+
+	/* Read once: the parameters are in the memory of the OS */
+	memcpy(&p, params, sizeof(p));
+
+	switch (p.op) {
+	case SMMSTORE_MOR_LOCK_STATUS:
+		return SMMSTORE_RET_SUCCESS;
+
+	case SMMSTORE_MOR_LOCK_WITHOUT_KEY:
+	case SMMSTORE_MOR_LOCK_WITH_KEY:
+		if (state->locked)
+			return SMMSTORE_RET_FAILURE;
+		state->protect = variable_store(&store) || mor_requested(&store);
+		state->has_key = p.op == SMMSTORE_MOR_LOCK_WITH_KEY;
+		if (state->has_key)
+			memcpy(state->key, p.key, sizeof(state->key));
+		state->locked = 1;
+		memset(&p, 0, sizeof(p));
+		printk(BIOS_INFO, "MOR lock: locked %s a key, request of the OS %s\n",
+		       state->has_key ? "with" : "without", state->protect ? "yes" : "no");
+		return SMMSTORE_RET_SUCCESS;
+
+	case SMMSTORE_MOR_UNLOCK_WITH_KEY:
+		if (!state->locked)
+			return SMMSTORE_RET_SUCCESS;
+		if (!state->has_key)
+			return SMMSTORE_RET_FAILURE;
+		for (size_t i = 0; i < sizeof(state->key); i++)
+			diff |= state->key[i] ^ p.key[i];
+		/* Right or wrong, the key is used up */
+		memset(state->key, 0, sizeof(state->key));
+		memset(&p, 0, sizeof(p));
+		state->has_key = 0;
+		if (diff) {
+			printk(BIOS_WARNING, "MOR lock: wrong key, locked until the next boot\n");
+			return SMMSTORE_RET_FAILURE;
+		}
+		state->locked = 0;
+		state->protect = 0;
+		printk(BIOS_INFO, "MOR lock: unlocked with its key\n");
+		return SMMSTORE_RET_SUCCESS;
+	}
+
+	return SMMSTORE_RET_UNSUPPORTED;
+}
diff --git a/src/drivers/smmstore/smi.c b/src/drivers/smmstore/smi.c
index 5c902fc55a..7aa7268912 100644
--- a/src/drivers/smmstore/smi.c
+++ b/src/drivers/smmstore/smi.c
@@ -345,6 +345,19 @@ uint32_t smmstore_exec(uint8_t command, void *param)
 	case SMMSTORE_CMD_VBOOT_TRY_OTHER:
 		ret = vboot_try_other();
 		break;
+	case SMMSTORE_CMD_MOR_LOCK: {
+		struct smmstore_params_mor_lock *params = param;
+
+		if (!CONFIG(SMMSTORE_MOR_LOCK)) {
+			ret = SMMSTORE_RET_UNSUPPORTED;
+			break;
+		}
+		if (range_check(params, sizeof(*params)) != 0)
+			break;
+
+		ret = smmstore_mor_lock(params);
+		break;
+	}
 	default:
 		printk(BIOS_DEBUG, "Unknown SMM store command: 0x%02x\n", command);
 		ret = SMMSTORE_RET_UNSUPPORTED;
diff --git a/src/drivers/smmstore/store.c b/src/drivers/smmstore/store.c
index 9ecb31a935..95f3b7fd57 100644
--- a/src/drivers/smmstore/store.c
+++ b/src/drivers/smmstore/store.c
@@ -8,9 +8,9 @@
 #include <fmap.h>
 #include <fmap_config.h>
 #include <smmstore.h>
+#include <string.h>
 #include <types.h>
 
-#define SMMSTORE_REGION "SMMSTORE"
 
 #define SMMSTORE_MIN_SIZE (64 * KiB)
 
@@ -24,6 +24,40 @@ _Static_assert(FMAP_SECTION_SMMSTORE_SIZE >= SMM_BLOCK_SIZE,
 	       "SMMSTORE FMAP region must fit at least one logical block");
 
 static int smmstore_use_full_flash;
+
+static enum cb_err lookup_store_region(struct region *region);
+
+#if ENV_SMM && CONFIG(SMMSTORE_MOR_LOCK)
+/*
+ * For SMMSTORE_MOR_LOCK: the part of a write (or, @data NULL, an erase) at
+ * @store_offset of the store, the SMMSTORE region or the whole flash for
+ * capsules, that falls in the SMMSTORE region, the variable store.
+ */
+static bool mor_lock_allows(size_t store_offset, const void *data, size_t size)
+{
+	struct region store, vars;
+	size_t start, end;
+
+	if (!smmstore_mor_protecting())
+		return true;
+	if (lookup_store_region(&store) != CB_SUCCESS ||
+	    fmap_locate_area(SMMSTORE_REGION, &vars))
+		return false;
+
+	start = MAX(region_offset(&store) + store_offset, region_offset(&vars));
+	end = MIN(region_offset(&store) + store_offset + size,
+		  region_offset(&vars) + region_sz(&vars));
+	if (start >= end)
+		return true;
+
