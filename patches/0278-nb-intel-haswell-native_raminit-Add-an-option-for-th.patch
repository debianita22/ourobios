+++ b/src/northbridge/intel/haswell/Kconfig
@@ -40,6 +40,24 @@ config HASWELL_NRI_ROUND_TRIP
 	  HASWELL_NRI_MEMORY_TEST, which trains again without this when the
 	  memory test fails.
 
+config HASWELL_NRI_MEMORY_PROFILE
+	bool "Offer the XMP profiles of the DIMMs as an option"
+	depends on USE_NATIVE_RAMINIT && SMMSTORE && CMOS_POST
+	help
+	  Read the option "memory_profile": with 1 or 2, train the memory
+	  with the timings and the clock of that XMP profile instead of
+	  those of the SPD, when every DIMM has it, for as many DIMMs as its
+	  channel holds and at a voltage the board is taken to feed, and up
+	  to the clock that the processor says it supports. The default is
+	  the SPD.
+
+	  A profile that fails the training, or that does not carry the
+	  firmware to the payload twice in a row, is given up until the
+	  option is changed: the state is in CMOS byte 0x7d, which the board
+	  must leave free, and the payload has to confirm each boot with
+	  SMMSTORE_CMD_VBOOT_SLOT_GOOD, or the profile is given up after two
+	  boots.
+
