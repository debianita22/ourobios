diff --git a/src/northbridge/intel/haswell/memory_profile.h b/src/northbridge/intel/haswell/memory_profile.h
new file mode 100644
index 00000000..68e432f1
--- /dev/null
+++ b/src/northbridge/intel/haswell/memory_profile.h
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#ifndef NORTHBRIDGE_INTEL_HASWELL_MEMORY_PROFILE_H
+#define NORTHBRIDGE_INTEL_HASWELL_MEMORY_PROFILE_H
+
+#include <commonlib/helpers.h>
+#include <pc80/mc146818rtc.h>
+#include <types.h>
+
+/* The option "memory_profile": the timings of the SPD, or those of an XMP profile */
+enum memory_profile {
+	MEMORY_PROFILE_SPD = 0,
+	MEMORY_PROFILE_XMP_1 = 1,
+	MEMORY_PROFILE_XMP_2 = 2,
+};
+
+/*
+ * An XMP profile runs the memory faster than its SPD says, and a memory that
+ * trains and passes the memory test may still not carry the firmware to the
+ * payload. The option is in the variable store, which only a firmware that
+ * boots can change, so the firmware has to give the profile up by itself.
+ *
+ * One CMOS byte: whether the last boot asked for a profile, the profile that
+ * failed, and the boots in a row with a profile that the payload did not
+ * confirm. Romstage adds one to the count at every boot with a profile, but
+ * an S3 resume; SMM clears it when the payload says that the firmware booted
+ * (SMMSTORE_CMD_VBOOT_SLOT_GOOD). With two boots not confirmed, or a training
+ * that fails, the profile is marked as failed and the timings of the SPD are
+ * used, until the option is set to the SPD timings once (which forgets the
+ * mark) or to the other profile.
+ *
+ * A mark in the three high bits, so that a byte nobody wrote reads as
+ * nothing. Byte 0x7d is free on the boards that select the option: after the
+ * checksum of their cmos.layout (0x7b, 0x7c) and CMOS_POST (0x70-0x7a), before
+ * the bytes of the firmware watchdog (0x7e) and of the GbE switch (0x7f).
+ */
+#define MEMORY_PROFILE_CMOS		0x7d
+#define  MEMORY_PROFILE_MARK		0xa0
+#define  MEMORY_PROFILE_MARK_MASK	0xe0
+#define  MEMORY_PROFILE_ACTIVE		(1 << 4)
+#define  MEMORY_PROFILE_FAILED_SHIFT	2
+#define  MEMORY_PROFILE_FIELD_MASK	0x3
+#define MEMORY_PROFILE_MAX_UNCONFIRMED	2
+
+struct memory_profile_state {
+	bool active;		/* The last boot asked for a profile */
+	uint8_t failed;		/* The profile that failed, or MEMORY_PROFILE_SPD */
+	uint8_t unconfirmed;	/* Boots in a row with a profile, not confirmed */
+};
+
+static inline struct memory_profile_state memory_profile_read_state(void)
+{
+	const uint8_t v = cmos_read(MEMORY_PROFILE_CMOS);
+	struct memory_profile_state state = { 0 };
+
+	if ((v & MEMORY_PROFILE_MARK_MASK) == MEMORY_PROFILE_MARK) {
+		state.active = v & MEMORY_PROFILE_ACTIVE;
+		state.failed = (v >> MEMORY_PROFILE_FAILED_SHIFT) & MEMORY_PROFILE_FIELD_MASK;
+		state.unconfirmed = v & MEMORY_PROFILE_FIELD_MASK;
+	}
+	return state;
+}
+
+static inline void memory_profile_write_state(const struct memory_profile_state state)
+{
+	const uint8_t v = MEMORY_PROFILE_MARK | (state.active ? MEMORY_PROFILE_ACTIVE : 0) |
+		(state.failed & MEMORY_PROFILE_FIELD_MASK) << MEMORY_PROFILE_FAILED_SHIFT |
+		MIN(state.unconfirmed, MEMORY_PROFILE_FIELD_MASK);
+
+	if (cmos_read(MEMORY_PROFILE_CMOS) != v)
+		cmos_write(v, MEMORY_PROFILE_CMOS);
+}
+
+#endif
diff --git a/src/northbridge/intel/haswell/memory_profile_smm.c b/src/northbridge/intel/haswell/memory_profile_smm.c
new file mode 100644
index 00000000..16833ae4
--- /dev/null
+++ b/src/northbridge/intel/haswell/memory_profile_smm.c
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <smmstore.h>
+
+#include "memory_profile.h"
+
+/*
+ * The payload runs: the memory carried the firmware this far with the profile
+ * of this boot, if there is one. Clear the count of the boots that did not
+ * get here.
+ */
+void smmstore_memory_confirmed(void)
+{
+	struct memory_profile_state state = memory_profile_read_state();
+
+	if (!state.unconfirmed)
+		return;
+
+	state.unconfirmed = 0;
+	memory_profile_write_state(state);
+}
