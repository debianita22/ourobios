@@ -22,6 +24,79 @@ static uint32_t get_mem_multiplier(const struct sysinfo *ctrl)
 	die("Unsupported base frequency\n");
 }
 
+/*
+ * A time in units of 1/256 ns, in DCLKs of the memory clock that
+ * normalize_tck() chose.
+ *
+ * The times of an XMP profile are whole numbers of its own clock: ten clocks
+ * of DDR3-1866 are 10.714 ns. Divided by the cycle time of the standard speed,
+ * which is rounded down to a unit of 1/256 ns (274 for 274.3), that is 10.01
+ * clocks: one clock lost on each such timing, and on tAA the speed itself, as
+ * a profile often supports no other CAS latency. So, with a profile, use the
+ * clock itself, a multiple of 400/3 MHz or of 100 MHz, in hundredths of a
+ * DCLK, and drop the last hundredth, for the rounding up of the decoded
+ * times. The times of an SPD are converted as they always were.
+ */
+uint32_t time_to_dclks(const struct sysinfo *ctrl, const uint32_t time)
+{
+	if (!ctrl->xmp)
+		return DIV_ROUND_UP(time, ctrl->tCK);
+
+	/*
+	 * time / 256 ns * multiplier * 400/3 MHz, times 100, is
+	 * time * multiplier * 5 / 96; with 100 MHz, 5 / 128.
+	 */
+	const uint32_t bounded = MIN(time, 0x00ffffff);
+	const uint32_t dclks_x100 = DIV_ROUND_UP(bounded * get_mem_multiplier(ctrl) * 5,
+						 ctrl->base_freq == 100 ? 128 : 96);
+
+	return DIV_ROUND_UP(dclks_x100 - MIN(dclks_x100, 1), 100);
+}
+
+/*
+ * The fastest memory clock that the processor says it supports, for each
+ * reference clock (CAPID0_B), unless it allows memory overclocking (CAPID0_A).
+ * Only asked with an XMP profile, the one case in which the DIMMs may say more
+ * than the processor.
+ */
+static bool mem_clock_is_supported(const struct sysinfo *ctrl)
+{
+	static const uint16_t ref133_max_mhz[] = {
+		[0] = UINT16_MAX,	/* No limit */
+		[1] = 1333,
+		[2] = 1200,
+		[3] = 1066,
+		[4] = 933,
+		[5] = 800,
+		[6] = 666,
+		[7] = 533,
+	};
+	static const uint16_t ref100_max_mhz[] = {
+		[0] = 0,		/* Not supported */
+		[1] = 700,
+		[2] = 800,
+		[3] = 900,
+		[4] = 1000,
+		[5] = 1100,
+		[6] = 1200,
+		[7] = UINT16_MAX,	/* No limit */
+	};
+	const union pci_capid0_a_reg capid0_a = {
+		.raw = pci_read_config32(HOST_BRIDGE, CAPID0_A)
+	};
+	const union pci_capid0_b_reg capid0_b = {
+		.raw = pci_read_config32(HOST_BRIDGE, CAPID0_B)
+	};
+
+	if (capid0_a.DDR_OVERCLOCK)
+		return true;
+
+	if (ctrl->base_freq == 100)
+		return ctrl->mem_clock_mhz <= ref100_max_mhz[capid0_b.PLL_REF100_CFG];
+
+	return ctrl->mem_clock_mhz <= ref133_max_mhz[capid0_b.DMFC];
+}
+
 static void normalize_tck(struct sysinfo *ctrl, const bool pll_ref100)
 {
 	/** TODO: Haswell supports up to DDR3-2600 **/
@@ -90,6 +165,11 @@ static void normalize_tck(struct sysinfo *ctrl, const bool pll_ref100)
 		/* Skip unsupported frequency */
 		ctrl->tCK++;
 		normalize_tck(ctrl, pll_ref100);
+	} else if (ctrl->xmp && !mem_clock_is_supported(ctrl)) {
+		printk(BIOS_DEBUG, "The processor does not support %u MHz, trying less\n",
+		       ctrl->mem_clock_mhz);
+		ctrl->tCK++;
+		normalize_tck(ctrl, pll_ref100);
 	}
 }
 
@@ -99,7 +179,7 @@ static void normalize_tck(struct sysinfo *ctrl, const bool pll_ref100)
 static uint8_t find_compatible_cas(struct sysinfo *ctrl)
 {
 	printk(RAM_DEBUG, "With tCK %u, try CAS: ", ctrl->tCK);
-	const uint8_t cas_lower = MAX(MIN_CAS, DIV_ROUND_UP(ctrl->tAA, ctrl->tCK));
+	const uint8_t cas_lower = MAX(MIN_CAS, time_to_dclks(ctrl, ctrl->tAA));
 	const uint8_t cas_upper = MIN(MAX_CAS, 19); /* JEDEC MR0 limit */
 
 	if (!(ctrl->cas_supported >> (cas_lower - MIN_CAS))) {
@@ -123,6 +203,11 @@ static enum nri_status find_cas_tck(struct sysinfo *ctrl)
 	uint8_t pll_ref100 = (pci_read_config32(HOST_BRIDGE, CAPID0_B) >> 21) & 0x7;
 	printk(RAM_DEBUG, "PLL_REF100_CFG value: 0x%x\n", pll_ref100);
 	printk(RAM_DEBUG, "100MHz reference clock support: %s\n", pll_ref100 ? "yes" : "no");
+	if (ctrl->xmp) {
+		printk(BIOS_DEBUG, "XMP profile: tCK %u, CAPID0_A 0x%08x, CAPID0_B 0x%08x\n",
+		       ctrl->tCK, pci_read_config32(HOST_BRIDGE, CAPID0_A),
+		       pci_read_config32(HOST_BRIDGE, CAPID0_B));
+	}
 
 	uint8_t selected_cas;
 	while (true) {
@@ -145,6 +230,55 @@ static enum nri_status find_cas_tck(struct sysinfo *ctrl)
 	return NRI_STATUS_SUCCESS;
 }
 
+/* In the extra field of CMOS_POST with POSTCODE_RESET_REQUESTED */
+#define RESET_EXTRA_MPLL	0x4d504c4c	/* "MPLL" */
+
+/*
+ * The MPLL cannot be locked again at another frequency. With the option for
+ * an XMP profile the frequency can change from one boot to the next, and if
+ * the MPLL is still locked where the boot before left it (a warm reset may
+ * keep it), the memory controller would be set up for one clock and run at
+ * another. Power the processor down then, which the MPLL does not survive.
+ * Only when this boot or the one before asked for a profile (with the
+ * timings of the SPD at every boot, nothing is looked at and nothing
+ * changes), only before the first request of this boot (after it, the MPLL
+ * is where this boot put it), and at most once: if it is still locked
+ * elsewhere after that reset, go on as this code always did.
+ */
+static bool mpll_requested;
+
+static void reset_if_mpll_locked_elsewhere(const struct sysinfo *ctrl)
+{
+	/* CMOS_POST is the loop breaker: without it, no reset */
+	if (!CONFIG(HASWELL_NRI_MEMORY_PROFILE) || !CONFIG(CMOS_POST) ||
+	    ctrl->bootmode == BOOTMODE_S3 || mpll_requested ||
+	    !nri_memory_profile_may_change_clock())
+		return;
+
+	const uint32_t locked = mchbar_read32(MC_BIOS_DATA) & 0xf;
+	if (!locked || locked == ctrl->multiplier)
+		return;
+
+	u8 code;
+	u32 extra;
+
+	cmos_post_previous_boot(&code, &extra);
+	if (code == POSTCODE_RESET_REQUESTED && extra == RESET_EXTRA_MPLL) {
+		printk(BIOS_ERR, "MPLL still locked at multiplier %u after a reset, "
+		       "%u wanted\n", locked, ctrl->multiplier);
+		return;
+	}
+	cmos_post_extra(RESET_EXTRA_MPLL);
+	cmos_post_code(POSTCODE_RESET_REQUESTED);
+
+	printk(BIOS_NOTICE, "MPLL locked at multiplier %u, %u wanted: resetting\n",
+	       locked, ctrl->multiplier);
+	/* This boot is not one that failed with the profile */
+	nri_memory_profile_uncount();
+	post_code(POSTCODE_RESET_REQUESTED);
+	full_reset();
+}
+
 enum nri_status initialise_mpll(struct sysinfo *ctrl)
 {
 	if (ctrl->tCK > TCK_400MHZ) {
@@ -177,6 +311,8 @@ enum nri_status initialise_mpll(struct sysinfo *ctrl)
 		//if (mchbar_read32(MC_BIOS_DATA) != 0)
 		//	break;
 
+		reset_if_mpll_locked_elsewhere(ctrl);
+
 		uint32_t mc_bios_req = ctrl->multiplier;
 		if (ctrl->base_freq == 100) {
 			/* Use 100 MHz reference clock */
@@ -186,6 +322,7 @@ enum nri_status initialise_mpll(struct sysinfo *ctrl)
 		printk(RAM_DEBUG, "MC_BIOS_REQ = 0x%08x\n", mc_bios_req);
 		printk(BIOS_DEBUG, "MPLL busy... ");
 		mchbar_write32(MC_BIOS_REQ, mc_bios_req);
+		mpll_requested = true;
 
 		for (unsigned int i = 0; i <= 5000; i++) {
 			if (!(mchbar_read32(MC_BIOS_REQ) & BIT(31))) {
diff --git a/src/northbridge/intel/haswell/native_raminit/memory_profile.c b/src/northbridge/intel/haswell/native_raminit/memory_profile.c
new file mode 100644
index 00000000..f5a670cd
--- /dev/null
+++ b/src/northbridge/intel/haswell/native_raminit/memory_profile.c
@@ -0,0 +1,174 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <cf9_reset.h>
+#include <console/console.h>
+#include <northbridge/intel/haswell/memory_profile.h>
+#include <option.h>
+#include <post.h>
+#include <types.h>
+
+#include "raminit_native.h"
+
+/* In the extra field of CMOS_POST with POSTCODE_RESET_REQUESTED */
+#define RESET_EXTRA_MEMORY_PROFILE	0x584d5000	/* "XMP" */
+
+/* The profile of this boot: decided once, before the saved training is looked up */
+static uint8_t boot_profile = MEMORY_PROFILE_SPD;
+
+/* Whether the boot before this one asked for a profile */
+static bool profile_before;
+
+/* What nri_memory_profile_init() said, for nri_memory_profile_report() */
+static enum {
+	SAID_NOTHING,
+	SAID_REQUESTED,
+	SAID_FAILED_BEFORE,
+	SAID_GAVE_UP,
+} said;
+static uint8_t said_option, said_boots;
+
+static void say_decision(void)
+{
+	switch (said) {
+	case SAID_REQUESTED:
+		printk(BIOS_INFO, "Memory profile: XMP profile %u requested\n", said_option);
+		break;
+	case SAID_FAILED_BEFORE:
+		printk(BIOS_ERR, "Memory profile: XMP profile %u failed before, using the SPD "
+		       "timings. Select the SPD timings once to try it again\n", said_option);
+		break;
+	case SAID_GAVE_UP:
+		printk(BIOS_ERR, "Memory profile: %u boots in a row with XMP profile %u did not "
+		       "reach the payload, using the SPD timings from now on\n",
+		       said_boots, said_option);
+		break;
+	default:
+		break;
+	}
+}
+
+uint8_t nri_memory_profile(void)
+{
+	return boot_profile;
+}
+
+/*
+ * Whether the memory clock of this boot may differ from that of the boot
+ * before: a profile now, or a profile then.
+ */
+bool nri_memory_profile_may_change_clock(void)
+{
+	return boot_profile != MEMORY_PROFILE_SPD || profile_before;
+}
+
+/*
+ * Decide the profile of this boot from the option and from how the boots
+ * before went (northbridge/intel/haswell/memory_profile.h). An S3 resume
+ * takes what the boot it resumes took, and counts nothing: neither the
+ * option nor the mark of a failed profile can have changed since.
+ */
+void nri_memory_profile_init(const bool s3resume)
+{
+	boot_profile = MEMORY_PROFILE_SPD;
+	said = SAID_NOTHING;
+
+	if (!CONFIG(HASWELL_NRI_MEMORY_PROFILE))
+		return;
+
+	const unsigned int option = get_uint_option("memory_profile", MEMORY_PROFILE_SPD);
+	struct memory_profile_state state = memory_profile_read_state();
+
+	profile_before = state.active;
+
+	if (option != MEMORY_PROFILE_XMP_1 && option != MEMORY_PROFILE_XMP_2) {
+		/* Forget a failed profile: selecting it again tries it again */
+		memory_profile_write_state((struct memory_profile_state) { 0 });
+		return;
+	}
+
+	said_option = option;
+
+	if (state.failed == option) {
+		said = SAID_FAILED_BEFORE;
+		say_decision();
+		state.active = false;
+		state.unconfirmed = 0;
+		memory_profile_write_state(state);
+		return;
+	}
+
+	if (s3resume) {
+		boot_profile = option;
+		return;
+	}
+
+	if (state.unconfirmed >= MEMORY_PROFILE_MAX_UNCONFIRMED) {
+		said = SAID_GAVE_UP;
+		said_boots = state.unconfirmed;
+		say_decision();
+		state.active = false;
+		state.failed = option;
+		state.unconfirmed = 0;
+		memory_profile_write_state(state);
+		return;
+	}
+
+	state.active = true;
+	state.unconfirmed++;
+	memory_profile_write_state(state);
+	boot_profile = option;
+	said = SAID_REQUESTED;
+	say_decision();
+}
+
+/*
+ * Say again, once the console is in CBMEM, what was decided about the profile
+ * and whether the DIMMs have it. A boot that trains overflows the pre-RAM
+ * console and loses its start, and a profile asked for, refused or given up
+ * makes such a boot: the version of the saved training has the profile.
+ */
+void nri_memory_profile_report(void)
+{
+	say_decision();
+	report_xmp_profile_use();
+}
+
+/* A reset that this code asks for before the training is not a boot that failed */
+void nri_memory_profile_uncount(void)
+{
+	struct memory_profile_state state = memory_profile_read_state();
+
+	if (boot_profile == MEMORY_PROFILE_SPD || !state.unconfirmed)
+		return;
+
+	state.unconfirmed--;
+	memory_profile_write_state(state);
+}
+
+/*
+ * The training with the profile failed twice. The memory clock cannot be
+ * lowered once the MPLL is locked, so mark the profile as failed and start
+ * again through a reset that powers the processor down: the next boot trains
+ * with the timings of the SPD.
+ */
+void nri_memory_profile_failed(void)
+{
+	/* Active: the next boot starts from the clock of this one */
+	const struct memory_profile_state state = {
+		.active = true,
+		.failed = boot_profile,
+		.unconfirmed = 0,
+	};
+
+	memory_profile_write_state(state);
+	printk(BIOS_ERR, "Memory profile: the training with XMP profile %u failed, resetting "
+	       "to train with the SPD timings\n", boot_profile);
+
+	/* For the next boot, also with NO_POST: a reset the firmware asked for */
+	if (CONFIG(CMOS_POST)) {
+		cmos_post_extra(RESET_EXTRA_MEMORY_PROFILE);
+		cmos_post_code(POSTCODE_RESET_REQUESTED);
+	}
+	post_code(POSTCODE_RESET_REQUESTED);
+	full_reset();
+}
