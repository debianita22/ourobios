 /* SPDX-License-Identifier: GPL-2.0-or-later */
 
+#include <cf9_reset.h>
 #include <commonlib/bsd/clamp.h>
 #include <console/console.h>
 #include <delay.h>
 #include <device/pci_ops.h>
 #include <northbridge/intel/haswell/haswell.h>
