+ramstage-$(CONFIG_SOC_INTEL_CANNONLAKE_FIRMWARE_WATCHDOG) += firmware_watchdog.c
+smm-$(CONFIG_SOC_INTEL_CANNONLAKE_FIRMWARE_WATCHDOG) += firmware_watchdog.c
