diff --git a/src/soc/intel/cannonlake/firmware_watchdog.c b/src/soc/intel/cannonlake/firmware_watchdog.c
new file mode 100644
index 00000000000..21879fac675
--- /dev/null
+++ b/src/soc/intel/cannonlake/firmware_watchdog.c
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * The firmware watchdog (SOC_INTEL_CANNONLAKE_FIRMWARE_WATCHDOG): the
+ * overclocking watchdog of the PCH, armed by romstage before the memory
+ * init when the option "firmware_watchdog" gives a timeout, and stopped by
+ * SMM when the payload confirms the RW slot (SMMSTORE_CMD_VBOOT_SLOT_GOOD).
+ * A boot that hangs in between is reset by the PCH; with a new slot on
+ * trial, two such resets make vboot fall back to the other slot. Off, or on
+ * a resume from S3, where the payload does not run, romstage stops it.
+ */
+
+#include <bootstate.h>
+#include <commonlib/helpers.h>
+#include <console/console.h>
+#include <intelblocks/oc_wdt.h>
+#include <option.h>
+#include <smmstore.h>
+#include <soc/firmware_watchdog.h>
+#include <types.h>
+
+/* Never shorter: a boot that trains the memory takes about 40 s */
+#define FIRMWARE_WATCHDOG_MIN_SECONDS	180
+
+#if ENV_SEPARATE_ROMSTAGE
+static unsigned int firmware_watchdog_timeout(void)
+{
+	unsigned int t = get_uint_option("firmware_watchdog", 0);
+
+	if (!t)
+		return 0;
+	return MAX(t, FIRMWARE_WATCHDOG_MIN_SECONDS);
+}
+
+void firmware_watchdog_romstage(bool s3wake)
+{
+	const unsigned int t = firmware_watchdog_timeout();
+
+	if (oc_wdt_caused_reset())
+		printk(BIOS_WARNING, "Firmware watchdog: the last reset came from the watchdog\n");
+
+	if (t && !s3wake) {
+		oc_wdt_arm(t);
+		printk(BIOS_INFO, "Firmware watchdog: armed, %u s (OC_WDT_CTL 0x%08x)\n", t,
+		       oc_wdt_read());
+	} else {
+		oc_wdt_stop();
+		printk(BIOS_DEBUG, "Firmware watchdog: off (OC_WDT_CTL 0x%08x)\n", oc_wdt_read());
+	}
+}
+#endif
+
+#if ENV_RAMSTAGE
+/* A full window for the payload, and what FSP-S left of the register */
+static void firmware_watchdog_payload(void *unused)
+{
+	oc_wdt_reload();
+	printk(BIOS_INFO, "Firmware watchdog: at the payload, OC_WDT_CTL 0x%08x\n", oc_wdt_read());
+}
+BOOT_STATE_INIT_ENTRY(BS_PAYLOAD_BOOT, BS_ON_ENTRY, firmware_watchdog_payload, NULL);
+#endif
+
+#if ENV_SMM
+/* The payload confirmed the slot: the firmware booted, stop the watchdog */
+void smmstore_firmware_confirmed(void)
+{
+	oc_wdt_stop();
+}
+#endif
diff --git a/src/soc/intel/cannonlake/include/soc/firmware_watchdog.h b/src/soc/intel/cannonlake/include/soc/firmware_watchdog.h
new file mode 100644
index 00000000000..8ec9cc610b3
--- /dev/null
+++ b/src/soc/intel/cannonlake/include/soc/firmware_watchdog.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _SOC_CANNONLAKE_FIRMWARE_WATCHDOG_H_
+#define _SOC_CANNONLAKE_FIRMWARE_WATCHDOG_H_
+
+#include <types.h>
+
+#if CONFIG(SOC_INTEL_CANNONLAKE_FIRMWARE_WATCHDOG)
+void firmware_watchdog_romstage(bool s3wake);
+#else
+static inline void firmware_watchdog_romstage(bool s3wake) {}
+#endif
+
+#endif
diff --git a/src/soc/intel/cannonlake/romstage/romstage.c b/src/soc/intel/cannonlake/romstage/romstage.c
index b88d83507b7..f6aeda71eda 100644
--- a/src/soc/intel/cannonlake/romstage/romstage.c
+++ b/src/soc/intel/cannonlake/romstage/romstage.c
@@ -14,6 +14,7 @@
 #include <soc/iomap.h>
 #include <soc/pci_devs.h>
 #include <soc/pm.h>
+#include <soc/firmware_watchdog.h>
 #include <soc/romstage.h>
 #include <string.h>
 
@@ -146,6 +147,7 @@ void mainboard_romstage_entry(void)
 	s3wake = pmc_fill_power_state(ps) == ACPI_S3;
 	/* Before fsp_memory_init(), whose CBMEM hook copies ps for ramstage */
 	ps->options_reset = !s3wake && reset_options_on_rtc_failure(ps);
+	firmware_watchdog_romstage(s3wake);
 	fsp_memory_init(s3wake);
 	pmc_set_disb();
 	if (!s3wake) {
-- 
