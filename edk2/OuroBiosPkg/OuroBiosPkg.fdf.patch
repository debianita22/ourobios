@@ -10,16 +13,27 @@
 ##
 
 [Defines]
-DEFINE FD_BASE       = 0x00800000
+#
+# The payload runs from 1 GiB, and its HOB memory follows it
+# (UefiPayloadEntry): the memory from 1 MiB to 1 GiB stays free for the OS
+# loaders, which want it low. The kernel of macOS goes at 1 MiB plus 2 MiB
+# times a slide of up to 255, about 100 MB long; with the payload at 8 MiB
+# and the HOB memory after it, from 19 MiB, the slides below 41 were taken.
+#
+DEFINE FD_BASE       = 0x40000000
 DEFINE FD_BLOCK_SIZE = 0x00001000
 
 !if $(TARGET) == "NOOPT"
 DEFINE FD_SIZE     = 0x00850000
 DEFINE NUM_BLOCKS  = 0x850
 !else
-
-DEFINE FD_SIZE     = 0x00700000
-DEFINE NUM_BLOCKS  = 0x700
+!if $(TARGET) == DEBUG
+DEFINE FD_SIZE     = 0x0C00000
+DEFINE NUM_BLOCKS  = 0xC00
+!else
+DEFINE FD_SIZE     = 0x0B00000
+DEFINE NUM_BLOCKS  = 0xB00
+!endif
 !endif
 
