+#
+# OuroBiosPkg: the flash device of UefiPayloadPkg, 12 MiB for a DEBUG build
+# and 11 for a RELEASE one, as the payload of ouroBIOS (its edk2/0024): with
+# Secure Boot the DXE volume is past 7 MiB, and it is memory the payload
+# takes while it runs, not flash
+#
 !if $(TARGET) == "NOOPT"
 DEFINE FD_SIZE     = 0x00850000
 DEFINE NUM_BLOCKS  = 0x850
 !else
-
-DEFINE FD_SIZE     = 0x00700000
-DEFINE NUM_BLOCKS  = 0x700
+!if $(TARGET) == "DEBUG"
+DEFINE FD_SIZE     = 0x00C00000
+DEFINE NUM_BLOCKS  = 0xC00
+!else
+DEFINE FD_SIZE     = 0x00B00000
+DEFINE NUM_BLOCKS  = 0xB00
+!endif
 !endif
 
