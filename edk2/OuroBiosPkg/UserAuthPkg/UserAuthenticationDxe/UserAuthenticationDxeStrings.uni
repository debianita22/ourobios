#langdef en-US  "English"
#langdef fr-FR  "Francais"


#string STR_FORM_SET_TITLE             #language en-US "Password Lock"
                                       #language fr-FR "Password Lock"
#string STR_FORM_SET_TITLE_HELP        #language en-US "Configure password protection for setup menu access"
                                       #language fr-FR "Configure password protection for setup menu access"
#string STR_FORM_TITLE                 #language en-US "Password Management"
                                       #language fr-FR "Password Management"
#string STR_ADMIN_PASSWORD_PROMPT      #language en-US "Change Admin Password"
                                       #language fr-FR "Change Admin Password"
#string STR_ADMIN_PASSWORD_HELP        #language en-US "Input old admin password if it was set, then you can change the password to a new one. After the change action, you may need input the new password when you enter UI. The new password must be between 8 and 64 chars. Input an empty password can clean old admin password, then no need input password to enter UI."
                                       #language fr-FR "Input old admin password if it was set, then you can change the password to a new one. After the change action, you may need input the new password when you enter UI. The new password must be between 8 and 64 chars. Input an empty password can clean old admin password, then no need input password to enter UI."
#string STR_ADMIN_PASSWORD_STS_HELP    #language en-US "Current Admin Password status: Installed or Not Installed."
                                       #language fr-FR "Current Admin Password status: Installed or Not Installed."
#string STR_ADMIN_PASSWORD_STS_PROMPT  #language en-US "Admin Password Status"
                                       #language fr-FR "Admin Password Status"
#string STR_ADMIN_PASSWORD_STS_CONTENT #language en-US ""
                                       #language fr-FR ""
#string STR_EMPTY_STRING               #language en-US ""
                                       #language fr-FR ""
#string STR_MSG_INCORRECT              #language en-US "Incorrect password."
                                       #language fr-FR "Incorrect password."
#string STR_MSG_MISMATCH               #language en-US "The passwords are not the same."
                                       #language fr-FR "The passwords are not the same."
#string STR_MSG_RETRY_COUNT            #language en-US "Too many wrong passwords: the system resets."
                                       #language fr-FR "Too many wrong passwords: the system resets."
#string STR_MSG_WEAK                   #language en-US "The new password is too short: at least 8 characters."
                                       #language fr-FR "The new password is too short: at least 8 characters."
#string STR_MSG_UPDATED                #language en-US "The new password is set."
                                       #language fr-FR "The new password is set."
#string STR_MSG_HISTORY                #language en-US "The new password was used before: choose another one."
                                       #language fr-FR "The new password was used before: choose another one."
#string STR_MSG_FAILED                 #language en-US "The password could not be changed."
                                       #language fr-FR "The password could not be changed."
