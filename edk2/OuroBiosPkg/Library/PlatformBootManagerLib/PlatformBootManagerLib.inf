  gEficorebootNvDataGuid          ## CONSUMES ## Variable:L"ipxe_boot" L"csmwrap_boot" L"usb_boot" L"boot_menu_prompt"; PRODUCES ## Variable:L"OptionLockStatus"
  gEfiGlobalVariableGuid          ## CONSUMES ## Variable:L"SecureBoot"

[Protocols]
