## @file
# OuroBiosPkg: the modules and the platform of the payload of ouroBIOS that
# TianoCore's tree does not have, built against it (docs/edk2-migration.md
# of ouroBIOS, steps (b) and (c)). Declared here: the GUIDs, PCDs and
# library classes that only the package uses (PACKAGE_DECLS of
# tools/edk2-import.py); the modules take the others from TianoCore's
# packages, which patches/tianocore extends.
#
# SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = OuroBiosPkg
  PACKAGE_GUID                   = 2201540D-F8BE-4411-A3BE-5549BE0F5B19
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[LibraryClasses]
  BootSplashLib|Include/Library/BootSplashLib.h
  CbfsLib|Include/Library/CbfsLib.h
  ## @libraryclass  The firmware update screen; also a DisplayUpdateProgressLib
  UpdateScreenLib|Include/Library/UpdateScreenLib.h

[Guids]
  gOuroBiosPkgTokenSpaceGuid = { 0xb29ace79, 0xa1db, 0x4d48, { 0x8d, 0xb7, 0x58, 0x8d, 0x3e, 0x8f, 0x21, 0xf4 } }

  ## Include/Guid/TimeDateSettingsHii.h
  gTimeDateSettingsFormSetGuid   = { 0x7a8b9c0d, 0x1e2f, 0x3a4b, { 0x5c, 0x6d, 0x7e, 0x8f, 0x9a, 0x0b, 0x1c, 0x2d }}

  ## Include/Guid/BootSplashConfig.h
  gUefiPayloadBootSplashGuid = { 0x8a7c3e21, 0x4f5b, 0x4d91, { 0x9c, 0x2e, 0x1a, 0x3b, 0x5d, 0x7f, 0x8e, 0x90 } }
  gBootSplashConfigFormSetGuid = { 0xb2d4e6f8, 0x1a3c, 0x4e5f, { 0x8b, 0x9d, 0x0c, 0x2e, 0x4a, 0x6f, 0x8d, 0xb1 } }

  ## Include/Guid/FirmwareUpdateConfig.h
  gFirmwareUpdateFormSetGuid = { 0x04e8b12f, 0xc919, 0x4cd9, { 0x89, 0x3d, 0x64, 0x23, 0x40, 0x4d, 0xc0, 0x2d } }

  # Secure Boot keys and owners
  gMicrosoftVendorGuid        = { 0x77fa9abd, 0x0359, 0x4d32, { 0xbd, 0x60, 0x28, 0xf4, 0xe7, 0x8f, 0x78, 0x4b } }
  gMicrosoftDbxUpdateGuid     = { 0x4e52dd60, 0xd79e, 0x42c5, { 0x83, 0x37, 0x08, 0x92, 0x32, 0xea, 0x5c, 0x87 } }
  gMicrosoftDbxBaselineGuid   = { 0x3d844ea9, 0xe7da, 0x48c5, { 0xa0, 0x31, 0xfa, 0x22, 0xb1, 0x0f, 0x8d, 0x7b } }
  gMicrosoftDbUefi2011Guid    = { 0x73282f84, 0x7909, 0x4e87, { 0xad, 0xf0, 0x84, 0x5d, 0x5d, 0xa3, 0x35, 0xab } }
  gMicrosoftDbWin2011Guid     = { 0x9b29f606, 0x5102, 0x4de1, { 0xa8, 0x8a, 0xff, 0x62, 0x10, 0xbd, 0x8b, 0x65 } }
  gMicrosoftDbUefi2023Guid    = { 0xc7769261, 0xfe8d, 0x4e15, { 0xb3, 0x34, 0xca, 0xdf, 0x43, 0x64, 0xad, 0x92 } }
  gMicrosoftDbWinUefi2023Guid = { 0x4ac66f32, 0x6895, 0x46fc, { 0xad, 0x00, 0xf1, 0xc8, 0x1d, 0x06, 0xc6, 0x68 } }
  gMicrosoftKek2011Guid       = { 0x73f89874, 0xb2ec, 0x4c28, { 0xa7, 0xe3, 0x7d, 0x80, 0x30, 0x13, 0x4e, 0x0b } }
  gMicrosoftKek2023Guid       = { 0xcce7d8e7, 0xaae8, 0x4697, { 0xb5, 0xc0, 0xef, 0x35, 0xa9, 0x2a, 0x05, 0x9f } }
  gMicrosoftDbOpRomUefi2023Guid = { 0xf5a81b7b, 0x419a, 0x4a92, { 0x82, 0x12, 0x1c, 0x36, 0x9b, 0xcb, 0xe2, 0xcb } }
  gMicrosoftPkOem2023Guid     = { 0x701649dd, 0x8739, 0x40b9, { 0xbb, 0xdb, 0x9c, 0xa4, 0x34, 0xfd, 0xcd, 0x3b } }

[Protocols]
  #
  # Gop Temp
  #
  gPlatformGOPPolicyGuid                  = { 0xec2e931b, 0x3281, 0x48a5, { 0x81, 0x07, 0xdf, 0x8a, 0x8b, 0xed, 0x3c, 0x5d } }
  ## The state of the firmware update being written, for the update screen
  #  Include/Protocol/FirmwareUpdateStatus.h
  gFirmwareUpdateStatusProtocolGuid       = { 0xe769a170, 0xb26e, 0x4763, { 0x9b, 0xbd, 0x42, 0xb7, 0xf6, 0x68, 0xdd, 0xa5 } }

[PcdsFixedAtBuild, PcdsPatchableInModule]
# Enable serial terminal print for boot menu prompt
gOuroBiosPkgTokenSpaceGuid.PcdSerialTerminalPrintEnabled|FALSE|BOOLEAN|0x00000021

## If TRUE, EnrollDefaultKeys leaves Secure Boot enabled after provisioning
#  default PK/KEK/db/dbx. If FALSE (legacy MrChromebox behavior), keys are
#  enrolled but SecureBootEnable/SecureBoot remain disabled until toggled in setup.
gOuroBiosPkgTokenSpaceGuid.PcdSecureBootDefaultEnable|FALSE|BOOLEAN|0x0000002F

## Title of the category of the CFR setup menu that ends with links to the
#  Secure Boot page (SecureBootConfigDxe) and to the password asked for
#  before the setup menu opens (UserAuthenticationDxe), to those of them
#  that are there. An empty string leaves them out.
gOuroBiosPkgTokenSpaceGuid.PcdCfrSetupMenuPasswordCategory|L"Security"|VOID*|0x00000030

## Title of the category of the CFR setup menu that ends with links to the
#  pages of the time and date, the firmware update, the boot splash and the
#  graphical UI, to those of them that are there. An empty string leaves
#  them out.
gOuroBiosPkgTokenSpaceGuid.PcdCfrSetupMenuGeneralCategory|L"General"|VOID*|0x00000031

## The FMAP regions that an update capsule may write (FmpDeviceSmmLib), their
#  names separated by spaces: a capsule whose manifest names another region
#  is refused before anything is written.  A list without names allows
#  every region of the flash map.
gOuroBiosPkgTokenSpaceGuid.PcdFmpDeviceSmmAllowedRegions|""|VOID*|0x00000032
