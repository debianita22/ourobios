## @file
# OuroBiosPkg: the modules and the platform of the payload of ouroBIOS,
# built against EDK II of TianoCore (docs/edk2-migration.md in ouroBIOS,
# "Step (b)").
#
# SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = OuroBiosPkg
  PACKAGE_GUID                   = 2201540D-F8BE-4411-A3BE-5549BE0F5B19
  PACKAGE_VERSION                = 0.1

[Guids]
  ## The token space of the package
  gOuroBiosPkgTokenSpaceGuid  = { 0x19d9cdf6, 0x3adf, 0x49de, { 0x82, 0x74, 0xa6, 0x22, 0xb9, 0xd4, 0x20, 0xfe } }

  ## Secure Boot keys and owners, the files of EnrollDefaultKeys (MrChromebox's
  ## 2686758 and the commits after it, in UefiPayloadPkg.dec there)
  gMicrosoftVendorGuid        = { 0x77fa9abd, 0x0359, 0x4d32, { 0xbd, 0x60, 0x28, 0xf4, 0xe7, 0x8f, 0x78, 0x4b } }
  gMicrosoftDbxUpdateGuid     = { 0x4e52dd60, 0xd79e, 0x42c5, { 0x83, 0x37, 0x08, 0x92, 0x32, 0xea, 0x5c, 0x87 } }
  gMicrosoftDbxBaselineGuid   = { 0x3d844ea9, 0xe7da, 0x48c5, { 0xa0, 0x31, 0xfa, 0x22, 0xb1, 0x0f, 0x8d, 0x7b } }
  gMicrosoftDbUefi2011Guid    = { 0x73282f84, 0x7909, 0x4e87, { 0xad, 0xf0, 0x84, 0x5d, 0x5d, 0xa3, 0x35, 0xab } }
  gMicrosoftDbWin2011Guid     = { 0x9b29f606, 0x5102, 0x4de1, { 0xa8, 0x8a, 0xff, 0x62, 0x10, 0xbd, 0x8b, 0x65 } }
  gMicrosoftDbUefi2023Guid    = { 0xc7769261, 0xfe8d, 0x4e15, { 0xb3, 0x34, 0xca, 0xdf, 0x43, 0x64, 0xad, 0x92 } }
  gMicrosoftDbWinUefi2023Guid = { 0x4ac66f32, 0x6895, 0x46fc, { 0xad, 0x00, 0xf1, 0xc8, 0x1d, 0x06, 0xc6, 0x68 } }
  gMicrosoftKek2011Guid       = { 0x73f89874, 0xb2ec, 0x4c28, { 0xa7, 0xe3, 0x7d, 0x80, 0x30, 0x13, 0x4e, 0x0b } }
  gMicrosoftKek2023Guid       = { 0xcce7d8e7, 0xaae8, 0x4697, { 0xb5, 0xc0, 0xef, 0x35, 0xa9, 0x2a, 0x05, 0x9f } }
  gMicrosoftDbOpRomUefi2023Guid = { 0xf5a81b7b, 0x419a, 0x4a92, { 0x82, 0x12, 0x1c, 0x36, 0x9b, 0xcb, 0xe2, 0xcb } }
  gMicrosoftPkOem2023Guid     = { 0x701649dd, 0x8739, 0x40b9, { 0xbb, 0xdb, 0x9c, 0xa4, 0x34, 0xfd, 0xcd, 0x3b } }

[PcdsFixedAtBuild]
  ## TRUE: Secure Boot on after EnrollDefaultKeys enrolls the default keys at
  ## the first boot; FALSE (the boards): the keys are there and Secure Boot
  ## waits for the setup
  gOuroBiosPkgTokenSpaceGuid.PcdSecureBootDefaultEnable|FALSE|BOOLEAN|0x00000001
