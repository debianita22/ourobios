# ThinkCentre M920x Tiny (Coffee Lake, Q370), RAM init con FSP-M di Intel
# (3rdparty/fsp, CoffeeLakeFspBinPkg): una sola variante, "fsp".
# Immagine completa da 24 MiB: IFD, GbE e ME di boards/m920x/blobs/ piu'
# coreboot. I file in m920x/ li copia tools/build.sh da boards/m920x/,
# assets/ e keys/.
CONFIG_VENDOR_LENOVO=y
CONFIG_BOARD_LENOVO_M920X=y
# Mappa del flash: boards/m920x/flash.fmd (le regioni scritte a ogni avvio
# in testa alla regione BIOS, i due slot RW di vboot, la regione RO in cima
# al chip da 8 MiB).
CONFIG_FMDFILE="m920x/m920x.fmd"

# vboot come sul W541 (docs/vboot.md): la regione RO (bootblock con
# verstage e microcode) verifica la firma di uno dei due slot RW (romstage,
# FSP-M, FSP-S, ramstage, payload) e lo avvia; se non si verifica, o non
# arriva al payload per due avvii dopo un aggiornamento, avvia l'altro.
# Nessun recovery: la RO minima non ha un payload.
CONFIG_VBOOT=y
CONFIG_VBOOT_SLOTS_RW_AB=y
CONFIG_LENOVO_M920_VBOOT_MINIMAL_RO=y
# Niente dati di vboot nel TPM (anti-rollback degli slot): il TPM 2.0 serve
# solo alle misure, e se non parte l'avvio continua senza (patch 0199)
CONFIG_VBOOT_MOCK_SECDATA=y
# Measured boot (from v1.5.0): verstage starts the TPM and coreboot
# measures every stage it loads into PCR0/PCR2, with its own event log
CONFIG_TPM_MEASURED_BOOT=y
# Il TPM 2.0 del M920x ha allocati i banchi SHA-1 e SHA-256: le misure in
# tutti e due, con i due digest in ogni evento (patch 0201)
CONFIG_TPM_MEASURED_BOOT_SHA1_BANK=y
# Con vboot il codice grafico comune di Intel accende lo schermo solo se
# vboot lo chiede (recovery, modo sviluppatore): qui sempre
CONFIG_VBOOT_ALWAYS_ENABLE_DISPLAY=y
# Le chiavi del progetto, le stesse del W541 (keys/vboot, che tools/build.sh
# copia in m920x/vboot/). La chiave privata degli slot arriva solo dal
# secret VBOOT_SIGNING_KEY; senza, tools/build.sh usa le chiavi di prova.
CONFIG_VBOOT_ROOT_KEY="m920x/vboot/root_key.vbpubk"
CONFIG_VBOOT_RECOVERY_KEY="m920x/vboot/recovery_key.vbpubk"
CONFIG_VBOOT_KERNEL_KEY="m920x/vboot/kernel_subkey.vbpubk"
CONFIG_VBOOT_KEYBLOCK="m920x/vboot/firmware.keyblock"
CONFIG_VBOOT_FIRMWARE_PRIVKEY="m920x/vboot/firmware_data_key.vbprivk"

# IFD, GbE e ME del firmware Lenovo del M920x del port, letto dai due chip
# (MAC e8:6a:64:cd:fd:06, CSME 12.0.6.1120 completa): regioni sbloccate con
# ifdtool, ME leggibile dalla CPU. La ME resta intera: lo stato si sceglie
# dal menu (Security -> Management Engine, comando HECI), senza me_cleaner.
CONFIG_HAVE_IFD_BIN=y
CONFIG_IFD_BIN_PATH="m920x/ifd.bin"
CONFIG_HAVE_ME_BIN=y
CONFIG_ME_BIN_PATH="m920x/me.bin"
CONFIG_HAVE_GBE_BIN=y
CONFIG_GBE_BIN_PATH="m920x/gbe.bin"
CONFIG_UNLOCK_FLASH_REGIONS=y
CONFIG_ME_REGION_ALLOW_CPU_READ_ACCESS=y
CONFIG_VALIDATE_INTEL_DESCRIPTOR=y

# I bit 3:0 della versione del training salvato (patch 0222; i bit 7:4 sono
# processore e Hyper-Threading, patch 0173). La capsula lascia RW_MRC_CACHE
# (BOARD_CAPSULE_REGIONS di board.sh): una release che cambia le UPD della
# memoria che mette coreboot alza questo numero, e il primo avvio rifa' il
# training. tools/fspm-settings.sh, in check.yml, ferma un cambio dei file di
# quelle UPD finche' boards/m920x/fspm-settings.txt non dice che e' stato
# guardato.
CONFIG_FSP_MEMORY_SETTINGS_SOC_VERSION=1

# Memoria azzerata a ogni avvio (non alla ripresa da S3); si spegne dal
# menu, Security -> Memory protection.
CONFIG_SECURITY_CLEAR_DRAM_ON_REGULAR_BOOT=y
# Il lock di TCG Secure MOR (MemoryOverwriteRequestControlLock) tenuto da SMM
# (patch 0207, edk2/0043): offerto solo con BIOS Lock acceso e "Clear memory
# at power-on" su "When the OS asks"
CONFIG_SMMSTORE_MOR_LOCK=y
# Gli argomenti dei comandi SMMSTORE solo nella pagina dopo il blocco dati
# del com buffer (patch 0215, edk2/0044): nessun indirizzo scelto dall'OS
# letto da SMM. Con il GSMI chiuso all'OS (0211) la tabella WSMT (0214) dichiara i tre flag:
# FIXED_COMM_BUFFERS, COMM_BUFFER_NESTED_PTR_PROTECTION (nessun puntatore
# dentro gli argomenti: offset nel blocco, chiave del MOR lock in linea),
# SYSTEM_RESOURCE_PROTECTION (dopo la finalize restano ACPI enable/disable,
# SMMSTORE, i comandi vboot e il MOR lock: solo il flash).
CONFIG_SMMSTORE_PARAMS_IN_COM_BUFFER=y
CONFIG_ACPI_WSMT=y
CONFIG_ACPI_WSMT_FIXED_COMM_BUFFERS=y
CONFIG_ACPI_WSMT_COMM_BUFFER_NESTED_PTR_PROTECTION=y
CONFIG_ACPI_WSMT_SYSTEM_RESOURCE_PROTECTION=y

# PCIe: Resizable BAR per una scheda grafica sul riser, come nella build
# coreboot che girava sul M920x
CONFIG_PCIEXP_SUPPORT_RESIZABLE_BARS=y

# Registro degli eventi nel flash (RW_ELOG), anche l'entrata in S3 e S5;
# i comandi GSMI dall'OS no (patch 0211), come sul W541
CONFIG_ELOG=y
CONFIG_ELOG_GSMI=y
# CONFIG_ELOG_GSMI_APMC is not set
# I codici POST anche in CMOS (byte 0x70-0x7A, liberi nella cmos.layout
# della board): l'avvio dopo un blocco mette nel registro dove era arrivato
CONFIG_CMOS_POST=y
CONFIG_CMOS_POST_OFFSET=0x70

# Console: la seriale (COM1 del Super I/O, dietro il connettore opzionale)
# spenta di default: il modulo COM e' facoltativo, e a 115200 baud la
# seriale costava a ogni avvio, con o senza cavo (6,2 s al livello DEBUG
# sulla v1.6.0-rc5). Si accende dal menu, Console -> Serial Console
# (CONSOLE_SERIAL_RUNTIME, l'opzione serial_console), da romstage in poi:
# bootblock e verstage seguono la parte RO, postcar resta senza seriale
# perche' non legge le opzioni. La console CBMEM (sudo cbmem -1) ha sempre
# fino a DEBUG; il livello della seriale: menu, Console -> Console Log Level.
CONFIG_DEFAULT_CONSOLE_LOGLEVEL_6=y
# CONFIG_CONSOLE_SERIAL is not set
CONFIG_CONSOLE_SERIAL_RUNTIME=y

# I dati di questa macchina dalla VPD (RO_VPD, vuota nelle release, si
# scrive con tools/vpd.py): numero di serie, UUID, Machine Type Model, SKU
# e famiglia nelle tabelle SMBIOS e nel menu, come col BIOS Lenovo.
CONFIG_VPD=y
CONFIG_SMBIOS_SERIAL_FROM_VPD=y
CONFIG_SMBIOS_UUID_FROM_VPD=y
CONFIG_SMBIOS_SYSTEM_DATA_FROM_VPD=y

# BIOS Lock e Firmware protection nel menu (Security -> Flash protection),
# come sul W541: BIOS Lock acceso di default dalla v1.6.0 (spento fino alla
# v1.5.0; BOOTMEDIA_SMM_BWP e' solo il default dell'opzione, un'impostazione
# salvata resta). Su soc/intel/common EISS e WPD si impostavano a
# BS_DEV_RESOURCES (pch/lockdown/lockdown.c), prima delle scritture del
# registro degli eventi da ramstage (elog a BS_POST_DEVICE, eventi di wake
# e reset a BS_DEV_INIT), che con il lock acceso fallivano tutte ("SPI
# Transaction Error", "ELOG: NV Write failed", hw-report BOOT-03): con la
# patch 0209 li imposta il gestore SMI alla finalize, dopo, come Lynx Point
# sul W541. La protezione di WP_RO dai Protected Range Register accesa.
CONFIG_BOOTMEDIA_SMM_BWP=y
CONFIG_BOOTMEDIA_SMM_BWP_RUNTIME_OPTION=y
CONFIG_SOC_INTEL_COMMON_PCH_LOCKDOWN_SMM_BWP_LATE=y
CONFIG_BOOTMEDIA_LOCK_CONTROLLER=y
CONFIG_BOOTMEDIA_LOCK_WPRO_VBOOT_RO=y
CONFIG_BOOTMEDIA_LOCK_RUNTIME_OPTION=y
# Con la stessa opzione un secondo Protected Range su SI_ALL (descrittore,
# GbE, ME; patch 0235, dalla v1.6.1): con UNLOCK_FLASH_REGIONS il
# descrittore le da' in scrittura alla CPU, e il BIOS Lock copre solo la
# regione BIOS. Restano leggibili; flashrom le scrive solo con la Firmware
# protection spenta, come la RO.
CONFIG_BOOTMEDIA_LOCK_SI_ALL=y
# Scrittura delle opzioni di sicurezza bloccata in SMM dopo ReadyToBoot
# (patch 0236/0237 + edk2 0056): l'OS non puo' piu' spegnere bios_lock o
# bootmedia_lock con la SMI raw di SMMSTORE e ripartire senza protezioni.
# Il setup le cambia ancora, prima dell'arm. Richiede BIOS Lock.
CONFIG_SMMSTORE_OPTION_LOCK=y
# Il lock per tutte le opzioni del setup (patch 0282): armato, il flash non
# tiene mai uno store da cui coreboot leggerebbe al prossimo avvio opzioni
# diverse da quelle dell'arm. Un programma dell'OS non puo' riaccendere un
# dispositivo spento nel setup. Il W541 resta col lock delle due opzioni
# finche' non l'ha provato (docs/dev-v1.7.0-m920x.md)
CONFIG_SMMSTORE_OPTION_LOCK_ALL=y
# Lo stesso lock un livello sopra (patch 0284): ogni opzione ha
# CFR_OPTFLAG_LOCK_AT_BOOT, e da ReadyToBoot il driver delle variabili del
# payload ne rifiuta la scrittura, prima che arrivi al flash. Il setup le
# cambia come prima; riaperto dopo una voce di avvio tornata indietro dice
# che sono bloccate fino al riavvio (edk2/0062)
CONFIG_DRIVERS_OPTION_CFR_LOCK_AT_BOOT=y

# Le opzioni del setup tornano ai default quando la RTC perde
# l'alimentazione (pila scarica, jumper della CMOS), come col BIOS Lenovo:
# romstage cancella le variabili di coreboot in SMMSTORE, tutte le opzioni
# del setup (anche livello della console e seriale). Quindi l'ME torna
# acceso (me_state Enabled, con qualche reset in piu'), Firmware protection
# accesa (da spegnere prima di un flashrom -i bios), e tornano le voci di
# avvio di iPXE e CSMWrap se erano spente. Con la pila scarica succede a
# ogni distacco della corrente. Chiavi di Secure Boot, le altre voci di
# avvio e VPD restano (docs/m920x.md, "Resetting the settings"). Solo negli
# slot costruiti con questa opzione; il simbolo viene dalla patch di
# drivers/efi che lo aggiunge (patches/series).
CONFIG_DRIVERS_EFI_RESET_OPTIONS_ON_RTC_FAILURE=y

# Aggiornamento con capsula UEFI (docs/update.md): il GUID dell'ESRT e' del
# M920x, una capsula del W541 non si applica qui ne' viceversa; cambiato con
# la parte RO del measured boot (generazione 2 di ro-interface.txt): una
# capsula di prima non si applica dietro questa parte RO, ne' viceversa
# (tools/update.py). LSV: la
# release piu' vecchia di cui il firmware accetta una capsula, quella della
# parte RO di oggi (da alzare con una release che riscrive la RO).
CONFIG_DRIVERS_EFI_FW_INFO=y
CONFIG_DRIVERS_EFI_MAIN_FW_GUID="ceef6456-ca3b-4cf3-a784-4895efaf1bde"
CONFIG_DRIVERS_EFI_MAIN_FW_LSV=0x01030900
CONFIG_DRIVERS_EFI_UPDATE_CAPSULES=y
CONFIG_DRIVERS_EFI_CAPSULE_ON_DISK_SUPPORT=y
# relativo all'albero di EDK2 (payloads/external/edk2/workspace/tianocore)
CONFIG_DRIVERS_EFI_CAPSULE_TRUSTED_PUBLIC_CERT="../../../../../m920x/capsule-signing.pem"
# FmpDxe con lo stesso FILE_GUID del W541 (patch 0135): ogni macchina ha le
# sue variabili; il GUID dell'ESRT arriva dalla tabella di coreboot
CONFIG_EDK2_CAPSULE_MAIN_FW_GUID="c9405485-0c3d-40b8-88bf-d2a07e5c3edd"

# Grafica: libgfxinit per l'iGPU (DisplayPort e HDMI), framebuffer del
# firmware al massimo 1920x1080 come nella build che girava sul M920x
CONFIG_MAINBOARD_USE_LIBGFXINIT=y
CONFIG_LINEAR_FRAMEBUFFER_MAX_WIDTH=1920
CONFIG_LINEAR_FRAMEBUFFER_MAX_HEIGHT=1080

# Payload: EDK II di TianoCore al tag stabile (edk2-stable202608) con
# patches/tianocore e il package del progetto, edk2/OuroBiosPkg con LvglPkg
# accanto (patch 0216, 0217): le righe di EDK2_PACKAGE_CONFIG di
# tools/build.sh. Gli stessi sorgenti dell'EDK2 di MrChromebox 6c14abf con
# patches/edk2 (tools/edk2-import.py), lo stesso payload byte per byte
# (tools/build.sh edk2-parity)
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_REPO_CUSTOM=y
CONFIG_EDK2_REPOSITORY="https://github.com/tianocore/edk2"
CONFIG_EDK2_TAG_OR_REV="2970e5699ba6267f3384ffab20f96647578aebc8"
CONFIG_EDK2_PLATFORM_DSC="OuroBiosPkg/OuroBiosPkg.dsc"
CONFIG_EDK2_PACKAGES_PATH="payloads/external/edk2/workspace/packages"
CONFIG_EDK2_SECURE_BOOT_SUPPORT=y
CONFIG_EDK2_BOOTSPLASH_FILE="m920x/bootsplash.bmp"
CONFIG_EDK2_BOOT_MANAGER_ESCAPE=y
CONFIG_EDK2_FOLLOW_BGRT_SPEC=y
# iPXE con il solo driver Intel (patch 0075: la I219-LM, 8086:15bb) e
# CSMWrap, come sul W541; il setup li spegne (General -> Boot)
CONFIG_EDK2_ENABLE_IPXE=y
CONFIG_IPXE_EFI_IMAGE="intel.efi"
CONFIG_EDK2_ENABLE_CSMWRAP=y
CONFIG_EDK2_CSMWRAP_FILE="m920x/csmwrap.efi"
# Le stesse opzioni di EDK2 del W541 (patch edk2/0027, edk2/0034)
# Le option ROM UEFI delle schede, come col firmware Lenovo: una scheda
# grafica sul riser mostra la schermata del firmware e il setup (con un
# processore F, senza grafica, e' l'unico schermo); con Secure Boot acceso
# EDK2 le verifica con le chiavi di db
CONFIG_EDK2_LOAD_OPTION_ROMS=y
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D UFS_ENABLE=FALSE -D UHCI_ENABLE=FALSE -D EBC_ENABLE=FALSE -D EXTRA_FS_DRIVERS=FALSE -D CRYPTO_PROTOCOL_SUPPORT=TRUE"
# Niente Shell UEFI nel payload (SHELL_TYPE NONE, dalla v1.6.0): 234
# KiB per slot, e con Secure Boot acceso partiva dal menu di avvio
# senza firma, come ogni file del firmware volume. Il boot manager
# toglie la voce che ne resta da una versione di prima (edk2/0053); una
# Shell su una chiavetta parte come ogni altro loader
# CONFIG_EDK2_HAVE_EFI_SHELL is not set
